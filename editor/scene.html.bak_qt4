        <button data-tab="peer" data-page-node-id="C7Uf2SbZMj4WIDk4ULhuGB" data-tip="对方主页面板：编辑对方的资料与主页">对方主页</button>
        <button data-tab="me" data-page-node-id="DdNbGCyzPW1xwgMaWZa1RH" data-tip="我的资料面板：编辑「我」的头像、昵称等信息">我的资料</button>
