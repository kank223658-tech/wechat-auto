    <div class="phone-screen" id="phoneScreen" data-page-node-id="vFiI9U2dliGsn9Ttst3pl5">
      <div class="live-empty" id="liveEmpty" data-page-node-id="mdEEzIZdUBNBPZ3tG5TAQB"><div class="dot" data-page-node-id="iYT3nRquSeQ5syjB3JQQFY">📱</div>运行工作流后<br data-page-node-id="lyyAPO7g01AACZkPObhjrp">这里会实时显示手机画面</div>
      <img id="liveImg" alt="实时手机画面" data-page-node-id="zr2eW6G5x1vHJdWnjybkCa">
