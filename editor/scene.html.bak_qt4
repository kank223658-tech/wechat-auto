    <div class="menu-wrap" id="sceneFileMenuWrap">
      <button type="button" class="menu-btn" id="btnSceneFileMenu" data-tip="文件菜单：载入 / 保存场景、生成工作流、打开视频目录">文件<i class="caret">▾</i></button>
      <div class="menu">
        <button id="btnLoad" data-tip="重新载入 scene.json，未保存的修改会丢失" class="menu-item" data-page-node-id="BA1S8ewzCyREOHhnAEqEhU">载入场景</button>
        <button id="btnSave" data-tip="把当前场景保存为 scene.json" class="menu-item" data-page-node-id="GoGBsmHFJPMKTMo2J1aSDv">保存场景</button>
        <button id="btnToWorkflow" data-tip="按当前场景自动生成工作流步骤（只生成不运行）" class="menu-item" data-page-node-id="qniAjqWw3nfWBMEVevaU4O">生成工作流</button>
        <button id="btnVideos" data-tip="打开生成视频所在的文件夹" class="menu-item" data-page-node-id="O2iIowqx9FVqFsyBCWospU">📂 打开视频目录</button>
      </div>
    </div>
    <div class="zoom" data-page-node-id="32KdXu33FLMnOtRPdwjhEU">
      <button id="btnZoomOut" data-tip="缩小手机画面" data-page-node-id="7gN1sbcxQGRseIQlRHBxMG">−</button>
      <b id="zoomLabel" data-page-node-id="sR5DnCRTCV6ZXWdGAqGOck">100%</b>
      <button id="btnZoomIn" data-tip="放大手机画面" data-page-node-id="jJacHmEaYuM64AiYVFxnBG">＋</button>
      <button id="btnZoomFit" data-tip="恢复手机画面默认大小" data-page-node-id="0W9ub5tsYeYkGtWzky8chH">适应</button>
    </div>
    <button id="btnEditMode" data-tip="进入编辑模式：实时画面可点选元素修改文字/头像/背景" data-page-node-id="BXJgVc9752XC2qycx2DaIG">✏️ 编辑模式</button>
    <button id="btnLive" data-tip="打开/关闭实时手机画面" data-page-node-id="9rjcxCVUwTYBP4GLnqnTEk">🖥 实时画面</button>
    <button id="btnStop" data-tip="停止当前运行" data-page-node-id="8LJzdGKlk1eNbZwG8xBGdM">⏹ 停止</button>
    <button id="btnRun" class="primary" data-tip="保存场景 → 生成工作流 → 立即运行并打开实时画面" data-page-node-id="CzCsyRgZXayBPD03VWzkIZ">▶ 生成并运行</button>
  </div>
  <div class="hint" style="padding:0 14px 6px" data-page-node-id="MqyVf8GrdeKKJxMEAmhr7N">左：实时预览——和最终视频完全同一套界面（同一份代码渲染），可直接点击操作（进聊天 / 翻朋友圈 / 切 Tab）；需要打字、键盘、点选改元素时切到「📱 真机运行」。Ctrl 或 Shift + 滚轮缩放画布。右：结构化面板编辑联系人与消息，改动实时同步到左边画面。「生成并运行」会保存场景、生成工作流并直接开跑。</div>

  <div class="main" data-page-node-id="zsW1ABs062PElWLtEBLMBE">
    <div class="stage" id="stage" data-page-node-id="nde6tzcYTdlGkMvDjbHfkM">
      <div class="viewport" id="viewport" data-page-node-id="yQH3QsWGzmOiEwnNtwayub">
        <div class="phone-wrap" id="phoneWrap" data-page-node-id="o0kR7KaXDQ5ygBOh5wGhj9">
          <div class="phone" data-page-node-id="l7DjpI2rnS5Q2KrvwCExv2">
            <div class="phone-inner" id="phoneInner" data-page-node-id="cW6kV9yKwyUzsuEEAWnWEl"></div>
            <img class="phone-live" id="stageLiveImg" alt="真机实时画面" hidden data-page-node-id="Yz3kLvPq1WmSdR8bTnQxHa">
            <iframe class="phone-pv" id="stagePv" src="about:blank" title="实时预览（真实界面）"></iframe>
            <div class="live-badge" id="stageLiveBadge" hidden data-page-node-id="Mv7TpKs2JdQnLcV9ZaWrEy"><i></i>真机 LIVE</div>
            <div class="edit-pop" id="stageEditPop" hidden data-page-node-id="Jp4RwNc8YbHmTqsZ6LfVdA"></div>
