<!DOCTYPE html>
<html lang="zh-CN" data-page-node-id="HCoAneiSlantjAEgGQjFU5">
<head data-page-node-id="fifKV7JzCQDbzMXTAHVEZK">
<meta charset="utf-8" data-page-node-id="Eri4ivWs5BD1KgVnAwFqE1">
<title>独立场景编辑器 · 微信录屏</title>
<style>
    :root {
    color-scheme: light;
    --bg: #f4f5f7;
    --panel: #ffffff;
    --panel-2: #f2f3f6;
    --panel-3: #e9ebef;
    --field: #f7f8fa;
    --line: rgba(17, 24, 39, 0.08);
    --line-strong: rgba(17, 24, 39, 0.16);
    --text: #1c1e22;
    --muted: #5c616b;
    --muted-2: #9095a0;
    --accent: #0aac5f;
    --accent-strong: #0a9d57;
    --accent-soft: rgba(10, 172, 95, 0.10);
    --accent-border: rgba(10, 172, 95, 0.38);
    --amber: #b9791e;
    --red: #d54941;
    --ink-0: #0f1115;
    --shadow: 0 24px 64px rgba(17, 24, 39, 0.16);
    --shadow-soft: 0 6px 20px rgba(17, 24, 39, 0.06);
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; height: 100%;
    background:
      radial-gradient(1100px 480px at 18% -12%, rgba(10, 172, 95, 0.04), transparent 60%),
      var(--bg);
    color: var(--text);
    font: 14px/1.5 "PingFang SC", "Microsoft YaHei", -apple-system, BlinkMacSystemFont, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb {
    background: rgba(17, 24, 39, 0.14);
    background-clip: content-box;
    border: 2.5px solid transparent;
    border-radius: 999px;
  }
  ::-webkit-scrollbar-thumb:hover { background-color: rgba(17, 24, 39, 0.24); }
  .app { display: flex; flex-direction: column; height: 100vh; }

  /* 顶部工具栏 */
  .topbar {
    display: flex; align-items: center; gap: 8px; padding: 10px 16px;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(16px);
    flex-wrap: wrap;
  }
  .topbar .brand { font-weight: 600; font-size: 15px; margin-right: 6px; color: var(--ink-0); letter-spacing: 0.3px; }
  .topbar .brand small { color: var(--muted-2); font-weight: 400; }
  .topbar .spacer { flex: 1; }
  .topbar button, .panel button {
    cursor: pointer;
    border: 1px solid var(--line);
    background: var(--panel-2);
    color: var(--text);
    border-radius: 9px;
    padding: 6px 12px;
    transition: background .14s ease, border-color .14s ease, transform .14s ease;
  }
  .topbar button:hover, .panel button:hover { background: var(--panel-3); border-color: var(--line-strong); transform: translateY(-1px); }
  .topbar button.primary, .panel button.primary {
    background: linear-gradient(180deg, #15d274, #0cb259);
    border-color: transparent;
    color: #ffffff;
    font-weight: 600;
    box-shadow: 0 6px 18px rgba(10, 172, 95, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.22);
  }
  .topbar button.primary:hover, .panel button.primary:hover {
    background: linear-gradient(180deg, #1bda7c, #0fbe62);
    border-color: transparent;
  }
  .topbar .zoom { display: flex; align-items: center; gap: 4px; }
  .topbar .zoom b { min-width: 54px; text-align: center; font-size: 13px; color: var(--muted); font-weight: 500; }
  .hint { font-size: 12px; color: var(--muted-2); margin-top: 2px; line-height: 1.7; }

  /* 主体：左预览 + 右面板 */
  .main { flex: 1; display: flex; min-height: 0; }
  .stage {
    flex: 1; position: relative; overflow: hidden;
    background-image: radial-gradient(rgba(17, 24, 39, 0.06) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  .viewport { position: absolute; inset: 0; overflow: hidden; }
  .phone-wrap { position: absolute; left: 50%; top: 40px; transform: translate(-50%, 0) scale(var(--zoom, 1)); transform-origin: top center; transition: transform .12s ease; }

  /* ============ 手机壳：严格 600 × 1300 固定画布（不做自适应缩放） ============ */
  .phone { width: 600px; height: 1300px; background: #181818; border: 1px solid #1a1b1e; overflow: hidden; position: relative; box-shadow: 0 30px 80px rgba(17, 24, 39, 0.28); }
  .phone-inner { width: 600px; height: 1300px; overflow: hidden; position: relative; background: #181818; color: #d6d6d6; font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", "Helvetica Neue", Arial, sans-serif; }

  /* ---- 状态栏 (0~83) ---- */
  .statusbar { position: absolute; left: 0; top: 0; width: 600px; height: 83px; background: #111111; color: #fff; }
  .statusbar .sb-time { position: absolute; left: 60px; top: 31px; font-size: 25px; line-height: 30px; font-weight: 600; color: #f5f5f5; letter-spacing: .2px; }
  .statusbar .sb-mute { position: absolute; left: 136px; top: 34px; width: 21px; height: 22px; color: #fff; }
  .statusbar .sb-right { position: absolute; inset: 0; }
  .statusbar .sb-signal { position: absolute; left: 430px; top: 36px; width: 30px; height: 20px; color: #f1f1f1; }
  .statusbar .sb-wifi { position: absolute; left: 471px; top: 35px; width: 27px; height: 21px; color: #f1f1f1; }
  .statusbar .sb-battery { position: absolute; left: 508px; top: 35px; width: 41px; height: 20px; color: #f1f1f1; }

  /* ---- 页面标题栏 (83~149) ---- */
  .wx-header { position: absolute; left: 0; top: 83px; width: 600px; height: 66px; background: #111111; color: #d8d8d8; z-index: 5; }
  .wx-header .c { position: absolute; left: 0; right: 0; top: 18px; height: 32px; line-height: 32px; text-align: center; font-size: 25px; font-weight: 500; color: #d8d8d8; }
  .wx-header .c .parentheses { color: #d8d8d8; }
  .wx-header .back { position: absolute; left: 26px; top: 18px; font-size: 28px; color: #cfd0d2; cursor: pointer; }
  .wx-header .right { position: absolute; right: 26px; top: 18px; font-size: 26px; color: #cfd0d2; }
  /* 首页大标题右侧加号：外圆 31×31，边框 2px #B8B8B8，内部十字线 */
  .wx-header .plus { position: absolute; left: 541px; top: 99px; width: 31px; height: 31px; border: 2px solid #b8b8b8; border-radius: 50%; cursor: pointer; }
  .wx-header .plus::before, .wx-header .plus::after { content: ""; position: absolute; background: #b8b8b8; }
  .wx-header .plus::before { left: 50%; top: 6px; bottom: 6px; width: 2px; transform: translateX(-50%); }
  .wx-header .plus::after { top: 50%; left: 6px; right: 6px; height: 2px; transform: translateY(-50%); }

  /* ---- 搜索框区域 (149~232) ---- */
  .search { position: absolute; left: 0; top: 149px; width: 600px; height: 83px; background: #111111; z-index: 4; }
  .search .box { position: absolute; left: 12px; top: 6px; width: 576px; height: 55px; background: #191919; border-radius: 8px; }
  .search .ic { position: absolute; left: 258px; top: 21px; width: 25px; height: 25px; color: #5a5a5a; }
  .search .txt { position: absolute; left: 296px; top: 18px; height: 30px; line-height: 30px; font-size: 24px; font-weight: 400; color: #5a5a5a; }

  /* ---- 会话列表 (232~1162) ---- */
  .chat-list { position: absolute; left: 0; top: 232px; width: 600px; height: 930px; overflow: hidden; background: #181818; z-index: 2; }
  .chat-row { position: absolute; left: 0; width: 600px; height: 110px; background: #181818; cursor: pointer; }
  .chat-row::after { content: ""; position: absolute; left: 115px; right: 0; bottom: 0; height: 1px; background: #292929; }
  .chat-row:hover { background: #1c1c1c; }
  .chat-row img.ava { position: absolute; left: 24px; top: 18px; width: 73px; height: 73px; border-radius: 7px; object-fit: cover; background: #2c2c2e; }
  .chat-row .name { position: absolute; left: 115px; top: 23px; width: 440px; height: 31px; line-height: 31px; font-size: 25px; font-weight: 400; color: #d6d6d6; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .chat-row .last { position: absolute; left: 115px; top: 61px; width: 460px; height: 28px; line-height: 28px; font-size: 22px; color: #686868; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .chat-row .time { position: absolute; right: 25px; top: 24px; font-size: 18px; line-height: 24px; font-weight: 400; color: #343434; }
  /* 未读数字角标：圆心 (94,254) 直径 28 */
  .chat-row .badge { position: absolute; left: 80px; top: 7px; width: 28px; height: 28px; line-height: 28px; border-radius: 14px; background: #fa5151; color: #fff; font-size: 17px; text-align: center; z-index: 3; }
  /* 免打扰未读小红点：直径 15 */
  .chat-row .dot { position: absolute; left: 86px; top: 13px; width: 15px; height: 15px; border-radius: 50%; background: #fa5151; z-index: 3; }
  /* 免打扰静音图标：摘要右侧 */
  .chat-row .mute2 { position: absolute; left: 557px; top: 64px; width: 18px; height: 18px; color: #303030; }

  /* ---- 右侧悬浮胶囊 (被屏幕右边缘裁切) ---- */
  .pill { position: absolute; left: 575px; top: 419px; width: 38px; height: 111px; background: #3a3a3a; border-radius: 12px 0 0 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; z-index: 3; }
  .pill i { width: 4px; height: 4px; border-radius: 50%; background: #747474; }

  /* ---- 底部 Tab Bar (1162~1300) ---- */
  .tabbar { position: absolute; left: 0; top: 1162px; width: 600px; height: 138px; background: rgba(24, 24, 24, 0.96); border-top: 1px solid #292929; z-index: 4; }
  .tabbar .tab { position: absolute; top: 0; width: 150px; height: 138px; text-align: center; cursor: pointer; }
  .tabbar .tab .ic { position: absolute; left: 50%; top: 16px; transform: translateX(-50%); width: 40px; height: 40px; color: #d2d2d2; }
  .tabbar .tab .lb { position: absolute; left: 0; right: 0; top: 62px; height: 22px; line-height: 22px; font-size: 16px; color: #c8c8c8; font-weight: 400; }
  .tabbar .tab.active .ic, .tabbar .tab.active .lb { color: #07c160; }
  /* 微信 Tab 未读徽标：位置约 (80,1163)，39×28 */
  .tabbar .tab-badge { position: absolute; left: 80px; top: 1px; width: 39px; height: 28px; line-height: 28px; border-radius: 14px; background: #fa5151; color: #fff; font-size: 17px; text-align: center; z-index: 3; }
  /* 发现 Tab 红点：圆心约 (389,1181) 直径 13 */
  .tabbar .tab-dot { position: absolute; left: 82px; top: 12px; width: 13px; height: 13px; border-radius: 50%; background: #fa5151; z-index: 3; }

  /* ---- 通讯录 / 我 示意稿（2026-09-11 同步新版真机 UI） ---- */
  .wxc-funcs { position: absolute; left: 0; top: 232px; width: 600px; height: 304px; background: #181818; z-index: 2; }
  .wxc-func { position: absolute; left: 0; width: 600px; height: 76px; background: #181818; }
  .wxc-func::after { content: ""; position: absolute; left: 96px; right: 0; bottom: 0; height: 1px; background: #292929; }
  .wxc-ic { position: absolute; left: 24px; top: 16px; width: 44px; height: 44px; border-radius: 9px; display: flex; align-items: center; justify-content: center; }
  .wxc-flb { position: absolute; left: 96px; top: 50%; transform: translateY(-50%); height: 32px; line-height: 32px; font-size: 25px; color: #d6d6d6; }
  .wxc-list { position: absolute; left: 0; top: 552px; width: 600px; height: 610px; overflow: hidden; background: #181818; z-index: 2; }
  .wxc-letter { position: absolute; left: 0; width: 600px; height: 44px; line-height: 44px; padding-left: 24px; font-size: 20px; color: #686868; background: #181818; box-sizing: border-box; }
  .wxc-row { position: absolute; left: 0; width: 600px; height: 96px; background: #181818; }
  .wxc-row::after { content: ""; position: absolute; left: 106px; right: 0; bottom: 0; height: 1px; background: #292929; }
  .wxc-row img.ava2 { position: absolute; left: 24px; top: 16px; width: 64px; height: 64px; border-radius: 7px; object-fit: cover; background: #2c2c2e; }
  .wxc-row .wxc-nm { position: absolute; left: 106px; top: 50%; transform: translateY(-50%); height: 32px; line-height: 32px; font-size: 25px; color: #d6d6d6; }
  .wxs-top { position: absolute; left: 0; top: 149px; width: 600px; height: 180px; background: #181818; z-index: 2; }
  .wxs-top img.wxs-ava { position: absolute; left: 24px; top: 36px; width: 108px; height: 108px; border-radius: 9px; object-fit: cover; background: #2c2c2e; }
  .wxs-top .wxs-name { position: absolute; left: 152px; top: 46px; height: 40px; line-height: 40px; font-size: 30px; font-weight: 600; color: #d6d6d6; }
  .wxs-top .wxs-wxid { position: absolute; left: 152px; top: 100px; height: 28px; line-height: 28px; font-size: 21px; color: #686868; }
  .wxs-top .wxs-qr { position: absolute; right: 74px; top: 72px; }
  .wxs-top .wxs-arrow { position: absolute; right: 30px; top: 64px; font-size: 36px; color: #555; }
  .wxs-cells { position: absolute; left: 0; top: 361px; width: 600px; height: 800px; background: #181818; z-index: 2; }
  .wxs-row { position: absolute; left: 0; width: 600px; height: 96px; background: #181818; }
  .wxs-row::after { content: ""; position: absolute; left: 96px; right: 0; bottom: 0; height: 1px; background: #292929; }


  /* ---- 对话气泡（适配 600 宽） ---- */
  .dialogue { position: absolute; left: 0; top: 149px; width: 600px; bottom: 0; background: #111 !important; padding: 16px; overflow-y: auto; }
  .bubble { display: flex; gap: 10px; margin-bottom: 10px; }
  .bubble img.ava { width: 40px; height: 40px; border-radius: 4px; object-fit: cover; background: #2c2c2e; flex: none; }
  .bubble.self { flex-direction: row-reverse; }
  .bubble .bubble-body { max-width: 72%; }
  .bubble .b-name { display: none; }
  .bubble .ta { position: relative; padding: 9px 13px; border-radius: 8px; background: #2c2c2e; color: #fff; font-size: 17px; line-height: 1.42; word-break: break-word; width: fit-content; }
  .bubble.self .ta { background: #2bb262; color: #111; }
  .bubble:not(.self) .ta::before { content: ''; position: absolute; left: -7px; top: 13px; border: 8px solid transparent; border-left: 0; border-right-color: #2c2c2e; }
  .bubble.self .ta::before { content: ''; position: absolute; right: -7px; top: 13px; border: 8px solid transparent; border-right: 0; border-left-color: #2bb262; }
  .bubble .ta.img { padding: 0; overflow: hidden; }
  .bubble .ta.img img { display: block; max-width: 200px; border-radius: 8px; }
  .bubble .ta.voice { display: flex; align-items: center; gap: 8px; min-width: 96px; }
  .bubble .ta.voice .wave { display: flex; align-items: center; gap: 2px; }
  .bubble .ta.voice .wave i { width: 3px; border-radius: 2px; background: #777; }
  .bubble.self .ta.voice .wave i { background: #3a7d20; }
  .bubble .ta.voice .dur { font-size: 12px; color: #cfd0d2; }
  .bubble.self .ta.voice .dur { color: #3a5b1f; }

  /* ---- 朋友圈 ---- */
  .moments { position: absolute; left: 0; top: 149px; width: 600px; bottom: 0; background: #111; overflow-y: auto; }
  .m-cover { height: 240px; background: url('/images/peer/peer_cover.jpg') center/cover no-repeat; position: relative; }
  .m-cover::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(0,0,0,.30) 0%, rgba(0,0,0,.05) 40%, rgba(0,0,0,.38) 100%); }
  .m-cover .me { position: absolute; right: 14px; bottom: -26px; width: 70px; height: 70px; border-radius: 8px; border: 2px solid #111; object-fit: cover; background: #2c2c2e; }
  .m-cover .me-name { position: absolute; right: 94px; bottom: 6px; color: #fff; font-weight: 600; font-size: 16px; text-shadow: 0 1px 3px #000; }
  .m-post { padding: 14px; border-bottom: 1px solid #2e2e30; }
  .m-post .row { display: flex; gap: 10px; }
  .m-post .row img.ava { width: 44px; height: 44px; border-radius: 6px; object-fit: cover; }
  .m-post .bd { flex: 1; }
  .m-post .author { color: #6aa1ff; font-size: 15px; }
  .m-post .author .co { color: #bc9663; margin-left: 4px; }
  .m-post .txt { color: #fff; font-size: 15px; margin-top: 4px; word-break: break-word; }
  .m-post .imgs { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
  .m-post .imgs img { width: 90px; height: 90px; border-radius: 4px; object-fit: cover; }
  /* 视频动态：封面 + 播放角标（脚本里 [播放视频] 点开全屏播放） */
  .m-post .m-video { margin-top: 8px; }
  .m-post .m-video .mv-wrap { position: relative; display: inline-block; width: 120px; height: 120px; border-radius: 4px; overflow: hidden; background: #000; }
  .m-post .m-video .mv-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .m-post .m-video .mv-wrap.mv-nocover::before { content: '视频'; position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #6a6b70; font-size: 13px; }
  .m-post .m-video .mv-play { position: absolute; left: 50%; top: 50%; width: 34px; height: 34px; margin: -17px 0 0 -17px; border-radius: 50%; background: rgba(0,0,0,.45); }
  .m-post .m-video .mv-play::after { content: ''; position: absolute; left: 13px; top: 10px; border-left: 12px solid #fff; border-top: 7px solid transparent; border-bottom: 7px solid transparent; }
  .m-post .m-video .mv-src { display: block; margin-top: 4px; font-size: 11px; color: #7a7b80; word-break: break-all; }
  .m-post .time { color: #5a5a5e; font-size: 12px; margin-top: 8px; }
  .m-post .likes { margin-top: 6px; background: #1c1c1e; border-radius: 4px; padding: 6px 8px; color: #6aa1ff; font-size: 13px; }
  .m-post .comment-e { color: #cfd0d2; font-size: 13px; margin-top: 4px; }
  .m-post .comment-e b { color: #6aa1ff; }

  .edit-mark { outline: 2px dashed transparent; }
  [data-path]:hover { outline: 2px dashed rgba(7,193,96,.75); outline-offset: 2px; cursor: pointer; }

  /* 右侧面板 */
  .panel {
    width: 420px; border-left: 1px solid var(--line);
    background: var(--panel);
    display: flex; flex-direction: column; min-height: 0;
  }
  .panel-tabs { display: flex; border-bottom: 1px solid var(--line); background: var(--panel-2); }
  .panel-tabs button {
    flex: 1; border: 0; border-bottom: 2px solid transparent; border-radius: 0;
    background: transparent; color: var(--muted); font-weight: 500; padding: 12px 0;
    transition: color .14s ease, border-color .14s ease;
  }
  .panel-tabs button:hover { background: transparent; border-color: transparent; border-bottom-color: transparent; transform: none; color: var(--text); }
  .panel-tabs button.active { color: var(--accent); border-bottom-color: var(--accent); }
  .panel-body { flex: 1; overflow: auto; padding: 14px; }
  .panel-body h3 { margin: 6px 0 10px; font-size: 14px; color: var(--ink-0); font-weight: 600; }
  .btn-row { display: flex; gap: 8px; margin: 8px 0 14px; flex-wrap: wrap; }
  .card { border: 1px solid var(--line); border-radius: 12px; padding: 10px; margin-bottom: 10px; background: var(--panel-2); }
  .card .head { display: flex; align-items: center; gap: 8px; }
  .card .head .t { flex: 1; font-weight: 600; color: var(--ink-0); }
  .card .head button { padding: 3px 8px; font-size: 12px; }
  .field { margin-top: 8px; }
  .field label { display: block; font-size: 12px; color: var(--muted); margin-bottom: 3px; letter-spacing: 0.3px; }
  .field input, .field select, .field textarea {
    width: 100%; background: var(--field); color: var(--text);
    border: 1px solid var(--line); border-radius: 9px; padding: 6px 8px; font: inherit;
    transition: border-color .14s ease, box-shadow .14s ease;
  }
  .field input:focus, .field select:focus, .field textarea:focus {
    outline: none; border-color: var(--accent-border);
    box-shadow: 0 0 0 3px rgba(10, 172, 95, 0.12);
  }
  .field textarea { min-height: 54px; resize: vertical; }
  .field .mini { display: flex; gap: 6px; }
  .field .mini input { flex: 1; min-width: 0; }
  .field .mini button { flex: none; white-space: nowrap; }
  /* 右侧面板里的视频预览：确认地址可播后再生成工作流 */
  .mv-preview { width: 100%; max-height: 220px; background: #000; border-radius: 9px; border: 1px solid var(--line); display: block; }
  .field select.imgsel { height: 30px; }
  .inline-btns { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
  .tag { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 12px; }
  .tag.me { background: var(--accent-soft); color: #0a8a4f; border: 1px solid var(--accent-border); }
  .tag.peer { background: rgba(71, 86, 216, 0.14); color: #4756d8; border: 1px solid rgba(71, 86, 216, 0.3); }
  .tag.kind { background: var(--panel-3); color: var(--muted); border: 1px solid var(--line); }
  .toast {
    position: fixed; left: 50%; bottom: 40px; transform: translateX(-50%);
    background: linear-gradient(180deg, #15d274, #0cb259);
    color: #ffffff; padding: 10px 18px; border-radius: 10px; font-weight: 600;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
    opacity: 0; transition: opacity .2s; pointer-events: none;
  }
  .toast.show { opacity: 1; }

  /* 编辑弹窗 */
  .modal-mask { position: fixed; inset: 0; background: rgba(5, 6, 8, 0.62); backdrop-filter: blur(6px); display: none; align-items: center; justify-content: center; z-index: 50; }
  .modal-mask.show { display: flex; }
  .modal { width: 360px; background: var(--panel); border: 1px solid var(--line-strong); border-radius: 16px; padding: 16px; box-shadow: var(--shadow); }
  .modal h4 { margin: 0 0 12px; font-size: 15px; color: var(--ink-0); font-weight: 600; }
  .modal .btns { display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px; }

  /* ---- 内联图片字段（会话/消息/朋友圈/我的资料 里的头像、配图、封面） ---- */
  .img-field { display: flex; gap: 10px; align-items: center; margin-top: 8px; }
  .img-field .if-thumb { width: 46px; height: 46px; border-radius: 9px; object-fit: cover; background: var(--field); border: 1px solid var(--line); flex: none; cursor: pointer; }
  .img-field .if-thumb.if-empty { display: flex; align-items: center; justify-content: center; font-size: 13px; color: var(--muted-2); }
  .img-field .if-right { flex: 1; min-width: 0; }
  .img-field .if-actions { display: flex; gap: 6px; flex-wrap: wrap; }
  .img-field .if-actions button { padding: 3px 9px; font-size: 12px; }
  .img-field .if-path { font-size: 11px; color: var(--muted-2); margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; direction: rtl; }

  /* ---- 图片选择弹窗（缩略图网格 + 上传 + 链接 + 预览） ---- */
  .modal-mask.picker-mask { z-index: 60; }
  .modal-mask.picker-mask .modal.picker { width: 720px; max-width: 94vw; }
  /* ---- 剧本导入弹窗 ---- */
  .modal-mask.script-mask { z-index: 72; }
  .modal-mask.script-mask .modal.script { width: 640px; max-width: 94vw; max-height: 88vh; overflow: auto; }
  .script-head { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
  .script-head b { font-size: 15px; color: var(--ink-0); }
  .script-head .spacer { flex: 1; }
  .script-close { background: transparent; border: 0; font-size: 20px; color: var(--muted-2); cursor: pointer; padding: 0 4px; }
  .script-hint { font-size: 12px; color: var(--muted-2); margin-bottom: 10px; line-height: 1.6; }
  .script-area {
    width: 100%; min-height: 220px; resize: vertical;
    background: var(--field); color: var(--text);
    border: 1px solid var(--line); border-radius: 10px; padding: 8px;
    font: 13px/1.6 inherit, sans-serif; box-sizing: border-box;
  }
  .script-area:focus { outline: none; border-color: var(--accent-border); box-shadow: 0 0 0 3px rgba(10, 172, 95, 0.12); }
  .script-opts { display: flex; align-items: center; gap: 18px; margin: 12px 0; flex-wrap: wrap; }
  .script-opts label { display: inline-flex; align-items: center; gap: 5px; font-size: 13px; color: var(--muted); cursor: pointer; }
  .script-opts select { background: var(--field); color: var(--text); border: 1px solid var(--line); border-radius: 9px; padding: 5px 8px; font: inherit; }
  .script-btns { display: flex; justify-content: flex-end; gap: 8px; }
  .script-btns button { cursor: pointer; border: 1px solid var(--line); background: var(--panel-2); color: var(--text); border-radius: 9px; padding: 7px 14px; }
  .script-btns button:hover { background: var(--panel-3); border-color: var(--line-strong); }
  .script-btns button.primary {
    background: linear-gradient(180deg, #15d274, #0cb259); border-color: transparent;
    color: #ffffff; font-weight: 600;
    box-shadow: 0 6px 18px rgba(10, 172, 95, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.22);
  }
  .script-btns button.primary:hover { background: linear-gradient(180deg, #1bda7c, #0fbe62); border-color: transparent; }
  /* ---- 剧本导入使用手册弹窗 ---- */
  .modal-mask.manual-mask { z-index: 80; }
  .modal-mask.manual-mask .modal.manual { width: 780px; max-width: 96vw; max-height: 90vh; overflow: auto; }
  .manual-head { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
  .manual-head b { font-size: 16px; color: var(--ink-0); }
  .manual-head .spacer { flex: 1; }
  .manual-body { font-size: 13px; line-height: 1.75; color: var(--muted); }
  .manual-body h3 { font-size: 14px; color: var(--accent); margin: 20px 0 6px; border-bottom: 1px solid var(--line); padding-bottom: 4px; }
  .manual-body h3:first-child { margin-top: 0; }
  .manual-body h4 { font-size: 13px; color: var(--text); margin: 12px 0 4px; }
  .manual-body p { margin: 6px 0; }
  .manual-body ol, .manual-body ul { margin: 6px 0 6px 22px; padding: 0; }
  .manual-body li { margin: 4px 0; }
  .manual-body code {
    background: var(--panel-3); border: 1px solid var(--line); border-radius: 5px;
    padding: 1px 6px; color: #7ee2ac; font-family: Consolas, "Courier New", monospace;
  }
  .manual-body .m-ex {
    background: #0a0b0d; border: 1px solid var(--line); border-radius: 9px;
    padding: 10px 12px; margin: 8px 0; white-space: pre; overflow: auto;
    font-family: Consolas, "Courier New", monospace; font-size: 12px; color: #a8d8b8;
  }
  .manual-body .m-tip { background: var(--accent-soft); border-left: 3px solid var(--accent); padding: 7px 10px; border-radius: 0 9px 9px 0; margin: 8px 0; color: #0a7a4a; }
  .manual-body .m-warn { background: rgba(202, 138, 20, 0.1); border-left: 3px solid var(--amber); padding: 7px 10px; border-radius: 0 9px 9px 0; margin: 8px 0; color: #b9791e; }
  .manual-body table { border-collapse: collapse; width: 100%; margin: 8px 0; font-size: 12px; }
  .manual-body th, .manual-body td { border: 1px solid var(--line); padding: 6px 8px; text-align: left; vertical-align: top; }
  .manual-body th { background: var(--panel-3); color: var(--muted); }
  .picker-head b { font-size: 15px; color: var(--ink-0); }
  .picker-head .picker-target { font-size: 12px; color: var(--muted-2); flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .picker-close { background: transparent; border: 0; font-size: 20px; color: var(--muted-2); cursor: pointer; padding: 0 4px; }
  .picker-toolbar { display: flex; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
  .picker-toolbar input { flex: 1; min-width: 140px; background: var(--field); color: var(--text); border: 1px solid var(--line); border-radius: 9px; padding: 6px 8px; font: inherit; }
  .picker-urlrow { display: flex; gap: 6px; margin-bottom: 8px; }
  .picker-urlrow input { flex: 1; background: var(--field); color: var(--text); border: 1px solid var(--line); border-radius: 9px; padding: 6px 8px; font: inherit; }
  .picker-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(88px, 1fr)); gap: 8px; max-height: 320px; overflow: auto; padding: 4px; border: 1px solid var(--line); border-radius: 10px; background: var(--field); }
  .pg-item { cursor: pointer; border: 1px solid transparent; border-radius: 9px; padding: 4px; text-align: center; }
  .pg-item:hover { background: var(--panel-3); }
  .pg-item.sel { border-color: var(--accent-border); background: var(--accent-soft); }
  .pg-thumb { height: 64px; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 7px; background: var(--panel-2); }
  .pg-thumb img { max-width: 100%; max-height: 100%; object-fit: cover; }
  .pg-thumb.pg-clear { font-size: 13px; color: var(--muted-2); }
  .pg-name { font-size: 11px; color: var(--muted-2); margin-top: 3px; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pg-empty { grid-column: 1 / -1; color: var(--muted-2); text-align: center; padding: 24px 0; font-size: 13px; }
  .picker-footer { display: flex; gap: 12px; align-items: center; margin-top: 12px; }
  .picker-preview { display: flex; gap: 10px; align-items: center; flex: 1; min-width: 0; }
  .picker-preview img { width: 54px; height: 54px; border-radius: 9px; object-fit: cover; background: var(--field); border: 1px solid var(--line); }
  .picker-preview .picker-path { font-size: 12px; color: var(--muted-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* ---- 图片库管理弹窗 ---- */
  .modal-mask.lib-mask { z-index: 70; }
  .modal-mask.lib-mask .modal.lib { width: 840px; max-width: 96vw; max-height: 88vh; display: flex; flex-direction: column; }
  .lib-head { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
  .lib-head b { font-size: 15px; color: var(--ink-0); }
  .lib-count { font-size: 12px; color: var(--muted-2); flex: 1; }
  .lib-close { background: transparent; border: 0; font-size: 20px; color: var(--muted-2); cursor: pointer; padding: 0 4px; }
  .lib-toolbar { display: flex; gap: 8px; margin-bottom: 10px; flex-wrap: wrap; }
  .lib-toolbar input, .lib-toolbar select { background: var(--field); color: var(--text); border: 1px solid var(--line); border-radius: 9px; padding: 6px 8px; font: inherit; }
  .lib-toolbar input { flex: 1; min-width: 160px; }
  .lib-toolbar button, .lib-btns button { cursor: pointer; border: 1px solid var(--line); background: var(--panel-2); color: var(--text); border-radius: 9px; padding: 6px 12px; }
  .lib-toolbar button:hover, .lib-btns button:hover { background: var(--panel-3); border-color: var(--line-strong); }
  .lib-toolbar button.primary {
    background: linear-gradient(180deg, #15d274, #0cb259); border-color: transparent;
    color: #ffffff; font-weight: 600;
  }
  .lib-grid { flex: 1; min-height: 200px; display: grid; grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); gap: 10px; overflow: auto; padding: 6px; border: 1px solid var(--line); border-radius: 10px; background: var(--field); align-content: start; }
  .lib-item { cursor: pointer; border: 1px solid transparent; border-radius: 10px; padding: 6px; text-align: center; position: relative; }
  .lib-item:hover { background: var(--panel-3); }
  .lib-item.sel { border-color: var(--accent-border); background: var(--accent-soft); }
  .lib-thumb { height: 84px; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 8px; background: var(--panel-2); position: relative; }
  .lib-thumb img { max-width: 100%; max-height: 100%; object-fit: cover; }
  .lib-thumb img.img-broken { outline: 2px dashed #fa5151; outline-offset: -2px; }
  .lib-type { position: absolute; top: 4px; right: 4px; font-size: 10px; color: var(--text); padding: 1px 5px; border-radius: 4px; border: 1px solid rgba(0,0,0,.4); }
  .lib-type.ic { background: rgba(71, 86, 216, 0.25); }
  .lib-type.im { background: rgba(10, 172, 95, 0.25); }
  .lib-typebar { display: flex; gap: 6px; align-items: center; margin-bottom: 8px; flex-wrap: wrap; }
  .lib-typebtn { cursor: pointer; border: 1px solid var(--line); background: var(--panel-2); color: var(--text); border-radius: 8px; padding: 5px 12px; font: inherit; font-size: 12px; }
  .lib-typebtn:hover { background: var(--panel-3); }
  .lib-typebtn.on { background: linear-gradient(180deg, #15d274, #0cb259); border-color: transparent; color: #ffffff; font-weight: 600; }
  .lib-typebtn.on:hover { background: linear-gradient(180deg, #1bda7c, #0fbe62); border-color: transparent; }
  .lib-name { font-size: 11px; color: var(--muted); margin-top: 4px; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lib-tag { font-size: 10px; color: var(--muted-2); display: block; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lib-selected { display: flex; align-items: center; gap: 8px; margin-top: 6px; }
  .lib-selpath { flex: 1; min-width: 0; font-size: 12px; color: var(--muted-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lib-btns { display: flex; gap: 8px; align-items: center; }
  .lib-btns button.danger { border-color: rgba(213, 73, 65, 0.35); background: rgba(213, 73, 65, 0.1); color: #c73e35; }
  .lib-btns button.danger:hover { background: rgba(213, 73, 65, 0.2); border-color: var(--red); }
  .lib-action { margin-top: 12px; border-top: 1px solid var(--line); padding-top: 12px; }
  .lib-rename-row { display: flex; gap: 8px; align-items: center; }
  .lib-rename-row input { flex: 1; background: var(--field); color: var(--text); border: 1px solid var(--line); border-radius: 9px; padding: 6px 8px; font: inherit; }
  .lib-empty { grid-column: 1 / -1; color: var(--muted-2); text-align: center; padding: 40px 0; font-size: 13px; }
  /* 批量删除：勾选角标 / 选中高亮 / 拖拽导入高亮 */
  .lib-cb { position: absolute; left: 6px; top: 6px; width: 20px; height: 20px; border-radius: 6px; border: 1.5px solid var(--line-strong); background: rgba(0,0,0,.5); color: transparent; font-size: 13px; line-height: 18px; text-align: center; font-style: normal; z-index: 2; transition: background .12s ease, border-color .12s ease, color .12s ease; }
  .lib-cb.on { border-color: var(--accent); background: var(--accent); color: #ffffff; }
  .lib-item.batch-sel { border-color: var(--accent-border); background: var(--accent-soft); }
  .lib-toolbar button.active { background: linear-gradient(180deg, #15d274, #0cb259); border-color: transparent; color: #ffffff; font-weight: 600; }
  .lib-grid.drop { border-color: var(--accent); box-shadow: inset 0 0 0 2px rgba(10, 172, 95, .3); }
  /* 拖图到分类按钮 ＝ 搬家；整窗拖入上传高亮 */
  .lib-typebtn.drop { border-color: var(--accent); background: var(--accent-soft); color: var(--accent); transform: scale(1.06); }
  .lib-item[draggable="true"] { cursor: grab; }
  .lib-item[draggable="true"]:active { cursor: grabbing; }
  .modal.lib.drop { outline: 2px dashed var(--accent); outline-offset: -6px; }
  .modal.lib.drop .lib-grid { border-color: var(--accent); }
  /* 图片库全屏预览 */
  .lib-preview { position: fixed; inset: 0; z-index: 80; background: rgba(0,0,0,.92); display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .lib-preview[hidden] { display: none; }
  .lib-pv-head { position: absolute; top: 16px; right: 22px; width: 40px; height: 40px; display: grid; place-items: center; background: rgba(255,255,255,.08); color: #fff; font-size: 26px; cursor: pointer; border-radius: 50%; }
  .lib-pv-head:hover { background: rgba(255,255,255,.18); }
  .lib-preview img { max-width: 92vw; max-height: 84vh; object-fit: contain; border-radius: 9px; }
  .lib-pv-path { position: absolute; bottom: 18px; left: 0; right: 0; text-align: center; color: var(--muted); font-size: 13px; }

  /* ---- 人物库管理弹窗 ---- */
  .modal-mask.people-mask { z-index: 55; }
  .modal-mask.people-mask .modal.people { width: 860px; max-width: 96vw; max-height: 88vh; display: flex; flex-direction: column; }
  .people-head { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
  .people-head b { font-size: 15px; color: var(--ink-0); }
  .people-count { font-size: 12px; color: var(--muted-2); flex: 1; }
  .people-close { background: transparent; border: 0; font-size: 20px; color: var(--muted-2); cursor: pointer; padding: 0 4px; }
  .people-toolbar { display: flex; gap: 8px; margin-bottom: 10px; flex-wrap: wrap; }
  .people-toolbar input, .people-toolbar select { background: var(--field); color: var(--text); border: 1px solid var(--line); border-radius: 9px; padding: 6px 8px; font: inherit; }
  .people-toolbar input { flex: 1; min-width: 160px; }
  .people-toolbar button { cursor: pointer; border: 1px solid var(--line); background: var(--panel-2); color: var(--text); border-radius: 9px; padding: 6px 12px; }
  .people-toolbar button:hover { background: var(--panel-3); border-color: var(--line-strong); }
  .people-toolbar button.primary {
    background: linear-gradient(180deg, #15d274, #0cb259); border-color: transparent;
    color: #ffffff; font-weight: 600;
  }
  .people-toolbar button.primary:hover { background: linear-gradient(180deg, #1bda7c, #0fbe62); border-color: transparent; }
  .people-groups { display: flex; gap: 6px; margin: 0 0 10px; flex-wrap: wrap; }
  .people-groups .pg-tab { cursor: pointer; border: 1px solid var(--line); background: var(--panel-2); color: var(--muted); border-radius: 999px; padding: 4px 12px; font-size: 12px; }
  .people-groups .pg-tab:hover { background: var(--panel-3); border-color: var(--line-strong); }
  .people-groups .pg-tab.on { background: linear-gradient(180deg, #15d274, #0cb259); border-color: transparent; color: #ffffff; font-weight: 600; }
  .people-grid { flex: 1; min-height: 200px; display: grid; grid-template-columns: repeat(auto-fill, minmax(128px, 1fr)); gap: 10px; overflow: auto; padding: 6px; border: 1px solid var(--line); border-radius: 10px; background: var(--field); align-content: start; }
  .people-item { cursor: pointer; border: 1px solid transparent; border-radius: 10px; padding: 6px; text-align: center; position: relative; }
  .people-item:hover { background: var(--panel-3); }
  .people-item.sel { border-color: var(--accent-border); background: var(--accent-soft); }
  .people-item.disabled { opacity: .45; pointer-events: none; }
  .people-thumb { width: 64px; height: 64px; margin: 0 auto; border-radius: 50%; display: flex; align-items: center; justify-content: center; overflow: hidden; background: var(--panel-2); border: 1px solid var(--line); }
  .people-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .people-thumb.people-noava { font-size: 11px; color: var(--muted-2); border-radius: 9px; }
  .people-name { font-size: 13px; color: var(--text); margin-top: 5px; display: block; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .people-extra { font-size: 11px; color: var(--muted-2); margin-top: 2px; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .people-extra.used { color: #0a8a4f; }
  .people-extra.missing { color: #b9791e; }
  .people-empty { grid-column: 1 / -1; color: var(--muted-2); text-align: center; padding: 40px 0; font-size: 13px; }
  .people-selected { display: flex; align-items: center; gap: 8px; margin-top: 6px; }
  .people-selpath { flex: 1; min-width: 0; font-size: 12px; color: var(--muted-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .people-btns { display: flex; gap: 8px; align-items: center; }
  .people-btns button { cursor: pointer; border: 1px solid var(--line); background: var(--panel-2); color: var(--text); border-radius: 9px; padding: 5px 10px; font-size: 12px; }
  .people-btns button:hover { background: var(--panel-3); border-color: var(--line-strong); }
  .people-btns button.danger { border-color: rgba(213, 73, 65, 0.35); background: rgba(213, 73, 65, 0.1); color: #c73e35; }
  .people-btns button.danger:hover { background: rgba(213, 73, 65, 0.2); border-color: var(--red); }
  .people-action { margin-top: 10px; border-top: 1px solid var(--line); padding-top: 10px; min-height: 0; }
  .people .btns { display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px; }
  .people .btns button { cursor: pointer; border: 1px solid var(--line); background: var(--panel-2); color: var(--text); border-radius: 9px; padding: 7px 16px; }
  .people .btns button:hover { background: var(--panel-3); border-color: var(--line-strong); }
  .people .btns button.primary {
    background: linear-gradient(180deg, #15d274, #0cb259); border-color: transparent;
    color: #ffffff; font-weight: 600;
  }
  .people .btns button.primary:hover { background: linear-gradient(180deg, #1bda7c, #0fbe62); border-color: transparent; }
  .people-rename-row { display: flex; gap: 8px; align-items: center; }
  .people-rename-row input { flex: 1; background: var(--field); color: var(--text); border: 1px solid var(--line); border-radius: 9px; padding: 6px 8px; font: inherit; }
  .people-rename-row button { cursor: pointer; border: 1px solid var(--line); background: var(--panel-2); color: var(--text); border-radius: 9px; padding: 6px 12px; }
  .people-rename-row button.primary { background: linear-gradient(180deg, #15d274, #0cb259); border-color: transparent; color: #ffffff; font-weight: 600; }
  .people-usage { font-size: 12px; color: var(--muted); line-height: 1.7; }
  .people-usage b { color: var(--text); }
  .people-usage .ok { color: #0a8a4f; }
  .people-usage .warn { color: #b9791e; }
  .people-usage a { color: #4756d8; text-decoration: underline; cursor: pointer; }
  .people-usage a:hover { color: #6474e8; }
  .people-usage .chips { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px; }
  .people-usage .chips span { background: var(--panel-3); border: 1px solid var(--line); border-radius: 999px; padding: 2px 10px; font-size: 12px; color: var(--muted); }
  .people-usage .chips span.this { border-color: var(--accent-border); color: #0a8a4f; }
  .people-hint-line { font-size: 12px; color: var(--muted-2); margin: 0 0 8px; }
  .people-hint-line b { color: var(--muted); }

  /* ---- 图片加载失败标记（调试用：红框提示，不再静默空白） ---- */
  .img-broken { visibility: visible !important; outline: 2px dashed #fa5151; outline-offset: -2px; background: #2a2b2e !important; min-width: 16px; min-height: 16px; }

  /* ---- 实时画面浮层（复用 /api/live 与编辑模式接口） ---- */
  .live-panel { position: fixed; top: 78px; left: 14px; z-index: 45; width: 302px; overflow: hidden; border: 1px solid var(--line-strong); border-radius: 18px; background: #0b0c0e; box-shadow: var(--shadow); }
  .live-head { display: flex; align-items: center; gap: 8px; padding: 9px 12px; border-bottom: 1px solid var(--line); background: #121317; color: #dfe2e8; font-size: 12px; font-weight: 600; }
  .live-head .spacer { flex: 1; }
  .live-dot { width: 8px; height: 8px; border-radius: 50%; background: #3a3d44; }
  .live-dot.on { background: var(--accent); box-shadow: 0 0 0 4px rgba(10, 172, 95, .16); animation: pulse 1s infinite; }
  .live-close { width: 26px; height: 26px; display: grid; place-items: center; border: none; border-radius: 8px; background: transparent; color: var(--muted-2); cursor: pointer; font-size: 16px; }
  .live-close:hover { background: rgba(255, 255, 255, .08); color: #fff; }
  .live-body { position: relative; padding: 12px; background: #000; }
  .phone-screen { position: relative; aspect-ratio: 600 / 1300; overflow: hidden; border-radius: 20px; background: #000; border: 1px solid #26282e; }
  .phone-screen img { width: 100%; height: 100%; display: block; object-fit: cover; }
  .phone-screen img.loading { opacity: .35; }
  .phone-screen.editable { cursor: crosshair; }
  .live-empty { position: absolute; inset: 0; z-index: 2; display: grid; place-items: center; padding: 20px; color: var(--muted-2); font-size: 12px; line-height: 1.9; text-align: center; pointer-events: none; }
  .live-empty .dot { font-size: 26px; margin-bottom: 8px; }
  .live-tip { padding: 8px 12px; border-top: 1px solid var(--line); background: #121317; color: var(--muted-2); font-size: 11px; line-height: 1.6; text-align: center; }
  .live-modes { display: flex; align-items: center; gap: 4px; }
  .mode-btn { height: 24px; padding: 0 8px; border: 1px solid var(--line-strong); border-radius: 999px; background: transparent; color: var(--muted); font-size: 11px; cursor: pointer; white-space: nowrap; transition: background .12s ease, color .12s ease, border-color .12s ease; }
  .mode-btn.active { background: var(--accent-strong); border-color: var(--accent-strong); color: #ffffff; }
  .edit-pop { position: absolute; z-index: 5; width: 232px; max-width: 92%; padding: 10px; border-radius: 12px; background: rgba(14, 15, 18, .97); border: 1px solid var(--line-strong); box-shadow: 0 12px 32px rgba(0, 0, 0, .5); color: #dfe2e8; font-size: 12px; }
  .edit-pop .ep-kind { margin-bottom: 6px; color: #7ee2ac; font-size: 11px; font-weight: 600; }
  .edit-pop input { width: 100%; height: 30px; padding: 0 8px; margin-bottom: 8px; border: 1px solid var(--line-strong); border-radius: 8px; background: #0a0b0d; color: #fff; font-size: 12px; outline: none; }
  .edit-pop .ep-actions { display: flex; gap: 6px; justify-content: flex-end; }
  .edit-pop .ep-actions button { height: 26px; padding: 0 10px; border: none; border-radius: 8px; cursor: pointer; font-size: 12px; }
  .edit-pop .ep-save { background: var(--accent-strong); color: #ffffff; }
  .edit-pop .ep-cancel { background: var(--panel-3); color: var(--muted); }
  .edit-pop .ep-hint { margin-top: 8px; color: var(--muted-2); font-size: 10px; line-height: 1.55; }
  .live-typebar { display: flex; gap: 6px; padding: 8px 10px; border-top: 1px solid var(--line); background: #121317; }
  .live-typebar input { flex: 1; min-width: 0; height: 30px; padding: 0 8px; border: 1px solid var(--line-strong); border-radius: 8px; background: #0a0b0d; color: #fff; font-size: 12px; outline: none; }
  .live-typebar button { height: 30px; padding: 0 12px; border: none; border-radius: 8px; background: var(--accent-strong); color: #ffffff; font-size: 12px; font-weight: 600; cursor: pointer; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(10, 172, 95, .5); } 70% { box-shadow: 0 0 0 6px rgba(10, 172, 95, 0); } 100% { box-shadow: 0 0 0 0 rgba(10, 172, 95, 0); } }

  /* ============ 对方主页 / 对方朋友圈 预览 ============
     直接复用前端真实样式 /enhance/peer_pages.css（.wx-peer-page / .wpp-* / .wpm-*），
     这里只把「全屏固定覆盖层」改成「手机画布内的绝对定位层」，保证预览 = 成品。 */
  .phone-inner .wx-peer-page { position: absolute; transform: none; visibility: visible; transition: none; z-index: 20; }
  .phone-inner .statusbar { z-index: 30; }              /* 状态栏压在封面之上，和真机一致 */
  .phone-inner .wx-peer-page .wpp-nav { margin-top: 83px; }  /* 编辑器状态栏高 83px */
  .phone-inner .wpp-scroll, .phone-inner .wpm-scroll { max-height: 1217px; }
  .peer-flag { font-size: 12px; color: var(--muted-2); }
  .peer-flag b { color: var(--accent); }
  /* 编辑器专用：对方朋友圈预览里的结构编辑小工具（运行端没有这些元素） */
  .phone-inner .wpm-edobar {
    margin: 12px 25px 0; padding: 8px 12px; border: 1px dashed var(--accent-border);
    border-radius: 9px; color: #6fd7a8; font-size: 12px; text-align: center; cursor: pointer;
  }
  .phone-inner .wpm-edobar:hover { background: rgba(10, 172, 95, .08); }
  .phone-inner .wpm-post { position: relative; }
  .phone-inner .wpm-ops {
    position: absolute; right: -6px; top: -2px; display: none; gap: 4px; z-index: 5;
  }
  .phone-inner .wpm-post:hover .wpm-ops { display: inline-flex; }
  .phone-inner .wpm-ops i {
    font-style: normal; font-size: 11px; line-height: 1; padding: 4px 6px;
    background: var(--panel-3); color: var(--muted); border-radius: 6px; cursor: pointer;
  }
  .phone-inner .wpm-ops i:hover { background: #2b2e34; color: #fff; }


  /* ---- UI v2: 顶栏菜单与统一尺寸 ---- */
  .topbar .btn { height: 32px; }
  .topbar .btn.small { height: 30px; }
  .topbar .btn.primary { height: 34px; }
  .menu-wrap { position: relative; display: inline-flex; }
  .menu-btn .caret { font-style: normal; font-size: 10px; opacity: .55; margin-left: 3px; }
  .menu {
    position: absolute; top: calc(100% + 6px); left: 0; z-index: 90;
    min-width: 176px; display: none; flex-direction: column; gap: 2px; padding: 6px;
    background: var(--panel); border: 1px solid var(--line-strong); border-radius: 12px;
    box-shadow: var(--shadow-pop, 0 12px 32px rgba(17, 24, 39, 0.14));
  }
  .menu-wrap.open .menu { display: flex; }
  .menu .btn, .menu button {
    display: flex; width: 100%; align-items: center; justify-content: flex-start; gap: 8px;
    height: 34px; padding: 0 10px; border: 0; border-radius: 8px; background: transparent;
    transform: none; box-shadow: none;
  }
  .menu .btn:hover, .menu button:hover { background: var(--panel-2); border: 0; transform: none; }
  .menu-sep { height: 1px; margin: 4px 6px; background: var(--line); }

  /* ---- UI v2: 分段式视图切换 ---- */
  .view-switch {
    display: inline-flex; align-items: center; gap: 2px; padding: 3px;
    border-radius: 11px; background: var(--panel-2); border: 1px solid var(--line);
  }
  .view-btn {
    height: 30px; padding: 0 13px; border: none; border-radius: 8px; background: transparent;
    color: var(--muted); font-size: 13px; font-weight: 500; cursor: pointer; white-space: nowrap;
    transition: background .14s ease, color .14s ease, box-shadow .14s ease;
  }
  .view-btn:hover { color: var(--text); }
  .view-btn.active { background: #ffffff; color: var(--ink-0); font-weight: 600; box-shadow: 0 1px 5px rgba(17, 24, 39, 0.14); }

  /* 深色部件与浅色界面的接缝 */
  .log { border-color: rgba(255, 255, 255, 0.08); }
  .log-head { border-color: rgba(255, 255, 255, 0.08); }
  .manual-syntax { border-color: rgba(255, 255, 255, 0.08); }
  .live-panel { border-color: #26282e; }
  .live-head { border-color: rgba(255, 255, 255, 0.08); }
  .live-tip { border-color: rgba(255, 255, 255, 0.08); }
  .live-typebar { border-color: rgba(255, 255, 255, 0.08); }
  .edit-pop { border-color: rgba(255, 255, 255, 0.14); }
  .phone-screen { border-color: #26282e; }
/* ---------- 卡片折叠控件 ---------- */
.fold-toolbar { display: flex; gap: 6px; margin: 0 0 10px; }
.fold-toolbar button {
  padding: 3px 10px; font-size: 11px; cursor: pointer;
  border: 1px solid var(--line); border-radius: 8px;
  background: var(--panel-2); color: var(--muted);
}
.fold-toolbar button:hover { color: var(--accent); border-color: var(--accent-border); }
.fold-btn {
  flex: none; width: 22px; height: 22px; padding: 0;
  display: grid; place-items: center; cursor: pointer;
  border: 1px solid transparent; border-radius: 7px;
  background: transparent; color: var(--muted); font-size: 12px; line-height: 1;
}
.fold-btn:hover { border-color: var(--line); background: var(--panel-3); color: var(--accent); }
.card-fold.closed { display: none; }

/* ---------- 说明文字折叠成「?」 ---------- */
.hint.compacted { display: flex; align-items: flex-start; gap: 7px; }
.hint-q {
  flex: none; width: 16px; height: 16px; display: inline-grid; place-items: center; padding: 0;
  border: 1px solid var(--line); border-radius: 50%; background: var(--panel-2);
  color: var(--muted); font-size: 10.5px; font-weight: 700; line-height: 1; cursor: help;
}
.hint-q:hover { color: var(--accent); border-color: var(--accent-border); background: var(--panel-3); }
.hint-body { display: none; flex: 1; }
.hint.compacted.open .hint-body { display: block; }

/* ===== 真机画面（主舞台实时画面：与成片同一套 UI，可点击操作） ===== */
.phone-live { position: absolute; left: 0; top: 0; width: 600px; height: 1300px; display: block; z-index: 40; background: #000; cursor: pointer; -webkit-user-drag: none; }
.phone-live[hidden] { display: none; }
.phone-live.picking { cursor: crosshair; }
.phone-live.loading { opacity: .55; }
.phone .live-badge {
  position: absolute; right: 12px; top: 12px; z-index: 60;
  display: inline-flex; align-items: center; gap: 6px;
  padding: 4px 10px; border-radius: 999px;
  background: rgba(10, 172, 95, .94); color: #fff;
  font-size: 11px; font-weight: 600; letter-spacing: .3px;
  box-shadow: 0 3px 10px rgba(0, 0, 0, .3);
}
.phone .live-badge[hidden] { display: none; }
.phone .live-badge.off { background: rgba(107, 114, 128, .92); }
.phone .live-badge i { width: 6px; height: 6px; border-radius: 50%; background: #fff; animation: lbPulse 1.6s ease-in-out infinite; }
.phone .live-badge.off i { animation: none; }
@keyframes lbPulse { 0%, 100% { opacity: 1; } 50% { opacity: .2; } }

.phone-live-empty {
  position: absolute; left: 0; top: 0; width: 600px; height: 1300px; z-index: 45;
  display: grid; place-content: center; justify-items: center; gap: 10px;
  padding: 0 60px; text-align: center; background: #12141a; color: #e5e7eb;
}
.phone-live-empty[hidden] { display: none; }
.phone-live-empty .ple-ico { font-size: 46px; line-height: 1; }
.phone-live-empty .ple-t { font-size: 18px; font-weight: 600; }
.phone-live-empty .ple-d { font-size: 13.5px; line-height: 1.8; color: #9ca3af; }
.phone-live-empty .ple-btn { margin-top: 8px; padding: 11px 24px; font-size: 14.5px; font-weight: 600; color: #fff; background: #0aac5f; border: 0; border-radius: 999px; cursor: pointer; }
.phone-live-empty .ple-btn:hover { background: #099455; }
.phone-live-empty .ple-btn:disabled { opacity: .65; cursor: default; }
.phone-live-empty .ple-err { font-size: 12px; line-height: 1.7; color: #f3a5a5; max-width: 400px; }
.phone-live-empty .ple-err[hidden] { display: none; }

.phone .edit-pop { z-index: 80; width: 236px; max-width: none; }
#stageEditPop[hidden] { display: none; }

/* 舞台底部浮动工具条 */
.stage-live-bar {
  position: absolute; left: 50%; bottom: 16px; transform: translateX(-50%); z-index: 70;
  display: flex; align-items: center; gap: 8px; padding: 7px 11px;
  border-radius: 999px; background: rgba(255, 255, 255, .97);
  border: 1px solid rgba(17, 24, 39, .1); box-shadow: 0 12px 32px rgba(17, 24, 39, .18);
  backdrop-filter: blur(8px); font-size: 13px; white-space: nowrap;
}
.slb-group { display: inline-flex; background: #f2f3f6; border-radius: 999px; padding: 2px; }
.slb-group button { height: 26px; padding: 0 13px; border: 0; border-radius: 999px; background: transparent; color: #55606e; font-size: 12.5px; cursor: pointer; }
.slb-group button.active { background: #fff; color: #111827; font-weight: 600; box-shadow: 0 1px 3px rgba(17, 24, 39, .14); }
.slb-btn { height: 28px; padding: 0 12px; border: 1px solid rgba(17, 24, 39, .13); border-radius: 999px; background: #fff; color: #374151; font-size: 12.5px; cursor: pointer; }
.slb-btn:hover { background: #f6f7f9; }
.slb-btn.on { background: #0aac5f; border-color: #0aac5f; color: #fff; }
.slb-sep { width: 1px; height: 20px; background: rgba(17, 24, 39, .13); }
.stage-live-bar input { width: 200px; height: 28px; padding: 0 12px; border: 1px solid rgba(17, 24, 39, .15); border-radius: 999px; font-size: 12.5px; background: #fff; color: #111827; outline: none; }
.stage-live-bar input:focus { border-color: #0aac5f; }
.slb-state { font-size: 11.5px; color: #9ca3af; padding-right: 3px; }
.slb-state.ok { color: #0aac5f; font-weight: 600; }

/* ---- 实时预览（同源嵌入真实前端，与成片同一套 UI）---- */
.phone-pv { position: absolute; left: 0; top: 0; width: 600px; height: 1300px; border: 0; display: block; z-index: 39; background: #181818; }
  .phone-pv[hidden] { display: none !important; }  /* 修复：hidden 被 display:block 压掉，导致示意稿被 iframe 盖住、点击全被吃 */
#stageLiveBar:not(.live) .slb-sep,
#stageLiveBar:not(.live) #btnStagePick,
#stageLiveBar:not(.live) #btnStageBack,
#stageLiveBar:not(.live) #stageTypeInput,
#stageLiveBar:not(.live) #btnStageSend { display: none; }
</style>
