function tplOptions() {
  return Object.keys(PEER_TEMPLATES).map(k =>
    '<option value="' + k + '"' + (k === peerTplSel ? ' selected' : '') + '>' + esc(PEER_TEMPLATES[k].label) + '</option>').join('');
}
/* 从图片库挑 n 张（不重复优先，不够就循环补齐），每次点击都重新洗牌 */
function pickGalleryImgs(n) {
  const pool = (gallery || []).slice();
  for (let i = pool.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    const t = pool[i]; pool[i] = pool[j]; pool[j] = t;
  }
  const out = [];
  for (let k = 0; k < n; k++) out.push(pool.length ? pool[k % pool.length] : '');
  return out;
}
function panelPeer() {
  migratePeer();
  const pp = activePeer();
  const p = peerData();
  const v = (p.video && typeof p.video === 'object') ? p.video : null;
  const B = PB();
  const planKeys = Object.keys(pp.plans);
  let h = '<h3>对方主页 · 朋友圈（多人物 × 多方案）</h3>';

  /* ① 人物列表 */
  h += '<div class="card"><div class="head"><span class="t">① 人物列表</span></div>' +
    '<div class="hint" style="margin:-4px 0 8px">每个人物都有自己独立的主页和朋友圈，点「编辑」切换到这个人物。</div>';
  scene.peers.forEach((it, pi) => {
    const d = it.plans[it.activePlan] || {};
    h += '<div class="card" style="background:#15161a"><div class="head">' +
      '<span class="t">' + (pi === peerSel ? '▶ ' : '') + esc(d.name || '人物 ' + (pi + 1)) +
      ' <span class="tag kind">' + esc(Object.keys(it.plans).join('/')) + '</span></span>' +
      '<button data-act="peer-use" data-i="' + pi + '"' + (pi === peerSel ? ' disabled' : '') + '>编辑</button>' +
      '<button data-act="peer-copy" data-i="' + pi + '">复制</button>' +
      '<button data-act="peer-del" data-i="' + pi + '">删除</button></div>' +
      (pi === peerSel
        ? '<div class="field"><label>关联会话联系人（选填，方便对应是谁的朋友圈）</label><select data-set="peers[' + pi + '].link">' +
          '<option value="">— 不关联 —</option>' +
          (scene.home || []).map(c => '<option value="' + esc(c.name || c.group || '') + '"' +
            (pp.link === (c.name || c.group) ? ' selected' : '') + '>' + esc(c.name || c.group || '') + '</option>').join('') +
          '</select></div>'
        : '') +
      '</div>';
  });
  h += '<div class="btn-row"><button data-act="peer-add">＋ 新建空白人物</button>' +
    '<button data-act="peer-add-from-preset">＋ 从预设新建人物</button></div></div>';

  /* ② 编辑方案 */
  h += '<div class="card"><div class="head"><span class="t">② 编辑方案（当前人物：' + esc((p.name || '未命名') + '）') + '</span></div>' +
    '<div class="btn-row">' + planKeys.map(k =>
      '<button data-act="plan-use" data-k="' + esc(k) + '"' + (k === pp.activePlan ? ' class="primary"' : '') + '>方案 ' + esc(k) + '</button>').join('') + '</div>' +
    '<div class="btn-row"><button data-act="plan-add">＋ 新建空白方案</button>' +
    '<button data-act="plan-copy">⧉ 复制当前方案</button>' +
    (planKeys.length > 1 ? '<button data-act="plan-del">✖ 删除当前方案</button>' : '') + '</div>' +
    '<div class="hint">同一人物可备多套朋友圈内容，点方案字母即切换预览；' +
    '「生成工作流」只导出每个人物的当前方案。' +
    '<label style="display:inline-flex;gap:6px;align-items:center;margin-left:10px">' +
    '<input type="checkbox" data-set="peerNav"' + (scene.peerNav ? ' checked' : '') + '> 生成工作流时自动进入对方主页 → 朋友圈</label></div>' +
    '</div>';

  /* 一键生成 */
  h += '<div class="card"><div class="head"><span class="t">一键生成整套动态（当前方案）</span></div>' +
    '<div class="field"><label>内容模板</label><select id="peerTplSel">' + tplOptions() + '</select></div>' +
    '<div class="btn-row"><button data-act="peer-tpl-gen">⚡ 按模板生成动态（覆盖当前方案的动态列表）</button></div>' +
    '<div class="hint">自动生成 6 条动态：模板文案 + 从图片库随机挑配图 + 日期错落；生成后仍可逐条再改。</div>' +
    (llmConfigured
      ? '<div class="field" style="margin-top:8px"><label>AI 文案关键词（职业 / 性格 / 语气，逗号分隔）</label>' +
        '<div class="mini"><input id="peerAiKw" placeholder="如：花店店主，温柔，文艺">' +
        '<button data-act="peer-ai-copy">AI 生成文案</button></div>' +
        '<div class="hint" style="margin-top:4px">用大模型给每条动态重新写文案（配图与日期保留）。</div></div>'
      : '<div class="hint" style="color:#8a8b8f">想用 AI 生成文案？先到工作流编辑器顶部「配置大模型」填入 DeepSeek Key。</div>') +
    '</div>';

  /* 预设库 */
  h += '<div class="card"><div class="head"><span class="t">预设库（peer_presets.json）</span></div>' +
    '<div class="field"><label>选择预设</label><select id="peerPresetSel">' + peerPresetOptions() + '</select></div>' +
    '<div class="btn-row">' +
      '<button data-act="peer-apply-preset">套用到当前方案</button>' +
      '<button data-act="peer-save-preset">把当前方案另存为预设</button>' +
      '<button data-act="peer-del-preset">删除该预设</button>' +
    '</div>' +
    '<div class="hint">套用后仍可逐字段改；改完点「保存场景」。</div></div>';

  /* 基本资料 */
  h += '<div class="card"><div class="head"><span class="t">基本资料（当前方案）</span></div>' +
    fieldText(B + '.name', '昵称', p.name) +
    fieldText(B + '.wxid', '微信号', p.wxid) +
    fieldText(B + '.area', '地区', p.area) +
    '<div class="field"><label>性别</label><select data-set="' + B + '.gender">' +
      '<option value="0"' + (Number(p.gender) !== 1 ? ' selected' : '') + '>女</option>' +
      '<option value="1"' + (Number(p.gender) === 1 ? ' selected' : '') + '>男</option></select></div>' +
    '<div class="field"><label>头像</label>' + imgField(B + '.avatar', p.avatar) + '</div>' +
    fieldText(B + '.signature', '个性签名', p.signature) +
    '</div>';

  /* 封面 / 缩略图 / 视频号 */
  h += '<div class="card"><div class="head"><span class="t">朋友圈封面 / 缩略图</span></div>' +
    '<div class="field"><label>封面</label>' + imgField(B + '.cover', p.cover) + '</div>' +
    imgListField(B + '.momentsThumbs', p.momentsThumbs, '主页朋友圈缩略图（最多 5 张）', 5) +
    '</div>';
  h += '<div class="card"><div class="head"><span class="t">视频号</span>' +
    '<button data-act="peer-toggle-video">' + (v ? '移除视频号' : '添加视频号') + '</button></div>';
  if (v) {
    h += fieldText(B + '.video.name', '视频号名称', v.name) +
      imgListField(B + '.video.thumbs', v.thumbs, '视频缩略图（最多 5 张）', 5);
  } else {
    h += '<div class="hint">未设置视频号时，资料页不显示「视频号」这一行。</div>';
  }
  h += '</div>';

  /* ③ 动态列表 */
  h += '<div class="card"><div class="head"><span class="t">③ 朋友圈动态（方案 ' + esc(pp.activePlan) + '）</span>' +
    '<button data-act="peer-add-post">＋ 新增动态</button></div>';
  (p.posts || []).forEach((post, i) => {
    const pv = peerResolveVideo(post);
    const likesVal = (post.likes || []).join('、');
    let comments = (post.comments || []).map((c, k) =>
      '<div class="field"><label>评论' + (k + 1) + ' 内容</label><input data-set="' + B + '.posts[' + i + '].comments[' + k + '].text" value="' + esc(c.text || '') + '">' +
      '<div style="margin-top:4px"><input data-set="' + B + '.posts[' + i + '].comments[' + k + '].name" value="' + esc(c.name || '') + '" placeholder="评论人"></div>' +
      '<div class="btn-row" style="margin:6px 0 0"><button data-act="peer-del-comment" data-i="' + i + '" data-k="' + k + '">删除该评论</button></div></div>').join('');
    h += '<div class="card" style="background:#15161a"><div class="head"><span class="t">动态 ' + (i + 1) + '</span>' +
      '<button data-act="peer-post-video" data-i="' + i + '">' + (pv ? '移除视频' : '加视频') + '</button>' +
      '<button data-act="peer-up-post" data-i="' + i + '">↑</button>' +
      '<button data-act="peer-down-post" data-i="' + i + '">↓</button>' +
      '<button data-act="peer-del-post" data-i="' + i + '">删除</button></div>' +
      fieldText(B + '.posts[' + i + '].date', '日期（如 10 6月）', post.date) +
      '<div class="field"><label>文案（换行即分段）</label><textarea data-set="' + B + '.posts[' + i + '].text">' + esc(post.text || '') + '</textarea></div>';
    if (pv) {
      h += fieldText(B + '.posts[' + i + '].video.src', '视频地址（/videos/xxx.mp4 或 http 地址）', pv.src) +
        '<div class="field"><label>视频封面</label>' + imgField(B + '.posts[' + i + '].video.cover', pv.cover) + '</div>' +
        '<div class="hint">这条动态显示「封面 + 播放角标」，脚本里用 [播放视频] 点开全屏播放。</div>';
    } else {
      h += imgListField(B + '.posts[' + i + '].images', post.images, '配图（最多 9 张）', 9);
    }
    h += '<div class="field"><label>点赞的人（顿号分隔，留空 = 不显示点赞）</label><input data-set="' + B + '.posts[' + i + '].likesText" value="' + esc(likesVal) + '"></div>' +
      comments +
      '<div class="btn-row"><button data-act="peer-add-comment" data-i="' + i + '">＋ 加评论</button></div></div>';
  });
  if (!(p.posts || []).length) h += '<div class="hint">这套方案还没有动态。可以点上方「按模板生成动态」快速填充，或在左边手机画面点「＋ 添加动态」。</div>';
  h += '</div>';
  return h;
}
function fieldText(path, label, val) {
  return '<div class="field"><label>' + esc(label) + '</label><input data-set="' + path + '" value="' + esc(val) + '"></div>';
}
function imgLabel(path) {
  if (/\.bg$/.test(path) || /bg/.test(path)) return '背景';
  if (/cover/.test(path)) return '封面';
  if (/avatar/.test(path)) return '头像';
  return '图片';
}
function imgField(path, val) {
  const label = imgLabel(path);
  const preview = val
    ? '<img class="if-thumb" src="' + esc(val) + '" onerror="onImgErr(this)" data-img="open" data-path="' + path + '" title="点击选择' + label + '">'
    : '<span class="if-thumb if-empty" data-img="open" data-path="' + path + '" title="点击选择' + label + '">无</span>';
  return '<div class="img-field">' +
    '<div class="if-left">' + preview + '</div>' +
    '<div class="if-right">' +
      '<div class="if-actions">' +
        '<button data-img="open" data-path="' + path + '">📁 选择</button>' +
        '<button data-img="upload" data-path="' + path + '">⬆ 上传</button>' +
        (val ? '<button data-img="clear" data-path="' + path + '">✖ 清除' + label + '</button>' : '') +
      '</div>' +
      '<div class="if-path" title="' + esc(val || '') + '">' + (val ? esc(val) : '（未设置' + label + '）') + '</div>' +
    '</div>' +
  '</div>';
}

/* ---------- 事件绑定 ---------- */
function bindPhoneEvents() {
  const inner = $('phoneInner');
  inner.onclick = e => {
    const pact = e.target.closest('[data-pact]');
    if (pact) { handlePeerPact(pact); return; }
    const path = e.target.closest('[data-path]');
    if (path) { openModal(path); return; }
    const opened = e.target.closest('[data-open]');
    if (opened) { selIdx = parseInt(opened.getAttribute('data-open'), 10); renderPhone(); setPanelTab('messages'); return; }
    const nav = e.target.closest('[data-nav]');
    if (nav) {
      const v = nav.getAttribute('data-nav');
      if (v === 'back') {
        if (camView === 'moments') camView = 'list';
        else if (selIdx != null) selIdx = null;
        renderPhone(); renderPanel();
        return;
      }
      if (v === 'peer-moments') { camView = 'peer-moments'; renderPhone(); setPanelTab('peer'); return; }
      if (v === 'peer-back') { camView = 'list'; renderPhone(); return; }
      if (v === 'peer-moments-back') { camView = 'peer'; renderPhone(); return; }
    }
    const tab = e.target.closest('[data-navtab]');
    if (tab) {
      const name = tab.getAttribute('data-navtab');
      if (name === '微信') { camView = 'list'; selIdx = null; }
      else if (name === '通讯录') { camView = 'contacts'; }
      else if (name === '发现') { camView = 'moments'; }
      else if (name === '我') { camView = 'self'; }
      renderPhone(); renderPanel();
    }
  };
}
/* 对方朋友圈预览里的结构编辑（新增/删除/排序动态、编辑点赞） */
function handlePeerPact(elm) {
  const act = elm.getAttribute('data-pact');
  const i = parseInt(elm.getAttribute('data-i') || '-1', 10);
  const posts = peerData().posts;
  if (act === 'add-post') {
    posts.push({ date: '', images: [], text: '', likes: [], comments: [] });
  } else if (act === 'del-post') {
    if (!window.confirm('删除动态 ' + (i + 1) + '？')) return;
    posts.splice(i, 1);
  } else if (act === 'up-post') { move(posts, i, -1); }
  else if (act === 'down-post') { move(posts, i, 1); }
  else if (act === 'edit-likes') {
    const post = posts[i];
    if (!post) return;
    const val = window.prompt('点赞的人（顿号或逗号分隔，清空 = 没有点赞）', (post.likes || []).join('、'));
    if (val == null) return;
    post.likes = val.split(/[、,，]/).map(s => s.trim()).filter(Boolean);
  } else { return; }
  renderPhone(); renderPanel();
}

function bindPanelEvents() {
  document.querySelectorAll('#panelBody [data-set]').forEach(el => {
    const isText = el.tagName === 'TEXTAREA' || (el.tagName === 'INPUT' && el.type !== 'checkbox' && el.type !== 'number' && el.type !== 'range');
    const commit = (redrawPanel) => {
      const path = el.getAttribute('data-set');
      const val = el.type === 'checkbox' ? el.checked : el.type === 'number' ? (parseInt(el.value, 10) || 0) : el.value;
      setPath(path, val);
      normalizeLists();
      schedulePhoneRefresh();
      if (redrawPanel) renderPanel();
    };
    if (isText) {
      /* 文本输入：边打字边提交 + 防抖刷新手机预览；不重建面板，焦点和滚动位置都不丢 */
      el.oninput = () => commit(false);
      el.onchange = () => commit(false);
    } else {
      el.onchange = () => commit(true);
    }
  });
  document.querySelectorAll('#panelBody [data-img]').forEach(el => {
    el.onclick = () => {
      const act = el.getAttribute('data-img');
      const path = el.getAttribute('data-path');
      if (act === 'open') openImagePicker(path);
      else if (act === 'upload') triggerUpload(path);
      else if (act === 'clear') { setPath(path, ''); normalizeLists(); renderPhone(); renderPanel(); }
    };
  });
  // 视频字段（无图片库可挑，只能上传或直接填地址）
  document.querySelectorAll('#panelBody [data-video]').forEach(el => {
    const act = el.getAttribute('data-video');
    const path = el.getAttribute('data-path');
    if (act === 'pick') {
      el.onchange = () => { if (el.value) { setPath(path, el.value); renderPhone(); renderPanel(); } };
    } else {
      el.onclick = () => {
        if (act === 'upload') triggerVideoUpload(path);
        else if (act === 'clear') { setPath(path, ''); renderPhone(); renderPanel(); }
      };
    }
  });
  document.querySelectorAll('#panelBody [data-act]').forEach(el => {
    el.onclick = async () => {
      const act = el.getAttribute('data-act');
      const i = parseInt(el.getAttribute('data-i') || '-1', 10);
      if (act === 'add-chat') scene.home.push({ id: 'c' + Date.now(), type: 'friend', name: '新朋友', lastText: '', unread: 0, quiet: false, messages: [] });
      else if (act === 'add-chat-from-people') { openPeopleLib(true, true); return; }
      else if (act === 'fill-chat-from-people') {
        if (selIdx == null) { toast('请先选中一个会话（点会话名或「✏️ 编消息」）'); return; }
        openPeopleLib(true, false);
        return;
      }
      else if (act === 'del-chat') scene.home.splice(i, 1), selIdx = (selIdx === i ? null : (selIdx > i ? selIdx - 1 : selIdx));
      else if (act === 'up-chat') move(scene.home, i, -1);
      else if (act === 'down-chat') move(scene.home, i, 1);
      else if (act === 'edit-msg') { selIdx = i; setPanelTab('messages'); return; }
      else if (act === 'add-msg') scene.home[selIdx].messages.push({ dir: 'peer', kind: 'text', text: '新消息', time: '' });
      else if (act === 'del-msg') scene.home[selIdx].messages.splice(i, 1);
      else if (act === 'up-msg') move(scene.home[selIdx].messages, i, -1);
      else if (act === 'down-msg') move(scene.home[selIdx].messages, i, 1);
      else if (act === 'peer-burst') {
        const arr = scene.home[selIdx].messages;
        const lines = ['在吗？', '看到回我一下', '晚上有空吗', '一起吃饭？', '定好地方告诉我'];
        lines.forEach((t, k) => arr.push({ dir: 'peer', kind: 'text', text: t, time: '' }));
      }
      else if (act === 'add-moment') scene.moments.push({ author: '新动态', avatar: '', text: '', images: [], time: '刚刚', likes: [], comments: [] });
      else if (act === 'del-moment') scene.moments.splice(i, 1);
      else if (act === 'up-moment') move(scene.moments, i, -1);
      else if (act === 'down-moment') move(scene.moments, i, 1);
      else if (act === 'add-comment') (scene.moments[i].comments = scene.moments[i].comments || []).push({ name: '', text: '' });
      else if (act === 'del-comment') {
        const post = scene.moments[i];
        const k = parseInt(el.getAttribute('data-k') || '-1', 10);
        if (post && Array.isArray(post.comments) && k >= 0) post.comments.splice(k, 1);
      }
      /* 视频动态 / 图片动态 互斥：加视频时把配图收进 cover 兜底，移除视频时还原为图片动态 */
      else if (act === 'moment-video') {
        const post = scene.moments[i];
        if (!post) return;
        const cur = momentVideo(post);
        if (cur) {
          const cover = cur.cover;
          delete post.video;
          delete post.cover;
          if (cover && /^\/images\//.test(cover) && !(post.images || []).length) post.images = [cover];
        } else {
          post.video = { src: '', cover: (post.images || [])[0] || '' };
        }
      }
      else if (act === 'peer-toggle-video') { const p = peerData(); p.video = p.video ? null : { name: '', thumbs: [] }; }
      else if (act === 'peer-post-video') {
        const post = peerData().posts[i];
        if (!post) return;
        if (peerResolveVideo(post)) { delete post.video; }
        else { post.video = { src: '', cover: (post.images || [])[0] || '' }; }
      }
      else if (act === 'peer-add-post') peerData().posts.push({ date: '', images: [], text: '', likes: [], comments: [] });
      else if (act === 'peer-del-post') peerData().posts.splice(i, 1);
      else if (act === 'peer-up-post') move(peerData().posts, i, -1);
      else if (act === 'peer-down-post') move(peerData().posts, i, 1);
      else if (act === 'peer-add-comment') (peerData().posts[i].comments = peerData().posts[i].comments || []).push({ name: '', text: '' });
      else if (act === 'peer-del-comment') {
        const post = peerData().posts[i];
        const k = parseInt(el.getAttribute('data-k') || '-1', 10);
        if (post && Array.isArray(post.comments) && k >= 0) post.comments.splice(k, 1);
      }
      /* ---- 多人物 × 多方案管理 ---- */
      else if (act === 'peer-use') { peerSel = i; camView = 'peer'; }
      else if (act === 'peer-add') {
        scene.peers.push({ id: 'p' + Date.now(), link: '', activePlan: 'A', plans: { A: {} } });
        peerSel = scene.peers.length - 1; camView = 'peer';
      }
      else if (act === 'peer-add-from-preset') {
        if (!peerPresetSel || !peerPresets[peerPresetSel]) { toast('先在预设下拉里选一个预设'); return; }
        scene.peers.push({ id: 'p' + Date.now(), link: '', activePlan: 'A',
          plans: { A: JSON.parse(JSON.stringify(peerPresets[peerPresetSel])) } });
        peerSel = scene.peers.length - 1; camView = 'peer';
      }
      else if (act === 'peer-copy') {
        const src = scene.peers[i];
        if (!src) return;
        const cp = JSON.parse(JSON.stringify(src));
        cp.id = 'p' + Date.now(); cp.link = '';
        scene.peers.push(cp); peerSel = scene.peers.length - 1; camView = 'peer';
      }
      else if (act === 'peer-del') {
        if (scene.peers.length <= 1) { toast('至少要保留一个人物'); return; }
        if (!window.confirm('删除人物「' + ((scene.peers[i].plans[scene.peers[i].activePlan] || {}).name || i + 1) + '」及其全部方案？')) return;
        scene.peers.splice(i, 1);
        if (peerSel >= scene.peers.length) peerSel = scene.peers.length - 1;
        camView = 'peer';
      }
      else if (act === 'plan-use') { activePeer().activePlan = el.getAttribute('data-k'); }
      else if (act === 'plan-add') {
        const pp0 = activePeer();
        const k = nextPlanKey(pp0);
        pp0.plans[k] = {};
        pp0.activePlan = k;
      }
      else if (act === 'plan-copy') {
        const pp1 = activePeer();
        const k = nextPlanKey(pp1);
        pp1.plans[k] = JSON.parse(JSON.stringify(pp1.plans[pp1.activePlan]));
        pp1.activePlan = k;
        toast('已复制为方案 ' + k);
      }
      else if (act === 'plan-del') {
        const pp2 = activePeer();
        const keys = Object.keys(pp2.plans);
        if (keys.length <= 1) { toast('至少要保留一个方案'); return; }
        if (!window.confirm('删除方案 ' + pp2.activePlan + '？')) return;
        delete pp2.plans[pp2.activePlan];
        pp2.activePlan = Object.keys(pp2.plans)[0];
      }
      else if (act === 'peer-tpl-gen') {
        const tpl = PEER_TEMPLATES[peerTplSel];
        if (!tpl) { toast('先选一个内容模板'); return; }
        if ((peerData().posts || []).length &&
            !window.confirm('按模板生成会覆盖当前方案已有的动态列表，继续？')) return;
        peerData().posts = tpl.posts.map(tp => ({
          date: tp.date, text: tp.text, images: pickGalleryImgs(tp.n), likes: [], comments: [],
        }));
        if (!peerData().cover && pickGalleryImgs(1)[0]) peerData().cover = pickGalleryImgs(1)[0];
        if (!peerData().momentsThumbs || !peerData().momentsThumbs.length) peerData().momentsThumbs = pickGalleryImgs(4);
        toast('已按模板「' + tpl.label + '」生成 ' + peerData().posts.length + ' 条动态');
      }
      else if (act === 'peer-ai-copy') {
        const kwEl = document.getElementById('peerAiKw');
        const kw = kwEl ? kwEl.value.trim() : '';
        if (!kw) { toast('先填几个关键词，比如：花店店主，温柔，文艺'); return; }
        el.disabled = true; el.textContent = '生成中…';
        try {
          const r = await api('/api/peer/ai-copy', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: peerData().name || '', keywords: kw, count: 6 }),
          });
          if (!r.ok || !Array.isArray(r.posts) || !r.posts.length) { toast(r.msg || 'AI 没有返回可用文案'); }
          else {
            const posts = peerData().posts;
            r.posts.forEach((np, k) => {
              if (k < posts.length) { posts[k].text = np.text || posts[k].text; posts[k].date = np.date || posts[k].date; }
              else posts.push({ date: np.date || '', text: np.text || '', images: [], likes: [], comments: [] });
            });
            toast('AI 文案已写入当前方案的 ' + Math.min(r.posts.length, posts.length) + ' 条动态');
          }
        } catch (err) { toast('AI 生成失败：' + (err && err.message)); }
        el.disabled = false; el.textContent = 'AI 生成文案';
        renderPhone(); renderPanel();
        return;
      }
      else if (act === 'peer-add-img' || act === 'add-img') {
        const base = el.getAttribute('data-path');
        const arr = (getPath(base) || []).slice();
        arr.push('');
        setPath(base, arr);
        renderPhone(); renderPanel();
        openImagePicker(base + '[' + (arr.length - 1) + ']');
        return;
      }
      else if (act === 'peer-del-img' || act === 'del-img') {
        const base = el.getAttribute('data-path');
        const arr = (getPath(base) || []).slice();
        arr.splice(i, 1);
        setPath(base, arr);
      }
      else if (act === 'peer-apply-preset') {
        if (!peerPresetSel || !peerPresets[peerPresetSel]) { toast('先在下拉里选一个预设'); return; }
        const pp = activePeer();
        pp.plans[pp.activePlan] = JSON.parse(JSON.stringify(peerPresets[peerPresetSel]));
        camView = 'peer';
      }
      else if (act === 'peer-save-preset') {
        const name = (window.prompt('预设名（脚本里写 [编辑对方资料] ' + (peerPresetSel || '名字'), peerPresetSel || '') || '').trim();
        if (!name) return;
        const r = await api('/api/peer-presets', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ preset: name, data: peerData() })
        });
        if (r && r.ok) { peerPresets = r.presets || peerPresets; peerPresetSel = name; toast('预设「' + name + '」已保存'); }
        else { toast((r && r.msg) || '保存预设失败'); return; }
      }
      else if (act === 'peer-del-preset') {
        if (!peerPresetSel) { toast('先在下拉里选一个预设'); return; }
        if (!window.confirm('删除预设「' + peerPresetSel + '」？')) return;
        const r = await api('/api/peer-presets', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ delete: peerPresetSel })
        });
        if (r && r.ok) { peerPresets = r.presets || {}; peerPresetSel = ''; toast('已删除预设'); }
        else { toast((r && r.msg) || '删除失败'); return; }
      }
      normalizeLists();
      renderPhone(); renderPanel();
    };
  });
  const psel = document.getElementById('peerPresetSel');
  if (psel) psel.onchange = () => { peerPresetSel = psel.value; };
  const tsel = document.getElementById('peerTplSel');
  if (tsel) tsel.onchange = () => { peerTplSel = tsel.value; };
  document.querySelectorAll('#panelBody [data-up]').forEach(el => {
    el.onclick = () => { selIdx = scene.home.findIndex(h => h === getMeta(el.getAttribute('data-up'))); renderPhone(); renderPanel(); };
  });
}
function getMeta(p) { const q = p.split('.'); let o = scene; for (const k of q) o = o[k]; return o; }
function move(arr, i, d) {
  const j = i + d;
  if (j < 0 || j >= arr.length) return;
  const t = arr[i]; arr[i] = arr[j]; arr[j] = t;
}
function normalizeLists() {
  scene.home.forEach(it => { if (it.type === 'group' && typeof it.membersText === 'string') it.members = it.membersText.split(/[,，]/).map(s => s.trim()).filter(Boolean); delete it.membersText; });
  (scene.moments || []).forEach(p => { if (typeof p.likesText === 'string') p.likes = p.likesText.split(/[、,，]/).map(s => s.trim()).filter(Boolean); delete p.likesText; });
  /* 对方人物的每套方案：点赞输入框（顿号分隔）转数组 */
  (scene.peers || []).forEach(pp => Object.values(pp.plans || {}).forEach(pl =>
    (pl.posts || []).forEach(po => {
      if (typeof po.likesText === 'string') {
        po.likes = po.likesText.split(/[、,，]/).map(s => s.trim()).filter(Boolean);
        delete po.likesText;
      }
    })));
}

/* ---------- 点选弹窗编辑 ---------- */
function openModal(path) {
  const cur = getPath(path);
  const isImg = /(avatar|image|images|bg)(\[(\d+)\])?$/.test(path) || (typeof cur === 'string' && /\.(png|jpe?g|gif|webp)$/i.test(cur));
  if (isImg) { openImagePicker(path); return; }
  let body;
  body = '<div class="field"><label>点击修改：' + esc(path) + '</label>' +
    (typeof cur === 'number' ? '<input id="modalInput" type="number" value="' + esc(cur) + '">' :
      '<textarea id="modalInput">' + esc(cur == null ? '' : cur) + '</textarea>') + '</div>';
  $('modalBox').innerHTML = '<h4>编辑 · ' + esc(path) + '</h4>' + body +
    '<div class="btns"><button id="modalCancel">取消</button><button id="modalOk" class="primary">保存</button></div>';
  $('modalMask').classList.add('show');
  $('modalCancel').onclick = () => $('modalMask').classList.remove('show');
  $('modalOk').onclick = () => {
    let v = $('modalInput').value;
    if (typeof cur === 'number') v = parseInt(v, 10) || 0;
    setPath(path, v);
    normalizeLists();
    $('modalMask').classList.remove('show');
    renderPhone(); renderPanel();
  };
}

/* ---------- 图片选择弹窗（缩略图网格 + 上传 + 链接 + 预览） ---------- */
let pickerUploading = false;

function pickerMarkup(path) {
  return '<div class="picker-head"><b>选择图片</b>' +
    '<span class="picker-target" id="pickerTarget">' + esc(path) + '</span>' +
    '<button id="pickerClose" class="picker-close">×</button></div>' +
    '<div class="picker-toolbar">' +
      '<input id="pickerSearch" placeholder="🔍 搜索文件名...">' +
      '<button id="pickerUploadBtn">⬆ 上传图片</button>' +
      '<button id="pickerUrlBtn">🔗 使用链接</button>' +
    '</div>' +
    '<div class="lib-typebar" id="pickerCats"></div>' +
    '<div class="picker-urlrow" id="pickerUrlRow" style="display:none">' +
      '<input id="pickerUrlInput" placeholder="输入 /images/... 或 http(s):// 图片链接">' +
      '<button id="pickerUrlApply" class="primary">应用</button>' +
    '</div>' +
    '<div class="picker-grid" id="pickerGrid"></div>' +
    '<div class="picker-footer">' +
      '<div class="picker-preview"><img id="pickerPreviewImg" alt=""><div class="picker-path" id="pickerPreviewPath"></div></div>' +
      '<div class="picker-foot-btns"><button id="pickerCancel">取消</button><button id="pickerOk" class="primary">确定</button></div>' +
    '</div>';
}

function openImagePicker(path) {
  pickerPath = path;
  pickerSel = getPath(path) || '';
  pickerQuery = '';
  pickerCat = '';
  $('pickerBox').innerHTML = pickerMarkup(path);
  $('pickerMask').classList.add('show');
  bindPickerEvents();
  renderPickerCats();
  renderPickerGrid();
  updatePickerPreview();
  if (!libFiles.length) refreshLibData().then(renderPickerGrid).catch(() => { /* 分类筛选退化为全量 */ });
}

/* 按字段路径推断上传分类：头像字段→头像，封面/背景→背景，其余图片字段→配图素材 */
function fieldUploadCat(path) {
  const p = path || '';
  if (/avatar/i.test(p)) return 'avatar';
  if (/(^|\.)bg$|cover/i.test(p)) return 'bg';
  return 'asset';
}

/* 内嵌选图弹窗的分类 chips（视频不在图片字段里选，不放 🎬视频 chip） */
function renderPickerCats() {
  const box = $('pickerCats');
  if (!box) return;
  let h = '<span class="lib-typebtn' + (pickerCat === '' ? ' on' : '') + '" data-cat="">全部</span>';
  libCatList().forEach(c => {
    h += '<span class="lib-typebtn' + (pickerCat === c.key ? ' on' : '') + '" data-cat="' + esc(c.key) + '">' + esc(c.label) + '</span>';
  });
  box.innerHTML = h;
  box.querySelectorAll('.lib-typebtn').forEach(btn => {
    btn.onclick = () => {
      pickerCat = btn.getAttribute('data-cat') || '';
      box.querySelectorAll('.lib-typebtn').forEach(x => x.classList.toggle('on', x === btn));
      renderPickerGrid();
    };
  });
}

function pickerFiltered() {
  const q = (pickerQuery || '').toLowerCase();
  let base = gallery;
  if (pickerCat) {
    // 按分类筛选：优先用带 category 元数据的 libFiles；元数据没就绪时退回全量
    if (libFiles && libFiles.length) {
      base = libFiles.filter(f => f.category === pickerCat).map(f => f.path);
    }
  }
  return base.filter(g => !q || g.toLowerCase().includes(q));
}

function renderPickerGrid() {
  const grid = $('pickerGrid');
  if (!grid) return;
  const list = pickerFiltered();
  let h = '<div class="pg-item" data-val=""><div class="pg-thumb pg-clear">无</div><span class="pg-name">清除</span></div>';
  list.forEach(g => {
    const sel = g === pickerSel ? ' sel' : '';
    h += '<div class="pg-item' + sel + '" data-val="' + esc(g) + '" title="' + esc(g) + '">' +
      '<div class="pg-thumb"><img src="' + esc(g) + '" onerror="onImgErr(this)"></div>' +
      '<span class="pg-name">' + esc(g.replace(/^\/images\//, '')) + '</span></div>';
  });
  if (!list.length) h += '<div class="pg-empty">没有匹配的图片，试试上传一张。</div>';
  grid.innerHTML = h;
  grid.querySelectorAll('.pg-item').forEach(el => {
    el.onclick = () => {
      pickerSel = el.getAttribute('data-val');
      grid.querySelectorAll('.pg-item').forEach(x => x.classList.toggle('sel', x === el));
      updatePickerPreview();
    };
    el.ondblclick = () => { pickerSel = el.getAttribute('data-val'); commitPicker(); };
  });
}

function updatePickerPreview() {
  const img = $('pickerPreviewImg'), p = $('pickerPreviewPath');
  if (!img || !p) return;
  if (pickerSel) { img.src = pickerSel; img.style.visibility = 'visible'; p.textContent = pickerSel; }
  else { img.removeAttribute('src'); img.style.visibility = 'hidden'; p.textContent = '（未选择）'; }
}

function commitPicker() {
  if (pickerOnCommit) {
    const cb = pickerOnCommit;
    pickerOnCommit = null;
    $('pickerMask').classList.remove('show');
    cb(pickerSel || '');
    return;
  }
  setPath(pickerPath, pickerSel || '');
  $('pickerMask').classList.remove('show');
  normalizeLists();
  renderPhone(); renderPanel();
  toast('已更新：' + (pickerSel || '（已清除）'));
}

function bindPickerEvents() {
  const mask = $('pickerMask');
  const close = () => { mask.classList.remove('show'); pickerOnCommit = null; };
  $('pickerClose').onclick = close;
  $('pickerCancel').onclick = close;
  $('pickerOk').onclick = commitPicker;
  $('pickerSearch').oninput = e => { pickerQuery = e.target.value; renderPickerGrid(); };
  $('pickerUploadBtn').onclick = () => triggerUpload(pickerPath, true);
  $('pickerUrlBtn').onclick = () => {
    const row = $('pickerUrlRow');
    row.style.display = row.style.display === 'none' ? 'flex' : 'none';
    if (row.style.display === 'flex') $('pickerUrlInput').focus();
  };
  $('pickerUrlApply').onclick = () => {
    const v = $('pickerUrlInput').value.trim();
    if (!v) return;
    pickerSel = v;
    updatePickerPreview();
    renderPickerGrid();
  };
  $('pickerUrlInput').onkeydown = e => { if (e.key === 'Enter') $('pickerUrlApply').click(); };
  mask.onclick = e => { if (e.target === mask) close(); };
}

function triggerUpload(path, fromPicker) {
  const inp = document.createElement('input');
  inp.type = 'file';
  inp.multiple = true;
  inp.accept = 'image/png,image/jpeg,image/gif,image/webp,image/bmp';
  inp.onchange = () => {
    const files = Array.from(inp.files);
    if (!files.length) return;
    const MAX = 10 * 1024 * 1024;
    const valid = files.filter(f => f.size <= MAX);
    if (!valid.length) { toast('图片不能超过 10MB'); return; }
    if (valid.length < files.length) toast((files.length - valid.length) + ' 张超限已跳过');
    if (pickerUploading) return;
    pickerUploading = true;
    let idx = 0;
    const total = valid.length;
    // 上传落哪个分类：弹窗里选了分类用选的；否则按字段类型推断（头像→头像、封面→背景、其余→配图素材）
    const cat = fromPicker ? (pickerCat || fieldUploadCat(pickerPath)) : fieldUploadCat(path);
    function uploadNext() {
      if (idx >= total) {
        pickerUploading = false;
        if (fromPicker) { renderPickerGrid(); updatePickerPreview(); bindPickerEvents(); }
        else { normalizeLists(); renderPhone(); renderPanel(); }
        toast('已上传 ' + total + ' 张图片（存到 · ' + libCatLabel(cat) + '）');
        return;
      }
      const f = valid[idx];
      toast('导入中 (' + (idx + 1) + '/' + total + ')...');
      const reader = new FileReader();
      reader.onload = () => {
        api('/api/upload-image', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ data: reader.result, name: f.name, category: cat })
        }).then(r => {
          if (r.ok) {
            gallery = r.images || gallery;
            if (fromPicker) pickerSel = r.path;
            else if (idx === 0) setPath(path, r.path);
          } else toast(r.msg || '上传失败：' + f.name);
          idx++; uploadNext();
        }).catch(() => { toast('上传失败：' + f.name); idx++; uploadNext(); });
      };
      reader.readAsDataURL(f);
    }
    uploadNext();
  };
  inp.click();
}

/* 上传源视频：直接把 File 当请求体 POST（原始二进制），避免 base64 的 33% 膨胀，
   大文件也不容易顶到内存。后端落盘到 vue-WeChat/public/videos/，返回 /videos/xxx.mp4。 */
function triggerVideoUpload(path) {
  const inp = document.createElement('input');
  inp.type = 'file';
  inp.accept = 'video/mp4,video/webm,video/quicktime,video/x-m4v,.mp4,.webm,.mov,.m4v';
  inp.onchange = () => {
    const f = inp.files && inp.files[0];
    if (!f) return;
    const MAX = 200 * 1024 * 1024;
    if (f.size > MAX) { toast('视频不能超过 200MB'); return; }
    toast('上传中 ' + (f.size / 1048576).toFixed(1) + 'MB，请稍候…');
    fetch('/api/upload-video', {
      method: 'POST',
      headers: {
        'Content-Type': f.type || 'application/octet-stream',
        'X-File-Name': encodeURIComponent(f.name || 'video.mp4')
      },
      body: f
    }).then(r => r.json()).then(r => {
      if (r && r.ok && r.path) {
        setPath(path, r.path);
        if (r.videos) sourceVideos = r.videos;
        renderPhone(); renderPanel();
        toast('视频已上传：' + r.path);
      } else {
        toast((r && r.msg) || '上传失败');
      }
    }).catch(e => toast('上传失败：' + ((e && e.message) || e)));
  };
  inp.click();
}

/* ---------- 图片库管理（统一编辑入口） ---------- */
function libMarkup() {
  return '<div class="lib-head"><b>📚 图片库</b><span class="lib-count" id="libCount">加载中…</span><button id="libClose" class="lib-close">×</button></div>' +
    '<div class="lib-toolbar">' +
      '<input id="libSearch" placeholder="🔍 搜索文件名 / 命名...">' +
      '<select id="libFolder"><option value="">📁 全部目录</option></select>' +
      '<select id="libSort" title="列表排序方式"></select>' +
      '<select id="libUpcat" title="上传的图片存入哪个分类（拖进来也存这里）"></select>' +
      '<button id="libUpload" class="primary">⬆ 上传图片</button>' +
      '<button id="libImport">📥 导入文件夹</button>' +
      '<button id="libBatch">☑ 批量操作</button>' +
      '<button id="libCatMgr" title="给分类改名，或新建自己的分类">⚙ 分类</button>' +
    '</div>' +
    '<div class="lib-typebar" id="libCats"></div>' +
    '<div class="lib-selected"><span class="lib-selpath" id="libSelPath">未选择图片</span><div class="lib-btns" id="libBtns"></div></div>' +
    '<div class="lib-grid" id="libGrid"></div>' +
    '<div class="lib-action" id="libAction"></div>' +
    '<div style="padding:8px 14px 12px;font-size:11px;color:#8a93a3">💡 把图片拖到窗口任意位置即可上传；把缩略图拖到上面的分类按钮上＝把这张图搬过去。勾选多张后可整批搬走或删除。</div>';
}

async function openLib() {
  $('libBox').innerHTML = libMarkup();
  $('libMask').classList.add('show');
  bindLibEvents();
  libRenameMode = false;
  libSel = null;
  libSelSet = new Set();
  libBatchMode = false;
  libCat = libRestoreCat();
  libSort = libRestoreSort();
  try { libFolder = localStorage.getItem('wx-lib-folder') || ''; } catch (e) { libFolder = ''; }
  try {
    await refreshLibData();
  } catch (e) { /* 加载失败会在 renderLibGrid 中提示 */ }
  libCat = libRestoreCat();          // 图库数据到位后再定默认分类（「配图素材」有图才默认它）
  renderLibCats();
  renderLibUpcat();
  libSyncUpcat();
  renderLibSortOptions();
  renderLibFolderOptions();
  renderLibGrid();
}

function closeLib() {
  $('libMask').classList.remove('show');
  $('libPreviewLayer').hidden = true;
  libSel = null;
  libRenameMode = false;
  libSelSet = new Set();
  libBatchMode = false;
}

async function refreshLibData() {
  const r = await api('/api/gallery');
  gallery = r.images || gallery;
  libFiles = r.files || [];
  libFolders = r.folders || [];
  libCategories = r.categories || [];
  libVideos = r.videos || [];
  return r;
}

/* 分类 chips（全部 / 各分类 / 🎬视频） */
function libCatList() {
  return (libCategories && libCategories.length) ? libCategories
    : [{ key: 'avatar', label: '头像' }, { key: 'sticker', label: '表情包' },
       { key: 'emoji', label: 'emoji' }, { key: 'bg', label: '背景' },
       { key: 'asset', label: '配图素材' }, { key: 'icon', label: '系统图标' }];
}
function libCatLabel(key) {
  const c = libCatList().find(x => x.key === key);
  return c ? c.label : key;
}
function renderLibCats() {
  const box = $('libCats');
  if (!box) return;
  const mk = (key, label) =>
    '<span class="lib-typebtn' + (libCat === key ? ' on' : '') + '" data-cat="' + esc(key) + '">' +
    esc(label) + '<span style="margin-left:5px;font-size:10px;opacity:.75;background:rgba(127,127,127,.15);border-radius:999px;padding:0 5px">' + libCatCount(key) + '</span></span>';
  let h = mk('', '全部');
  libCatList().forEach(c => { h += mk(c.key, c.label); });
  h += mk('video', '🎬 视频');
  box.innerHTML = h;
  box.querySelectorAll('.lib-typebtn').forEach(btn => {
    const key = btn.getAttribute('data-cat') || '';
    btn.onclick = () => {
      libCat = key;
      libBatchMode = false;
      libSelSet = new Set();
      try { localStorage.setItem('wx-lib-cat', key); } catch (e) { /* 忽略 */ }
      libSyncUpcat();
      renderLibCats();
      renderLibGrid();
    };
    // 把缩略图拖到分类按钮上 = 把这张（批量模式下＝选中的这些）搬过去
    btn.addEventListener('dragover', e => {
      if (!libDragPaths.length) return;
      e.preventDefault(); e.stopPropagation();
      btn.classList.add('drop');
    });
    btn.addEventListener('dragleave', () => btn.classList.remove('drop'));
    btn.addEventListener('drop', e => {
      if (!libDragPaths.length) return;
      e.preventDefault(); e.stopPropagation();
      btn.classList.remove('drop');
      const paths = libDragPaths.slice();
      libDragPaths = [];
      libMovePaths(paths, key);
    });
  });
}

/* 「上传存入分类」下拉（记住上次选择；只列可上传的分类） */
function renderLibUpcat() {
  const sel = $('libUpcat');
  if (!sel) return;
  const cats = libCatList().filter(c => c.canUpload !== false);
  let saved = '';
  try { saved = localStorage.getItem('wx-lib-upcat') || ''; } catch (e) { /* 忽略 */ }
  if (!cats.some(c => c.key === saved)) saved = cats.some(c => c.key === 'asset') ? 'asset' : (cats[0] || {}).key || '';
  sel.innerHTML = cats.map(c =>
    '<option value="' + esc(c.key) + '"' + (c.key === saved ? ' selected' : '') + '>存到 · ' + esc(c.label) + '</option>').join('');
}

/* 排序下拉（记住上次选择） */
function renderLibSortOptions() {
  const sel = $('libSort');
  if (!sel) return;
  const opts = [['new', '⇅ 最新在前'], ['old', '⇅ 最早在前'], ['name', '⇅ 按名称'], ['size', '⇅ 按体积']];
  sel.innerHTML = opts.map(o => '<option value="' + o[0] + '"' + (o[0] === libSort ? ' selected' : '') + '>' + o[1] + '</option>').join('');
}

function renderLibFolderOptions() {
  const sel = $('libFolder');
  if (!sel) return;
  const keep = libFolder;
  sel.innerHTML = '<option value="">📁 全部目录</option>' +
    libFolders.map(f => '<option value="' + esc(f) + '">' + esc(f === '/' ? '根目录' : f) + '</option>').join('');
  sel.value = libFolders.includes(keep) ? keep : '';
  libFolder = sel.value;
}

function libFiltered() {
  const q = (libQuery || '').toLowerCase();
  return libFiles.filter(f => {
    if (libCat && f.category !== libCat) return false;
    if (libFolder && f.folder !== libFolder) return false;
    if (q) {
      const hay = ((f.label || '') + ' ' + (f.name || '')).toLowerCase();
      if (!hay.includes(q)) return false;
    }
    return true;
  });
}

function fmtSize(n) {
  if (n < 1024) return n + 'B';
  if (n < 1048576) return (n / 1024).toFixed(0) + 'KB';
  return (n / 1048576).toFixed(1) + 'MB';
}

function renderLibGrid() {
  const grid = $('libGrid');
  if (!grid) return;
  const isVideoTab = libCat === 'video';
  const list = isVideoTab
    ? libSorted(libVideos.map(v => ({ path: v.path, label: v.name || v.path, name: v.path, size: 0, isVideo: true })))
    : libSorted(libFiltered());
  $('libCount').textContent = '共 ' + (isVideoTab ? libVideos.length + ' 个视频' : libFiles.length + ' 张') +
    ' · 显示 ' + list.length + (isVideoTab ? ' 个' : ' 张') + (libBatchMode ? ' · 已选 ' + libSelSet.size : '');
  let h = '';
  list.forEach(f => {
    const sel = libBatchMode ? (libSelSet.has(f.path) ? ' batch-sel' : '') : (libSel === f.path ? ' sel' : '');
    const cb = libBatchMode ? '<i class="lib-cb' + (libSelSet.has(f.path) ? ' on' : '') + '">✓</i>' : '';
    const folderName = f.folder === '/' ? '根目录' : (f.folder || '视频库');
    const size = f.size ? fmtSize(f.size) : '';
    const typeTag = f.isVideo ? '视频' : libCatLabel(f.category);
    const thumb = f.isVideo
      ? '<div class="lib-thumb" style="display:flex;align-items:center;justify-content:center;font-size:30px">🎬</div>'
      : '<div class="lib-thumb"><img src="' + esc(f.path) + '" loading="lazy" onerror="onImgErr(this)">' +
          '<span class="lib-type' + (f.category === 'icon' ? ' ic' : ' im') + '">' + typeTag + '</span></div>';
    h += '<div class="lib-item' + sel + '" data-path="' + esc(f.path) + '"' + (f.isVideo ? '' : ' draggable="true"') + '>' +
      cb +
      thumb +
      '<span class="lib-name" title="' + esc(f.label || f.name) + '">' + esc(f.label || f.name) + '</span>' +
      '<span class="lib-tag">' + esc(folderName) + (size ? ' · ' + size : '') + '</span>' +
      '</div>';
  });
  if (!list.length) {
    h = isVideoTab
      ? '<div class="lib-empty">还没有视频素材。在场景编辑器里给朋友圈动态传视频，或把 MP4 放进 vue-WeChat/public/videos/。</div>'
      : '<div class="lib-empty">这里还没有图片。把图片拖到窗口任意位置即可上传（存进右上角选的分类），或点「⬆ 上传图片」。</div>';
  }
  grid.innerHTML = h;
  grid.querySelectorAll('.lib-item').forEach(el => {
    const path = el.getAttribute('data-path');
    if (el.getAttribute('draggable') === 'true') {
      el.addEventListener('dragstart', (e) => {
        libDragPaths = (libBatchMode && libSelSet.has(path) && libSelSet.size) ? Array.from(libSelSet) : [path];
        el.style.opacity = '.45';
        try {
          e.dataTransfer.setData('text/plain', libDragPaths.join('\n'));
          e.dataTransfer.effectAllowed = 'move';
        } catch (err) { /* 忽略 */ }
      });
      el.addEventListener('dragend', () => { libDragPaths = []; el.style.opacity = ''; });
    }
    el.onclick = () => {
      if (libBatchMode) {
        if (libSelSet.has(path)) libSelSet.delete(path); else libSelSet.add(path);
        renderLibGrid();
      } else {
        libSel = path;
        grid.querySelectorAll('.lib-item').forEach(x => x.classList.toggle('sel', x === el));
        renderLibActionBar();
      }
    };
    el.ondblclick = () => { if (!libBatchMode) { libSel = el.getAttribute('data-path'); previewLib(); } };
  });
  renderLibActionBar();
}

function renderLibActionBar() {
  const selPath = $('libSelPath');
  const btns = $('libBtns');
  const action = $('libAction');
  if (!selPath || !btns || !action) return;
  if (libBatchMode) { renderLibBatchBar(); return; }
  if (libRenameMode) { renderLibRename(); return; }
  const f = libFiles.find(x => x.path === libSel);
  if (!f || !libSel) {
    selPath.textContent = '未选择图片';
    btns.innerHTML = '';
    action.innerHTML = '';
    return;
  }
  selPath.textContent = f.path + '  （' + fmtSize(f.size || 0) + '）' + (f.label && f.label !== f.name ? ' · 命名：' + f.label : '');
  btns.innerHTML =
    '<button id="libPreview">🔍 预览</button>' +
    '<button id="libCopy">📋 复制路径</button>' +
    '<button id="libName">✏️ 命名</button>' +
    '<button id="libRename">📄 重命名</button>' +
    '<select id="libMove" title="移动到指定分类（自动更新剧本/场景里的引用）">' +
      '<option value="">📂 移动到分类…</option>' +
      libCatList().filter(c => c.canUpload !== false).map(c =>
        '<option value="' + esc(c.key) + '">' + esc(c.label) + '</option>').join('') +
    '</select>' +
    '<button id="libDelete" class="danger">🗑 删除</button>';
  action.innerHTML = '';
  $('libPreview').onclick = previewLib;
  $('libCopy').onclick = () => { copyText(f.path); toast('已复制：' + f.path); };
  $('libName').onclick = () => {
    const v = prompt('为此图命名（用于搜索/识别，不会改动图片文件）：', f.label || '');
    if (v === null) return;
    api('/api/gallery/label', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ path: f.path, label: v.trim() }) })
      .then(r => { if (!r.ok) { toast(r.msg || '命名失败'); return; } applyGalleryPayload(r.gallery); renderLibGrid(); toast('已命名'); })
      .catch(() => toast('命名失败'));
  };
  $('libRename').onclick = () => { libRenameMode = true; renderLibActionBar(); };
  $('libMove').onchange = async (e) => {
    const cat = e.target.value || '';
    if (!cat) return;
    const r = await api('/api/gallery/move', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ path: f.path, category: cat }) });
    if (!r.ok) { toast(r.msg || '移动失败'); e.target.value = ''; return; }
    libSel = r.path;
    applyGalleryPayload(r.gallery);
    renderLibGrid();
    renderLibFolderOptions();
    e.target.value = '';
    toast('已移动到「' + libCatLabel(cat) + '」' + (r.changed && r.changed.length ? '，已更新引用：' + r.changed.join('、') : ''));
  };
  $('libDelete').onclick = async () => {
    if (!confirm('确定删除这张图片吗？\n' + f.path + '\n\n删除后无法恢复。')) return;
    const r = await api('/api/gallery/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ path: f.path }) });
    if (!r.ok) { toast(r.msg || '删除失败'); return; }
    libSel = null;
    applyGalleryPayload(r.gallery);
    renderLibGrid();
    renderLibFolderOptions();
    toast('已删除');
  };
}

/* ---------- 批量删除模式 ---------- */
function libToggleBatch() {
  libBatchMode = !libBatchMode;
  if (!libBatchMode) libSelSet = new Set();
  const btn = $('libBatch');
  if (btn) {
    btn.textContent = libBatchMode ? '☑ 取消批量' : '☑ 批量操作';
    btn.classList.toggle('active', libBatchMode);
  }
  renderLibGrid();
}

function renderLibBatchBar() {
  const selPath = $('libSelPath');
  const btns = $('libBtns');
  const action = $('libAction');
  if (!selPath || !btns || !action) return;
  const n = libSelSet.size;
  selPath.textContent = '批量操作：点选图片勾选，已选 ' + n + ' 张';
  btns.innerHTML = '';
  action.innerHTML =
    '<div class="lib-rename-row">' +
      '<select id="libBatchMove"><option value="">📂 整批移到分类…</option>' +
        libCatList().filter(c => c.canUpload !== false).map(c =>
          '<option value="' + esc(c.key) + '">' + esc(c.label) + '</option>').join('') +
      '</select>' +
      '<button id="libBatchAll">全选当前列表</button>' +
      '<button id="libBatchClear">清空选择</button>' +
      '<button id="libBatchDel" class="danger">删除选中 (' + n + ')</button>' +
    '</div>';
  $('libBatchAll').onclick = () => { libSelSet = new Set(libFiltered().map(f => f.path)); renderLibGrid(); };
  $('libBatchClear').onclick = () => { libSelSet = new Set(); renderLibGrid(); };
  $('libBatchMove').onchange = async (e) => {
    const cat = e.target.value || '';
    e.target.value = '';
    if (!cat) return;
    if (!libSelSet.size) { toast('请先勾选要搬走的图片'); return; }
    await libMovePaths(Array.from(libSelSet), cat);
  };
  $('libBatchDel').onclick = libDeleteSelected;
}

async function libDeleteSelected() {
  const paths = Array.from(libSelSet);
  if (!paths.length) { toast('请先选择要删除的图片'); return; }
  if (!confirm('确定删除选中的 ' + paths.length + ' 张图片吗？\n\n删除后无法恢复。')) return;
  const r = await api('/api/gallery/batch', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ op: 'delete', paths: paths }) });
  if (!r.ok) { toast(r.msg || '批量删除失败'); return; }
  libSelSet = new Set();
  libSel = null;
  applyGalleryPayload(r.gallery);
  renderLibCats();
  renderLibFolderOptions();
  renderLibGrid();
  toast('已删除 ' + r.done + ' 张' + (r.failed ? '，失败 ' + r.failed + ' 张' : ''));
}

function renderLibRename() {
  const f = libFiles.find(x => x.path === libSel);
  const selPath = $('libSelPath');
  const btns = $('libBtns');
  if (!f) { libRenameMode = false; renderLibActionBar(); return; }
  selPath.textContent = '重命名：';
  btns.innerHTML = '<input id="libRenameInput" value="' + esc(f.name) + '">' +
    '<button id="libRenameOk" class="primary">确定</button>' +
    '<button id="libRenameCancel">取消</button>';
  const input = $('libRenameInput');
  input.focus();
  const dot = f.name.lastIndexOf('.');
  if (dot > 0) input.setSelectionRange(0, dot);
  input.onkeydown = e => { if (e.key === 'Enter') $('libRenameOk').click(); };
  $('libRenameCancel').onclick = () => { libRenameMode = false; renderLibActionBar(); };
  $('libRenameOk').onclick = async () => {
    const name = input.value.trim();
    if (!name || name === f.name) { libRenameMode = false; renderLibActionBar(); return; }
    const r = await api('/api/gallery/rename', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ path: f.path, name: name }) });
    if (!r.ok) { toast(r.msg || '重命名失败'); return; }
    libSel = r.path;
    libRenameMode = false;
    applyGalleryPayload(r.gallery);
    renderLibGrid();
    renderLibFolderOptions();
    toast('已重命名');
  };
}

function applyGalleryPayload(payload) {
  if (!payload) return;
  gallery = payload.images || gallery;
  libFiles = payload.files || libFiles;
  libFolders = payload.folders || libFolders;
  if (payload.categories) libCategories = payload.categories;
}

function previewLib() {
  const f = libFiles.find(x => x.path === libSel);
  if (!f) return;
  $('libPvImg').src = f.path;
  $('libPvPath').textContent = f.path;
  $('libPreviewLayer').hidden = false;
}

function copyText(t) {
  try { navigator.clipboard.writeText(t); }
  catch (e) { toast('复制失败，请手动选择路径'); }
}

function bindLibEvents() {
  $('libClose').onclick = closeLib;
  $('libMask').onclick = e => { if (e.target === $('libMask')) closeLib(); };
  $('libSearch').oninput = e => { libQuery = e.target.value; renderLibGrid(); };
  $('libFolder').onchange = e => {
    libFolder = e.target.value;
    try { localStorage.setItem('wx-lib-folder', libFolder || ''); } catch (err) { /* 忽略 */ }
    renderLibGrid();
  };
  $('libSort').onchange = e => {
    libSort = e.target.value;
    try { localStorage.setItem('wx-lib-sort', libSort); } catch (err) { /* 忽略 */ }
    renderLibGrid();
  };
  $('libUpcat').onchange = e => {
    try { localStorage.setItem('wx-lib-upcat', e.target.value || ''); } catch (err) { /* 忽略 */ }
  };
  // 分类 chips 的点击/拖放目标在 renderLibCats() 里自行绑定
  $('libUpload').onclick = libUpload;
  $('libImport').onclick = libImport;
  $('libBatch').onclick = libToggleBatch;
  $('libCatMgr').onclick = () => {
    if (window.__wxPick && typeof window.__wxPick.openCategoryManager === 'function') {
      window.__wxPick.openCategoryManager();
    } else toast('分类管理组件还没加载好，请刷新页面再试');
  };
  $('libPvHead').onclick = () => { $('libPreviewLayer').hidden = true; };
  $('libPreviewLayer').onclick = e => { if (e.target === $('libPreviewLayer')) $('libPreviewLayer').hidden = true; };
  // 整个弹窗都是「拖图上传」的落点（不只是网格）
  let depth = 0;
  const isFileDrag = e => !libDragPaths.length && e.dataTransfer &&
    Array.prototype.indexOf.call(e.dataTransfer.types || [], 'Files') >= 0;
  $('libMask').addEventListener('dragenter', e => {
    if (!isFileDrag(e)) return;
    e.preventDefault(); depth++;
    $('libBox').classList.add('drop');
  });
  $('libMask').addEventListener('dragover', e => {
    if (!isFileDrag(e)) return;
    e.preventDefault();
    try { e.dataTransfer.dropEffect = 'copy'; } catch (err) { /* 忽略 */ }
  });
  $('libMask').addEventListener('dragleave', e => {
    if (!isFileDrag(e)) return;
    depth = Math.max(0, depth - 1);
    if (!depth) $('libBox').classList.remove('drop');
  });
  $('libMask').addEventListener('drop', e => {
    if (!isFileDrag(e)) return;
    e.preventDefault();
    depth = 0;
    $('libBox').classList.remove('drop');
    const files = Array.from(e.dataTransfer && e.dataTransfer.files ? e.dataTransfer.files : []);
    if (files.length) libUploadFiles(files, null, libTargetCat());
  });
}

function libUploadFiles(files, onDone, category) {
  if (!files || !files.length) return;
  const MAX = 10 * 1024 * 1024;
  const valid = files.filter(f => f.size <= MAX);
  if (!valid.length) { toast('图片不能超过 10MB'); return; }
  if (valid.length < files.length) toast((files.length - valid.length) + ' 张超限已跳过');
  if (libUploading) { toast('正在上传中，请稍候'); return; }
  libUploading = true;
  const cat = category || libTargetCat();
  let idx = 0;
  const total = valid.length;
  function libNext() {
    if (idx >= total) {
      libUploading = false;
      const done = () => {
        libCat = cat;                       // 传完自动切到目标分类，立刻看到刚传的
        try { localStorage.setItem('wx-lib-cat', cat); } catch (e) { /* 忽略 */ }
        renderLibCats();
        renderLibGrid();
        renderLibFolderOptions();
        toast('已上传 ' + total + ' 张到「' + libCatLabel(cat) + '」');
        if (onDone) onDone();
      };
      refreshLibData().then(done).catch(done);
      return;
    }
    const f = valid[idx];
    toast('导入中 (' + (idx + 1) + '/' + total + ')...');
    const reader = new FileReader();
    reader.onload = () => {
      api('/api/upload-image', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ data: reader.result, name: f.name, category: cat }) })
        .then(r => {
          if (r.ok) { gallery = r.images || gallery; if (idx === 0) libSel = r.path; }
          else toast(r.msg || '上传失败：' + f.name);
          idx++; libNext();
        }).catch(() => { toast('上传失败：' + f.name); idx++; libNext(); });
    };
    reader.readAsDataURL(f);
  }
  libNext();
}

function libUpload() {
  const inp = document.createElement('input');
  inp.type = 'file';
  inp.multiple = true;
  inp.accept = 'image/png,image/jpeg,image/gif,image/webp,image/bmp,bmp';
  inp.onchange = () => { if (inp.files.length) libUploadFiles(Array.from(inp.files)); };
  inp.click();
}

function libImport() {
  const inp = document.createElement('input');
  inp.type = 'file';
  inp.multiple = true;
  inp.accept = 'image/png,image/jpeg,image/gif,image/webp,image/bmp';
  try { inp.webkitdirectory = true; } catch (e) { /* 不支持目录选择时退化为多选文件 */ }
  inp.onchange = () => { if (inp.files.length) libUploadFiles(Array.from(inp.files)); };
  inp.click();
}

/* ---------- 人物库（people.json 管理与输入） ---------- */
let _peopleInput = null; // 新增人物的临时编辑句柄

function peopleKeyOf(it) {
  // 场景会话的「库名」= name（群聊也以 name 为准）
  return (it && (it.name || it.group || '')).trim();
}

async function peopleLoad() {
  const r = await api('/api/people');
  const dict = (r && typeof r === 'object') ? r : {};
  // 兼容两种结构：
  //   分组 {"学员": {name: avatar}, "美女": {name: avatar}}
  //   扁平 {name: avatar}
  const hasGroups = dict['学员'] || dict['美女'];
  if (hasGroups) {
    people = [];
    (['学员', '美女']).forEach(g => {
      const sub = (dict[g] && typeof dict[g] === 'object') ? dict[g] : {};
      Object.keys(sub).forEach(name => people.push({ name: name, avatar: sub[name] || '', group: g }));
    });
  } else {
    people = Object.keys(dict)
      .map(name => ({ name: name, avatar: dict[name] || '', group: '' }))
      .sort((a, b) => a.name.localeCompare(b.name, 'zh'));
  }
  people.sort((a, b) => a.name.localeCompare(b.name, 'zh'));
  return people;
}

function peopleMatchesFilter(p) {
  const q = (peopleQuery || '').trim().toLowerCase();
  if (!q) return true;
  if ((p.name || '').toLowerCase().includes(q)) return true;
  const file = String(p.avatar || '').replace(/^\/images\//, '').toLowerCase();
  if (file && file.includes(q)) return true;
  return false;
}

function peopleUsageInScene(name) {
  // 返回场景里用到该人物名的会话：卡片展示会先查 home 里的 name/group，
  // 因此“已在场景使用”指存在 home[i].name === name
  const out = [];
  (scene.home || []).forEach((it, i) => {
    if (peopleKeyOf(it) === name) out.push({ i, it });
  });
  return out;
}

function peopleGroupTabs() {
  const cnt = g => people.filter(p => p.group === g).length;
  return '<button class="pg-tab' + (!peopleGroup ? ' on' : '') + '" data-g="">全部（' + people.length + '）</button>' +
    '<button class="pg-tab' + (peopleGroup === '美女' ? ' on' : '') + '" data-g="美女">美女女性（' + cnt('美女') + '）</button>' +
    '<button class="pg-tab' + (peopleGroup === '学员' ? ' on' : '') + '" data-g="学员">学员（' + cnt('学员') + '）</button>';
}

function peopleMarkup() {
  return '<div class="people-head"><b>👥 人物库</b><span class="people-count" id="peopleCount">加载中…</span><button id="peopleClose" class="people-close">×</button></div>' +
    (peoplePickMode
      ? '<div class="people-hint-line">' + (peoplePickAdd
          ? '点一个人物：用它的<b>名字 + 头像</b>在场景里<b>新建一个会话</b>（加到会话列表末尾）。'
          : '点一个人物：把它的<b>头像</b>套用到<b>当前选中的会话</b>，并把名字改成人物名。') + '</div>'
      : '') +
    '<div class="people-toolbar">' +
      '<input id="peopleSearch" placeholder="🔍 搜索名字 / 头像文件名...">' +
      '<button id="peopleSync" title="把当前会话列表里所有已填头像的人同步进人物库（覆盖同名）">⬆ 从场景同步</button>' +
      '<button id="peopleAdd" class="primary">＋ 新增人物</button>' +
    '</div>' +
    '<div class="people-groups" id="peopleGroups">' + peopleGroupTabs() + '</div>' +
    '<div class="people-selected"><span class="people-selpath" id="peopleSelPath">未选择人物</span><div class="people-btns" id="peopleBtns"></div></div>' +
    '<div class="people-grid" id="peopleGrid"></div>' +
    '<div class="people-action" id="peopleAction"></div>';
}

async function openPeopleLib(pickMode, addNew) {
  peoplePickMode = !!pickMode;
  peoplePickAdd = !!addNew;
  $('peopleBox').innerHTML = peopleMarkup();
  $('peopleMask').classList.add('show');
  bindPeopleEvents();
  peopleSel = null;
  peopleRenameMode = false;
  peopleQuery = '';
  peopleGroup = '';
  try { await peopleLoad(); } catch (e) { /* 忽略 */ }
  renderPeopleGrid();
}

function closePeopleLib() {
  $('peopleMask').classList.remove('show');
  peopleSel = null;
  peopleRenameMode = false;
  peoplePickMode = false;
  peoplePickAdd = false;
}

function peopleFiltered() {
  return people.filter(p => {
    if (peopleGroup && p.group !== peopleGroup) return false;
    return peopleMatchesFilter(p);
  });
}

function renderPeopleGrid() {
  const grid = $('peopleGrid');
  if (!grid) return;
  // 刷新分组筛选按钮（计数会变）
  const gwrap = $('peopleGroups');
  if (gwrap) gwrap.innerHTML = peopleGroupTabs();
  const list = peopleFiltered();
  $('peopleCount').textContent = '共 ' + people.length + ' 人 · 显示 ' + list.length + ' 人';
  let h = '';
  list.forEach(p => {
    const usage = peopleUsageInScene(p.name);
    const used = usage.length > 0;
    const cls = 'people-item' + (p.name === peopleSel ? ' sel' : '');
    const thumb = p.avatar
      ? '<div class="people-thumb"><img src="' + esc(p.avatar) + '" loading="lazy" onerror="onImgErr(this)" alt=""></div>'
      : '<div class="people-thumb people-noava">未设头像</div>';
    h += '<div class="' + cls + '" data-name="' + esc(p.name) + '">' +
      thumb +
      '<span class="people-name" title="' + esc(p.name) + '">' + esc(p.name) + '</span>' +
      '<span class="people-extra' + (p.avatar ? (used ? ' used' : '') : ' missing') + '">' +
        (p.avatar ? '' : '未设头像 · ') +
        (used ? ('场景已用 ' + usage.length + ' 处') : (p.avatar ? '仅入库' : '未使用')) +
      '</span>' +
      '</div>';
  });
  if (!list.length) h = '<div class="people-empty">' +
    (peopleQuery ? '没有匹配的人物，换个关键词试试；或点「＋ 新增人物」。' : '人物库是空的。点「＋ 新增人物」添加，或在「会话」给联系人填好头像后点顶栏「💾 保存到人物库」。') +
    '</div>';
  grid.innerHTML = h;
  grid.querySelectorAll('.people-item').forEach(el => {
    el.onclick = () => {
      const name = el.getAttribute('data-name');
      if (peoplePickMode) {
        peoplePickToChat(name);
      } else {
        peopleSel = name;
        peopleRenameMode = false;
        grid.querySelectorAll('.people-item').forEach(x => x.classList.toggle('sel', x === el));
        renderPeopleActionBar();
      }
    };
    el.ondblclick = () => {
      const name = el.getAttribute('data-name');
      const p = people.find(x => x.name === name);
      if (p && p.avatar) { $('libPvImg').src = p.avatar; $('libPvPath').textContent = name + ' · ' + p.avatar; $('libPreviewLayer').hidden = false; }
    };
  });
  renderPeopleActionBar();
}

function peoplePickToChat(name) {
  const p = people.find(x => x.name === name);
  if (!p) return;
  if (peoplePickAdd) {
    scene.home.push({
      id: 'c' + Date.now(), type: 'friend', name: p.name,
      avatar: p.avatar || '', lastText: '', time: '', unread: 0, quiet: false, messages: []
    });
    closePeopleLib();
    renderPhone(); renderPanel();
    toast('已用人物「' + p.name + '」新建会话' + (p.avatar ? '' : '（该人物未设头像）'));
    return;
  }
  // 套用到当前会话
  const idx = selIdx;
  if (idx == null || !scene.home[idx]) {
    toast('请先在「会话」tab 选中一个会话，再选人物');
    return;
  }
  const it = scene.home[idx];
  it.name = p.name;          // 库名即会话名，保证后续自动套头像能对上
  if (p.avatar) it.avatar = p.avatar;
  else { toast('人物「' + p.name + '」还没设头像，仅更新了名字'); }
  closePeopleLib();
  renderPhone(); renderPanel();
  toast('已应用人物「' + p.name + '」到当前会话');
}

function renderPeopleActionBar() {
  const selPath = $('peopleSelPath');
  const btns = $('peopleBtns');
  const action = $('peopleAction');
  if (!selPath || !btns || !action) return;
  if (peopleRenameMode) { renderPeopleRename(); return; }
  const p = people.find(x => x.name === peopleSel);
  if (!p) {
    selPath.textContent = peoplePickMode ? '点击上方人物 → 应用到头像' : '未选择人物';
    btns.innerHTML = '';
    action.innerHTML = '';
    return;
  }
  selPath.textContent = p.name + (p.group ? '（' + p.group + '）' : '') + (p.avatar ? '  →  ' + p.avatar : '  （未设头像）');
  btns.innerHTML =
    '<button id="peopleEditAvatar">🖼 换头像</button>' +
    '<button id="peopleRename">✏️ 改名</button>' +
    '<button id="peopleMoveGroup">⇄ 换到' + (p.group === '学员' ? '美女' : '学员') + '</button>' +
    '<button id="peopleDel" class="danger">🗑 删除</button>';
  action.innerHTML = '';
  const usage = peopleUsageInScene(p.name);
  let h = '<div class="people-usage"><b>' + esc(p.name) + '</b> 在场景中' +
    (usage.length ? '出现在 <span class="ok">' + usage.length + '</span> 个会话：' : '尚未被任何会话使用。') + '</div>';
  if (usage.length) {
    h += '<div class="chips">' + usage.map(u =>
      '<span class="' + (u.it.avatar === p.avatar ? 'this' : '') + '" title="' + esc((u.it.avatar || '') || '该会话还没头像') + '">' +
        esc(u.it.name || u.it.group) + (u.it.avatar === p.avatar ? ' ✓头像一致' : ' ✗头像不同') + '</span>'
    ).join('') + '</div>';
  }
  h += '<div class="btn-row" style="margin:8px 0 2px">' +
    '<button id="peopleUseInChat">👤 应用到当前会话</button>' +
    '<button id="peopleSyncOne">💾 同步到场景同名会话</button>' +
  '</div>';
  action.innerHTML = h;
  $('peopleEditAvatar').onclick = () => peoplePickAvatar(p);
  $('peopleRename').onclick = () => { peopleRenameMode = true; renderPeopleActionBar(); };
  $('peopleDel').onclick = () => peopleDelete(p.name);
  $('peopleMoveGroup').onclick = async () => {
    const target = (p.group === '学员') ? '美女' : '学员';
    const r = await api('/api/people/save', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: p.name, avatar: p.avatar || '', group: target }) });
    if (!r.ok) { toast(r.msg || '移动失败'); return; }
    await peopleLoad();
    renderPeopleGrid();
    toast('已把「' + p.name + '」移到' + target + '类');
  };
  $('peopleUseInChat').onclick = () => {
    if (selIdx == null) { toast('请先在「会话」tab 选中一个会话，再点「应用到当前会话」'); return; }
    const it = scene.home[selIdx];
    if (!it) return;
    it.name = p.name;
    if (p.avatar) it.avatar = p.avatar;
    else { toast('人物「' + p.name + '」还没设头像，仅更新了名字'); }
    closePeopleLib();
    renderPhone(); renderPanel();
    toast('已应用人物「' + p.name + '」到当前会话');
  };
  $('peopleSyncOne').onclick = () => {
    const usages = peopleUsageInScene(p.name);
    if (!usages.length) { toast('场景里没有「' + p.name + '」同名会话，无需同步'); return; }
    usages.forEach(u => { u.it.avatar = p.avatar || u.it.avatar; });
    renderPhone(); renderPanel();
    toast('已把「' + p.name + '」的头像同步到场景 ' + usages.length + ' 个会话');
  };
}

function renderPeopleRename() {
  const action = $('peopleAction');
  const p = people.find(x => x.name === peopleSel);
  if (!p) return;
  action.innerHTML = '<div class="people-rename-row">' +
    '<input id="peopleRenameInput" value="' + esc(p.name) + '" placeholder="新名字">' +
    '<button id="peopleRenameOk" class="primary">保存</button>' +
    '<button id="peopleRenameCancel">取消</button></div>' +
    '<div class="hint" style="margin-top:6px">改名后，脚本里要写新名字才会自动带该头像；场景中同名会话不会被自动改名。</div>';
  const inp = $('peopleRenameInput');
  inp.focus(); inp.select();
  $('peopleRenameOk').onclick = async () => {
    const newName = inp.value.trim();
    if (!newName) { toast('名字不能为空'); return; }
    if (newName === p.name) { peopleRenameMode = false; renderPeopleActionBar(); return; }
    if (people.some(x => x.name === newName)) { toast('人物库已有「' + newName + '」，请换个名字'); return; }
    const r = await api('/api/people/rename', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: p.name, newName }) });
    if (!r.ok) { toast(r.msg || '改名失败'); return; }
    people = (r.people || {}); // {name:avatar}
    people = Object.keys(people).map(name => ({ name, avatar: people[name] || '' })).sort((a, b) => a.name.localeCompare(b.name, 'zh'));
    peopleSel = newName;
    peopleRenameMode = false;
    renderPeopleGrid();
    toast('已改名');
  };
  $('peopleRenameCancel').onclick = () => { peopleRenameMode = false; renderPeopleActionBar(); };
}

async function peoplePickAvatar(p) {
  // 复用图片选择弹窗选头像路径（不走 setPath 写 scene，写的是人物库）
  pickerPath = null;
  pickerSel = p.avatar || '';
  pickerQuery = '';
  pickerOnCommit = async (path) => {
    const r = await api('/api/people/save', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: p.name, avatar: path }) });
    if (!r.ok) { toast(r.msg || '保存失败'); return; }
    await peopleLoad();
    renderPeopleGrid();
    toast(path ? '头像已更新' : '已清除头像');
  };
  $('pickerBox').innerHTML = pickerMarkup('人物头像：' + p.name);
  $('pickerMask').classList.add('show');
  bindPickerEvents();
  renderPickerGrid();
  updatePickerPreview();
}

async function peopleDelete(name) {
  const p = people.find(x => x.name === name);
  if (!confirm('确定从人物库删除「' + name + '」？\n\n删除后，脚本历史会话里这个名字不再自动带头像，但场景里已有的会话不受影响。')) return;
  const r = await api('/api/people/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name }) });
  if (!r.ok) { toast(r.msg || '删除失败'); return; }
  peopleSel = null;
  await peopleLoad();
  renderPeopleGrid();
  toast('已删除');
}

function peopleAddForm() {
  const box = $('peopleBox');
  box.innerHTML = '<div class="people-head"><b>＋ 新增人物</b><span class="people-count"></span><button id="peopleAddBack" class="people-close" title="返回列表">←</button></div>' +
    '<div class="people-toolbar"></div>' +
    '<div class="field"><label>人物名（脚本 [会话] 里写这个名字会自动带头像）</label>' +
    '<input id="peopleAddName" placeholder="如：香儿"></div>' +
    '<div class="field"><label>所属类别（学员 / 美女，别弄混）</label>' +
      '<select id="peopleAddGroup">' +
        '<option value="美女">美女女性</option>' +
        '<option value="学员">学员</option>' +
      '</select></div>' +
    '<div class="field"><label>头像（可先跳过，稍后在列表里点「换头像」）</label>' +
      '<div class="img-field">' +
        '<div class="if-left"><span class="if-thumb if-empty" id="paThumb" title="点击选择头像">无</span></div>' +
        '<div class="if-right">' +
          '<div class="if-actions">' +
            '<button id="paPick">📁 选择</button>' +
            '<button id="paUpload">⬆ 上传</button>' +
            '<button id="paClear">✖ 清除头像</button>' +
          '</div>' +
          '<div class="if-path" id="paPath">（未设置头像）</div>' +
        '</div>' +
      '</div>' +
    '</div>' +
    '<div class="people-selected"></div>' +
    '<div class="people-grid" style="flex:0"></div>' +
    '<div class="people-action" style="border-top:0;padding-top:0">' +
      '<div class="btns" style="justify-content:flex-end">' +
        '<button id="peopleAddCancel">取消</button>' +
        '<button id="peopleAddOk" class="primary">添加</button>' +
      '</div>' +
    '</div>';
  _peopleInput = '';
  const nameInp = $('peopleAddName');
  nameInp.focus();
  const refreshThumb = () => {
    const thumb = $('paThumb');
    const path = $('paPath');
    const clear = $('paClear');
    if (thumb) thumb.outerHTML = _peopleInput
      ? '<img class="if-thumb" id="paThumb" src="' + esc(_peopleInput) + '" onerror="onImgErr(this)" title="点击选择头像">'
      : '<span class="if-thumb if-empty" id="paThumb" title="点击选择头像">无</span>';
    if (path) path.textContent = _peopleInput || '（未设置头像）';
    if (clear) clear.style.display = _peopleInput ? '' : 'none';
    const t = $('paThumb');
    if (t) t.onclick = openPeopleAvatarPicker;
  };
  const openPeopleAvatarPicker = () => {
    pickerSel = _peopleInput || '';
    pickerQuery = '';
    pickerPath = null;
    pickerCat = '';
    pickerOnCommit = (path) => { _peopleInput = path; refreshThumb(); };
    $('pickerBox').innerHTML = pickerMarkup('人物头像');
    $('pickerMask').classList.add('show');
    bindPickerEvents();
    renderPickerCats();
    renderPickerGrid();
    updatePickerPreview();
    if (!libFiles.length) refreshLibData().then(renderPickerGrid).catch(() => { /* 退化全量 */ });
  };
  refreshThumb();
  $('paPick').onclick = openPeopleAvatarPicker;
  $('paUpload').onclick = () => {
    const inp = document.createElement('input');
    inp.type = 'file';
    inp.accept = 'image/png,image/jpeg,image/gif,image/webp,image/bmp';
    inp.onchange = () => {
      if (!inp.files.length) return;
      const f = inp.files[0];
      if (f.size > 10 * 1024 * 1024) { toast('图片不能超过 10MB'); return; }
      const reader = new FileReader();
      reader.onload = () => {
        api('/api/upload-image', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ data: reader.result, name: f.name }) })
          .then(r => { if (r.ok) { _peopleInput = r.path; gallery = r.images || gallery; refreshThumb(); } else toast(r.msg || '上传失败'); })
          .catch(() => toast('上传失败'));
      };
      reader.readAsDataURL(f);
    };
    inp.click();
  };
  $('paClear').onclick = () => { _peopleInput = ''; refreshThumb(); };
  const back = () => { box.innerHTML = ''; openPeopleLib(false); };
  $('peopleAddBack').onclick = back;
  $('peopleAddCancel').onclick = back;
  $('peopleAddOk').onclick = async () => {
    const name = nameInp.value.trim();
    if (!name) { toast('请填写人物名'); return; }
    const group = ($('peopleAddGroup') || {}).value || '美女';
    if (people.some(x => x.name === name)) toast('人物库已有「' + name + '」，将覆盖其头像');
    const r = await api('/api/people/save', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name, avatar: _peopleInput || '', group }) });
    if (!r.ok) { toast(r.msg || '保存失败'); return; }
    box.innerHTML = '';
    await openPeopleLib(false);
    toast('已新增「' + name + '」（' + group + '）');
  };
}

function bindPeopleEvents() {
  $('peopleClose').onclick = closePeopleLib;
  $('peopleMask').onclick = e => { if (e.target === $('peopleMask')) closePeopleLib(); };
  const search = $('peopleSearch');
  search.oninput = e => { peopleQuery = e.target.value; renderPeopleGrid(); };
  search.onkeydown = e => { if (e.key === 'Enter') e.preventDefault(); };
  // 分组筛选切换（事件委托，兼容渲染后重建）
  const gwrap = $('peopleGroups');
  if (gwrap) gwrap.onclick = e => {
    const tab = e.target.closest('.pg-tab');
    if (!tab) return;
    peopleGroup = tab.getAttribute('data-g') || '';
    renderPeopleGrid();
  };
  $('peopleSync').onclick = async () => {
    const src = (scene.home || []).filter(it => it && peopleKeyOf(it) && it.avatar)
      .map(it => ({ name: peopleKeyOf(it), avatar: it.avatar }));
    if (!src.length) { toast('当前会话还没有填头像的联系人'); return; }
    const r = await api('/api/people/sync', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ people: src }) });
    if (!r.ok) { toast(r.msg || '同步失败'); return; }
    await peopleLoad();
    renderPeopleGrid();
    toast('已同步 ' + src.length + ' 人进人物库');
  };
  $('peopleAdd').onclick = peopleAddForm;
}

/* ---------- 剧本一键注入（两人对话 -> 预置消息历史） ---------- */
function scriptMarkup() {
  const curName = (selIdx != null && scene.home[selIdx]) ? (scene.home[selIdx].name || scene.home[selIdx].group || '当前会话') : '未选中会话';
  return '<div class="script-head"><b>📜 剧本一键注入</b><span class="spacer"></span><button id="scriptClose" class="script-close">×</button></div>' +
    '<div class="script-hint">粘贴两人的对话剧本，每行一条（如「香儿：我今晚好想哭」「我：哭什么」）。格式有误时默认交给 AI 归一修正；也可勾选「离线解析」仅按「说话人：内容」逐行识别。完成后会在左侧画面生成一条完整消息历史，可再进「消息」tab 微调。</div>' +
    '<textarea id="scriptArea" class="script-area" placeholder="香儿：我今晚好想哭，我要哭一晚。\n我：哭什么\n香儿：没什么。\n也可以用 [图片] 标记一张图片消息，例如：\n林晚晚：[图片] 一张对镜自拍照\n林晚晚：夏天快到了，刚买的，会不会有点太露了呀？"></textarea>' +
    '<div id="scriptAttach" style="display:none"></div>' +
    '<div class="script-opts">' +
      '<label>导入到：<select id="scriptTarget">' +
        '<option value="new">新建会话</option>' +
        '<option value="current"' + (selIdx != null ? ' selected' : '') + '>当前会话（' + esc(curName) + '）</option>' +
      '</select></label>' +
      '<label><input type="checkbox" id="scriptOffline"> 离线解析（不上传剧本给 AI）</label>' +
      '<label><input type="checkbox" id="scriptAutoRun"> 导入后直接生成并运行</label>' +
    '</div>' +
    '<div class="script-btns">' +
      '<button id="scriptPreview">预览</button>' +
      '<button id="scriptImport" class="primary">导入</button>' +
    '</div>';
}

function openScriptImport() {
  $('scriptBox').innerHTML = scriptMarkup();
  $('scriptMask').classList.add('show');
  bindScriptEvents();
  $('scriptArea').focus();
}

function closeScriptImport() {
  $('scriptMask').classList.remove('show');
}

function bindScriptEvents() {
  $('scriptClose').onclick = closeScriptImport;
  $('scriptMask').onclick = e => { if (e.target === $('scriptMask')) closeScriptImport(); };
  $('scriptPreview').onclick = () => runScriptImport(false);
  $('scriptImport').onclick = () => runScriptImport(true);
}

/* ---------- 剧本导入使用手册 ---------- */
function manualMarkup() {
  const B = [];
  B.push('<div class="manual-head"><b>📖 场景编辑器 · 历史会话使用手册</b><span class="spacer"></span><button id="manualClose" class="script-close">×</button></div>');
  B.push('<div class="manual-body">');

  B.push('<h3>一、历史会话是什么</h3>');
  B.push('<p>这个场景编辑器用「会话」来还原微信里的<b>聊天</b>，分成两层：<b>会话列表</b>（微信首页那排联系人）和<b>消息历史</b>（点进某个联系人后看到的聊天记录）。这两层数据都保存在 <code>scene.json</code> 的 <code>home[]</code> 数组里，<b>一个会话占一条</b>。</p>');
  B.push('<p>换句话说：<b>一个会话 = 首页里的一行</b>（头像 + 名字 + 最后一条 + 时间 + 未读红点）；<b>点进这一行</b> 就能看到它的 <b>消息历史</b>（我方 + 对方一条条发言）。你要做的「历史会话」，就是把这两层内容编辑成你想要的样子。</p>');
  B.push('<table><tr><th>名词</th><th>指什么</th><th>显示在哪里</th></tr>');
  B.push('<tr><td>会话</td><td>一个联系人 / 一个群</td><td>手机画面「微信」首页列表；右侧「会话」tab</td></tr>');
  B.push('<tr><td>消息历史</td><td>这个会话里一条条的具体发言</td><td>手机画面点进会话后的详情页；右侧「消息」tab</td></tr>');
  B.push('<tr><td>我方（me）</td><td>「我」说的话</td><td>右侧<b>绿色</b>气泡（dir:me）</td></tr>');
  B.push('<tr><td>对方（peer）</td><td>联系人 / 群成员说的话</td><td>左侧<b>白色</b>气泡（dir:peer）</td></tr>');
  B.push('<tr><td>我的资料（me）</td><td>你自己的昵称 / 头像 / 签名 / 朋友圈封面</td><td>右侧「我的资料」tab；手机画面「我」页</td></tr>');
  B.push('</table>');
  B.push('<p class="m-tip">记住两个 tab：<b>「会话」</b> 管<b>有哪些联系人</b>，<b>「消息」</b> 管<b>每次会话里聊了什么</b>。先把会话建好，再往里填消息。</p>');

  B.push('<h3>二、界面长什么样</h3>');
  B.push('<p>整个界面分三块：</p>');
  B.push('<ul>');
  B.push('<li><b>左边手机画面</b>：固定 600×1300 像素的手机，滚轮缩放、拖拽平移。顶部「会话列表」按钮看微信首页，「朋友圈」按钮看朋友圈；<b>点画面上的任意元素就能直接改</b>。</li>');
  B.push('<li><b>右边结构化面板</b>：4 个 tab——「会话」（联系人列表）/「消息」（某个会话的聊天记录）/「朋友圈」/「我的资料」。<b>面板和手机画面是联动的</b>，改哪边另一边都会刷新。</li>');
  B.push('<li><b>顶部工具条</b>：会话列表、朋友圈、🖼检查图片、📚图片库、📜剧本导入、📖使用手册、👥人物库、💾保存到人物库、放大缩小、载入场景、保存场景、生成工作流、打开视频目录、▶生成并运行、✏️编辑模式、⏹停止、🖥实时画面。</li>');
  B.push('</ul>');
  B.push('<p>看「历史会话」最常用的是：<b>左边手机画面 + 右边「会话」「消息」两个 tab</b>。</p>');

  B.push('<h3>三、怎么选中一个会话（进入它的消息历史）</h3>');
  B.push('<p>「消息」tab 只显示<b>当前选中的那个会话</b>的聊天记录。选中会话有三种方式：</p>');
  B.push('<ol>');
  B.push('<li><b>右边「会话」tab 点会话名</b>：点卡片顶部那块名字（会话名 / 群名），便选中它并自动切到「消息」tab。</li>');
  B.push('<li><b>左边手机画面点那一行</b>：在微信首页列表里点某个会话，直接进入它的详情页，右边同时切到「消息」tab。</li>');
  B.push('<li><b>点「✏️ 编消息」按钮</b>：每个会话卡片上都有这个按钮，点它直接选中并跳到「消息」tab，最省事。</li>');
  B.push('</ol>');
  B.push('<p>选中后：手机画面顶部出现 <b>‹ 返回键 + 会话名</b>，下方是气泡聊天记录；右侧「消息」tab 列出该会话每条消息。</p>');
  B.push('<p><b>返回到列表</b>：点手机画面左上角的 <b>‹</b>，或顶部「会话列表」按钮，或点底部 Tab 栏的「微信」。</p>');
  B.push('<p class="m-warn">如果没有先选中会话就去「消息」tab，会看到一句提示「先在上方会话tab选中一个会话」。这不是坏了，选一个就行了。</p>');

  B.push('<h3>四、右侧「会话」tab：每个字段怎么填</h3>');
  B.push('<p>打开「会话」tab，每个会话是一张卡片，从上到下依次是：</p>');
  B.push('<table><tr><th>字段</th><th>含义</th><th>说明</th></tr>');
  B.push('<tr><td>会话名</td><td>联系人/群的名字</td><td>显示在列表、详情页标题；群聊时群名与之相同。</td></tr>');
  B.push('<tr><td>最后一条（列表摘要）</td><td>首页那一行显示的「最后一条消息」</td><td><b>留空会自动取最后一条消息</b>；手动填则优先用你填的内容。</td></tr>');
  B.push('<tr><td>列表时间</td><td>首页那一行右侧的时间</td><td>可填 18:22、昨天 23:52、星期日 等，随你写。</td></tr>');
  B.push('<tr><td>类型</td><td>私聊 / 群聊</td><td>选「群聊」会多出「群成员」一栏。</td></tr>');
  B.push('<tr><td>头像</td><td>联系人/群的头像</td><td>点卡片或手机上的头像，从图片库选一张。</td></tr>');
  B.push('<tr><td>未读数</td><td>右上角红底白字的数字</td><td>填 0 不显示；填几就显示几个点的红字。</td></tr>');
  B.push('<tr><td>免打扰</td><td>勾选后未读不再数字红点</td><td>改成<span style="color:#9aa0a6">⚠ 灰色小圆点</span> + 静音图标；红点和圆点二选一。</td></tr>');
  B.push('<tr><td>群成员</td><td>仅群聊：逗号分隔的成员名</td><td>例如 <code>梓康、小宇</code>；用于群聊逐条消息标说话人。</td></tr>');
  B.push('</table>');
  B.push('<p>每个会话卡片右上角还有四个按钮：</p>');
  B.push('<ul>');
  B.push('<li><b>✏️ 编消息</b>：选中并跳到「消息」tab。</li>');
  B.push('<li><b>↑ / ↓</b>：把该会话在列表里上移/下移（调顺序）。</li>');
  B.push('<li><b>删除</b>：把整个会话（连同消息）删掉。</li>');
  B.push('</ul>');
  B.push('<p>面板最上方「＋ 新增会话」：新建一条，默认名字「新朋友」、私聊、无消息，自己再改。</p>');
  B.push('<p class="m-ex">示例：会话名=香儿，最后一条=我也吃饭去了，列表时间=18:16，未读数=1，免打扰=不勾。<br>进「消息」tab 就能给香儿填聊天记录。</p>');

  B.push('<h3>五、右侧「消息」tab：每个字段怎么填</h3>');
  B.push('<p>先选中一个会话（见第三节），再切到「消息」tab。每条消息是一张卡片，从上到下是：</p>');
  B.push('<table><tr><th>字段</th><th>含义</th><th>说明</th></tr>');
  B.push('<tr><td>方向</td><td>这条是谁说的</td><td><b>我</b>=右侧绿色气泡（dir:me）；<b>对方</b>=左侧白色气泡（dir:peer）。</td></tr>');
  B.push('<tr><td>类型</td><td>文字 / 图片 / 语音</td><td>类型的选项会影响下面填的内容：文字填内容，图片选图片，语音填秒数。</td></tr>');
  B.push('<tr><td>说话人</td><td>群聊里这条是谁说的</td><td><b>群聊</b>逐条可填成员名；<b>私聊留空</b>，会自动显示为会话名或「对方」。</td></tr>');
  B.push('<tr><td>消息内容</td><td>文字的内容</td><td>当类型=文字时出现。</td></tr>');
  B.push('<tr><td>图片</td><td>图片的路径</td><td>当类型=图片时出现，点图片字段选一张。</td></tr>');
  B.push('<tr><td>语音秒数</td><td>语音的长度</td><td>当类型=语音时出现，填几秒就显示多长的波纹。</td></tr>');
  B.push('<tr><td>时间</td><td>这条消息的时间气泡</td><td>可填 18:22；<b>留空就不显示时间</b>。</td></tr>');
  B.push('</table>');
  B.push('<p>每个消息卡片右上角还有：<b>↑ / ↓</b>（调整这条在对话里的先后）、<b>删除</b>（删掉这一条）。</p>');
  B.push('<p>面板最上方：</p>');
  B.push('<ul>');
  B.push('<li><b>＋ 添加消息</b>：追加一条「对方·文字」的新消息，再改方向/内容。</li>');
  B.push('<li><b>🔥 对方连发一长串</b>：一次加 5 条对方消息（在吗 / 看到回我一下 / 晚上有空吗 / 一起吃饭 / 定好地方告诉我），适合模拟「对方连续发多条」。改内容即可。</li>');
  B.push('</ul>');
  B.push('<p class="m-tip">关于头像：<b>「我」这一方的气泡头像用的是「我的资料」里的头像和昵称</b>；<b>对方的头像用的是这个会话的头像</b>。所以想让对方像个真人，先把会话头像选好。</p>');
  B.push('<p class="m-ex">示例（香儿这条会话的几条消息）：<br>对方(18:16)：我今晚好想哭，我要哭一晚。<br>我：哭什么<br>我：这次是我的问题<br>对方：我要去扫地了(20:53)<br>方向、内容、时间都按这张卡片填。</p>');

  B.push('<h3>六、左边手机画面：点选即改</h3>');
  B.push('<p>手机画面上的元素都是<b>可以点的</b>，点完会弹出编辑框，改完点「保存」立即上屏：</p>');
  B.push('<ul>');
  B.push('<li><b>点会话列表的一行</b>：进入该会话详情，右侧切到「消息」tab。</li>');
  B.push('<li><b>点 ‹ 返回键</b>：从详情页回到会话列表。</li>');
  B.push('<li><b>点任意文字</b>（会话名 / 最后一条 / 气泡文字 / 时间 / 群名）：弹出「编辑」框，填新文字点保存。</li>');
  B.push('<li><b>点头像 / 图片 / 封面</b>：弹出图片选择器，从图库挑一张。</li>');
  B.push('<li><b>点底部 Tab 栏</b>：微信（回到列表）/ 通讯录（场景人物分组）/ 发现（朋友圈）/ 我（个人信息示意）。</li>');
  B.push('</ul>');
  B.push('<p><b>缩放平移</b>：滚轮缩放，按住拖拽平移；顶部「适应」恢复 100% 居中，+/− 手动缩放。</p>');
  B.push('<p class="m-warn">点「保存」只改手机画面，<b>没点顶部「保存场景」不会写进 scene.json</b>。要留存记得点「保存场景」。</p>');

  B.push('<h3>七、图片来源</h3>');
  B.push('<p>所有头像 / 图片 / 封面都是一个<b>图片路径</b>，推荐放在 <code>vue-WeChat/public/images</code> 下，用 <code>/images/...</code> 相对路径引用（也支持 http(s):// 链接）。常见的：</p>');
  B.push('<ul>');
  B.push('<li><b>📚 图片库</b>：浏览 / 搜索 / 上传 / 重命名 / 删除 / 一键复制图片路径；批量模式下还能整批搬运 / 删除。分类按钮标着每类张数，打开自动停在上次用的分类；图片拖进窗口任意位置即可上传；缩略图拖到分类按钮上＝搬家；「⚙ 分类」可改名 / 新建分类。</li>');
  B.push('<li><b>🖼 检查图片</b>：检查场景里引用的所有图片能否加载，失败的用红框标出。</li>');
  B.push('<li><b>图片字段的三个按钮</b>：📁 选择（从图库挑）、⬆ 上传（本机文件）、✖ 清除（清空这张图）。</li>');
  B.push('</ul>');

  B.push('<h3>八、保存 / 生成 / 运行（一条龙）</h3>');
  B.push('<ol>');
  B.push('<li><b>载入场景</b>：从 <code>scene.json</code> 读入当前数据，开始编辑。</li>');
  B.push('<li><b>保存场景</b>：把当前数据写回 <code>scene.json</code>（微信首页会话、消息、我的资料、朋友圈都在里面）。</li>');
  B.push('<li><b>生成工作流</b>：自动产出「应用场景 / 编辑主页 + 编辑朋友圈 + 个人资料」等步骤，写入 workflow。这是运行前必做的一步。</li>');
  B.push('<li><b>▶ 生成并运行</b>：一键完成 保存场景 → 生成工作流 → 立即开跑。右下角「实时画面」会跟着执行自动刷新，完成后点「打开视频目录」看录出的 MP4。</li>');
  B.push('</ol>');
  B.push('<p class="m-tip">推荐顺序：先「载入场景」→ 编辑会话/消息 →「保存场景」→「生成工作流」→「▶ 生成并运行」。中间的「生成工作流」漏了，运行会可能报「联系人不存在」。</p>');

  B.push('<h3>九、剧本导入：一键生成消息历史</h3>');
  B.push('<p>「📜 剧本导入」能把两个人<b>已经聊过的对话</b>粘成一段剧本，一次性生成一条<b>完整的消息历史</b>——自动区分「我」和「对方」、逐条识别说话人。<b>不用一条一条手动编辑</b>。生成后可继续微调，再「生成并运行」录成视频。</p>');
  B.push('<h4>怎么用：三步走</h4>');
  B.push('<ol>');
  B.push('<li><b>准备剧本</b>：每行一条，写成「说话人：内容」；含图片的消息用 <code>[图片]</code> 标记，如 <code>林晚晚：[图片] 一张对镜自拍照</code>。</li>');
  B.push('<li><b>点顶部「📜 剧本导入」</b>：粘贴剧本，选导入目标，可勾选「离线解析」「导入后直接生成并运行」。</li>');
  B.push('<li><b>先「预览」再「导入」</b>：确认生成条数没问题再正式写入，完成后自动跳到「消息」tab 微调。</li>');
  B.push('</ol>');
  B.push('<h4>剧本怎么写（两种）</h4>');
  B.push('<p><b>1. 标准格式：每行「说话人：内容」</b></p>');
  B.push('<div class="m-ex">香儿：我今晚好想哭，我要哭一晚。\n我：哭什么\n香儿：没什么。</div>');
  B.push('<p><b>2. 自然叙述（有 DeepSeek Key 时才由 AI 归一）</b></p>');
  B.push('<div class="m-ex">我和香儿聊了下周聚餐的事，她说周三有空，我回复好的到时候见。</div>');
  B.push('<p>系统把 <code>我</code> / <code>我方</code> / <code>me</code> / <code>自己</code>，以及「我的资料」里填的昵称，都当作<b>「我」这一方</b>生成<i>右侧绿色气泡（dir:me）</i>；其余说话人（如「香儿」）都是<b>对方</b>，生成<i>左侧白色气泡（dir:peer）</i>。</p>');
  B.push('<h4>说话人 → 气泡方向</h4>');
  B.push('<table><tr><th>剧本里的说话人</th><th>显示方式</th></tr>');
  B.push('<tr><td>我 / 我方 / me / 自己 / 我的昵称</td><td>右侧 <b>绿色气泡</b>（dir:me）</td></tr>');
  B.push('<tr><td>对方名字（如 香儿）</td><td>左侧 <b>白色气泡</b>（dir:peer）</td></tr>');
  B.push('</table>');
  B.push('<h4>导入选项说明</h4>');
  B.push('<table><tr><th>选项</th><th>含义</th></tr>');
  B.push('<tr><td>导入到：新建会话</td><td>在会话列表新增一条，自动取对方名字为会话名</td></tr>');
  B.push('<tr><td>导入到：当前会话</td><td>覆盖当前选中会话的聊天历史（替换原有消息）</td></tr>');
  B.push('<tr><td>离线解析</td><td>不上传剧本给 AI，只按「说话人：内容」逐行识别；标准格式剧本用它更稳</td></tr>');
  B.push('<tr><td>导入后直接生成并运行</td><td>导入完自动「保存场景 → 生成工作流 → 运行录视频」</td></tr>');
  B.push('</table>');
  B.push('<h4>导入之后要做的事</h4>');
  B.push('<ul>');
  B.push('<li><b>图片消息：</b>剧本里用 <code>[图片]</code> 标记的消息，导入前会在下方「🖼 配图清单」逐条选图；没配的会保留空图，可到「消息」tab 的图片字段补选。</li>');
  B.push('<li><b>补对方头像：</b>剧本<b>无法推断头像图片路径</b>，导入后请到「会话」卡片用图片库（📚 图片库 / 🖼 检查图片）补选一张头像。</li>');
  B.push('<li><b>微调消息：</b>自动跳到「消息」tab，可逐条改内容、时间、方向；要补多条用「对方连发一长串」。</li>');
  B.push('<li><b>确认会话名 / 未读：</b>「会话」tab 里改名字、未读数、免打扰等。</li>');
  B.push('</ul>');
  B.push('<p class="m-tip">小技巧：导入时直接勾选「导入后直接生成并运行」，一条龙完成 注入 → 生成工作流 → 录屏。</p>');

  B.push('<h3>十、单文本剧本格式规范（历史会话块 + 动作指令）</h3>');
  B.push('<p>这是<b>「脚本模式」</b>（编辑器首页）用的<b>一页式智能剧本</b>：把<b>①页面要有的会话与消息历史</b> 和 <b>②要表演的动作</b> 全部写进同一段文本。系统会先把「历史会话块」转成一条 <code>[编辑主页]</code> 插到最前面，把会话与消息精确还原到手机，再按后面的动作指令播放。</p>');
  B.push('<h4>1. 整体结构</h4>');
  B.push('<div class="m-ex">[历史会话]<br>　[会话] 香儿<br>　香儿：我今晚好想哭<br>　我：哭什么呀<br>　[会话] 小明<br>　小明：周末有空吗<br>　我：有的，怎么了<br>[历史会话结束]<br>[打开聊天] 香儿<br>[等待] 0.5<br>[我方打字] 别哭了</div>');
  B.push('<p>上面<b>前八行</b>是「历史会话块」（页面内容），下面是<b>动作指令</b>（表演）。分界线就是 <code>[历史会话结束]</code> 或第一条以 <code>[</code> 开头的动作行。</p>');
  B.push('<h4>2. 历史会话块</h4>');
  B.push('<ul>');
  B.push('<li><b>起始</b>：单独一行 <code>[历史会话]</code>（也兼容 <code>[历史会话区]</code>、<code>[会话历史]</code> 及全角 <code>【】</code>）。</li>');
  B.push('<li><b>结束</b>：单独一行 <code>[历史会话结束]</code>；也可<b>省略</b>，遇到下一条以 <code>[</code> 开头的动作行即自动结束。</li>');
  B.push('<li><b>会话头</b>：<code>[会话] 联系人名</code> 开启一个会话；想写多个会话就多点几个 <code>[会话]</code>，每个 <code>[会话]</code> 之后到下一个 <code>[会话]</code> 之前的对白都属于它。</li>');
  B.push('<li><b>对白行</b>：每行<b>一条消息</b>，格式 <code>说话人：内容</code>（半角或全角冒号均可）。</li>');
  B.push('<li><b>说话人归一</b>：<code>我/我方/me/我自己/自己</code> → 我方（<code>dir:me</code>，右侧绿泡）；其它任意名字 → 对方（<code>dir:peer</code>，左侧白泡）。</li>');
  B.push('<li><b>消息类型</b>：<br>· 文字：<code>说话人：内容</code><br>· 图片：<code>说话人：[图片] 描述</code>（<code>[配图]</code> 或全角 <code>【图片】</code> 亦可，描述可省略）<br>· 语音：<code>说话人：[语音]</code> 或 <code>说话人：[语音] 5秒</code>（缺省 3 秒）</li>');
  B.push('<li><b>换行</b>：对白之间可留空行，空行会被忽略；<b>每行只需一条</b>。</li>');
  B.push('</ul>');
  B.push('<h4>3. 动作指令（表演部分）</h4>');
  B.push('<p>历史会话块之后逐行写动作，格式 <code>[动作名] 参数</code>，参数与动作同行。</p>');
  B.push('<table><tr><th>动作</th><th>参数</th><th>说明</th></tr>');
  B.push('<tr><td>[打开聊天]</td><td>联系人名</td><td>进入某个会话；该名字须在历史块里出现过</td></tr>');
  B.push('<tr><td>[我方打字]</td><td>内容</td><td>键盘动画逐字打出并发送</td></tr>');
  B.push('<tr><td>[对方发消息]</td><td>内容</td><td>对方话以左侧气泡整行上屏</td></tr>');
  B.push('<tr><td>[对方正在输入]</td><td>秒数</td><td>头部显示「对方正在输入…」</td></tr>');
  B.push('<tr><td>[等待]</td><td>秒数</td><td>自然停顿（0.3~0.8 为常见值）</td></tr>');
  B.push('<tr><td>[返回主页]</td><td>无</td><td>切回微信首页</td></tr>');
  B.push('</table>');
  B.push('<p>完整动作表以编辑器左侧动作库为准；也支持自然语言叙述（有 DeepSeek Key 时由系统自动翻译成动作）。</p>');
  B.push('<h4>4. 消息 → 手机渲染映射</h4>');
  B.push('<table><tr><th>剧本写法</th><th>dir</th><th>kind</th><th>渲染</th></tr>');
  B.push('<tr><td>我：内容</td><td><code>me</code></td><td><code>text</code></td><td>右侧绿色气泡</td></tr>');
  B.push('<tr><td>某名字：内容</td><td><code>peer</code></td><td><code>text</code></td><td>左侧白色气泡</td></tr>');
  B.push('<tr><td>我：[图片] 描述</td><td><code>me</code></td><td><code>image</code></td><td>图片消息（image 待配图，未配则显示 [图片] 占位）</td></tr>');
  B.push('<tr><td>说话人：[语音] 秒数</td><td>按说话人</td><td><code>voice</code></td><td>语音消息（秒数）</td></tr>');
  B.push('</table>');
  B.push('<h4>5. 系统会把它变成什么</h4>');
  B.push('<p>转译时，历史块被自动转成一条 <code>[编辑主页]</code> 步骤（<code>数据</code> = <code>[{name:"会话名", messages:[{dir,kind,text,image,seconds}]}]</code>），插到所有动作最前面。等价于一次性完成「场景编辑器里建会话+写消息」再接着「动作剧本」。</p>');
  B.push('<h4>6. 供 AI 生成/优化的约定</h4>');
  B.push('<ul>');
  B.push('<li>对白内容、会话名、说话人<b>原样保留</b>，不要改写、润色或翻译。</li>');
  B.push('<li>「我」统一写 <code>我</code>，不要写 <code>me/我方/自己</code>。</li>');
  B.push('<li>只区分两类消息类型标记：<code>[图片]</code>（图片）与 <code>[语音]</code>（语音）；其它 <code>[...]</code> 方括号不要用在对白行里（它们属于会话头或动作指令）。</li>');
  B.push('<li>对白行<b>不要以 <code>[</code> 开头</b>；以 <code>[</code> 开头的行只能是 <code>[历史会话]</code>、<code>[会话]</code>、<code>[历史会话结束]</code> 或动作指令。</li>');
  B.push('<li>一个会话开一个 <code>[会话]</code>，不要复用；多个会话用多个 <code>[会话]</code>。</li>');
  B.push('<li>图片消息<b>无法从文本推断真实图片路径</b>，写 <code>[图片]</code> 时优先给一句描述；配图留给后续手动在场景编辑器「消息」tab 或图库补。</li>');
  B.push('<li>人物头像<b>不用在剧本里写</b>：系统会从 <code>people.json</code> 人物库按 <code>[会话] 名字</code> 自动匹配头像。顶栏「👥 人物库」可<b>浏览、搜索、新增、改名、删除、换头像</b>全部人物；「💾 保存到人物库」把当前会话里有头像的人批量入库。之后脚本里写这个名字就自动带头像；查不到则用默认头像，并在结果里提示补充。</li>');
  B.push('</ul>');
  B.push('<p class="m-tip"><b>人物库怎么用最顺：</b>先在「会话」tab 点「👥 从人物库加会话」或「👤 用人物库填当前会话」，选一个人就自动把名字+头像填好；也可以直接在「👥 人物库」里「＋ 新增人物」建一个人，之后再往会话里填。</p>');
  B.push('<p class="m-tip">小技巧：editor 首页「脚本模式」顶部有 <b>「📜 插入历史会话」</b> 按钮，可一键插入这段格式的占位，再改人名/对白即可。</p>');

  B.push('<h3>十一、常见问题</h3>');
  B.push('<h4>1. 打开「消息」tab 是空的？</h4>');
  B.push('<p>因为你还没<b>选中一个会话</b>。到「会话」tab 点某条会话的名字，或点手机画面里那一个会话，或点它的「✏️ 编消息」。选中的会话消息才会显示。</p>');
  B.push('<h4>2. 为什么「我」显示成右侧绿泡？</h4>');
  B.push('<p>方向是按说话人识别的。剧本里的「我」系列（我/我方/me/自己/昵称）被映射为 <code>me</code>，右侧绿泡；其它都成对方 <code>peer</code>，左侧白泡。想改某一条，进「消息」tab 改「方向」即可。</p>');
  B.push('<h4>3. 未读红点和免打扰小圆点有什么区别？</h4>');
  B.push('<p><b>红点圆形数字</b>（未读数 > 0 且未勾免打扰）= 正常新消息提醒；<b>灰色小圆点 + 静音图标</b>（未读数 > 0 且勾了免打扰）= 免打扰，只提醒不响。两者都代表有未读，只是形式不同。</p>');
  B.push('<h4>4. 群聊怎么让每句话显示不同人？</h4>');
  B.push('<p>把会话类型改成「群聊」，填好「群成员」（逗号分隔），再在「消息」tab 每条消息的<b>「说话人」</b>填各自的名字。私聊则留空即可。</p>');
  B.push('<h4>5. 为什么最后一条和时间不对？</h4>');
  B.push('<p>「最后一条（列表摘要）」和「列表时间」留空时，系统自动取<b>最后一条消息</b>的内容和时间。若想强制，手动填这两项即可覆盖。</p>');
  B.push('<h4>6. 导入后对方头像是空的？</h4>');
  B.push('<p>头像路径无法从文字剧本推断，属正常现象。到「会话」卡片点头像位置，从图片库选一张；或点「👥 人物库」选一个已设头像的人物直接填进去。</p>');
  B.push('<h4>6b. 人物库到底存了什么，怎么查询/管理？</h4>');
  B.push('<p>顶栏「👥 人物库」打开一张全屏弹窗：顶部搜索框可按<b>名字 / 头像文件名</b>过滤；网格里每人显示头像 + 名字 + 「场景已用 X 处」角标（绿色=头像与场景一致，黄色=不一致或未设头像）。选中一人后可在底部<b>换头像 / 改名 / 删除</b>，还能看到它当前出现在场景里哪些会话、头像是否一致，并可一键<b>应用到当前会话</b>或<b>同步到场景同名会话</b>。人物数据保存在项目根目录 <code>people.json</code>，供剧本历史会话自动套头像。</p>');
  B.push('<h4>7. 提示「未能识别出对话」？</h4>');
  B.push('<p>剧本没有按「说话人：内容」分行，或全是同一个人。请改成标准格式；有 DeepSeek Key 时去掉「离线解析」勾选，交给 AI 归一修正。</p>');
  B.push('<h4>8. 图片大批量上传失败 / 画面出现红框？</h4>');
  B.push('<p>把图片放进 <code>vue-WeChat/public/images</code> 再用；或点「🖼 检查图片」定位到具体失败项。「📚 图片库」支持批量导入 / 删除。</p>');
  B.push('<h4>9. 运行时报「联系人不存在」？</h4>');
  B.push('<p>运行时会话列表只来自「场景 scene.json + 人物库 people.json」——<code>打开聊天</code> 只能填里面真实存在的名字。场景编辑器「生成工作流」会写 <code>应用场景 / 编辑主页</code> 重建列表，一般没问题；仍报错就先「生成工作流」再运行，或把人加进人物库。</p>');
  B.push('<h4>10. AI 归一需要什么？</h4>');
  B.push('<p>需要 DeepSeek API Key（首页「脚本模式」→「⚙ 配置大模型」填入，或环境变量 <code>DEEPSEEK_API_KEY</code>）。没有 Key 会自动降级为离线规则解析，标准格式剧本照样能用。</p>');

  B.push('<h3>十二、我的朋友圈（含视频动态）</h3>');
  B.push('<p>右侧「朋友圈」tab 编排的是<b>你自己的朋友圈</b>（从「发现 → 朋友圈」进去看到的那一页）。手机画面顶部点「朋友圈」可直接预览。</p>');
  B.push('<ul>');
  B.push('<li><b>每条动态</b>：作者 / 作者头像 / 公司名（企业微信来源，填了昵称后面会跟金色的 <code>@公司名</code>）/ 文案 / 时间 / 点赞的人 / 评论。</li>');
  B.push('<li><b>配图动态</b>：最多 9 张，点「＋ 添加图片」从图片库挑。真机排版规则：<b>1 张</b>按原图比例（限制在文字列宽的 60% 内）；<b>2 张 / 3 张 / 5~9 张</b>一行三列方格；<b>4 张</b>是田字格 2×2。多图一律正方形居中裁切，单图不裁切。</li>');
  B.push('<li><b>视频动态</b>：点那条动态右上角的「加视频」，它会从「配图」切到「视频」（再点一次是「移除视频」切回配图）。然后点 <b>⬆ 上传视频</b>选本机的 mp4，或从下面的下拉里挑一个已经传过的。</li>');
  B.push('<li><b>视频封面</b>：不填就用该动态的第一张配图；封面右上角会自动叠一个播放角标。</li>');
  B.push('</ul>');
  B.push('<p><b>视频文件</b>上传后自动落到 <code>vue-WeChat/public/videos/</code>，场景里记的是 <code>/videos/文件名.mp4</code>。推荐 <b>mp4（H.264 + AAC）</b>，录制用的浏览器是系统安装的 Chrome，能直接播；也支持 http(s) 直链。</p>');
  B.push('<p><b>一键进朋友圈 + 打开内容</b>：朋友圈 tab 顶部有个「生成工作流时进入朋友圈」区块，勾上它再选「打开方式」（播放视频 / 点开图片）和「第几条动态」，点顶栏「生成工作流」就会自动拼出这样一段：' +
    '<code>[进入朋友圈]</code> → <code>[向下滚动]</code> → <code>[播放视频]</code>（或 <code>[点开图片]</code>）。</p>');
  B.push('<p class="m-tip">注意「第几条动态」指<b>动态列表里的第几条</b>（不是「第几个视频」）。<code>[播放视频]</code> 的序号是「第几个视频动态」，二者不一致时以实际视频数为准。</p>');

  B.push('<h3>十三、对方主页 / 对方朋友圈</h3>');
  B.push('<p>右侧「对方主页」tab 用来编排<b>参考视频里那种「点开对方头像 → 对方资料页 → 对方朋友圈」</b>的内容。手机画面顶部也有「对方主页」「对方朋友圈」两个按钮，可直接预览。</p>');
  B.push('<p><b>多人物 × 多方案</b>：面板分三段——① <b>人物列表</b>：每个联系人可以有自己的主页和朋友圈，可新建/复制/删除/从预设新建；② <b>编辑方案</b>：同一人物可备 A/B/C 多套朋友圈内容，点字母一键切换预览，「生成工作流」只导出每个人物的当前方案；③ <b>动态列表</b>：当前方案的动态增删/排序/加视频/点赞/评论。老场景的单 peer 数据会自动迁移成「单人物·方案 A」，完全兼容。</p>');
  B.push('<p><b>一键生成</b>：选内容模板（日常自拍/旅拍打卡/美食探店/健身运动/创业正能量）自动生成 6 条动态——模板文案 + 图片库随机配图 + 日期错落。已配置 DeepSeek Key 时还能用 <b>AI 文案</b>：填几个关键词（职业/性格/语气），大模型重写整套动态文案（配图与日期保留）。</p>');
  B.push('<ul>');
  B.push('<li><b>基本资料</b>：昵称 / 微信号 / 地区 / 性别 / 头像 / 个性签名（随当前人物当前方案）。</li>');
  B.push('<li><b>朋友圈封面 / 缩略图</b>：封面图 + 资料页「朋友圈」那一行最多 5 张缩略图。</li>');
  B.push('<li><b>视频号</b>：可加/移除；不加时资料页不显示这一行。</li>');
  B.push('<li><b>朋友圈动态</b>：每条可填日期（如 <code>10 6月</code>）、文案、最多 9 张配图、点赞的人（顿号分隔）、多条评论（评论人+内容）；点「加视频」把这条变成<b>视频动态</b>，填视频地址（<code>/videos/xxx.mp4</code>）和封面，朋友圈里就显示「封面 + 播放角标」。</li>');
  B.push('<li><b>点选即改</b>：对方朋友圈预览里点文案/日期/配图/评论即改；悬停动态右上角出现 ↑↓✕ 排序删除；列表顶部「＋ 添加动态」直接加一条。</li>');
  B.push('</ul>');
  B.push('<p><b>视频文件</b>放在 <code>vue-WeChat/public/videos/</code> 下，用 <code>/videos/文件名.mp4</code> 引用（也支持 http(s) 地址）。生成的工作流里，<code>[播放视频]</code> 会点开全屏播放；<code>[向下滚动] / [向上滚动]</code> 可滚动朋友圈；看完想直接切回聊天，用 <code>[闪回聊天]</code>——它不做滑出转场，一帧切回聊天页，观感像剪辑软件里的一次硬切。</p>');
  B.push('<p class="m-tip">朋友圈里的图片和视频角标在成片里都是<b>可以点开</b>的：图片会真人式放大查看，视频会全屏播放（带进度条）。资料页的「朋友圈」缩略图也能点开。</p>');

  B.push('</div>');
  return B.join('');
}
function openManual() {
  $('manualBox').innerHTML = manualMarkup();
  $('manualMask').classList.add('show');
  $('manualClose').onclick = closeManual;
  $('manualMask').onclick = e => { if (e.target === $('manualMask')) closeManual(); };
}
function closeManual() { $('manualMask').classList.remove('show'); }

function myName() { return (scene.me && scene.me.name) || '我'; }

function _picDesc(t) {
  const m = /^\s*(?:[\[【]\s*(?:图片|配图)\s*[\]】])/.exec(t || '');
  return m ? t.slice(m[0].length).trim() : (t || '');
}
function _isImgEntry(d) {
  return !!(d && (d.image === true || /^\s*(?:[\[【]\s*(?:图片|配图)\s*[\]】])/.test(d.text || '')));
}

function detectImageSlots(dia) {
  const prev = new Map(pendingSlots.map(s => [s.id, s.path]));
  const slots = [];
  dia.forEach((d, i) => {
    if (!_isImgEntry(d)) return;
    slots.push({ id: 'img_' + i, no: '图' + (slots.length + 1), speaker: d.speaker, desc: _picDesc(d.text), path: prev.get('img_' + i) || '' });
  });
  return slots;
}

function dialogueToConversation(dia) {
  const isMe = sp => /^(我|我方|me|我自己|自己)$/i.test((sp || '').trim()) || (sp || '').trim() === myName();
  const pathFor = i => { const s = pendingSlots.find(x => x.id === 'img_' + i); return s ? (s.path || '') : ''; };
  let peerName = '';
  const messages = [];
  dia.forEach((d, i) => {
    const me = isMe(d.speaker);
    if (!me && d.speaker && !peerName) peerName = d.speaker;
    if (_isImgEntry(d)) {
      messages.push({ dir: me ? 'me' : 'peer', kind: 'image', image: pathFor(i), text: _picDesc(d.text), time: '' });
    } else {
      messages.push({ dir: me ? 'me' : 'peer', kind: 'text', text: d.text || '', time: '' });
    }
  });
  return { peerName: peerName, messages: messages };
}

function applyConversation(conv, intoCurrent) {
  const last = conv.messages[conv.messages.length - 1];
  if (intoCurrent && selIdx != null && scene.home[selIdx]) {
    const cur = scene.home[selIdx];
    cur.messages = conv.messages;
    if (conv.peerName) cur.name = conv.peerName;
    cur.lastText = last ? last.text : (cur.lastText || '');
    return cur;
  }
  const item = {
    id: 'c' + Date.now(),
    type: 'friend',
    name: conv.peerName || '对方',
    lastText: last ? last.text : '',
    unread: 1,
    quiet: false,
    messages: conv.messages,
    time: ''
  };
  scene.home.push(item);
  selIdx = scene.home.length - 1;
  return item;
}

async function runScriptImport(apply) {
  const text = $('scriptArea').value;
  if (!text.trim()) { toast('请先粘贴剧本内容'); return; }
  const offline = $('scriptOffline').checked;
  let r;
  try {
    r = await api('/api/scene/script-import', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text: text, offline: offline })
    });
  } catch (e) { toast('剧本归一失败：' + (e && e.message)); return; }
  if (!r.ok) { toast(r.msg || '剧本解析失败'); return; }
  const dia = r.dialogue || [];
  if (!dia.length) {
    toast((r.warnings && r.warnings[0]) || '未能识别出对话，请确认是「说话人：内容」格式');
    (r.warnings || []).forEach(w => toast(w));
    return;
  }
  // 识别图片槽位并渲染配图面板
  pendingSlots = detectImageSlots(dia);
  const attachBox = $('scriptAttach');
  if (attachBox) {
    attachBox.style.display = pendingSlots.length ? '' : 'none';
    if (pendingSlots.length && window.__wxPick) {
      __wxPick.renderAttachPanel(attachBox, pendingSlots, function () { });
    }
  }
  const intoCurrent = $('scriptTarget').value === 'current';
  const conv = dialogueToConversation(dia);
  applyConversation(conv, intoCurrent);
  normalizeLists();
  renderPhone();
  setPanelTab('messages');
  const ws = r.warnings || [];
  if (ws.length) ws.forEach(w => toast(w));
  if (!apply) {
    toast('预览：已生成「' + (conv.peerName || '对方') + '」的 ' + conv.messages.length + ' 条消息' +
      (pendingSlots.length ? '，含 ' + pendingSlots.length + ' 张图片待配图' : '') + '（未保存）。确认后点「导入」。');
    return;
  }
  if (pendingSlots.length) {
    const unassigned = pendingSlots.filter(s => !s.path);
    if (unassigned.length) toast('注意：有 ' + unassigned.length + ' 张图片未配图，导入后请到「消息」tab 补图。');
  }
  if ($('scriptAutoRun').checked) {
    closeScriptImport();
    generateAndRun();
  } else {
    toast('已注入「' + (conv.peerName || '对方') + '」的 ' + conv.messages.length + ' 条消息。切到「消息」tab 可逐条微调，再「保存场景」。');
  }
}

/* ---------- 缩放 / 平移 ---------- */
/* 实时预览是真实界面 iframe —— 被缩放过会被浏览器渲染成黑屏（实测），
   所以预览下把缩放锁死在 1:1，靠滚轮上下平移看整台手机 */
function isPvScaleBlocked() {
  return stageView === 'pv';
}
function warnPvNoZoom() {
  toast('实时预览是 1:1 的真实界面（缩放会黑屏）：滚轮可上下移动画面，需要缩放请切到「示意稿」');
}

function applyZoom() {
  if (isPvScaleBlocked()) zoom = 1;
  const wrap = $('phoneWrap');
  wrap.style.setProperty('--zoom', zoom);
  wrap.style.left = (50 + panX) + '%';
  wrap.style.top = (40 + panY) + 'px';
  $('zoomLabel').textContent = Math.round(zoom * 100) + '%';
}
function setupStage() {
  const stage = $('stage');
  stage.addEventListener('wheel', e => {
    e.preventDefault();
    if (isPvScaleBlocked()) {
      /* 实时预览：滚轮 = 上下平移（手机 1300 高，舞台只有几百高，移下去才看得到底部 tab 栏） */
      panY = Math.max(-620, Math.min(60, panY - e.deltaY * 0.6));
      applyZoom();
      return;
    }
    zoom = Math.max(0.2, Math.min(3, zoom + (e.deltaY < 0 ? 0.08 : -0.08)));
    applyZoom();
  }, { passive: false });
  let dragging = false, sx = 0, sy = 0, ox = 0, oy = 0;
  stage.addEventListener('mousedown', e => {
    if (e.target.closest('[data-path],[data-open],[data-nav],[data-navtab],.phone')) return;
    dragging = true; sx = e.clientX; sy = e.clientY; ox = panX; oy = panY;
  });
  window.addEventListener('mousemove', e => {
    if (!dragging) return;
    panX = ox + (e.clientX - sx) / 4; panY = oy + (e.clientY - sy) / 4;
    applyZoom();
  });
  window.addEventListener('mouseup', () => { dragging = false; });
}

/* 群聊归一：把 type==='group' 的会话项补上 group 字段（= 群名，镜像 name），
   与 enhance/config.js 注入侧读取 it.group 对齐，保证群聊按群形态渲染。 */
function syncGroupFields() {
  (scene.home || []).forEach(it => {
    if (it && it.type === 'group') it.group = it.name || it.group || '';
  });
}

/* ---------- 实时画面 / 编辑模式调试（复用 /api/live 与 /api/editmode 接口） ---------- */
const KIND_META = {
  text:      { label: "文字内容", prop: "text", hint: "直接修改这段文字，切换页面不丢失。" },
  image:     { label: "图片路径", prop: "src", hint: "如 /images/avatar/2_20260831_184618_874.jpg" },
  bg:        { label: "背景图路径", prop: "bg", hint: "如 /images/avatar/IMG_0491_20260903_144508_035.png" },
  me_avatar: { label: "我的头像", prop: "me_avatar", hint: "全局同步：头像在所有位置一起变" },
  me_name:   { label: "我的昵称", prop: "me_name", hint: "全局同步：主页/通讯录/朋友圈一起变" },
  me_bg:     { label: "朋友圈封面", prop: "me_bg", hint: "全局同步：朋友圈封面一起变" },
};

function setRunningUI(running) {
  runActive = running;
  $('btnRun').disabled = running;
  $('btnStop').disabled = !running;
  $('btnRun').textContent = running ? '⏳ 运行中' : '▶ 生成并运行';
}

async function generateAndRun() {
  syncGroupFields();
  syncPeerMirror();
  try {
    const r1 = await api('/api/scene', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(scene) });
    if (!r1.ok) { toast(r1.msg || '保存场景失败'); return; }
    const r2 = await api('/api/scene/to-workflow', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(scene) });
    if (!r2.ok) { toast(r2.msg || '生成工作流失败'); return; }
    const r3 = await api('/api/run', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ headless: true, typing_speed: 30.0 }) });
    if (!r3.ok) { toast(r3.msg || '启动运行失败'); return; }
    toast('已开始运行并生成视频');
    openLivePanel();
    setRunningUI(true);
    startRunStatusPolling();
  } catch (err) { toast('启动运行失败：' + (err && err.message)); }
}

async function stopRun() {
  try {
    const r = await api('/api/stop', { method: 'POST' });
    toast(r.ok ? '已停止' : '停止失败');
  } catch (err) { toast('停止失败'); }
  setRunningUI(false);
  stopRunStatusPolling();
}

function startRunStatusPolling() {
  stopRunStatusPolling();
  runStatusTimer = setInterval(async () => {
    try {
      const s = await api('/api/status');
      if (!s.running && runActive) { setRunningUI(false); stopRunStatusPolling(); toast('运行已结束'); }
    } catch (err) { /* 服务重启时忽略 */ }
  }, 2000);
}
function stopRunStatusPolling() { clearInterval(runStatusTimer); runStatusTimer = null; }

function openLivePanel() {
  $('livePanel').hidden = false;
  if (editActive) {
    $('liveEmpty').innerHTML = '<div class="dot">📱</div>正在连接编辑模式画面…';
    $('liveModes').hidden = false;
    $('liveTypebar').hidden = false;
    $('liveTitle').textContent = '编辑模式 · 实时画面';
  } else {
    $('liveEmpty').innerHTML = '<div class="dot">📱</div>运行工作流后<br>这里会实时显示手机画面';
    $('liveTip').textContent = '点击「生成并运行」，画面随执行自动刷新；「✏️ 编辑模式」可点选元素修改。';
  }
  startLivePolling();
}
function closeLivePanel() {
  $('livePanel').hidden = true;
  stopLivePolling();
}

function startLivePolling() {
  stopLivePolling();
  liveHasFrame = false;
  $('liveDot').className = 'live-dot on';
  $('liveTitle').textContent = '实时手机画面 · LIVE';
  tickLiveFrame();
  /* 轮询放慢到 1s：主画面的「真机画面」已改为按需抓帧，这里只服务运行监控 */
  liveTimer = setInterval(tickLiveFrame, 1000);
}
function tickLiveFrame() {
  const img = $('liveImg');
  img.onload = () => { liveHasFrame = true; img.classList.remove('loading'); $('liveEmpty').style.display = 'none'; };
  img.onerror = () => { img.classList.remove('loading'); if (!liveHasFrame) $('liveEmpty').style.display = 'grid'; };
  if (!liveHasFrame) { img.classList.add('loading'); $('liveEmpty').style.display = 'grid'; }
  img.src = '/api/live?t=' + Date.now();
}
function stopLivePolling() { clearInterval(liveTimer); liveTimer = null; $('liveDot').className = 'live-dot'; $('liveTitle').textContent = '实时手机画面'; }

async function startEditMode() {
  if (editActive) { stopEditMode(); return; }
  try {
    const res = await api('/api/editmode/start', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) });
    if (!res.ok) { toast(res.msg || '编辑模式启动失败'); return; }
    editActive = true;
    $('btnEditMode').classList.add('primary');
    $('btnEditMode').textContent = '⏹ 退出编辑模式';
    openLivePanel();
    setPickMode(false);
    $('phoneScreen').classList.add('editable');
    $('liveTip').textContent = '点击画面即可操作手机；切到「✎ 编辑」后点选元素可修改文字/头像/背景。';
    startEditStatusPolling();
  } catch (err) { toast('编辑模式启动失败：' + (err && err.message)); }
}
async function stopEditMode() {
  try { await api('/api/editmode/stop', { method: 'POST' }); } catch (err) { /* 进程可能已退出 */ }
  finishEditMode();
}
function finishEditMode() {
  editActive = false; pickMode = false; hideEditPop();
  $('btnEditMode').classList.remove('primary');
  $('btnEditMode').textContent = '✏️ 编辑模式';
  $('liveModes').hidden = true;
  $('liveTypebar').hidden = true;
  $('phoneScreen').classList.remove('editable');
  $('liveTitle').textContent = '实时手机画面';
  $('liveTip').textContent = '编辑模式已退出。';
  stopEditStatusPolling();
}
function setPickMode(on) {
  pickMode = on;
  $('modeTap').classList.toggle('active', !on);
  $('modePick').classList.toggle('active', on);
  $('liveTip').textContent = on
    ? '「✎ 编辑」模式：点击画面中的元素会弹出修改框，改完点保存即时上屏。'
    : '「👆 操作」模式：点击画面 = 点击手机屏幕（可进入聊天、切换页面）。';
}
function startEditStatusPolling() {
  stopEditStatusPolling();
  editStatusTimer = setInterval(async () => {
    try {
      const s = await api('/api/editstatus');
      if (!s.running && editActive) { toast('编辑模式进程已退出'); finishEditMode(); }
    } catch (err) { /* 服务重启时忽略 */ }
  }, 2000);
}
function stopEditStatusPolling() { clearInterval(editStatusTimer); editStatusTimer = null; }

function viewportFromEvent(event) {
  const rect = $('liveImg').getBoundingClientRect();
  const x = (event.clientX - rect.left) / rect.width * 600;
  const y = (event.clientY - rect.top) / rect.height * 1300;
  return { x: Math.max(0, Math.min(600, x)), y: Math.max(0, Math.min(1300, y)) };
}
async function onScreenClick(event) {
  if (event.target.closest('.edit-pop')) return;
  if (!editActive) { toast('请先点击顶部「✏️ 编辑模式」启用画面操作'); return; }
  const { x, y } = viewportFromEvent(event);
  if (pickMode) {
    try {
      const res = await api('/api/live/pick?x=' + x.toFixed(1) + '&y=' + y.toFixed(1));
      if (!res.ok) { toast(res.msg || '该位置不可编辑'); return; }
      showEditPop(res, x, y);
    } catch (err) { toast('拾取元素失败：' + (err && err.message)); }
  } else {
    try {
      const res = await api('/api/live/tap', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ x: Math.round(x), y: Math.round(y) }) });
      if (!res.ok) toast(res.msg || '点击未生效');
    } catch (err) { toast('点击失败：' + (err && err.message)); }
  }
}
function showEditPop(info, x, y) {
  editInfo = info;
  const meta = KIND_META[info.kind] || KIND_META.text;
  const value = (info.kind === 'text' || info.kind === 'me_name') ? (info.text || '') : (info.src || '');
  const pop = $('editPop');
  pop.innerHTML =
    '<div class="ep-kind">' + esc(meta.label) + '</div>' +
    '<input id="epValue" value="' + esc(value) + '" placeholder="' + esc(meta.label) + '">' +
    '<div class="ep-actions"><button type="button" class="ep-cancel" id="epCancel">取消</button>' +
    '<button type="button" class="ep-save" id="epSave">保存</button></div>' +
    '<div class="ep-hint">' + esc(meta.hint || '') + '</div>';
  pop.hidden = false;
  const ph = $('phoneScreen').getBoundingClientRect();
  let left = x / 600 * ph.width, top = y / 1300 * ph.height;
  const pw = pop.offsetWidth || 232, phh = pop.offsetHeight || 130;
  if (left + pw > ph.width) left = ph.width - pw - 4;
  if (left < 4) left = 4;
  if (top + phh > ph.height) top = top - phh - 8;
  if (top < 4) top = 4;
  pop.style.left = Math.round(left) + 'px';
  pop.style.top = Math.round(top) + 'px';
  const input = $('epValue'); input.focus(); input.select();
  $('epSave').onclick = saveEdit;
  $('epCancel').onclick = hideEditPop;
}
async function saveEdit() {
  if (!editInfo) return;
  const meta = KIND_META[editInfo.kind] || KIND_META.text;
  const value = $('epValue').value.trim();
  try {
    const res = await api('/api/live/edit', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: editInfo.id, prop: meta.prop, value }) });
    if (res.ok) { toast('已修改' + meta.label + '：' + (value || '（已清空）')); hideEditPop(); }
    else toast('修改失败：' + (res.msg || '未知错误'));
  } catch (err) { toast('修改失败：' + (err && err.message)); }
}
function hideEditPop() { $('editPop').hidden = true; editInfo = null; }
async function doType() {
  const input = $('liveTypeInput'), text = input.value;
  if (!text) return;
  try {
    const res = await api('/api/live/type', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text }) });
    if (res.ok) input.value = ''; else toast(res.msg || '输入失败');
  } catch (err) { toast('输入失败：' + (err && err.message)); }
}

/* ---------- 真机画面：主舞台 = 真实渲染（与成片同一套 UI，可点击操作） ----------
   性能约定：**不常驻轮询**。只在「连接成功 / 场景真的变了 / 每次操作后」抓帧，
   操作后额外补几帧等动画走完；空闲时完全不发请求。 */
let stageView = 'pv';          // pv = 实时预览（真实界面） / live = 真机运行 / draft = 静态示意稿
let pvReady = false;           // 实时预览是否已就绪
let pvBooted = false;          // 是否已挂载过预览 iframe
let pvStarting = false;        // 预览渲染器是否正在启动
let _pvPushTimer = null;       // 场景 → 预览 的推送防抖
let _lastPvSceneJSON = '';     // 上次已应用的场景快照（没变就不推）
let _pvRetryTimer = null;      // 套场景失败后的重试定时器（有限次）
let _pvRetryLeft = 0;          // 剩余重试次数
let _pvNavKey = '';            // 上次同步过的导航状态（避免重复跳转）
let liveUp = false;            // 真机画面是否已连上
let livePicking = false;       // 点选模式（点画面 = 拾取元素改属性）
let stageEditInfo = null;
let _livePushTimer = null;     // 场景推送防抖
let _liveBurstTimer = null, _liveBurstLeft = 0;
let _lastLiveSceneJSON = '';   // 上次已推给真机的场景快照（没变就不推）
let _wheelAcc = 0, _wheelFlush = null;

function probeLive() {
  return new Promise(resolve => {
    const im = new Image();
    let done = false;
    const fin = v => { if (!done) { done = true; resolve(v); } };
    im.onload = () => fin(true);
    im.onerror = () => fin(false);
    setTimeout(() => fin(false), 4000);
    im.src = '/api/live?probe=' + Date.now();
  });
}

function applyLiveState() {
  const v = stageView;
  const pv = (v === 'pv'), on = (v === 'live');
  $('phoneInner').style.visibility = (v === 'draft') ? '' : 'hidden';
  $('stagePv').hidden = !pv;
  $('stagePvEmpty').hidden = !pv || pvReady;
  $('stageLiveImg').hidden = !on || !liveUp;
  $('stageLiveBadge').hidden = !on || !liveUp;
  $('stageLiveEmpty').hidden = !on || liveUp;
  const bar = $('stageLiveBar');
  bar.classList.remove('pv', 'live', 'draft');
  bar.classList.add(v);
  const b = $('stageLiveBadge');
  b.innerHTML = '<i></i>' + (liveUp ? '真机 LIVE' : '真机 未连接');
  b.classList.toggle('off', !liveUp);
  const st = $('stageLiveState');
  if (pv) st.textContent = pvReady ? '实时预览 · 与成片同一套界面'
    : (pvStarting ? '预览渲染器启动中…' : '实时预览未就绪');
  else if (on) st.textContent = liveUp ? '真机已连接 · 600×1300' : '真机未连接';
  else st.textContent = '静态示意稿（离线备用）';
  st.classList.toggle('ok', pv ? pvReady : (on && liveUp));
  const pb = $('btnStagePvStart');
  if (pb) { pb.disabled = !!pvStarting; pb.textContent = pvStarting ? '正在启动预览渲染器…' : '▶ 启动预览渲染器'; }
}

function setStageView(v) {
  stageView = (v === 'pv') ? 'pv' : ((v === 'draft') ? 'draft' : 'live');
  $('btnViewPv').classList.toggle('active', stageView === 'pv');
  $('btnViewLive').classList.toggle('active', stageView === 'live');
  $('btnViewDraft').classList.toggle('active', stageView === 'draft');
  applyLiveState();
  if (stageView === 'live' && liveUp) refreshStageLive(false);
  if (stageView === 'pv') {
    if (!pvBooted) stagePvBoot();
    else { pushSceneToPv(true); pvSyncNav(true); }
  }
}

function tickStageLive() {
  const img = $('stageLiveImg');
  if (!img) return;
  img.onload = () => {
    img.classList.remove('loading');
    if (!liveUp) { liveUp = true; applyLiveState(); pushSceneToLive(true); }
  };
  img.onerror = () => {
    img.classList.remove('loading');
    if (liveUp) { liveUp = false; applyLiveState(); }
  };
  if (!liveUp) img.classList.add('loading');
  img.src = '/api/live?t=' + Date.now();
}

/* 抓帧：burst=true 时补 5 帧（每 260ms），等真机页面的过渡动画走完 */
function refreshStageLive(burst) {
  if (stageView !== 'live') return;
  tickStageLive();
  if (!burst) return;
  _liveBurstLeft = 5;
  if (!_liveBurstTimer) _liveBurstTimer = setTimeout(stepLiveBurst, 260);
}
function stepLiveBurst() {
  _liveBurstTimer = null;
  if (_liveBurstLeft <= 0) return;
  _liveBurstLeft -= 1;
  if (stageView === 'live') tickStageLive();
  if (_liveBurstLeft > 0) _liveBurstTimer = setTimeout(stepLiveBurst, 260);
}

async function stageLiveBoot() {
  liveUp = await probeLive();
  applyLiveState();
  if (liveUp) { refreshStageLive(false); pushSceneToLive(true); }
}

async function stageLiveConnect() {
  const btn = $('btnStageLiveConnect'), err = $('stageLiveErr');
  if (btn) { btn.disabled = true; btn.textContent = '正在启动真机画面…（首次约 10 秒）'; }
  if (err) { err.hidden = true; }
  try {
    const r = await api('/api/editmode/start', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) });
    if (!r.ok) throw new Error(r.msg || '启动失败');
    toast('真机画面正在启动…');
    let waited = 0;
    const wait = setInterval(async () => {
      waited += 1;
      const ok = await probeLive();
      if (ok) {
        clearInterval(wait);
        liveUp = true; applyLiveState();
        _lastLiveSceneJSON = '';
        if (btn) { btn.disabled = false; btn.textContent = '▶ 连接真机画面'; }
        pushSceneToLive(true);        // 推送成功后会补帧，这里不再重复刷
        toast('真机画面已连接，可以直接点击操作');
      } else if (waited >= 25) {
        clearInterval(wait);
        if (btn) { btn.disabled = false; btn.textContent = '▶ 重试连接'; }
        if (err) { err.hidden = false; err.textContent = '启动超时。请确认前端服务（8080 端口）在运行，稍后重试。'; }
      }
    }, 800);
  } catch (e) {
    if (btn) { btn.disabled = false; btn.textContent = '▶ 连接真机画面'; }
    if (err) { err.hidden = false; err.textContent = (e && e.message) || '启动失败'; }
  }
}

/* 屏幕坐标 → 真机视口坐标（真机画面固定 600×1300，与 .phone 同尺寸，1:1 映射） */
function stageXY(event) {
  const rect = $('stageLiveImg').getBoundingClientRect();
  const x = (event.clientX - rect.left) / rect.width * 600;
  const y = (event.clientY - rect.top) / rect.height * 1300;
  return { x: Math.max(0, Math.min(599, x)), y: Math.max(0, Math.min(1299, y)) };
}

async function onStageLiveClick(event) {
  if (event.target.closest('#stageEditPop')) return;
  if (!liveUp) { toast('真机画面未连接，点画面中间的「连接真机画面」'); return; }
  const p = stageXY(event);
  if (livePicking) {
    try {
      const res = await api('/api/live/pick?x=' + p.x.toFixed(1) + '&y=' + p.y.toFixed(1));
      if (!res.ok) { toast(res.msg || '该位置没有可改的元素'); return; }
      showStageEditPop(res, p.x, p.y);
    } catch (e) { toast('拾取元素失败'); }
    return;
  }
  try {
    const res = await api('/api/live/tap', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ x: Math.round(p.x), y: Math.round(p.y) }) });
    if (res.ok) refreshStageLive(true); else toast(res.msg || '点击未生效');
  } catch (e) { toast('点击失败'); }
}

function onStageLiveWheel(event) {
  if (stageView !== 'live' || !liveUp) return;      // 真机没连上：交给舞台缩放
  if (event.ctrlKey || event.shiftKey) return;      // Ctrl / Shift + 滚轮 = 缩放画布
  event.preventDefault();
  event.stopPropagation();                          // 别让舞台的滚轮缩放也处理一次
  const p = stageXY(event);
  _wheelAcc += event.deltaY;
  if (_wheelFlush) return;
  _wheelFlush = setTimeout(() => {
    _wheelFlush = null;
    const dy = Math.round(_wheelAcc);
    _wheelAcc = 0;
    if (!dy) return;
    api('/api/live/scroll', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ x: Math.round(p.x), y: Math.round(p.y), dy: dy, dx: 0 }) })
      .then(() => refreshStageLive(false)).catch(() => {});
  }, 110);
}

function showStageEditPop(info, x, y) {
  stageEditInfo = info;
  const meta = KIND_META[info.kind] || KIND_META.text;
  const value = (info.kind === 'text' || info.kind === 'me_name') ? (info.text || '') : (info.src || '');
  const pop = $('stageEditPop');
  pop.innerHTML =
    '<div class="ep-kind">' + esc(meta.label) + '</div>' +
    '<input id="sepValue" value="' + esc(value) + '" placeholder="' + esc(meta.label) + '">' +
    '<div class="ep-actions"><button type="button" class="ep-cancel" id="sepCancel">取消</button>' +
    '<button type="button" class="ep-save" id="sepSave">保存</button></div>' +
    '<div class="ep-hint">' + esc(meta.hint || '') + '</div>';
  pop.hidden = false;
  let left = x, top = y + 8;
  const pw = pop.offsetWidth || 236, phh = pop.offsetHeight || 132;
  if (left + pw > 594) left = 594 - pw;
  if (left < 6) left = 6;
  if (top + phh > 1294) top = y - phh - 8;
  if (top < 6) top = 6;
  pop.style.left = Math.round(left) + 'px';
  pop.style.top = Math.round(top) + 'px';
  const input = $('sepValue'); input.focus(); input.select();
  $('sepSave').onclick = saveStageEdit;
  $('sepCancel').onclick = () => { pop.hidden = true; stageEditInfo = null; };
}

async function saveStageEdit() {
  if (!stageEditInfo) return;
  const meta = KIND_META[stageEditInfo.kind] || KIND_META.text;
  const value = $('sepValue').value.trim();
  try {
    const res = await api('/api/live/edit', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: stageEditInfo.id, prop: meta.prop, value: value }) });
    if (res.ok) { toast('已修改' + meta.label + '：' + (value || '（已清空）')); $('stageEditPop').hidden = true; stageEditInfo = null; refreshStageLive(true); }
    else toast('修改失败：' + (res.msg || '未知错误'));
  } catch (e) { toast('修改失败'); }
}

async function stageLiveBack() {
  if (!liveUp) { toast('真机画面未连接'); return; }
  try {
    const res = await api('/api/live/back', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) });
    if (res.ok) refreshStageLive(true); else toast(res.msg || '返回失败');
  } catch (e) { toast('返回失败'); }
}

async function stageTypeSend() {
  const input = $('stageTypeInput'), text = input.value;
  if (!text) return;
  if (!liveUp) { toast('真机画面未连接'); return; }
  try {
    const res = await api('/api/live/type', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text: text }) });
    if (res.ok) { input.value = ''; refreshStageLive(true); }
    else { toast(res.msg || '输入失败：先在真机上点一下输入框'); }
  } catch (e) { toast('输入失败'); }
}

/* 把当前编辑的场景推给真机。挂在 renderPhone 末尾 + 900ms 防抖，
   并且**序列化比对**：内容没变就一个请求都不发。
   于是「右边面板改一个字，左边真机画面跟着变」，但不会打字就卡。 */
function pushSceneToLive(immediate) {
  pushSceneToPv(immediate);          // 预览永远跟着场景走（哪怕当前没显示）
  if (!liveUp) return;
  if (_livePushTimer) { clearTimeout(_livePushTimer); _livePushTimer = null; }
  const send = () => {
    _livePushTimer = null;
    let snap = '';
    try { snap = JSON.stringify(scene); } catch (e) { return; }
    if (snap === _lastLiveSceneJSON) return;      // 场景没变：不推、不刷，零开销
    _lastLiveSceneJSON = snap;
    api('/api/live/scene', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ scene: scene }) })
      .then(r => { if (r && r.ok) refreshStageLive(true); })
      .catch(() => { _lastLiveSceneJSON = ''; });
  };
  if (immediate) send(); else _livePushTimer = setTimeout(send, 900);
}

/* ---------- 实时预览：同源嵌入真实前端（与成片同一套 UI，逐像素同源） ----------
   性能约定：不常驻轮询、不启动额外进程。只在「iframe 就绪 / 场景真的变了 /
   右侧选中项变化」时做事；空闲期零请求（实测静置 6 秒 0 请求）。 */
function pvEl() { return $('stagePv'); }
function pvWin() {
  const f = pvEl();
  try { return f ? f.contentWindow : null; } catch (e) { return null; }
}

function mountPv() {
  const f = pvEl();
  if (!f) return;
  pvReady = false;
  applyLiveState();
  try { f.src = '/wxpv/#/'; } catch (e) { /* 忽略 */ }
  let waited = 0;
  const t = setInterval(() => {
    waited += 350;
    const w = pvWin();
    if (w && w.__wxConfig && !_lastPvSceneJSON) {
      /* 尽早把场景套上，避免先闪一下默认参考数据 */
      try {
        const snap = JSON.stringify(scene);
        if (pvApplyScene(snap) && pvSceneLooksRight(snap)) _lastPvSceneJSON = snap;
      } catch (e) { /* 忽略 */ }
    }
    if (w && w.__wxEmbedReady) {
      clearInterval(t);
      pvReady = true;
      _lastPvSceneJSON = '';
      _pvRetryLeft = 0;
      _pvNavKey = '';
      applyLiveState();
      pushSceneToPv(true);
      pvSyncNav(true);
      return;
    }
    if (waited >= 25000) { clearInterval(t); pvReady = false; applyLiveState(); }
  }, 350);
}

async function stagePvBoot() {
  pvBooted = true;
  if (pvReady) return;
  let up = false, conflict = false;
  try {
    const r = await api('/api/wxapp/status');
    up = !!(r && r.up); conflict = !!(r && r.conflict);
  } catch (e) { up = false; }
  if (!up) {
    applyLiveState();   // 渲染器没在跑：显示「启动预览渲染器」按钮
    // 8080 被其他程序占用：预览永远起不来，必须明确说原因，不能让用户对着空白猜
    const err = $('stagePvErr');
    if (conflict && err) {
      err.hidden = false;
      err.textContent = '端口 8080 被其他程序占用，预览无法启动。请关闭占用 8080 的程序后重试。';
    }
    return;
  }
  mountPv();
}

async function stagePvStart() {
  if (pvStarting) return;
  pvStarting = true;
  const err = $('stagePvErr');
  if (err) err.hidden = true;
  applyLiveState();
  try {
    const r = await api('/api/wxapp/start', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
    if (!r || !r.ok) throw new Error((r && r.msg) || '启动失败');
    toast('预览渲染器正在启动…（首次编译约 20~60 秒）');
    let waited = 0;
    const t = setInterval(async () => {
      waited += 1;
      let up = false;
      try { const s = await api('/api/wxapp/status'); up = !!(s && s.up); } catch (e) { up = false; }
      if (up) { clearInterval(t); pvStarting = false; mountPv(); toast('预览渲染器已启动'); }
      else if (waited >= 90) {
        clearInterval(t); pvStarting = false; applyLiveState();
        if (err) { err.hidden = false; err.textContent = '启动超时。详情见 vue-WeChat/dev-server.log'; }
      }
    }, 1000);
  } catch (e) {
    pvStarting = false; applyLiveState();
    if (err) { err.hidden = false; err.textContent = (e && e.message) || '启动失败'; }
  }
}

function pvApplyScene(snap) {
  const w = pvWin();
  if (!w || !w.__wxConfig) return false;
  try { w.__wxConfig.apply(); w.__wxConfig.applyScene(JSON.parse(snap)); return true; }
  catch (e) { return false; }
}

/* 校验预览里真的是这份场景（首几行名字对得上）。
   只有「真套上了」才算成功 —— 否则前端在路由切换期会把它覆盖回去。 */
function pvSceneLooksRight(snap) {
  const w = pvWin();
  if (!w) return false;
  let want = [];
  try { want = (JSON.parse(snap).home || []).slice(0, 3).map(it => it.name || '').filter(Boolean); }
  catch (e) { return false; }
  if (!want.length) return true;
  try {
    const names = [...w.document.querySelectorAll('.wechat-list li.list-row .desc-author')]
      .map(e => e.textContent.trim());
    if (!names.length) return false;
    const hit = want.filter(n => names.indexOf(n) >= 0).length;
    return hit >= Math.min(2, want.length);
  } catch (e) { return false; }
}

function pushSceneToPv(immediate, isRetry) {
  if (!pvReady) return;
  if (_pvPushTimer) { clearTimeout(_pvPushTimer); _pvPushTimer = null; }
  if (!isRetry) _pvRetryLeft = 8;               // 新一轮同步：重置重试额度
  const send = () => {
    _pvPushTimer = null;
    if (!pvReady) return;
    let snap = '';
    try { snap = JSON.stringify(scene); } catch (e) { return; }
    if (snap === _lastPvSceneJSON) return;        // 场景没变：不发请求、不重渲染
    if (pvApplyScene(snap) && pvSceneLooksRight(snap)) {
      _lastPvSceneJSON = snap;
      _pvRetryLeft = 0;
      return;
    }
    /* 没套上（被前端重渲染覆盖）：有限次重试后放弃，绝不退化成轮询 */
    _lastPvSceneJSON = '';
    if (_pvRetryLeft > 0) {
      _pvRetryLeft--;
      if (!_pvRetryTimer) {
        _pvRetryTimer = setTimeout(() => {
          _pvRetryTimer = null;
          if (pvReady) pushSceneToPv(true, true);
        }, 900);
      }
    }
  };
  if (immediate) send(); else _pvPushTimer = setTimeout(send, 700);
}

/* 右侧面板选中项 / 相机工具条 → 驱动左边真实界面导航（和真人点一样） */
function pvSyncNav(force) {
  if (!pvReady) return;
  const w = pvWin();
  if (!w) return;
  const key = camView + '|' + (selIdx == null ? '' : selIdx);
  if (!force && key === _pvNavKey) return;
  _pvNavKey = key;
  try {
    const hash = String(w.location.hash || '#/');
    const inChat = hash.indexOf('/wechat/dialogue') >= 0;
    const inSub = hash.indexOf('/contact') >= 0 || hash.indexOf('/explore') >= 0;
    if (camView === 'moments') {
      if (hash.indexOf('/explore/moments') < 0) w.location.hash = '#/explore/moments';
      return;
    }
    if (camView === 'peer' || camView === 'peer-moments') {
      if (w.__wxPeer && w.__wxPeer.openProfile) {
        const st = (w.__wxPeer.isOpen && w.__wxPeer.isOpen()) || {};
        if (!st.profile) w.__wxPeer.openProfile();
        if (camView === 'peer-moments' && !st.moments) {
          setTimeout(() => { try { w.__wxPeer.openMoments(); } catch (e) { /* 忽略 */ } }, 420);
        }
      }
      if (inSub || inChat) w.location.hash = '#/';
      return;
    }
    if (inSub) {
      w.location.hash = '#/';
      if (selIdx != null) setTimeout(() => pvOpenRow(selIdx), 420);
      return;
    }
    if (selIdx == null) { if (inChat) w.location.hash = '#/'; return; }
    if (inChat) { w.location.hash = '#/'; setTimeout(() => pvOpenRow(selIdx), 420); }
    else pvOpenRow(selIdx);
  } catch (e) { /* 忽略：导航失败不影响编辑 */ }
}

function pvOpenRow(i) {
  const w = pvWin();
  if (!w || !pvReady) return;
  try {
    const rows = w.document.querySelectorAll('.wechat-list li.list-row');
    if (rows[i]) rows[i].click();
  } catch (e) { /* 忽略 */ }
}

function bindStageLive() {
  $('btnViewPv').onclick = () => setStageView('pv');
  $('btnViewLive').onclick = () => setStageView('live');
  $('btnViewDraft').onclick = () => setStageView('draft');
  $('btnStagePvStart').onclick = stagePvStart;
  $('btnStageLiveConnect').onclick = stageLiveConnect;
  $('btnStageBack').onclick = stageLiveBack;
  $('btnStageSend').onclick = stageTypeSend;
  $('stageTypeInput').addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); stageTypeSend(); } });
  $('btnStagePick').onclick = () => {
    livePicking = !livePicking;
    $('btnStagePick').classList.toggle('on', livePicking);
    $('stageLiveImg').classList.toggle('picking', livePicking);
    toast(livePicking ? '点选模式：点画面上的文字 / 头像 / 背景即可改' : '已切回操作模式：点画面 = 点手机');
  };
  $('stageLiveImg').addEventListener('click', onStageLiveClick);
  $('stageLiveImg').addEventListener('wheel', onStageLiveWheel, { passive: false });
}

function bindDebug() {
  $('btnRun').onclick = () => generateAndRun();
  $('btnStop').onclick = stopRun;
  $('btnEditMode').onclick = () => { if (editActive) stopEditMode(); else startEditMode(); };
  $('btnLive').onclick = () => { const p = $('livePanel'); if (p.hidden) openLivePanel(); else closeLivePanel(); };
  $('btnLiveClose').onclick = () => closeLivePanel();
  $('modeTap').onclick = () => setPickMode(false);
  $('modePick').onclick = () => setPickMode(true);
  $('liveImg').addEventListener('click', onScreenClick);
  bindStageLive();
  $('btnType').onclick = doType;
  $('liveTypeInput').addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); doType(); } });
}

/* ---------- 顶部动作 ---------- */
function bindTopbar() {
  $('btnZoomIn').onclick = () => { if (isPvScaleBlocked()) { warnPvNoZoom(); return; }
    zoom = Math.min(3, zoom + 0.1); applyZoom(); };
  $('btnZoomOut').onclick = () => { if (isPvScaleBlocked()) { warnPvNoZoom(); return; }
    zoom = Math.max(0.2, zoom - 0.1); applyZoom(); };
  $('btnZoomFit').onclick = () => { zoom = 1; panX = 0; panY = 0; applyZoom(); };
  $('btnCamList').onclick = () => { camView = 'list'; selIdx = null; renderPhone(); renderPanel(); };
  $('btnCamMoments').onclick = () => { camView = 'moments'; renderPhone(); renderPanel(); };
  $('btnCamPeer').onclick = () => { camView = 'peer'; renderPhone(); setPanelTab('peer'); };
  $('btnCamPeerMoments').onclick = () => { camView = 'peer-moments'; renderPhone(); setPanelTab('peer'); };
  $('btnCheckImgs').onclick = checkImages;
  $('btnLib').onclick = openLib;
  $('btnScriptImport').onclick = openScriptImport;
  $('btnManual').onclick = openManual;
  $('btnPeopleSync').onclick = async () => {
    // 收集当前会话列表里已填头像的人 -> 存进人物库
    const people = (scene.home || []).filter(it => it && it.name && it.avatar)
      .map(it => ({ name: it.name, avatar: it.avatar }));
    if (!people.length) { toast('当前会话还没有填头像的联系人，先在「会话」或手机上给联系人选头像'); return; }
    const r = await api('/api/people/sync', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ people }) });
    toast(r.ok ? ('已保存 ' + people.length + ' 人到人物库，脚本里写这些名字会自动带头像') : (r.msg || '保存失败'));
  };
  $('btnPeopleLib').onclick = () => openPeopleLib(false);
  $('btnLoad').onclick = async () => { scene = await api('/api/scene'); syncGroupFields(); migratePeer(); renderPhone(); renderPanel(); toast('已载入场景'); };
  $('btnSave').onclick = async () => {
    syncGroupFields();
    syncPeerMirror();
    const r = await api('/api/scene', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(scene) });
    toast(r.ok ? '场景已保存' : (r.msg || '保存失败'));
  };
  $('btnToWorkflow').onclick = async () => {
    syncGroupFields();
    syncPeerMirror();
    const r = await api('/api/scene/to-workflow', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(scene) });
    toast(r.ok ? (r.msg || '已生成工作流') : '生成失败');
  };
  $('btnVideos').onclick = () => api('/api/openvideos');
  document.querySelectorAll('.panel-tabs button').forEach(b => {
    b.onclick = () => { panelTab = b.getAttribute('data-tab'); document.querySelectorAll('.panel-tabs button').forEach(x => x.classList.toggle('active', x === b)); renderPanel(); };
  });
}

async function init() {
  scene = await api('/api/scene');
  if (!scene.me) scene.me = {};
  if (!scene.home) scene.home = [];
  if (!scene.moments) scene.moments = [];
  if (!scene.peer || typeof scene.peer !== 'object') scene.peer = {};
  if (scene.peerNav == null) scene.peerNav = false;
  migratePeer();
  try {
    const lc = await api('/api/llm/config');
    llmConfigured = !!(lc && lc.configured);
  } catch (e) { llmConfigured = false; }
  try {
    const lib = await api('/api/peer-presets');
    peerPresets = (lib && lib.presets) || {};
  } catch (e) { peerPresets = {}; }
  syncGroupFields();
  gallery = (await api('/api/gallery')).images || [];
  try {
    const sv = await api('/api/source-videos');
    sourceVideos = (sv && sv.videos) || [];
  } catch (e) { sourceVideos = []; }
  renderPhone(); renderPanel(); applyZoom();
  bindPhoneEvents(); bindTopbar(); bindDebug(); setupStage();
  stageLiveBoot();
  stagePvBoot();      // 默认视图：实时预览（真实界面）
  setRunningUI(false);
}
init();
</script>

<script>
/* UI v2: 顶栏下拉菜单（纯展示层，不改动任何既有功能绑定） */
(function () {
  "use strict";
  var wraps = document.querySelectorAll(".menu-wrap");
  wraps.forEach(function (w) {
    var btn = w.querySelector(".menu-btn");
    if (!btn) return;
    btn.addEventListener("click", function (e) {
      e.stopPropagation();
      var wasOpen = w.classList.contains("open");
      wraps.forEach(function (o) { o.classList.remove("open"); });
      if (!wasOpen) w.classList.add("open");
    });
    w.querySelectorAll(".menu-item").forEach(function (it) {
      it.addEventListener("click", function () { w.classList.remove("open"); });
    });
  });
  document.addEventListener("click", function () {
    wraps.forEach(function (o) { o.classList.remove("open"); });
  });
})();
</script>

<script>
/* UI v2: 场景编辑器镜头切换激活态（纯视觉反馈） */
(function () {
  "use strict";
  var ids = ["btnCamList", "btnCamMoments", "btnCamPeer", "btnCamPeerMoments"];
  ids.forEach(function (id) {
    var b = document.getElementById(id);
    if (!b) return;
    b.addEventListener("click", function () {
      ids.forEach(function (o) {
        var x = document.getElementById(o);
        if (x) x.classList.remove("active");
      });
      b.classList.add("active");
    });
  });
  var first = document.getElementById("btnCamList");
  if (first) first.classList.add("active");
})();
</script>
<script src="/shared_picker.js"></script>
<script>
/* 图片库与选图器共用同一份分类数据：分类被改名/新增后，把本页的图片库一并刷新 */
(function () {
  if (!window.__wxPick) return;
  window.__wxPick.onCategoriesChanged = function () {
    if (typeof refreshLibData !== 'function') return;
    refreshLibData().then(function () {
      renderLibCats();
      renderLibUpcat();
      renderLibGrid();
    }).catch(function () { /* 静默 */ });
  };
})();
</script>
<style id="qtTipsStyle">
/* 悬停问号提示 */
.qt-host { position: relative; }
.qt-badge {
  position: absolute; top: 1px; right: 2px; width: 11px; height: 11px;
  border-radius: 50%; background: #0aac5f; color: #fff;
  font-size: 8px; line-height: 11px; text-align: center; font-style: normal;
  font-weight: 700; pointer-events: none; opacity: .85;
}
.qt-pop {
  position: fixed; z-index: 99999; max-width: 300px;
  background: #23272e; color: #e8eaee; font-size: 12px; line-height: 1.75;
  padding: 7px 11px; border-radius: 8px;
  box-shadow: 0 8px 24px rgba(0,0,0,.3);
  pointer-events: none; opacity: 0; transition: opacity .12s ease;
}
.qt-pop.show { opacity: 1; }
</style>
<script id="qtTipsJs">
(function () {
  var VOID_TAGS = { INPUT: 1, SELECT: 1, TEXTAREA: 1, IMG: 1, BR: 1 };
  var DYN_IDS = [];
  function ensureBadge(el) {
    if (VOID_TAGS[el.tagName]) return;
    if (!el.querySelector(':scope > .qt-badge')) {
      var b = document.createElement('i');
      b.className = 'qt-badge'; b.textContent = '?';
      el.appendChild(b);
    }
  }
  function decorate(el) {
    if (!el || !el.classList) return;
    el.classList.add('qt-host');
    ensureBadge(el);
  }
  function adoptTitles() {
    DYN_IDS.forEach(function (id) {
      var el = document.getElementById(id);
      if (el && el.hasAttribute('title') && !el.hasAttribute('data-tip')) {
        el.setAttribute('data-tip', el.getAttribute('title'));
        el.removeAttribute('title');
      }
    });
  }
  function scan() {
    adoptTitles();
    document.querySelectorAll('[data-tip]').forEach(decorate);
  }
  scan();
  var moT = null;
  new MutationObserver(function () {
    clearTimeout(moT); moT = setTimeout(scan, 80);
  }).observe(document.body, { childList: true, subtree: true });
  var pop = null, cur = null;
  function ensure() {
    if (!pop) { pop = document.createElement('div'); pop.className = 'qt-pop'; document.body.appendChild(pop); }
    return pop;
  }
  function place(host) {
    var tip = host.getAttribute('data-tip'); if (!tip) return false;
    var p = ensure(); p.textContent = tip;
    var r = host.getBoundingClientRect();
    var pw = p.offsetWidth, ph = p.offsetHeight;
    var x = Math.min(Math.max(8, r.left + r.width / 2 - pw / 2), window.innerWidth - pw - 8);
    var y = r.bottom + 7;
    if (y + ph > window.innerHeight - 8) y = r.top - ph - 7;
    p.style.left = x + 'px'; p.style.top = Math.max(8, y) + 'px';
    return true;
  }
  function show(host) { if (place(host)) { ensure().classList.add('show'); cur = host; } }
  function hide() { if (pop) pop.classList.remove('show'); cur = null; }
  document.addEventListener('mouseover', function (e) {
    var h = e.target && e.target.closest ? e.target.closest('[data-tip]') : null;
    if (h !== cur) { h ? show(h) : hide(); }
  });
  document.addEventListener('click', hide);
  window.addEventListener('scroll', function () {
    if (cur && document.contains(cur) && cur.getBoundingClientRect().height > 0) place(cur);
    else hide();
  }, true);
  window.addEventListener('resize', hide);
})();
</script>

</body>
</html>
