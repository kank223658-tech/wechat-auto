</div>
<div class="toast" id="toast" data-page-node-id="6QOtRQH2rlhhcwK56hYwfE"></div>

<script>
"use strict";
let scene = { me: {}, home: [], moments: [], peer: null, peerNav: false };
let sourceVideos = [];      // public/videos 下已上传的源视频（朋友圈视频动态可引用）
let peerPresets = {};        // /api/peer-presets 读到的女性人设预设库
let peerPresetSel = '';      // 面板里当前选中的预设名
let peerSel = 0;             // 当前编辑的人物下标（scene.peers[peerSel]）
let llmConfigured = false;   // DeepSeek Key 是否已配置（决定 AI 文案入口是否显示）
let peerTplSel = 'daily';    // 模板一键生成：当前选中的模板 key
let gallery = [];
let panelTab = 'conversations';
let camView = 'list';       // list | moments | peer | peer-moments | contacts | self
let selIdx = null;           // 当前会话选中项（home 下标）
let zoom = 1, panX = 0, panY = 0;
let pickerPath = null, pickerSel = null, pickerQuery = '';
let pickerCat = '';   // 内嵌选图弹窗的当前分类（''=全部）
let pickerOnCommit = null; // 非空时，图片选择确认/双击改为调用它（供人物库选头像复用）
let pendingSlots = [];           // 剧本导入识别出的图片槽位（含已配图路径）
let libFiles = [], libFolders = [], libSel = null, libQuery = '', libFolder = '', libRenameMode = false;
let libCategories = [];   // 分类清单（后端下发 [{key,label,folders,canUpload}]，可自定义）
let libCat = '';          // 当前筛选分类（''=全部，'video'=视频素材）
let libVideos = [];       // 视频素材 [{path,name}]
let libSelSet = new Set(), libBatchMode = false, libUploading = false;
let libSort = 'new';      // 排序：new=最新在前 old=最早在前 name=按名称 size=按体积
let libDragPaths = [];    // 正在从网格拖动的图片路径（拖到分类按钮上＝搬过去）

/* 分类张数（''=全部 / 'video'=视频）。前端现算，永远跟网格一致 */
function libCatCount(key) {
  if (key === '') return libFiles.length;
  if (key === 'video') return libVideos.length;
  return libFiles.filter(f => f.category === key).length;
}
/* 恢复上次所在的分类：没记录过就默认「配图素材」（那类没图退回全部） */
function libRestoreCat() {
  let v = null;
  try { v = localStorage.getItem('wx-lib-cat'); } catch (e) { /* 忽略 */ }
  const fallback = libCatCount('asset') > 0 ? 'asset' : '';
  if (v === null) return fallback;
  if (v === '' || v === 'video') return v;
  return libCatList().some(c => c.key === v) ? v : fallback;
}
function libRestoreSort() {
  let v = '';
  try { v = localStorage.getItem('wx-lib-sort') || ''; } catch (e) { /* 忽略 */ }
  return ['new', 'old', 'name', 'size'].includes(v) ? v : 'new';
}
function libSorted(list) {
  const arr = (list || []).slice();
  const nm = x => String((x && (x.label || x.name)) || '');
  arr.sort((a, b) => {
    if (libSort === 'old') return (a.ctime || a.mtime || 0) - (b.ctime || b.mtime || 0) || nm(a).localeCompare(nm(b), 'zh');
    if (libSort === 'name') return nm(a).localeCompare(nm(b), 'zh');
    if (libSort === 'size') return (b.size || 0) - (a.size || 0);
    return (b.ctime || b.mtime || 0) - (a.ctime || a.mtime || 0) || nm(a).localeCompare(nm(b), 'zh');
  });
  return arr;
}
/* 「存到」下拉跟随当前分类（可上传的分类才跟） */
function libSyncUpcat() {
  const sel = $('libUpcat');
  if (!sel) return;
  const ok = libCatList().some(c => c.key === libCat && c.canUpload !== false);
  if (ok) {
    sel.value = libCat;
    try { localStorage.setItem('wx-lib-upcat', libCat); } catch (e) { /* 忽略 */ }
  }
}
/* 当前上传目标分类 */
function libTargetCat() {
  const sel = $('libUpcat');
  return (sel && sel.value) || 'asset';
}
/* 把若干张图搬到指定分类（走批量接口，自动同步剧本/场景引用） */
async function libMovePaths(paths, catKey) {
  const P = (paths || []).filter(p => p && !String(p).startsWith('/videos/'));
  if (!P.length) return;
  if (!catKey || !libCatList().some(c => c.key === catKey && c.canUpload !== false)) {
    toast('这个分类不能作为搬运目标（「全部 / 🎬视频」不行）');
    return;
  }
  const r = await api('/api/gallery/batch', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ op: 'move', paths: P, category: catKey }) });
  if (!r.ok) { toast(r.msg || '移动失败'); return; }
  const moved = (r.results || []).filter(x => x.ok);
  const failed = (r.results || []).filter(x => !x.ok);
  if (moved.length === 1 && moved[0].newPath) libSel = moved[0].newPath;
  libSelSet = new Set();
  applyGalleryPayload(r.gallery);
  renderLibCats(); renderLibGrid(); renderLibFolderOptions();
  toast('已把 ' + moved.length + ' 张搬到「' + libCatLabel(catKey) + '」' +
    (failed.length ? '（' + failed.length + ' 张失败）' : ''));
}
// 人物库管理弹窗状态
let people = [];            // 完整人物库 [{name, avatar, group}]，按名字字典序
let peopleQuery = '';       // 当前搜索词
let peopleGroup = '';       // 当前分组筛选：''=全部 / '学员' / '美女'
let peopleSel = null;       // 当前选中的人物名
let peopleRenameMode = false;
let peoplePickMode = false; // true = 「选一个人回填会话头像」模式
let peoplePickAdd = false;  // pick 模式下：true=新建会话 false=套用到当前会话
let liveTimer = null;          // 实时画面轮询定时器
let liveHasFrame = false;      // 是否已收到过一帧真实画面
let editActive = false;        // 编辑模式进程是否在运行
let pickMode = false;          // false=操作（点击转发手机） true=编辑（点击选元素）
let editInfo = null;           // 当前正在编辑的元素信息
let editStatusTimer = null;    // 编辑模式存活轮询
let runActive = false;         // 是否正在运行工作流
let runStatusTimer = null;     // 运行状态轮询

const $ = id => document.getElementById(id);
const esc = s => String(s == null ? '' : s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

function toast(msg) {
  const t = $('toast'); t.textContent = msg; t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 1800);
}
async function api(url, opts) {
  const r = await fetch(url, opts || {});
  return r.json();
}

/* ---------- 图片加载失败可视化（调试辅助） ---------- */
let _imgErrToastAt = 0;
function onImgErr(img) {
  const src = img.getAttribute('src') || '';
  if (!src) { img.style.visibility = 'hidden'; return false; }  // 空占位仍按原逻辑隐藏
  try { img.onerror = null; } catch (e) { /* noop */ }
  img.classList.add('img-broken');
  img.title = '图片加载失败：' + src;
  const now = Date.now();
  if (now - _imgErrToastAt > 1500) { _imgErrToastAt = now; toast('有图片加载失败，已用红框标出'); }
  return false;
}
function collectImagePaths() {
  const set = new Set();
  const walk = o => {
    if (typeof o === 'string') { if (/^\/images\//.test(o)) set.add(o); return; }
    if (Array.isArray(o)) { o.forEach(walk); return; }
    if (o && typeof o === 'object') { Object.values(o).forEach(walk); }
  };
  walk(scene);
  return Array.from(set);
}
async function checkImages() {
  const paths = collectImagePaths();
  if (!paths.length) { toast('场景中没有引用图片'); return; }
  const bad = [];
  await Promise.all(paths.map(p => new Promise(res => {
    const im = new Image();
    im.onload = () => res();
    im.onerror = () => { bad.push(p); res(); };
    im.src = p;
  })));
  if (bad.length) toast(`图片检查：${bad.length}/${paths.length} 张无法加载，失败项已用红框标出`);
  else toast(`图片检查完成：${paths.length} 张全部正常`);
}
function getPath(p) {
  const parts = p.split('.');
  let o = scene;
  for (const part of parts) {
    if (o == null) return undefined;
    const li = /\[(\d+)\]/.exec(part);
    const key = part.replace(/\[(\d+)\]/, '');
    o = o[key];
    if (li != null && o != null) o = o[parseInt(li[1], 10)];
  }
  return o;
}
function setPath(p, v) {
  const parts = p.split('.');
  let o = scene;
  for (let i = 0; i < parts.length - 1; i++) {
    const k = parts[i].replace(/\[(\d+)\]/, '');
    const idx = /\[(\d+)\]/.exec(parts[i]);
    if (o[k] == null) o[k] = idx ? [] : {};
    o = o[k];
    if (idx && o) o = o[parseInt(idx[1], 10)];
  }
  const last = parts[parts.length - 1].replace(/\[(\d+)\]/, '');
  const li = /\[(\d+)\]/.exec(parts[parts.length - 1]);
  if (li) o[parseInt(li[1], 10)] = v; else o[last] = v;
}

/* ---------- 手机渲染（600×1300 像素级） ---------- */
function signalSvg() {
  return '<svg viewBox="0 0 30 20" width="30" height="20" color="currentColor">' +
    '<g fill="currentColor">' +
    '<rect x="0"  y="14" width="5" height="6" rx="1.2"/>' +
    '<rect x="7"  y="10" width="5" height="10" rx="1.2"/>' +
    '<rect x="14" y="6"  width="5" height="14" rx="1.2"/>' +
    '<rect x="21" y="2"  width="5" height="18" rx="1.2"/>' +
    '</g></svg>';
}
function wifiSvg() {
  return '<svg viewBox="0 0 27 21" width="27" height="21" color="currentColor">' +
    '<g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">' +
    '<path d="M2.5 8.4a16 16 0 0 1 22 0"/>' +
    '<path d="M6.6 12.4a10 10 0 0 1 13.8 0"/>' +
    '<path d="M10.7 16.4a4.5 4.5 0 0 1 5.6 0"/>' +
    '</g><circle cx="13.5" cy="19.2" r="1.8" fill="currentColor"/></svg>';
}
function batterySvg() {
  return '<svg viewBox="0 0 41 20" width="41" height="20" color="currentColor">' +
    '<rect x="0.5" y="0.5" width="34.5" height="19" rx="4.5" fill="none" stroke="currentColor" stroke-opacity=".55" stroke-width="1.4"/>' +
    '<rect x="3" y="3" width="29.5" height="14" rx="2.5" fill="currentColor"/>' +
    '<rect x="36" y="7" width="3" height="6" rx="1.5" fill="currentColor" fill-opacity=".55"/></svg>';
}
function muteSvg() {
  // 铃铛 + 斜杠，白描边
  return '<svg viewBox="0 0 24 24" width="21" height="22" color="currentColor" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">' +
    '<path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/>' +
    '<path d="M13.7 21a2 2 0 0 1-3.4 0"/>' +
    '<line x1="3" y1="3" x2="21" y2="21"/>' +
    '</svg>';
}
function searchSvg() {
  return '<svg viewBox="0 0 24 24" width="25" height="25" color="currentColor" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">' +
    '<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>';
}

function statusbar() {
  return '<div class="statusbar">' +
    '<span class="sb-time">18:36</span>' +
    '<span class="sb-mute">' + muteSvg() + '</span>' +
    '<span class="sb-right">' +
    '<span class="sb-signal">' + signalSvg() + '</span>' +
    '<span class="sb-wifi">' + wifiSvg() + '</span>' +
    '<span class="sb-battery">' + batterySvg() + '</span>' +
    '</span></div>';
}
// 首页大标题栏：含加号
function homeHeader() {
  const t = scene.title || ('微信 (' + homeUnread() + ')');
  return '<div class="wx-header"><div class="c">' + esc(t) + '</div><div class="plus"></div></div>';
}
function subHeader(title, withBack) {
  return '<div class="wx-header">' +
    (withBack ? '<span class="back" data-nav="back">‹</span>' : '<span style="width:20px"></span>') +
    '<div class="c">' + esc(title) + '</div></div>';
}
const avatarHtml = (src, cls, path) => '<img class="' + cls + '"' + (path ? ' data-path="' + esc(path) + '"' : '') + ' src="' + esc(src) + '" onerror="onImgErr(this)" alt="">';

// 搜索框（149~232）
function searchHtml() {
  return '<div class="search"><div class="box"></div>' +
    '<span class="ic">' + searchSvg() + '</span>' +
    '<span class="txt">搜索</span></div>';
}

function renderPhone() {
  const inner = $('phoneInner');
  let html = statusbar();
  if (camView === 'moments') {
    html += subHeader('朋友圈', true);
    html += momentsHtml();
  } else if (camView === 'peer') {
    html += peerProfileHtml();
  } else if (camView === 'peer-moments') {
    html += peerMomentsHtml();
  } else if (camView === 'contacts') {
    html += contactsViewHtml();
  } else if (camView === 'self') {
    html += selfViewHtml();
  } else if (selIdx != null && scene.home[selIdx]) {
    const it = scene.home[selIdx];
    html += subHeader(it.name || it.group || '会话', true);
    html += dialogueHtml(it);
  } else {
    html += homeHeader();
    html += searchHtml();
    html += chatListHtml();
    html += pillHtml();
    html += tabbarHtml();
  }
  inner.innerHTML = html;
  /* 场景一变就推给真机画面（真机未连接时内部直接返回）与实时预览 */
  pushSceneToLive();
  pvSyncNav();
}
function homeUnread() {
  let n = 0;
  (scene.home || []).forEach(it => { if ((it.unread || 0) > 0 && !it.quiet) n += (it.unread || 0); });
  return n;
}
function chatListHtml() {
  let h = '<div class="chat-list">';
  (scene.home || []).forEach((it, i) => {
    const name = it.name || it.group || '会话';
    const unread = it.unread || 0;
    const badge = unread > 0 && !it.quiet ? '<span class="badge" data-path="home[' + i + '].unread">' + unread + '</span>' : '';
    const dot = unread > 0 && it.quiet ? '<span class="dot" data-path="home[' + i + '].unread"></span>' : '';
    const mute = it.quiet ? '<span class="mute2" data-path="home[' + i + '].quiet">' + muteSvg() + '</span>' : '';
    const msg = it.lastText || lastText(it);
    const time = it.time || lastTime(it);
    h += '<div class="chat-row" data-open="' + i + '" style="top:' + (i * 110) + 'px">' +
      avatarHtml(it.avatar || '/images/avatar/2_20260831_184618_874.jpg', 'ava', 'home[' + i + '].avatar') +
      '<div class="name" data-path="home[' + i + '].name">' + esc(name) + '</div>' +
      '<div class="last" data-path="home[' + i + '].lastText">' + esc(msg) + '</div>' +
      '<div class="time">' + esc(time) + '</div>' +
      badge + dot + mute + '</div>';
  });
  h += '</div>';
  return h;
}
function pillHtml() {
  return '<div class="pill"><i></i><i></i><i></i></div>';
}
function tabbarHtml(activeName) {
  const tabs = [
    { name: '微信', icon: 'M8 3C4.7 3 2 5.5 2 8.6c0 1.8.9 3.4 2.3 4.5L3.6 16l3-1.6c.5.1.9.1 1.4.1 3.3 0 6-2.5 6-5.9S11.3 3 8 3z', badge: '10', dot: false, active: true },
    { name: '通讯录', icon: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm-7 8a7 7 0 0 1 14 0z', badge: '', dot: false, active: false },
    { name: '发现', icon: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 4a6 6 0 0 1 6 6h-4V8a2 2 0 0 0-2-2z', badge: '', dot: true, active: false },
    { name: '我', icon: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0 2c-3.9 0-7 2.5-7 5.5V21h14v-1.5c0-3-3.1-5.5-7-5.5z', badge: '', dot: false, active: false },
  ];
  let h = '<div class="tabbar">';
  tabs.forEach((t, i) => {
    h += '<div class="tab' + (t.name === (activeName || '微信') ? ' active' : '') + '" data-navtab="' + t.name + '" style="left:' + (i * 150) + 'px">' +
      '<span class="ic"><svg viewBox="0 0 24 24" width="40" height="40" fill="currentColor"><path d="' + t.icon + '"/></svg></span>' +
      '<span class="lb">' + t.name + '</span>' +
      (t.badge ? '<span class="tab-badge">' + t.badge + '</span>' : '') +
      (t.dot ? '<span class="tab-dot"></span>' : '') +
      '</div>';
  });
  h += '</div>';
  return h;
}
/* ===== 通讯录 / 我 两页示意稿（2026-09-11 同步新版真机 UI） ===== */
function wxcIcon(bg, d) {
  return '<span class="wxc-ic" style="background:' + bg + '">' +
    '<svg viewBox="0 0 24 24" width="23" height="23" fill="#fff"><path d="' + d + '"/></svg></span>';
}
function pinyinInitial(name) {
  const m = (name || '').replace(/^\s+/, '').charAt(0) || '#';
  if (/[a-zA-Z]/.test(m)) return m.toUpperCase();
  if (/[\u4e00-\u9fa5]/.test(m)) {
    const anchors = [['阿','A'],['芭','B'],['擦','C'],['搭','D'],['鹅','E'],['发','F'],['噶','G'],['哈','H'],['击','J'],['喀','K'],['垃','L'],['妈','M'],['拿','N'],['哦','O'],['啪','P'],['七','Q'],['然','R'],['撒','S'],['塌','T'],['挖','W'],['昔','X'],['压','Y'],['匝','Z']];
    let cur = '#';
    anchors.forEach(pr => { try { if (m.localeCompare(pr[0], 'zh-Hans-CN') >= 0) cur = pr[1]; } catch (e) {} });
    return cur;
  }
  return '#';
}
function contactsViewHtml() {
  const funcs = [
    { name: '新的朋友', bg: '#dfa540', d: 'M15 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm-9-3V6h2v3h3v2H8v3H6v-3H3V9zm9 3c-3.3 0-8 1.7-8 5v2h16v-2c0-3.3-4.7-5-8-5z' },
    { name: '群聊', bg: '#63b45f', d: 'M16 11a3.2 3.2 0 1 0-3.2-3.2A3.2 3.2 0 0 0 16 11zm-8 0a3.2 3.2 0 1 0-3.2-3.2A3.2 3.2 0 0 0 8 11zm0 2c-2.8 0-7 1.4-7 4.2V19h7v-2a6.6 6.6 0 0 1 2-4.6 10 10 0 0 0-2-.4zm8 0a10 10 0 0 0-2 .4 6.6 6.6 0 0 1 2 4.6v2h7v-1.8c0-2.8-4.2-4.2-7-4.2z' },
    { name: '标签', bg: '#4f94e8', d: 'M21.4 11.6l-9-9A2 2 0 0 0 11 2H4a2 2 0 0 0-2 2v7a2 2 0 0 0 .6 1.4l9 9a2 2 0 0 0 2.8 0l7-7a2 2 0 0 0 0-2.8zM7.5 9A1.5 1.5 0 1 1 9 7.5 1.5 1.5 0 0 1 7.5 9z' },
    { name: '公众号', bg: '#4f94e8', d: 'M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm-1.5 14.5L6 12l1.9-1.9 2.6 2.6 5.6-5.6L18 9z' },
  ];
  let h = '<div class="wx-header"><div class="c">通讯录</div></div>';
  h += searchHtml();
  h += '<div class="wxc-funcs">';
  funcs.forEach((f, i) => {
    h += '<div class="wxc-func" style="top:' + (i * 76) + 'px">' + wxcIcon(f.bg, f.d) +
      '<span class="wxc-flb">' + f.name + '</span></div>';
  });
  h += '</div>';
  /* 联系人 = 场景里的人物（与左侧会话列表同一份场景数据，可点头像换图） */
  const home = scene.home || [];
  const items = home.map((it, i) => ({ nm: it.name || '会话', ava: it.avatar || '/images/avatar/2_20260831_184618_874.jpg', p: 'home[' + i + '].avatar' }));
  items.sort((a, b) => a.nm.localeCompare(b.nm, 'zh-Hans-CN'));
  let lastL = '', y = 0;
  h += '<div class="wxc-list">';
  items.forEach(o => {
    const L = pinyinInitial(o.nm);
    if (L !== lastL) { h += '<div class="wxc-letter" style="top:' + y + 'px">' + L + '</div>'; y += 44; lastL = L; }
    h += '<div class="wxc-row" style="top:' + y + 'px">' + avatarHtml(o.ava, 'ava2', o.p) +
      '<span class="wxc-nm">' + esc(o.nm) + '</span></div>';
    y += 96;
  });
  h += '</div>';
  h += tabbarHtml('通讯录');
  return h;
}
function selfViewHtml() {
  const me = scene.me || {};
  let h = '<div class="wx-header"><div class="c">我</div></div>';
  h += '<div class="wxs-top">' +
    avatarHtml(me.avatar || '/images/avatar/2_20260831_184618_874.jpg', 'wxs-ava', 'me.avatar') +
    '<div class="wxs-name" data-path="me.name">' + esc(me.name || '未命名') + '</div>' +
    '<div class="wxs-wxid">微信号：' + esc(me.wxid || 'weixin') + '</div>' +
    '<span class="wxs-qr"><svg viewBox="0 0 24 24" width="34" height="34" fill="#9a9a9a"><path d="M3 3h8v8H3zm2 2v4h4V5zm10-2h6v6h-6zm2 2v2h2V5zM5 15h6v6H5zm2 2v2h2v-2zm8-2h2v2h-2zm4 0h2v2h-2zm-4 4h2v2h-2zm4 0h2v2h-2z"/></svg></span>' +
    '<span class="wxs-arrow">›</span></div>';
  const g1 = [
    { name: '相册', bg: '#5aa2e8', d: 'M21 19V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2zM8.5 13.5l2.5 3 3.5-4.5 4.5 6H5z' },
    { name: '收藏', bg: '#dfa540', d: 'M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z' },
    { name: '钱包', bg: '#4f94e8', d: 'M21 7h-1V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-2h1a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1zm-3 10H5V5h13zm-6 6.5A1.5 1.5 0 1 0 10.5 12 1.5 1.5 0 0 0 12 13.5z' },
    { name: '卡券', bg: '#63b45f', d: 'M20 6H4a2 2 0 0 0-2 2v3a2 2 0 0 1 0 2v3a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-3a2 2 0 0 1 0-2V8a2 2 0 0 0-2-2zm-9 9H9v-2h2zm0-4H9V9h2z' },
  ];
  const g2 = [
    { name: '表情', bg: '#dfa540', d: 'M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zM8.5 10a1.5 1.5 0 1 1 1.5-1.5A1.5 1.5 0 0 1 8.5 10zm7 0a1.5 1.5 0 1 1 1.5-1.5A1.5 1.5 0 0 1 15.5 10zM12 18a5.5 5.5 0 0 1-5.2-3.6h10.4A5.5 5.5 0 0 1 12 18z' },
    { name: '设置', bg: '#5aa2e8', d: 'M19.4 13a7.6 7.6 0 0 0 0-2l2.1-1.6a.5.5 0 0 0 .1-.7l-2-3.4a.5.5 0 0 0-.6-.2l-2.5 1a7.7 7.7 0 0 0-1.7-1L14.4 2.4a.5.5 0 0 0-.5-.4h-4a.5.5 0 0 0-.5.4L9 4.9a7.7 7.7 0 0 0-1.7 1l-2.5-1a.5.5 0 0 0-.6.2l-2 3.4a.5.5 0 0 0 .1.7L4.6 11a7.6 7.6 0 0 0 0 2l-2.1 1.6a.5.5 0 0 0-.1.7l2 3.4a.5.5 0 0 0 .6.2l2.5-1a7.7 7.7 0 0 0 1.7 1l.4 2.5a.5.5 0 0 0 .5.4h4a.5.5 0 0 0 .5-.4l.4-2.5a7.7 7.7 0 0 0 1.7-1l2.5 1a.5.5 0 0 0 .6-.2l2-3.4a.5.5 0 0 0-.1-.7zM12 15.5A3.5 3.5 0 1 1 15.5 12 3.5 3.5 0 0 1 12 15.5z' },
  ];
  const cells = (rows, startTop) => {
    let s = '<div class="wxs-cells">';
    rows.forEach((r, i) => {
      s += '<div class="wxs-row" style="top:' + (startTop + i * 96) + 'px">' + wxcIcon(r.bg, r.d) +
        '<span class="wxc-flb">' + r.name + '</span></div>';
    });
    return s + '</div>';
  };
  h += cells(g1, 0);
  h += cells(g2, 96 * 4 + 16);
  h += tabbarHtml('我');
  return h;
}
function lastText(it) {
  const msgs = it.messages || [];
  const m = msgs[msgs.length - 1];
  if (!m) return it.lastText || '';
  if (m.kind === 'image') return '[图片]';
  if (m.kind === 'voice') return '[语音]';
  return m.text || it.lastText || '';
}
function lastTime(it) {
  const msgs = it.messages || [];
  const m = msgs[msgs.length - 1];
  return (m && m.time) || '';
}
function dialogueHtml(it) {
  const meName = (scene.me && scene.me.name) || 'd';
  let h = '<div class="dialogue">';
  (it.messages || []).forEach((m, j) => {
    const isMe = m.dir === 'me';
    const name = isMe ? meName : (m.sender || it.name || it.group || '对方');
    const ava = isMe ? (scene.me.avatar || '/images/avatar/2_20260831_184618_874.jpg') : (it.avatar || '/images/peer/peer_avatar.jpg');
    let body;
    const path = 'home[' + selIdx + '].messages[' + j + ']';
    if (m.kind === 'image') body = '<div class="ta img" data-path="' + path + '.image"><img src="' + esc(m.image) + '" onerror="onImgErr(this)" alt=""></div>';
    else if (m.kind === 'voice') body = '<div class="ta voice" data-path="' + path + '.seconds">' + voiceHtml(parseInt(m.seconds, 10) || 1) + '</div>';
    else body = '<div class="ta" data-path="' + path + '.text">' + esc(m.text) + '</div>';
    const avaPath = isMe ? 'me.avatar' : 'home[' + selIdx + '].avatar';
    h += '<div class="bubble' + (isMe ? ' self' : '') + '">' + avatarHtml(ava, 'ava', avaPath) +
      '<div class="bubble-body"><div class="b-name">' + esc(name) + '</div>' + body + '</div></div>';
  });
  if (!(it.messages || []).length) h += '<div style="color:#5a5a5e;text-align:center;padding:40px 0 0">（暂无消息，在右侧「消息」tab 添加）</div>';
  h += '</div>';
  return h;
}
function voiceHtml(secs) {
  const n = Math.max(4, Math.min(14, Math.round(secs * 2.2)));
  let bars = '';
  for (let i = 0; i < n; i++) bars += '<i style="height:' + (6 + Math.round(Math.abs(Math.sin(i * 1.7)) * 10) + 2) + 'px"></i>';
  return '<span class="wave">' + bars + '</span><span class="dur">' + secs + '"</span>';
}
/* 解析「我的朋友圈」某条动态里的视频：字符串 或 {src, cover}。
   与 enhance/moments_extra.js 的 normalizeVideo 同一套字段约定。

   注意：**只判断 post.video 是否存在，不要求 src 已填**。
   编辑器里刚点「加视频」时 src 就是空的，此时仍要显示视频字段让用户去填；
   若这里因为 src 为空返回 null，面板会退回图片模式，视频地址就永远填不进去。
   渲染预览时再单独看 src 是否为空。 */
function momentVideo(p) {
  const v = p && p.video;
  if (!v) return null;
  if (typeof v === 'string') return { src: v, cover: p.cover || (p.images || [])[0] || '' };
  return {
    src: String(v.src || v.url || v.path || v.视频 || ''),
    cover: v.cover || v.封面 || p.cover || (p.images || [])[0] || '',
  };
}
function momentsHtml() {
  let h = '<div class="moments"><div class="m-cover">' +
    '<span class="me-name" data-path="me.name">' + esc((scene.me && scene.me.name) || 'd') + '</span>' +
    '<img class="me" data-path="me.avatar" src="' + esc((scene.me && scene.me.avatar) || '') + '" onerror="onImgErr(this)" alt="">' +
    '</div>';
  (scene.moments || []).forEach((p, i) => {
    let likes = (p.likes || []).join('、');
    let comments = (p.comments || []).map(c => '<div class="comment-e" data-path="moments[' + i + '].comments[0].text"><b>' + esc(c.name) + '：</b>' + esc(c.text) + '</div>').join('');
    const vid = momentVideo(p);
    let media = '';
    if (vid) {
      if (!vid.src) {
        media = '<div class="m-video"><span class="mv-wrap mv-nocover" data-path="moments[' + i + '].video.src">' +
          '<i class="mv-play"></i></span>' +
          '<span class="mv-src" data-path="moments[' + i + '].video.src">（未填视频地址）</span></div>';
      } else {
        media = '<div class="m-video"><span class="mv-wrap' + (vid.cover ? '' : ' mv-nocover') + '" data-path="moments[' + i + '].video.cover">' +
          (vid.cover ? '<img src="' + esc(vid.cover) + '" onerror="onImgErr(this)" alt="">' : '') +
          '<i class="mv-play"></i></span>' +
          '<span class="mv-src" data-path="moments[' + i + '].video.src">' + esc(vid.src) + '</span></div>';
      }
    } else {
      const imgs = (p.images || []).slice(0, 9).map((s, k) =>
        '<img data-path="moments[' + i + '].images[' + k + ']" src="' + esc(s) + '" onerror="onImgErr(this)" alt="">').join('');
      if (imgs) media = '<div class="imgs">' + imgs + '</div>';
    }
    const author = '<div class="author" data-path="moments[' + i + '].author">' + esc(p.author || '') +
      (p.company ? '<span class="co" data-path="moments[' + i + '].company">@' + esc(p.company) + '</span>' : '') + '</div>';
    h += '<div class="m-post"><div class="row">' + avatarHtml(p.avatar || '/images/peer/peer_avatar.jpg', 'ava', 'moments[' + i + '].avatar') +
      '<div class="bd">' + author +
      '<div class="txt" data-path="moments[' + i + '].text">' + esc(p.text || '') + '</div>' +
      media +
      '<div class="time" data-path="moments[' + i + '].time">' + esc(p.time || '') + '</div>' +
      (likes ? '<div class="likes" data-path="moments[' + i + '].likes">👍 ' + esc(likes) + '</div>' : '') +
      comments + '</div></div></div>';
  });
  if (!(scene.moments || []).length) h += '<div style="color:#5a5a5e;text-align:center;padding:40px 0">（暂无动态，在右侧「朋友圈」tab 添加）</div>';
  h += '</div>';
  return h;
}

/* ---------- 对方主页 / 对方朋友圈（复用 /enhance/peer_pages.css 真实样式） ---------- */
/* 多人物 × 多方案数据结构：
   scene.peers = [{ id, link, activePlan, plans: { A: {人设+动态}, B: {...}, ... } }]
   老场景只有 scene.peer：载入时自动迁移成「单人物 · 方案 A」。 */
const PLAN_KEYS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
function migratePeer() {
  if (!Array.isArray(scene.peers)) scene.peers = [];
  if (!scene.peers.length) {
    const legacy = (scene.peer && typeof scene.peer === 'object' &&
      (scene.peer.name || scene.peer.avatar || scene.peer.cover || (scene.peer.posts || []).length))
      ? JSON.parse(JSON.stringify(scene.peer)) : null;
    scene.peers = [{ id: 'p' + Date.now(), link: '', activePlan: 'A', plans: { A: legacy || {} } }];
  }
  scene.peers.forEach(pp => {
    if (!pp.id) pp.id = 'p' + Math.random().toString(36).slice(2, 8);
    if (!pp.link) pp.link = '';
    if (!pp.plans || typeof pp.plans !== 'object' || !Object.keys(pp.plans).length) pp.plans = { A: {} };
    const keys = Object.keys(pp.plans);
    if (!pp.activePlan || !pp.plans[pp.activePlan]) pp.activePlan = keys[0];
  });
  if (peerSel >= scene.peers.length) peerSel = 0;
}
function activePeer() { migratePeer(); return scene.peers[peerSel]; }
/* 当前「对方」数据的寻址根：预览与面板里所有 data-path / data-set 都挂在它下面，
   这样通用的 getPath/setPath/点选弹窗无需任何特判就能工作。 */
function PB() { return 'peers[' + peerSel + '].plans.' + activePeer().activePlan; }
function peerData() {
  const pp = activePeer();
  const p = pp.plans[pp.activePlan];
  if (typeof p !== 'object' || p == null) { pp.plans[pp.activePlan] = {}; return peerData(); }
  if (p.gender == null) p.gender = 0;
  if (!Array.isArray(p.momentsThumbs)) p.momentsThumbs = [];
  if (!Array.isArray(p.posts)) p.posts = [];
  return p;
}
/* 保存 / 生成工作流前：把当前人物当前方案镜像到 scene.peer，兼容旧消费方 */
function syncPeerMirror() {
  migratePeer();
  scene.peer = JSON.parse(JSON.stringify(peerData()));
}
function nextPlanKey(pp) {
  const used = Object.keys(pp.plans);
  for (const ch of PLAN_KEYS) if (!used.includes(ch)) return ch;
  return 'P' + used.length;
}
function peerThumbImgs(list, base, max) {
  return (list || []).slice(0, max).map((s, i) =>
    '<img src="' + esc(s) + '" onerror="onImgErr(this)" data-path="' + base + '[' + i + ']" alt="">').join('');
}
/* 解析对方动态里的视频：字符串 或 {src, cover}；无则 null。
   这是「渲染用」的严格版：src 为空视为没有视频，预览里不显示播放角标。 */
function peerPostVideo(post) {
  const v = post && post.video;
  if (!v) return null;
  if (typeof v === 'string') return { src: v, cover: post.cover || (post.images || [])[0] || '' };
  const src = v.src || v.url || v.path || v.视频 || '';
  if (!src) return null;
  return { src: String(src), cover: v.cover || v.封面 || post.cover || (post.images || [])[0] || '' };
}
/* 「编辑用」的宽松版：只要 post.video 存在就算视频动态，src 允许为空——
   否则刚点「加视频」时 src 是空的，面板会退回图片模式，视频地址永远填不进去。 */
function peerResolveVideo(post) {
  const v = post && post.video;
  if (!v) return null;
  if (typeof v === 'string') return { src: v, cover: post.cover || (post.images || [])[0] || '' };
  return { src: String(v.src || v.url || v.path || v.视频 || ''),
           cover: v.cover || v.封面 || post.cover || (post.images || [])[0] || '' };
}
function peerProfileHtml() {
  const p = peerData();
  const B = PB();
  const gcls = Number(p.gender) === 1 ? 'male' : 'female';
  const v = (p.video && typeof p.video === 'object') ? p.video : null;
  let h = '<div class="wx-peer-page open">' +
    '<div class="wpp-nav"><span class="wpp-back" data-nav="peer-back"></span>' +
    '<span class="wpp-more"><i></i><i></i><i></i></span></div>' +
    '<div class="wpp-scroll">' +
      '<div class="wpp-head">' +
        '<img class="wpp-avatar" data-path="' + B + '.avatar" src="' + esc(p.avatar || '') + '" onerror="onImgErr(this)" alt="">' +
        '<div class="wpp-meta">' +
          '<div class="wpp-name"><span class="wpp-name-t" data-path="' + B + '.name">' + esc(p.name || '') + '</span>' +
          '<i class="wpp-gender ' + gcls + '"></i></div>' +
          '<div class="wpp-wxid" data-path="' + B + '.wxid">微信号：' + esc(p.wxid || '') + '</div>' +
          '<div class="wpp-area" data-path="' + B + '.area">地区：' + esc(p.area || '') + '</div>' +
        '</div>' +
      '</div>' +
      '<div class="wpp-group"><div class="wpp-cell wpp-friend-cell">' +
        '<div class="wpp-cell-main"><div class="wpp-cell-title">朋友资料</div>' +
        '<div class="wpp-cell-desc">添加朋友的备注名、电话、标签、备忘、照片等，并设置朋友权限。</div></div>' +
        '<span class="wpp-arrow"></span></div></div>' +
      '<div class="wpp-group"><div class="wpp-cell wpp-moments-cell" data-nav="peer-moments">' +
        '<div class="wpp-cell-title wpp-title-fixed">朋友圈</div>' +
        '<div class="wpp-thumbs">' + peerThumbImgs(p.momentsThumbs, B + '.momentsThumbs', 5) + '</div>' +
        '<span class="wpp-arrow"></span></div></div>';
  if (v && (v.name || (v.thumbs || []).length)) {
    h += '<div class="wpp-group"><div class="wpp-cell wpp-video-cell">' +
      '<div class="wpp-cell-title wpp-title-fixed">视频号</div>' +
      '<div class="wpp-video"><div class="wpp-video-name" data-path="' + B + '.video.name">' + esc(v.name || '') + '</div>' +
      '<div class="wpp-thumbs wpp-video-thumbs">' + peerThumbImgs(v.thumbs, B + '.video.thumbs', 5) + '</div></div>' +
      '<span class="wpp-arrow"></span></div></div>';
  }
  h += '<div class="wpp-group wpp-actions">' +
      '<div class="wpp-action"><i class="wpp-ic wpp-ic-msg"></i><span>发消息</span></div>' +
      '<div class="wpp-action"><i class="wpp-ic wpp-ic-call"></i><span>音视频通话</span></div></div>' +
    '</div></div>';
  return h;
}
function peerPostHtml(post, i) {
  const B = PB();
  const raw = String(post.date == null ? '' : post.date).trim();
  const m = /^(\d{1,2})\s*(.*)$/.exec(raw);
  let dateHtml = '';
  if (m) dateHtml = '<b data-path="' + B + '.posts[' + i + '].date">' + esc(m[1]) + '</b>' + (m[2] ? '<span>' + esc(m[2]) + '</span>' : '');
  else if (raw) dateHtml = '<b data-path="' + B + '.posts[' + i + '].date">' + esc(raw) + '</b>';
  const vid = peerPostVideo(post);
  let mediaHtml;
  if (vid) {
    mediaHtml = '<div class="wpm-imgs wpm-imgs-video"><div class="wpm-video-wrap">' +
      '<img class="wpm-video-cover" src="' + esc(vid.cover) + '" onerror="onImgErr(this)" data-path="' + B + '.posts[' + i + '].video.cover" alt="">' +
      '<span class="wpm-play"></span></div></div>';
  } else {
    const imgs = (post.images || []).slice(0, 9);
    mediaHtml = imgs.length
      ? '<div class="wpm-imgs wpm-imgs-' + Math.min(imgs.length, 9) + '">' + imgs.map((s, k) =>
          '<img src="' + esc(s) + '" onerror="onImgErr(this)" data-path="' + B + '.posts[' + i + '].images[' + k + ']" alt="">').join('') + '</div>'
      : '<div class="wpm-imgs wpm-imgs-empty"></div>';
  }
  const texts = String(post.text == null ? '' : post.text).split('\n')
    .map(line => '<p>' + esc(line) + '</p>').join('');
  /* 编辑器专用小工具条（↑↓ 删），只在编辑器预览里渲染，不影响运行端 */
  const ops = '<span class="wpm-ops">' +
    '<i data-pact="up-post" data-i="' + i + '" title="上移">↑</i>' +
    '<i data-pact="down-post" data-i="' + i + '" title="下移">↓</i>' +
    '<i data-pact="del-post" data-i="' + i + '" title="删除">✕</i></span>';
  return '<div class="wpm-post"><div class="wpm-date">' + dateHtml + '</div>' + mediaHtml +
    '<div class="wpm-texts" data-path="' + B + '.posts[' + i + '].text">' + texts + peerSocialHtml(post, i) + '</div>' +
    ops + '</div>';
}
/* 动态的点赞 / 评论区块：运行端（enhance/peer_pages.js）渲染同款结构，
   编辑器里点赞可整块点击编辑，评论逐条可点（改文案）/点名字（改评论人）。 */
function peerSocialHtml(post, i) {
  const B = PB();
  const likes = (post.likes || []).filter(Boolean);
  const cmts = post.comments || [];
  if (!likes.length && !cmts.length) return '';
  let h = '<div class="wpm-social">';
  if (likes.length) h += '<div class="wpm-likes" data-pact="edit-likes" data-i="' + i + '" title="点击编辑点赞的人">' +
    '<i class="wpm-like-ic">♥</i><span>' + esc(likes.join('，')) + '</span></div>';
  if (likes.length && cmts.length) h += '<div class="wpm-social-div"></div>';
  cmts.forEach((c, k) => {
    h += '<div class="wpm-cmt"><span class="wpm-cmt-name" data-path="' + B + '.posts[' + i + '].comments[' + k + '].name">' +
      esc(c.name || '') + '</span>：<span data-path="' + B + '.posts[' + i + '].comments[' + k + '].text">' + esc(c.text || '') + '</span></div>';
  });
  h += '</div>';
  return h;
}
function peerMomentsHtml() {
  const p = peerData();
  const B = PB();
  return '<div class="wx-peer-page open">' +
    '<div class="wpm-scroll">' +
      '<div class="wpm-cover">' +
        '<img class="wpm-cover-img" data-path="' + B + '.cover" src="' + esc(p.cover || '') + '" onerror="onImgErr(this)" alt="">' +
        '<span class="wpm-back" data-nav="peer-moments-back"></span>' +
        '<div class="wpm-cover-bottom"><div class="wpm-name" data-path="' + B + '.name">' + esc(p.name || '') + '</div>' +
        '<img class="wpm-avatar" data-path="' + B + '.avatar" src="' + esc(p.avatar || '') + '" onerror="onImgErr(this)" alt=""></div>' +
      '</div>' +
      '<div class="wpm-signature" data-path="' + B + '.signature"' + (p.signature ? '' : ' style="display:none"') + '>' + esc(p.signature || '') + '</div>' +
      '<div class="wpm-list"><div class="wpm-edobar" data-pact="add-post" title="在这套方案里新增一条动态">＋ 添加动态</div>' +
      (p.posts || []).map((post, i) => peerPostHtml(post, i)).join('') + '</div>' +
    '</div></div>';
}

/* ---------- 右侧结构化面板 ---------- */
/* ---------- 输入体验：文本边打边存，防抖刷新手机预览，不重建面板 ---------- */
let _phoneRefreshTimer = null;
function schedulePhoneRefresh() {
  if (_phoneRefreshTimer) clearTimeout(_phoneRefreshTimer);
  _phoneRefreshTimer = setTimeout(() => { _phoneRefreshTimer = null; renderPhone(); }, 250);
}

/* ---------- 卡片折叠：每个卡片可展开/收起，顶部可全部展开/收起 ---------- */
const cardFoldState = new Map();

/* ---------- 说明性 hint 折叠成小问号（空状态/警告/含控件的保留） ---------- */
const HINT_KEEP = ['还没有', '先在上方', '这套方案还没有', '⚠', '加载失败', '请确认'];
function compressHints(root) {
  (root || document).querySelectorAll('.hint').forEach(h => {
    if (h.querySelector('.hint-q')) return;
    if (h.querySelector('button, input, select, textarea, video, a')) return;
    const t = (h.textContent || '').trim();
    if (!t || HINT_KEEP.some(k => t.includes(k))) return;
    if (t.length < 12) return;
    h.classList.add('compacted');
    const q = document.createElement('button');
    q.type = 'button';
    q.className = 'hint-q';
    q.title = '点开查看说明';
    const body = document.createElement('div');
    body.className = 'hint-body';
    while (h.firstChild) body.appendChild(h.firstChild);
    h.appendChild(q);
    h.appendChild(body);
    q.onclick = (e) => { e.stopPropagation(); h.classList.toggle('open'); };
  });
}
let _hintObsT = null;
new MutationObserver(() => {
  if (_hintObsT) clearTimeout(_hintObsT);
  _hintObsT = setTimeout(() => compressHints(document.body), 120);
}).observe(document.body, { childList: true, subtree: true });
compressHints(document.body);
function applyCardFolds() {
  const body = $('panelBody');
  body.querySelectorAll('.card').forEach((card, ci) => {
    const head = card.querySelector(':scope > .head');
    if (!head || head.querySelector('.fold-btn')) return;
    const fold = document.createElement('div');
    fold.className = 'card-fold';
    while (head.nextSibling) fold.appendChild(head.nextSibling);
    card.appendChild(fold);
    const key = panelTab + '#' + ci + '#' + (head.textContent || '').trim().slice(0, 10);
    fold.dataset.foldKey = key;
    const tog = document.createElement('button');
    tog.type = 'button';
    tog.className = 'fold-btn';
    tog.title = '展开 / 收起这个卡片';
    const open0 = cardFoldState.has(key) ? cardFoldState.get(key) : true;
    tog.textContent = open0 ? '▾' : '▸';
    if (!open0) fold.classList.add('closed');
    tog.onclick = (e) => {
      e.stopPropagation();
      const nowOpen = !fold.classList.contains('closed');
      cardFoldState.set(key, !nowOpen);
      fold.classList.toggle('closed', nowOpen);
      tog.textContent = nowOpen ? '▸' : '▾';
    };
    head.insertBefore(tog, head.firstChild);
  });
  if (!body.querySelector('.fold-toolbar')) {
    const bar = document.createElement('div');
    bar.className = 'fold-toolbar';
    bar.innerHTML = '<button type="button" data-fold="open">⊟ 全部展开</button><button type="button" data-fold="close">▤ 全部收起</button>';
    bar.querySelectorAll('button').forEach(b => {
      b.onclick = () => {
        const open = b.getAttribute('data-fold') === 'open';
        body.querySelectorAll('.card .card-fold').forEach(f => {
          f.classList.toggle('closed', !open);
          if (f.dataset.foldKey) cardFoldState.set(f.dataset.foldKey, open);
        });
        body.querySelectorAll('.card .fold-btn').forEach(t => { t.textContent = open ? '▾' : '▸'; });
      };
    });
    body.insertBefore(bar, body.firstChild);
  }
}

function renderPanel() {
  const body = $('panelBody');
  const keepScroll = body.scrollTop;
  if (panelTab === 'conversations') body.innerHTML = panelConversations();
  else if (panelTab === 'messages') body.innerHTML = panelMessages();
  else if (panelTab === 'moments') body.innerHTML = panelMoments();
  else if (panelTab === 'peer') body.innerHTML = panelPeer();
  else body.innerHTML = panelMe();
  applyCardFolds();
  bindPanelEvents();
  body.scrollTop = keepScroll;
}
function setPanelTab(tab) {
  panelTab = tab;
  document.querySelectorAll('.panel-tabs button').forEach(x => x.classList.toggle('active', x.getAttribute('data-tab') === tab));
  renderPanel();
}
function btn(html) { return html; }
function panelConversations() {
  let h = '<h3>联系人 · 会话（主页列表）</h3><div class="btn-row">' +
    '<button data-act="add-chat">＋ 新增会话</button>' +
    '<button data-act="add-chat-from-people" title="从人物库选一个人，直接用他的名字+头像新建一个会话">👥 从人物库加会话</button>' +
    '<button data-act="fill-chat-from-people" title="给当前选中的会话从人物库套用名字+头像">👤 用人物库填当前会话</button></div>';
  (scene.home || []).forEach((it, i) => {
    h += '<div class="card"><div class="head"><span class="t" data-up="home[' + i + '].name">' + esc(it.name || it.group || '会话') + '</span>' +
      '<button data-act="edit-msg" data-i="' + i + '">✏️ 编消息</button>' +
      '<button data-act="up-chat" data-i="' + i + '">↑</button><button data-act="down-chat" data-i="' + i + '">↓</button>' +
      '<button data-act="del-chat" data-i="' + i + '">删除</button></div>' +
      fieldText('home[' + i + '].name', '会话名', it.name || '') +
      fieldText('home[' + i + '].lastText', '最后一条（列表摘要）', it.lastText || '') +
      fieldText('home[' + i + '].time', '列表时间（如 18:22）', it.time || '') +
      '<div class="field"><label>类型</label><select data-set="home[' + i + '].type">' +
      '<option value="friend"' + (it.type !== 'group' ? ' selected' : '') + '>私聊</option>' +
      '<option value="group"' + (it.type === 'group' ? ' selected' : '') + '>群聊</option></select></div>' +
      '<div class="field"><label>头像</label>' + imgField('home[' + i + '].avatar', it.avatar) + '</div>' +
      '<div class="field mini-row"><div style="flex:1"><label>未读数</label><input data-set="home[' + i + '].unread" type="number" value="' + (it.unread || 0) + '"></div>' +
      '<div style="flex:1"><label>免打扰</label><input data-set="home[' + i + '].quiet" type="checkbox"' + (it.quiet ? ' checked' : '') + '></div></div>' +
      (it.type === 'group' ? '<div class="field"><label>群成员（逗号分隔）</label><input data-set="home[' + i + '].membersText" value="' + esc((it.members || []).join(',')) + '"></div>' : '') +
      '</div>';
  });
  return h;
}
function panelMessages() {
  const it = scene.home[selIdx];
  if (!it) return '<h3>消息历史</h3><div class="hint">先在上方「会话」tab 选中一个会话，或点击左边手机里的联系人。</div>';
  const msgs = it.messages || (it.messages = []);
  let h = '<h3>消息历史 · ' + esc(it.name || it.group || '会话') + '</h3>' +
    '<div class="btn-row"><button data-act="add-msg">＋ 添加消息</button>' +
    '<button data-act="peer-burst">🔥 对方连发一长串</button></div>';
  msgs.forEach((m, j) => {
    const dirTag = m.dir === 'me' ? '<span class="tag me">我</span>' : '<span class="tag peer">对方</span>';
    const kindTag = '<span class="tag kind">' + (m.kind === 'image' ? '图片' : m.kind === 'voice' ? '语音' : '文字') + '</span>';
    h += '<div class="card"><div class="head"><span class="t">' + dirTag + ' ' + kindTag + '</span>' +
      '<button data-act="up-msg" data-i="' + j + '">↑</button><button data-act="down-msg" data-i="' + j + '">↓</button>' +
      '<button data-act="del-msg" data-i="' + j + '">删除</button></div>' +
      '<div class="field"><label>方向</label><select data-set="home[' + selIdx + '].messages[' + j + '].dir">' +
      '<option value="peer"' + (m.dir !== 'me' ? ' selected' : '') + '>对方</option>' +
      '<option value="me"' + (m.dir === 'me' ? ' selected' : '') + '>我</option></select>' +
      ' <select data-set="home[' + selIdx + '].messages[' + j + '].kind">' +
      '<option value="text"' + (m.kind !== 'image' && m.kind !== 'voice' ? ' selected' : '') + '>文字</option>' +
      '<option value="image"' + (m.kind === 'image' ? ' selected' : '') + '>图片</option>' +
      '<option value="voice"' + (m.kind === 'voice' ? ' selected' : '') + '>语音</option></select></div>' +
      '<div class="field"><label>说话人（群聊逐条可填，私聊留空）</label><input data-set="home[' + selIdx + '].messages[' + j + '].sender" value="' + esc(m.sender || '') + '"></div>' +
      (m.kind === 'image' ? '<div class="field"><label>图片</label>' + imgField('home[' + selIdx + '].messages[' + j + '].image', m.image) + '</div>' :
        m.kind === 'voice' ? '<div class="field"><label>语音秒数</label><input data-set="home[' + selIdx + '].messages[' + j + '].seconds" type="number" value="' + (m.seconds || 1) + '"></div>' :
        '<div class="field"><label>消息内容</label><textarea data-set="home[' + selIdx + '].messages[' + j + '].text">' + esc(m.text || '') + '</textarea></div>') +
      '<div class="field"><label>时间（如 18:22）</label><input data-set="home[' + selIdx + '].messages[' + j + '].time" value="' + esc(m.time || '') + '"></div></div>';
  });
  if (!msgs.length) h += '<div class="hint">还没有消息。</div>';
  return h;
}
function panelMoments() {
  const openSel = ['', 'video', 'image'];
  let h = '<h3>朋友圈动态</h3>' +
    '<div class="hint" style="margin:-4px 0 10px">每条动态可以是「图片动态」或「视频动态」（二选一）。' +
      '视频上传后会自动放进 <code>vue-WeChat/public/videos/</code>，脚本里用 <code>[播放视频]</code> 点开全屏播放，' +
      '图片用 <code>[点开图片]</code> 放大查看。</div>' +
    '<div class="card"><div class="head"><span class="t">生成工作流时进入朋友圈</span></div>' +
      '<div class="field"><label style="display:flex;gap:8px;align-items:center;margin:0">' +
        '<input type="checkbox" data-set="momentsNav" style="width:auto"' + (scene.momentsNav ? ' checked' : '') +
        '> 自动「进入朋友圈」并打开一条内容</label></div>' +
      '<div class="field"><label>打开方式</label><select data-set="momentsOpen">' +
        openSel.map(o => '<option value="' + o + '"' + ((scene.momentsOpen || '') === o ? ' selected' : '') + '>' +
          ({ '': '— 只进入，不打开 —', 'video': '播放视频', 'image': '点开图片' }[o]) + '</option>').join('') +
      '</select></div>' +
      '<div class="field"><label>打开第几条动态</label>' +
        '<input type="number" min="1" data-set="momentsOpenIndex" value="' + (scene.momentsOpenIndex || 1) + '"></div>' +
      '<div class="hint">例：第 1 条动态是视频、打开方式选「播放视频」，生成的工作流就是' +
        '「进朋友圈 → 向下滚动 → 播放视频」。</div>' +
    '</div>' +
    '<div class="btn-row"><button data-act="add-moment">＋ 新增动态</button></div>';
  (scene.moments || []).forEach((p, i) => {
    let comments = (p.comments || []).map((c, k) =>
      '<div class="field"><label>评论' + (k + 1) + '</label><input data-set="moments[' + i + '].comments[' + k + '].text" value="' + esc(c.text || '') + '">' +
      '<div style="margin-top:4px"><input data-set="moments[' + i + '].comments[' + k + '].name" value="' + esc(c.name || '') + '" placeholder="评论人"></div>' +
      '<div class="btn-row" style="margin:6px 0 0"><button data-act="del-comment" data-i="' + i + '" data-k="' + k + '">删除该评论</button></div></div>').join('');
    let likesVal = (p.likes || []).join('、');
    const vid = momentVideo(p);
    h += '<div class="card"><div class="head"><span class="t" data-up="moments[' + i + '].author">' + esc(p.author || '动态') + '</span>' +
      '<button data-act="moment-video" data-i="' + i + '">' + (vid ? '移除视频' : '加视频') + '</button>' +
      '<button data-act="up-moment" data-i="' + i + '">↑</button><button data-act="down-moment" data-i="' + i + '">↓</button>' +
      '<button data-act="del-moment" data-i="' + i + '">删除</button></div>' +
      '<div class="field"><label>作者</label><input data-set="moments[' + i + '].author" value="' + esc(p.author || '') + '"></div>' +
      '<div class="field"><label>作者头像</label>' + imgField('moments[' + i + '].avatar', p.avatar) + '</div>' +
      '<div class="field"><label>公司名（企业微信来源，留空则不显示）</label>' +
        '<input data-set="moments[' + i + '].company" value="' + esc(p.company || '') + '" placeholder="如：微盛企微管家"></div>' +
      '<div class="field"><label>文案（换行即分段）</label><textarea data-set="moments[' + i + '].text">' + esc(p.text || '') + '</textarea></div>';
    if (vid) {
      h +=       '<div class="field"><label>视频地址（/videos/xxx.mp4 或 http 地址）</label>' +
        '<div class="mini"><input data-set="moments[' + i + '].video.src" value="' + esc(vid.src) + '" placeholder="/videos/xxx.mp4">' +
        '<button data-video="upload" data-path="moments[' + i + '].video.src">⬆ 上传视频</button></div>' +
        ((sourceVideos || []).length
          ? '<select class="imgsel" style="margin-top:6px" data-video="pick" data-path="moments[' + i + '].video.src">' +
              '<option value="">— 从已上传的 ' + sourceVideos.length + ' 个视频里选 —</option>' +
              sourceVideos.map(v => '<option value="' + esc(v) + '"' + (v === vid.src ? ' selected' : '') + '>' + esc(v) + '</option>').join('') +
            '</select>'
          : '') + '</div>' +
        '<div class="field"><label>视频封面</label>' + imgField('moments[' + i + '].video.cover', vid.cover) + '</div>' +
        '<div class="field"><label>视频预览</label>' +
          (vid.src ? '<video class="mv-preview" src="' + esc(vid.src) + '" controls preload="metadata" muted></video>'
                   : '<div class="hint" style="color:#ffb454">⚠ 还没填视频地址：这条动态在朋友圈里不会显示内容。请点「⬆ 上传视频」或从下拉里选一个。</div>') + '</div>' +
        '<div class="hint">这条动态在朋友圈里显示「封面 + 播放角标」，脚本里用 [播放视频] 点开全屏播放。</div>';
    } else {
      h += imgListField('moments[' + i + '].images', p.images, '配图（最多 9 张）', 9);
    }
    h += '<div class="field"><label>时间</label><input data-set="moments[' + i + '].time" value="' + esc(p.time || '') + '"></div>' +
      '<div class="field"><label>点赞的人（顿号分隔）</label><input data-set="moments[' + i + '].likesText" value="' + esc(likesVal) + '"></div>' +
      comments +
      '<div class="btn-row"><button data-act="add-comment" data-i="' + i + '">＋ 加评论</button></div></div>';
  });
  if (!(scene.moments || []).length) h += '<div class="hint">还没有动态。</div>';
  return h;
}
function panelMe() {
  const me = scene.me || (scene.me = {});
  return '<h3>我的资料</h3>' +
    '<div class="field"><label>昵称</label><input data-set="me.name" value="' + esc(me.name || '') + '"></div>' +
    '<div class="field"><label>个性签名</label><input data-set="me.signature" value="' + esc(me.signature || '') + '"></div>' +
    '<div class="field"><label>头像</label>' + imgField('me.avatar', me.avatar) + '</div>' +
    '<div class="field"><label>朋友圈封面</label>' + imgField('me.bg', me.bg) + '</div>' +
    '<div class="hint" style="margin-top:10px">头像/昵称会同步到会话列表、通讯录与朋友圈。</div>';
}
function peerPresetOptions() {
  const names = Object.keys(peerPresets || {}).sort();
  return '<option value="">— 选择预设 —</option>' + names.map(n =>
    '<option value="' + esc(n) + '"' + (n === peerPresetSel ? ' selected' : '') + '>' + esc(n) + '</option>').join('');
}
function imgListField(base, arr, label, max) {
  const list = Array.isArray(arr) ? arr : [];
  let h = '<div class="field"><label>' + esc(label) + '（' + list.length + '/' + max + '）</label>';
  list.forEach((src, i) => {
    h += '<div class="img-field">' +
      '<div class="if-left"><img class="if-thumb" src="' + esc(src) + '" onerror="onImgErr(this)" data-img="open" data-path="' + base + '[' + i + ']"></div>' +
      '<div class="if-right"><div class="if-actions">' +
        '<button data-img="open" data-path="' + base + '[' + i + ']">📁 换图</button>' +
        '<button data-img="upload" data-path="' + base + '[' + i + ']">⬆ 上传</button>' +
        '<button data-act="del-img" data-path="' + base + '" data-i="' + i + '">✖ 删除</button>' +
      '</div><div class="if-path" title="' + esc(src) + '">' + esc(src) + '</div></div></div>';
  });
  if (list.length < max) h += '<div class="btn-row"><button data-act="add-img" data-path="' + base + '">＋ 添加图片</button></div>';
  h += '</div>';
  return h;
}
/* 一键生成模板：文案固定 + 图片张数，配图从图片库现挑现填 */
const PEER_TEMPLATES = {
