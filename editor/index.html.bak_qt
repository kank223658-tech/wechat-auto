<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>微信录屏工作流可视化编辑器</title>
  <style>
:root {
  color-scheme: light;
  --bg: #f4f5f7;
  --panel: #ffffff;
  --panel-2: #f2f3f6;
  --panel-3: #e9ebef;
  --field: #f7f8fa;
  --line: rgba(17, 24, 39, 0.08);
  --line-strong: rgba(17, 24, 39, 0.16);
  --text: #1c1e22;
  --muted: #5c616b;
  --muted-2: #9095a0;
  --accent: #0aac5f;
  --accent-strong: #0a9d57;
  --accent-soft: rgba(10, 172, 95, 0.10);
  --accent-border: rgba(10, 172, 95, 0.38);
  --green: #0aac5f;
  --green-soft: rgba(10, 172, 95, 0.10);
  --green-line: rgba(10, 172, 95, 0.32);
  --amber: #b9791e;
  --amber-soft: rgba(202, 138, 20, 0.10);
  --amber-line: rgba(202, 138, 20, 0.32);
  --red: #d54941;
  --red-soft: rgba(213, 73, 65, 0.10);
  --red-line: rgba(213, 73, 65, 0.32);
  --ink-0: #0f1115;
  --shadow: 0 24px 64px rgba(17, 24, 39, 0.16);
  --shadow-soft: 0 6px 20px rgba(17, 24, 39, 0.06);
  --shadow-pop: 0 12px 32px rgba(17, 24, 39, 0.14);
  --radius: 14px;
  --radius-sm: 10px;
  --topbar-h: 58px;
  --log-h: 176px;
}

* { box-sizing: border-box; }

html,
body {
  width: 100%;
  height: 100%;
  overflow: hidden;
}

body {
  margin: 0;
  color: var(--text);
  background:
    radial-gradient(1100px 480px at 18% -12%, rgba(10, 172, 95, 0.04), transparent 60%),
    radial-gradient(900px 420px at 88% -18%, rgba(71, 86, 216, 0.03), transparent 60%),
    var(--bg);
  font-family: "PingFang SC", "Microsoft YaHei", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 14px;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

::selection { background: rgba(10, 172, 95, 0.30); }

::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb {
  background: rgba(17, 24, 39, 0.14);
  background-clip: content-box;
  border: 2.5px solid transparent;
  border-radius: 999px;
}
::-webkit-scrollbar-thumb:hover { background-color: rgba(17, 24, 39, 0.24); }

button,
input,
textarea,
select {
  font: inherit;
}

button {
  user-select: none;
}

.app {
  height: 100%;
  display: grid;
  grid-template-rows: var(--topbar-h) minmax(0, 1fr) var(--log-h);
  min-width: 0;
}

/* ---- 顶栏 ---- */
.topbar {
  height: var(--topbar-h);
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 16px;
  background: rgba(255, 255, 255, 0.82);
  border-bottom: 1px solid var(--line);
  backdrop-filter: blur(16px);
  z-index: 30;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 230px;
  font-weight: 700;
  letter-spacing: 0.2px;
  color: var(--ink-0);
}

.brand-mark {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  color: #ffffff;
  font-weight: 800;
  background: linear-gradient(145deg, #17d377, #0aa257);
  box-shadow: 0 6px 16px rgba(10, 172, 95, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.25);
}

.brand-sub {
  display: block;
  margin-top: 1px;
  color: var(--muted-2);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.4px;
}

.toolbar-group {
  display: flex;
  align-items: center;
  gap: 6px;
  padding-right: 12px;
  border-right: 1px solid var(--line);
}

.toolbar-group:last-child {
  border-right: 0;
}

/* ---- 按钮 ---- */
.btn {
  height: 34px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 0 12px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--panel-2);
  color: var(--text);
  cursor: pointer;
  transition: background .14s ease, border-color .14s ease, box-shadow .14s ease, transform .14s ease;
  white-space: nowrap;
}

.btn:hover:not(:disabled) {
  background: var(--panel-3);
  border-color: var(--line-strong);
  transform: translateY(-1px);
}

.btn:active:not(:disabled) { transform: translateY(0); }

.btn:disabled {
  opacity: .45;
  cursor: not-allowed;
}

.btn.primary {
  color: #ffffff;
  font-weight: 700;
  border-color: transparent;
  background: linear-gradient(180deg, #15d274, #0cb259);
  box-shadow: 0 6px 18px rgba(10, 172, 95, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.22);
}

.btn.primary:hover:not(:disabled) {
  background: linear-gradient(180deg, #1bda7c, #0fbe62);
  box-shadow: 0 8px 22px rgba(10, 172, 95, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.22);
}

.btn.ghost {
  background: transparent;
  border-color: transparent;
}

.btn.ghost:hover:not(:disabled) {
  background: var(--panel-2);
  border-color: var(--line);
}

.btn.primary-soft {
  color: var(--accent);
  border-color: var(--accent-border);
  background: var(--accent-soft);
}

.btn.primary-soft:hover:not(:disabled) {
  border-color: var(--accent);
  background: rgba(10, 172, 95, 0.18);
}

.btn.danger {
  color: #c73e35;
  border-color: var(--red-line);
  background: transparent;
}

.btn.accent {
  color: #ffffff;
  border-color: transparent;
  background: linear-gradient(180deg, #15d274, #0cb259);
  font-weight: 600;
}

.btn.accent:hover:not(:disabled) {
  background: linear-gradient(180deg, #1bda7c, #0fbe62);
}

.btn.danger:hover:not(:disabled) {
  color: #fff;
  border-color: var(--red);
  background: rgba(213, 73, 65, 0.85);
}

.btn.small {
  height: 28px;
  padding: 0 10px;
  border-radius: 8px;
  font-size: 12px;
}

.flow-name {
  width: min(320px, 22vw);
  height: 34px;
  padding: 0 11px;
  border: 1px solid transparent;
  border-radius: var(--radius-sm);
  background: transparent;
  outline: none;
  font-weight: 600;
  color: var(--ink-0);
  transition: border-color .14s ease, background .14s ease, box-shadow .14s ease;
}

.flow-name:hover { background: var(--panel-2); }

.flow-name:focus {
  border-color: var(--accent-border);
  background: var(--field);
  box-shadow: 0 0 0 3px rgba(10, 172, 95, 0.12);
}

.spacer {
  flex: 1;
  min-width: 0;
}

.save-state {
  min-width: 78px;
  color: var(--muted-2);
  font-size: 12px;
  text-align: center;
  letter-spacing: 0.3px;
}

/* ---- 状态胶囊 ---- */
.status-pill {
  height: 30px;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 0 12px;
  border-radius: 999px;
  background: var(--green-soft);
  color: #0a8a4f;
  border: 1px solid var(--green-line);
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
}

.status-pill::before {
  content: "";
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 0 4px rgba(10, 172, 95, 0.14);
}

.status-pill.running {
  background: var(--amber-soft);
  color: #b9791e;
  border-color: var(--amber-line);
}

.status-pill.running::before {
  background: var(--amber);
  box-shadow: 0 0 0 4px rgba(202, 138, 20, 0.16);
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(.9); opacity: .75; }
  50% { transform: scale(1.18); opacity: 1; }
}

/* ---- 工作区三栏 ---- */
.workspace {
  min-height: 0;
  display: grid;
  grid-template-columns: 260px minmax(0, 1fr) 340px;
  gap: 12px;
  padding: 12px;
}

.panel {
  min-height: 0;
  overflow: hidden;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow-soft);
}

.sidebar {
  display: grid;
  grid-template-rows: auto auto minmax(0, 1fr);
}

.panel-title {
  padding: 14px 14px 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  border-bottom: 1px solid var(--line);
}

.panel-title h2 {
  margin: 0;
  font-size: 13px;
  font-weight: 600;
  color: var(--ink-0);
  letter-spacing: 1.5px;
}

.panel-title span {
  color: var(--muted-2);
  font-size: 12px;
}

.search-box {
  padding: 10px 12px 12px;
  border-bottom: 1px solid var(--line);
}

.search-box input {
  width: 100%;
  height: 36px;
  padding: 0 12px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  outline: none;
  background: var(--field);
  color: var(--text);
  transition: border-color .14s ease, box-shadow .14s ease;
}

.search-box input::placeholder { color: var(--muted-2); }

.search-box input:focus {
  border-color: var(--accent-border);
  box-shadow: 0 0 0 3px rgba(10, 172, 95, 0.12);
}

.palette-scroll {
  min-height: 0;
  overflow-y: auto;
  padding: 8px 8px 14px;
}

.category-title {
  margin: 12px 6px 6px;
  padding: 0 6px;
  color: var(--muted-2);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 1.2px;
  text-transform: uppercase;
}

.action-card {
  width: 100%;
  display: grid;
  grid-template-columns: 34px minmax(0, 1fr) 22px;
  gap: 9px;
  align-items: center;
  margin-bottom: 6px;
  padding: 9px;
  border: 1px solid transparent;
  border-radius: 12px;
  background: transparent;
  color: var(--text);
  cursor: pointer;
  text-align: left;
  transition: background .14s ease, border-color .14s ease, transform .14s ease, box-shadow .14s ease;
}

.action-card:hover {
  border-color: var(--line);
  background: var(--panel-2);
  transform: translateY(-1px);
}

.action-icon {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: var(--panel-3);
  border: 1px solid var(--line);
  font-size: 16px;
}

.action-main {
  min-width: 0;
}

.action-name {
  overflow: hidden;
  color: var(--text);
  font-size: 13px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-desc {
  margin-top: 3px;
  overflow: hidden;
  color: var(--muted-2);
  font-size: 11px;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-add {
  width: 22px;
  height: 22px;
  display: grid;
  place-items: center;
  border-radius: 7px;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 15px;
  font-weight: 700;
  opacity: 0;
  transition: opacity .14s ease, transform .14s ease;
}

.action-card:hover .action-add {
  opacity: 1;
  transform: scale(1.04);
}

/* ---- 画板 ---- */
.board {
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
}

.board-toolbar {
  min-height: 62px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  border-bottom: 1px solid var(--line);
}

.stats {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.stat-chip {
  height: 34px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 0 11px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--panel-2);
  color: var(--muted);
  font-size: 12px;
  white-space: nowrap;
}

.stat-chip b {
  color: var(--ink-0);
  font-weight: 600;
}

.board-actions {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 8px;
}

.visual-wrap {
  min-height: 0;
  overflow: hidden;
  background-image: radial-gradient(rgba(17, 24, 39, 0.07) 1px, transparent 1px);
  background-size: 22px 22px;
}

.flow-canvas {
  height: 100%;
  overflow: auto;
  padding: 24px 28px 34px;
}

.empty-board {
  height: 100%;
  display: grid;
  place-items: center;
  color: var(--muted);
  text-align: center;
}

.empty-board-inner {
  width: min(420px, 90%);
  padding: 36px 24px;
  border: 1px dashed var(--line-strong);
  border-radius: 20px;
  background: rgba(17, 24, 39, 0.02);
}

.empty-board-icon {
  width: 64px;
  height: 64px;
  display: grid;
  place-items: center;
  margin: 0 auto 14px;
  border-radius: 20px;
  background: var(--accent-soft);
  border: 1px solid var(--accent-border);
  color: var(--accent);
  font-size: 28px;
}

.empty-board h3 {
  margin: 0 0 8px;
  color: var(--ink-0);
  font-size: 17px;
  font-weight: 600;
  letter-spacing: 0.5px;
}

.empty-board p {
  margin: 0;
  line-height: 1.7;
}

/* ---- 步骤节点 ---- */
.timeline {
  position: relative;
  min-width: 560px;
  padding: 8px 0;
}

.step-node {
  position: relative;
  display: grid;
  grid-template-columns: 44px minmax(0, 1fr);
  gap: 12px;
  margin-bottom: 14px;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: var(--panel-2);
  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.28);
  cursor: pointer;
  transition: border-color .14s ease, box-shadow .14s ease, transform .14s ease, background .14s ease;
}

.step-node::before {
  content: "";
  position: absolute;
  left: 32px;
  top: 62px;
  bottom: -18px;
  width: 2px;
  background: linear-gradient(var(--accent), rgba(10, 172, 95, 0.05));
  opacity: .4;
}

.step-node:last-child::before {
  display: none;
}

.step-node:hover {
  border-color: var(--line-strong);
  background: var(--panel-3);
  box-shadow: 0 14px 32px rgba(0, 0, 0, 0.38);
  transform: translateY(-1px);
}

.step-node.active {
  border-color: var(--accent);
  background: var(--panel-3);
  box-shadow: 0 0 0 1px var(--accent), 0 14px 34px rgba(10, 172, 95, 0.12);
}

.step-node.dragging {
  opacity: .45;
  transform: scale(.99);
}

.node-dot {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: linear-gradient(145deg, #17d377, #0a9e56);
  color: #ffffff;
  font-size: 18px;
  font-weight: 700;
  box-shadow: 0 8px 16px rgba(10, 172, 95, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.25);
}

.node-body {
  min-width: 0;
}

.node-top {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.node-title {
  min-width: 0;
  overflow: hidden;
  color: var(--ink-0);
  font-size: 15px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.node-category {
  flex: none;
  padding: 2px 8px;
  border-radius: 999px;
  background: var(--panel-3);
  border: 1px solid var(--line);
  color: var(--muted);
  font-size: 11px;
  font-weight: 500;
}

.node-summary {
  margin-top: 7px;
  overflow: hidden;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.node-meta {
  margin-top: 8px;
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--muted-2);
  font-size: 12px;
}

.node-index {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 20px;
  border-radius: 999px;
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 700;
}

.node-actions {
  display: flex;
  justify-content: flex-end;
  gap: 4px;
}

.icon-btn {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border: 1px solid transparent;
  border-radius: 9px;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  transition: background .14s ease, color .14s ease, border-color .14s ease;
}

.icon-btn:hover:not(:disabled) {
  border-color: var(--line);
  background: var(--panel-3);
  color: var(--accent);
}

.icon-btn.danger:hover:not(:disabled) {
  border-color: var(--red-line);
  background: var(--red-soft);
  color: var(--red);
}

.icon-btn:disabled {
  opacity: .35;
  cursor: not-allowed;
}

/* ---- 属性面板 ---- */
.inspector {
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
}

.inspector-scroll {
  min-height: 0;
  overflow-y: auto;
  padding: 12px;
}

.overview-card {
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--panel-2);
}

.overview-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  color: var(--ink-0);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.5px;
}

.overview-grid {
  margin-top: 12px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.overview-item {
  padding: 10px;
  border-radius: 12px;
  background: var(--field);
  border: 1px solid var(--line);
}

.overview-item span {
  display: block;
  color: var(--muted-2);
  font-size: 11px;
}

.overview-item b {
  display: block;
  margin-top: 4px;
  color: var(--ink-0);
  font-size: 18px;
  font-weight: 600;
}

.progress {
  margin-top: 12px;
  height: 6px;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(17, 24, 39, 0.08);
}

.progress > i {
  display: block;
  height: 100%;
  width: 0;
  border-radius: inherit;
  background: linear-gradient(90deg, #17d377, #0aa257);
  box-shadow: 0 0 10px rgba(10, 172, 95, 0.4);
  transition: width .2s ease;
}

.props-section {
  margin-top: 12px;
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--panel-2);
}

.props-section h3 {
  margin: 0 0 12px;
  color: var(--ink-0);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.5px;
}

.prop-desc {
  margin: -4px 0 12px;
  color: var(--muted-2);
  font-size: 12px;
  line-height: 1.6;
}

.field {
  margin-bottom: 12px;
}

.field:last-child {
  margin-bottom: 0;
}

.field label {
  display: block;
  margin-bottom: 6px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.3px;
}

.field input,
.field textarea,
.field select {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  outline: none;
  background: var(--field);
  color: var(--text);
  transition: border-color .14s ease, box-shadow .14s ease;
}

.field input,
.field select {
  height: 38px;
  padding: 0 10px;
}

.field textarea {
  min-height: 92px;
  padding: 9px 10px;
  resize: vertical;
  line-height: 1.55;
}

.field input:focus,
.field textarea:focus,
.field select:focus {
  border-color: var(--accent-border);
  box-shadow: 0 0 0 3px rgba(10, 172, 95, 0.12);
}

.field-hint {
  margin-top: 6px;
  color: var(--muted-2);
  font-size: 11px;
  line-height: 1.45;
}

.empty-inspector {
  height: 100%;
  display: grid;
  place-items: center;
  padding: 26px;
  color: var(--muted-2);
  text-align: center;
  line-height: 1.7;
}

.empty-inspector-icon {
  width: 56px;
  height: 56px;
  display: grid;
  place-items: center;
  margin: 0 auto 12px;
  border-radius: 16px;
  background: var(--panel-2);
  border: 1px solid var(--line);
  color: var(--muted);
  font-size: 24px;
}

/* ---- 运行日志 ---- */
.log {
  min-height: 0;
  display: grid;
  grid-template-rows: 40px minmax(0, 1fr);
  margin: 0 12px 12px;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: #0a0b0d;
  box-shadow: var(--shadow-soft);
}

.log-head {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 14px;
  border-bottom: 1px solid var(--line);
  color: var(--muted);
  font-size: 12px;
  letter-spacing: 1px;
}

.log-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #3a3d44;
}

.log-dot.on {
  background: var(--green);
  box-shadow: 0 0 0 4px rgba(10, 172, 95, 0.16);
}

.log-body {
  overflow-y: auto;
  padding: 10px 14px;
  color: #a8adb8;
  font-family: Consolas, "SFMono-Regular", Menlo, Monaco, monospace;
  font-size: 12px;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-word;
}

.log-body .ok { color: #6fe3a5; }
.log-body .err { color: #ff9187; }
.log-body .warn { color: #f0c67e; }

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* 统一：hidden 属性优先级最高，避免被类样式覆盖 */
[hidden] {
  display: none !important;
}

/* ---- 顶部模式切换（工作流编辑 / 脚本模式 / 创作） ---- */
.view-switch {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  padding: 3px;
  border-radius: 11px;
  background: rgba(17, 24, 39, 0.05);
  border: 1px solid var(--line);
}

.view-btn {
  height: 30px;
  padding: 0 14px;
  border: none;
  border-radius: 8px;
  background: transparent;
  color: var(--muted);
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  white-space: nowrap;
  transition: background .14s ease, color .14s ease, box-shadow .14s ease;
}

.view-btn:hover { color: var(--text); }

.view-btn.active {
  background: var(--panel-3);
  color: var(--ink-0);
  font-weight: 600;
  box-shadow: 0 1px 5px rgba(17, 24, 39, 0.14);
}

/* ---- 脚本模式 ---- */
.script-mode {
  min-height: 0;
  overflow-y: auto;
  padding: 12px;
}

.script-panel {
  max-width: 1160px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.script-head {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 15px 16px;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow-soft);
}

.script-head h2 {
  margin: 0;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.5px;
  color: var(--ink-0);
}

.script-sub {
  color: var(--muted-2);
  font-size: 12px;
}

.llm-status {
  height: 28px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 0 11px;
  border-radius: 999px;
  background: var(--amber-soft);
  color: #b9791e;
  border: 1px solid var(--amber-line);
  font-size: 12px;
  font-weight: 500;
  white-space: nowrap;
}

.llm-status.on {
  background: var(--green-soft);
  color: #0a8a4f;
  border-color: var(--green-line);
}

.script-layout {
  display: grid;
  grid-template-columns: minmax(340px, 5fr) minmax(0, 6fr);
  gap: 12px;
  align-items: stretch;
}

.script-input-col,
.script-result-col {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.script-card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow-soft);
  padding: 14px;
}

.script-card-title {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
  color: var(--ink-0);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.5px;
}

.script-card-title .spacer {
  flex: 1;
}

.script-textarea {
  width: 100%;
  min-height: 280px;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  outline: none;
  background: var(--field);
  color: var(--text);
  font-family: Consolas, "SFMono-Regular", Menlo, Monaco, monospace;
  font-size: 13px;
  line-height: 1.6;
  resize: vertical;
}

.script-textarea:focus {
  border-color: var(--accent-border);
  box-shadow: 0 0 0 3px rgba(10, 172, 95, 0.12);
}

.script-textarea::placeholder {
  color: var(--muted-2);
}

.script-toolbar {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 10px;
}

.script-tips {
  margin: 0;
  padding-left: 18px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.9;
}

.script-tips li {
  margin-bottom: 2px;
}

.script-tips code {
  background: var(--panel-3);
  border: 1px solid var(--line);
  border-radius: 5px;
  padding: 0 5px;
  color: #0a7a4a;
  font-family: Consolas, "Courier New", monospace;
  font-size: 11.5px;
}

.hint-card .script-card-title {
  margin-bottom: 6px;
}

.script-warnings {
  margin-bottom: 10px;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  background: var(--amber-soft);
  border: 1px solid var(--amber-line);
  color: #b9791e;
  font-size: 12px;
  line-height: 1.7;
}

.script-warnings b {
  color: #8f5e0e;
}

.script-warnings .warn-item {
  display: block;
}

.script-preview {
  min-height: 120px;
  max-height: 420px;
  overflow-y: auto;
  padding: 4px 2px;
}

.empty-script {
  padding: 40px 20px;
  text-align: center;
  color: var(--muted-2);
  font-size: 13px;
  border: 1px dashed var(--line-strong);
  border-radius: var(--radius-sm);
  background: rgba(17, 24, 39, 0.02);
}

/* 脚本模式步骤卡片 */
.script-step {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 8px;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--panel-2);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.22);
  cursor: pointer;
  transition: border-color .14s ease, box-shadow .14s ease, background .14s ease;
}

.script-step:hover {
  border-color: var(--line-strong);
  background: var(--panel-3);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
}

.script-step.selected {
  border-color: var(--accent);
  box-shadow: 0 0 0 1px var(--accent), 0 8px 20px rgba(10, 172, 95, 0.1);
}

/* 需要配图的步骤：琥珀色 = 待配图，绿色 = 已配图 */
.script-step.img {
  border-color: var(--amber-line);
  background: var(--amber-soft);
  box-shadow: 0 4px 14px rgba(214, 148, 32, 0.10);
}
.script-step.img .ss-index { background: rgba(233, 162, 59, 0.20); color: #a5650a; }
.script-step.img .ss-title { color: #8a5306; }
.script-step.img.filled {
  border-color: var(--green-line);
  background: rgba(10, 172, 95, 0.06);
  box-shadow: 0 4px 14px rgba(10, 172, 95, 0.08);
}
.script-step.img.filled .ss-index { background: var(--green-soft); color: #0a8a4f; }
.script-step.img.filled .ss-title { color: #0a7a4a; }
.script-step .ss-need {
  flex: none; padding: 2px 9px; border-radius: 999px; font-size: 11px; font-weight: 600;
  background: rgba(233, 162, 59, 0.18); color: #a5650a; border: 1px solid var(--amber-line);
}
.script-step .ss-need.ok { background: var(--green-soft); color: #0a8a4f; border-color: var(--green-line); }

.script-step .ss-index {
  flex: none;
  width: 26px;
  height: 22px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 12px;
  font-weight: 700;
}

.script-step .ss-icon {
  flex: none;
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: linear-gradient(145deg, #17d377, #0a9e56);
  color: #ffffff;
  font-size: 15px;
  font-weight: 700;
}

.script-step .ss-main {
  flex: 1;
  min-width: 0;
}

.script-step .ss-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
}

.script-step .ss-summary {
  margin-top: 2px;
  overflow: hidden;
  color: var(--muted-2);
  font-size: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.script-step .ss-ops {
  flex: none;
  display: flex;
  gap: 2px;
}

.script-edit-area {
  margin-top: 10px;
}

.script-edit-area .script-sub {
  display: block;
  margin-bottom: 6px;
}

.script-edit-area textarea {
  width: 100%;
  min-height: 120px;
  padding: 10px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  outline: none;
  background: var(--field);
  color: var(--text);
  font-family: Consolas, Menlo, monospace;
  font-size: 12px;
  line-height: 1.5;
  resize: vertical;
}

.script-edit-area textarea:focus {
  border-color: var(--accent-border);
  box-shadow: 0 0 0 3px rgba(10, 172, 95, 0.12);
}

.script-edit-area .row {
  display: flex;
  gap: 8px;
  margin-top: 8px;
}

/* ---- 创作生成面板 ---- */
.create-panel {
  max-width: 1440px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.create-head {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 15px 16px;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow-soft);
}

.create-head h2 {
  margin: 0;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.5px;
  color: var(--ink-0);
}

.create-sub {
  color: var(--muted-2);
  font-size: 12px;
}

.create-layout {
  display: grid;
  grid-template-columns: minmax(330px, 4fr) minmax(0, 6fr) minmax(270px, 3.1fr);
  gap: 12px;
  align-items: start;
}

.create-col {
  display: flex;
  flex-direction: column;
  gap: 12px;
  min-width: 0;
}

@media (max-width: 1180px) {
  .create-layout { grid-template-columns: minmax(320px, 5fr) minmax(0, 6fr); }
  .create-col.history-col { grid-column: 1 / -1; }
}

@media (max-width: 900px) {
  .create-layout { grid-template-columns: 1fr; }
  .create-col.history-col { grid-column: auto; }
}

.create-card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow-soft);
  padding: 14px;
}

.create-card-title {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
  color: var(--ink-0);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.5px;
}

.create-card-title .spacer { flex: 1; }

/* ---- 规则库 / 候选规则 ---- */
.gen-skills { display: flex; flex-direction: column; gap: 6px; max-height: 340px; overflow: auto; }
.gen-skill-item { border: 1px solid var(--line); border-radius: 10px; padding: 8px 10px; background: var(--panel-2); opacity: .5; }
.gen-skill-item.on { opacity: 1; border-color: var(--green-line); background: rgba(10, 172, 95, 0.07); }
.gsk-top { display: flex; align-items: center; gap: 6px; }
.gsk-check { display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 500; color: var(--text); cursor: pointer; }
.gsk-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 5px; font-size: 11px; color: var(--muted-2); }
.gsk-kind { background: rgba(71, 86, 216, 0.14); color: #4756d8; border-radius: 999px; padding: 1px 7px; font-size: 11px; white-space: nowrap; }
.gsk-kind.style { background: rgba(202, 138, 20, 0.13); color: #b9791e; }
.gsk-val { color: var(--muted); }
.gsk-hits { font-size: 11px; color: #b9791e; white-space: nowrap; }
.gsk-src { color: var(--muted-2); }
.gsk-edit { border: 1px solid var(--accent-border); background: var(--field); border-radius: 10px; padding: 8px; margin-bottom: 8px; display: flex; flex-direction: column; gap: 6px; }
.gsk-edit .gsk-row { display: flex; gap: 6px; align-items: center; }
.gsk-edit select, .gsk-edit input, .gsk-edit textarea { border: 1px solid var(--line); border-radius: 7px; padding: 4px 6px; font-size: 12px; font-family: inherit; color: var(--text); background: var(--panel-2); }
.gsk-edit input { flex: 1; min-width: 0; }
.gsk-edit textarea { min-height: 46px; resize: vertical; }
.gsk-edit .gsk-tip { font-size: 11px; color: var(--muted-2); line-height: 1.5; }
.gen-candidates { margin-top: 10px; border: 1px solid var(--accent-border); background: rgba(10, 172, 95, 0.06); border-radius: 10px; padding: 10px; }
.gsc-title { font-size: 13px; font-weight: 600; color: #0a8a4f; margin-bottom: 8px; }
.gsc-list { display: flex; flex-direction: column; gap: 6px; margin-bottom: 8px; }
.gsc-item { display: flex; align-items: flex-start; gap: 8px; background: var(--panel-2); border: 1px solid var(--line); border-radius: 9px; padding: 7px 9px; cursor: pointer; }
.gsc-main { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
.gsc-main b { font-size: 13px; color: var(--text); font-weight: 600; }
.gsc-sub { font-size: 11px; color: var(--muted-2); }
.gri-main { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
.gri-meta { font-size: 11px; color: var(--muted-2); }
.gri-score { color: #b9791e; }

.create-textarea {
  width: 100%;
  min-height: 120px;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  outline: none;
  background: var(--field);
  color: var(--text);
  font-family: Consolas, "SFMono-Regular", Menlo, Monaco, monospace;
  font-size: 13px;
  line-height: 1.6;
  resize: vertical;
}

.create-textarea:focus {
  border-color: var(--accent-border);
  box-shadow: 0 0 0 3px rgba(10, 172, 95, 0.12);
}

.create-field-label {
  display: block;
  margin: 10px 0 6px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.3px;
}

.gen-select {
  width: 100%;
  padding: 9px 12px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  outline: none;
  background: var(--field);
  font-size: 13px;
  color: var(--text);
}

.gen-select:focus {
  border-color: var(--accent-border);
  box-shadow: 0 0 0 3px rgba(10, 172, 95, 0.12);
}

/* 参考剧本管理器 */
.gen-refs {
  display: flex;
  flex-direction: column;
  gap: 6px;
  max-height: 220px;
  overflow-y: auto;
}

.gen-ref-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 10px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--panel-2);
}

.gen-ref-item.checked {
  border-color: var(--accent-border);
  background: rgba(10, 172, 95, 0.07);
}

.gen-ref-item .gri-check {
  flex: none;
  width: 16px;
  height: 16px;
}

.gen-ref-item .gri-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--text);
  font-size: 13px;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gen-ref-item .gri-del {
  flex: none;
}

/* 三色校验报告 */
.gen-report {
  display: none;
  margin-bottom: 12px;
  padding: 10px 14px;
  border-radius: var(--radius-sm);
  font-size: 12px;
  line-height: 1.6;
  border: 1px solid transparent;
}

.gen-report.show { display: block; }
.gen-report.ok { background: var(--green-soft); color: #0a8a4f; border-color: var(--green-line); }
.gen-report.warn { background: var(--amber-soft); color: #b9791e; border-color: var(--amber-line); }
.gen-report.err { background: var(--red-soft); color: #c73e35; border-color: var(--red-line); }

.gen-report b { font-weight: 700; }

.gen-report .gr-item { display: block; margin-top: 2px; }

.create-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin-top: 10px;
}

.create-toolbar .spacer { flex: 1; }

/* 生成结果步骤列表 */
.gen-steps {
  display: flex;
  flex-direction: column;
  gap: 4px;
  max-height: 260px;
  overflow-y: auto;
}

.gen-step {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 7px 10px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: var(--panel-2);
}

.gen-step .gs-index {
  flex: none;
  width: 22px;
  height: 20px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 11px;
  font-weight: 700;
}

.gen-step .gs-name {
  flex: none;
  color: var(--text);
  font-size: 12px;
  font-weight: 600;
}

.gen-step .gs-sum {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--muted-2);
  font-size: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 生成进度提示 */
.gen-progress {
  margin-bottom: 10px;
  padding: 9px 12px;
  border: 1px solid var(--accent-border);
  border-radius: var(--radius-sm);
  background: rgba(10, 172, 95, 0.07);
  color: #0a8a4f;
  font-size: 12px;
  font-weight: 500;
  line-height: 1.5;
}

/* 历史生成面板 */
.gen-history {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 10px;
  max-height: 560px;
  overflow-y: auto;
}

.gen-history-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 9px 10px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--panel-2);
  transition: border-color .14s ease, box-shadow .14s ease;
}

.gen-history-item:hover { border-color: var(--line-strong); }

.gen-history-item.active {
  border-color: var(--accent-border);
  background: rgba(10, 172, 95, 0.06);
  box-shadow: 0 0 0 3px rgba(10, 172, 95, 0.07);
}

.ghi-top {
  display: flex;
  align-items: flex-start;
  gap: 8px;
}

.ghi-brief {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--text);
  font-size: 13px;
  font-weight: 500;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.ghi-badge { flex: none; font-size: 12px; font-weight: 700; }
.ghi-badge.ok { color: #0a8a4f; }
.ghi-badge.err { color: #c73e35; }

.ghi-meta { color: var(--muted-2); font-size: 11px; }

.ghi-refs {
  overflow: hidden;
  color: var(--muted-2);
  font-size: 11px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ghi-actions {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 2px;
}

.ghi-actions .spacer { flex: 1; }

/* 星级评价 */
.gen-feedback {
  display: none;
  margin-top: 4px;
}
.gen-feedback.show { display: block; }

.star-row {
  display: flex;
  align-items: center;
  gap: 4px;
  margin: 8px 0;
}
.star {
  cursor: pointer;
  font-size: 22px;
  color: #c8ccd4;
  transition: color .14s ease, transform .14s ease;
}
.star:hover { transform: scale(1.15); }
.star.lit { color: #b9791e; }

/* ---- 大模型配置弹窗 ---- */
.llm-modal {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: grid;
  place-items: center;
  background: rgba(5, 6, 8, 0.62);
  backdrop-filter: blur(6px);
}

.llm-modal-card {
  width: min(430px, 92vw);
  padding: 20px;
  border-radius: 16px;
  background: var(--panel);
  border: 1px solid var(--line-strong);
  box-shadow: var(--shadow);
}

.llm-modal-card h3 {
  margin: 0 0 14px;
  color: var(--ink-0);
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.5px;
}

.llm-modal-card .row {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 14px;
}

.llm-modal-card .field-hint {
  margin-top: 10px;
}

/* ---- 运行确认弹窗：防止误点「运行并生成视频」直接开始录屏 ---- */
.run-modal {
  position: fixed;
  inset: 0;
  z-index: 110;
  display: grid;
  place-items: center;
  background: rgba(5, 6, 8, 0.66);
  backdrop-filter: blur(6px);
}

.run-modal-card {
  width: min(400px, 92vw);
  padding: 22px;
  border-radius: 16px;
  background: var(--panel);
  border: 1px solid var(--line-strong);
  box-shadow: var(--shadow);
  text-align: center;
}

.run-modal-icon {
  width: 58px;
  height: 58px;
  display: grid;
  place-items: center;
  margin: 0 auto 14px;
  border-radius: 16px;
  background: var(--amber-soft);
  border: 1px solid var(--amber-line);
  color: var(--amber);
  font-size: 26px;
}

.run-modal-card h3 {
  margin: 0 0 8px;
  color: var(--ink-0);
  font-size: 16px;
  font-weight: 600;
}

.run-modal-card p {
  margin: 0 0 4px;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
}

.run-modal-steps {
  margin: 12px 0 4px;
  display: flex;
  justify-content: center;
  gap: 10px;
}

.run-modal-steps .chip {
  padding: 6px 12px;
  border-radius: 999px;
  background: var(--accent-soft);
  border: 1px solid var(--accent-border);
  color: var(--accent);
  font-size: 12px;
  font-weight: 500;
}

.run-modal-speed {
  margin: 12px 0 0;
  font-size: 13px;
}

.run-modal-speed label {
  color: var(--text);
  font-weight: 500;
}

.run-modal-speed-hint {
  display: block;
  margin-top: 3px;
  color: var(--muted-2);
  font-size: 11.5px;
  line-height: 1.6;
}

.run-modal-card .row {
  display: flex;
  gap: 10px;
  justify-content: center;
  margin-top: 16px;
}

.run-modal-card .row .btn {
  flex: 1;
  height: 40px;
}

/* 运行确认弹窗：剧本图片（按顺序配图） */
.run-modal-images {
  margin-top: 14px;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--panel-2);
  text-align: left;
}
.run-modal-images.hidden-none { display: none; }
.run-image-head {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
}
.run-image-head .spacer { flex: 1; }
.run-image-head .btn { height: 30px; padding: 4px 12px; }
.run-image-status { font-size: 12px; color: var(--muted); }
.run-image-list {
  display: flex;
  flex-direction: column;
  gap: 7px;
  max-height: 200px;
  overflow: auto;
  padding: 2px;
}
.run-image-item {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  padding: 6px 8px;
  border-radius: 9px;
  background: var(--field);
  border: 1px solid var(--line);
}
.run-image-item .rum-thumb {
  flex: 0 0 40px;
  height: 40px;
  border-radius: 7px;
  background: var(--panel-2);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1px solid var(--line-strong);
}
.run-image-item .rum-thumb img { max-width: 100%; max-height: 100%; object-fit: cover; }
.run-image-item .rum-thumb.missing { font-size: 11px; color: var(--muted-2); }
.run-image-item .rum-info { flex: 1; min-width: 0; font-size: 12px; color: var(--muted); }
.run-image-item .rum-info b { color: var(--text); display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.run-image-item .rum-pick {
  flex: 0 0 auto;
  border: 1px solid var(--line-strong);
  background: var(--panel-2);
  color: var(--accent);
  border-radius: 7px;
  padding: 4px 10px;
  font-size: 12px;
  cursor: pointer;
}
.run-image-empty { font-size: 12px; color: var(--muted); padding: 2px 4px; }

/* ---- 离线使用手册 ---- */
.manual-overlay {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(5, 6, 8, 0.6);
  backdrop-filter: blur(6px);
}
.manual-overlay[hidden] { display: none; }
.manual-shell {
  width: min(1180px, 100%);
  height: min(880px, 100%);
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto;
  background: var(--panel);
  border: 1px solid var(--line-strong);
  border-radius: 16px;
  box-shadow: var(--shadow);
  overflow: hidden;
}
.manual-top {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 12px 16px;
  border-bottom: 1px solid var(--line);
  background: var(--panel-2);
}
.manual-title { display: flex; align-items: center; gap: 10px; font-weight: 600; color: var(--ink-0); }
.manual-title-icon { font-size: 20px; }
.manual-title-sub { display: block; margin-top: 1px; font-size: 11px; font-weight: 400; color: var(--muted-2); }
.manual-search { position: relative; flex: 1; max-width: 460px; margin-left: auto; display: flex; align-items: center; }
.manual-search-icon { position: absolute; left: 10px; font-size: 13px; opacity: .5; }
.manual-search input {
  width: 100%;
  height: 36px;
  padding: 0 30px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--field);
  color: var(--text);
  outline: none;
}
.manual-search input:focus { border-color: var(--accent-border); box-shadow: 0 0 0 3px rgba(10, 172, 95, 0.12); }
.manual-search-clear {
  position: absolute;
  right: 6px;
  width: 22px;
  height: 22px;
  border: 0;
  border-radius: 50%;
  background: var(--panel-3);
  color: var(--muted);
  cursor: pointer;
  line-height: 1;
}
.manual-close {
  width: 34px;
  height: 34px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--muted);
  font-size: 20px;
  cursor: pointer;
}
.manual-close:hover { background: var(--panel-3); color: var(--text); }
.manual-body { display: grid; grid-template-columns: 210px minmax(0, 1fr); min-height: 0; }
.manual-nav { overflow: auto; padding: 10px; border-right: 1px solid var(--line); background: var(--panel-2); }
.manual-nav-item {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 8px 10px;
  margin-bottom: 2px;
  border: 0;
  border-radius: 9px;
  background: transparent;
  color: var(--muted);
  font-weight: 500;
  font-size: 13px;
  cursor: pointer;
  text-align: left;
}
.manual-nav-item:hover { background: var(--panel-3); color: var(--text); }
.manual-nav-item.active { background: var(--accent-soft); color: var(--accent); }
.manual-nav-item .count { margin-left: auto; font-size: 11px; color: var(--muted-2); font-weight: 400; }
.manual-content { overflow: auto; padding: 18px 22px 40px; }
.manual-section { margin-bottom: 26px; }
.manual-section-head { display: flex; align-items: baseline; gap: 8px; margin-bottom: 4px; }
.manual-section-head h2 { margin: 0; font-size: 17px; font-weight: 600; color: var(--ink-0); }
.manual-section-intro { margin: 0 0 14px; color: var(--muted); font-size: 13px; line-height: 1.7; }
.manual-item {
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 10px;
  background: var(--panel-2);
}
.manual-item:hover { border-color: var(--line-strong); }
.manual-item-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.manual-item-name { font-weight: 600; color: var(--text); }
.manual-item-tag {
  font-size: 11px;
  color: var(--accent);
  background: var(--accent-soft);
  border-radius: 999px;
  padding: 1px 8px;
  font-weight: 500;
}
.manual-item-desc { margin: 6px 0 0; color: var(--muted); font-size: 13px; line-height: 1.75; white-space: pre-wrap; }
.manual-syntax {
  display: block;
  margin: 8px 0 0;
  padding: 8px 10px;
  background: #0a0b0d;
  border: 1px solid var(--line);
  color: #7ee2ac;
  border-radius: 8px;
  font-family: Consolas, "Courier New", monospace;
  font-size: 12.5px;
  white-space: pre-wrap;
  word-break: break-word;
  overflow-x: auto;
}
.manual-item ul { margin: 8px 0 0 18px; padding: 0; color: var(--muted); font-size: 12.5px; line-height: 1.75; }
.manual-item li { margin: 3px 0; }
.manual-example-label { margin: 10px 0 4px; font-size: 11px; font-weight: 600; color: var(--muted-2); letter-spacing: 0.5px; }
.manual-empty { padding: 60px 20px; text-align: center; color: var(--muted-2); }
.manual-foot {
  padding: 8px 16px;
  border-top: 1px solid var(--line);
  background: var(--panel-2);
  color: var(--muted-2);
  font-size: 12px;
  display: flex;
  gap: 10px;
  align-items: center;
}
.manual-foot b { color: var(--muted); }
.manual-hit { background: rgba(202, 138, 20, 0.32); border-radius: 3px; color: #7a5200; }
@media (max-width: 760px) {
  .manual-body { grid-template-columns: 1fr; }
  .manual-nav { display: none; }
}

@media (max-width: 1080px) {
  .script-layout {
    grid-template-columns: 1fr;
  }
}

/* ---- 实时手机画面浮窗 ---- */
.live-panel {
  position: fixed;
  top: calc(var(--topbar-h) + 12px);
  right: 12px;
  z-index: 60;
  width: 302px;
  overflow: hidden;
  border: 1px solid var(--line-strong);
  border-radius: 18px;
  background: #0b0c0e;
  box-shadow: var(--shadow);
}

.live-head {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 9px 12px;
  border-bottom: 1px solid var(--line);
  background: #121317;
  color: #dfe2e8;
  font-size: 12px;
  font-weight: 600;
}

.live-head .spacer {
  flex: 1;
}

.live-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #3a3d44;
}

.live-dot.on {
  background: var(--green);
  box-shadow: 0 0 0 4px rgba(10, 172, 95, 0.16);
  animation: pulse 1s infinite;
}

.live-close {
  width: 26px;
  height: 26px;
  display: grid;
  place-items: center;
  border: none;
  border-radius: 8px;
  background: transparent;
  color: var(--muted-2);
  cursor: pointer;
}

.live-close:hover {
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
}

.live-body {
  position: relative;
  padding: 12px;
  background: #000;
}

.phone-screen {
  position: relative;
  aspect-ratio: 600 / 1300;
  overflow: hidden;
  border-radius: 20px;
  background: #000;
  border: 1px solid #26282e;
}

.phone-screen img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.phone-screen img.loading {
  opacity: .35;
}

.live-empty {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: grid;
  place-items: center;
  padding: 20px;
  color: var(--muted-2);
  font-size: 12px;
  line-height: 1.9;
  text-align: center;
  pointer-events: none;
}

.live-empty .dot {
  font-size: 26px;
  margin-bottom: 8px;
}

.live-tip {
  padding: 8px 12px;
  border-top: 1px solid var(--line);
  background: #121317;
  color: var(--muted-2);
  font-size: 11px;
  line-height: 1.6;
  text-align: center;
}

/* ---- 编辑模式：操作/编辑切换 + 元素编辑弹窗 + 打字栏 ---- */
.live-modes {
  display: flex;
  align-items: center;
  gap: 4px;
}

.mode-btn {
  height: 24px;
  padding: 0 8px;
  border: 1px solid var(--line-strong);
  border-radius: 999px;
  background: transparent;
  color: var(--muted);
  font-size: 11px;
  cursor: pointer;
  white-space: nowrap;
  transition: background .14s ease, color .14s ease, border-color .14s ease;
}

.mode-btn.active {
  background: var(--accent-strong);
  border-color: var(--accent-strong);
  color: #ffffff;
}

.phone-screen.editable {
  cursor: crosshair;
}

.edit-pop {
  position: absolute;
  z-index: 5;
  width: 232px;
  max-width: 92%;
  padding: 10px;
  border-radius: 12px;
  background: rgba(14, 15, 18, 0.96);
  border: 1px solid var(--line-strong);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
  color: #dfe2e8;
  font-size: 12px;
}

.edit-pop .ep-kind {
  margin-bottom: 6px;
  color: #7ee2ac;
  font-size: 11px;
  font-weight: 600;
}

.edit-pop input {
  width: 100%;
  height: 30px;
  padding: 0 8px;
  margin-bottom: 8px;
  border: 1px solid var(--line-strong);
  border-radius: 8px;
  background: #0a0b0d;
  color: #fff;
  font-size: 12px;
  outline: none;
}

.edit-pop .ep-actions {
  display: flex;
  gap: 6px;
  justify-content: flex-end;
}

.edit-pop .ep-actions button {
  height: 26px;
  padding: 0 10px;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-size: 12px;
}

.edit-pop .ep-save {
  background: var(--accent-strong);
  color: #ffffff;
}

.edit-pop .ep-cancel {
  background: var(--panel-3);
  color: var(--muted);
}

.edit-pop .ep-hint {
  margin-top: 8px;
  color: var(--muted-2);
  font-size: 10px;
  line-height: 1.55;
}

.live-typebar {
  display: flex;
  gap: 6px;
  padding: 8px 10px;
  border-top: 1px solid var(--line);
  background: #121317;
}

.live-typebar input {
  flex: 1;
  min-width: 0;
  height: 30px;
  padding: 0 8px;
  border: 1px solid var(--line-strong);
  border-radius: 8px;
  background: #0a0b0d;
  color: #fff;
  font-size: 12px;
  outline: none;
}

.live-typebar input::placeholder {
  color: var(--muted-2);
}

.live-typebar button {
  height: 30px;
  padding: 0 12px;
  border: none;
  border-radius: 8px;
  background: var(--accent-strong);
  color: #ffffff;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
}

@media (max-width: 1180px) {
  .workspace {
    grid-template-columns: 230px minmax(0, 1fr) 310px;
  }

  .brand {
    min-width: 190px;
  }

  .flow-name {
    width: 220px;
  }

  .btn .optional-text {
    display: none;
  }
}

@media (max-width: 900px) {
  body {
    overflow: auto;
  }

  .app {
    min-height: 100vh;
    height: auto;
    grid-template-rows: auto auto 176px;
  }

  .topbar {
    height: auto;
    min-height: var(--topbar-h);
    flex-wrap: wrap;
    padding: 10px;
  }

  .brand,
  .flow-name,
  .toolbar-group {
    min-width: 0;
  }

  .flow-name {
    width: min(100%, 260px);
  }

  .workspace {
    grid-template-columns: 1fr;
    overflow: visible;
  }

  .sidebar,
  .board,
  .inspector {
    min-height: 360px;
  }

  .palette-scroll {
    max-height: 320px;
  }

  .board-actions {
    flex-wrap: wrap;
  }

  .log {
    margin-left: 10px;
    margin-right: 10px;
  }
}


  /* ---- UI v2: 顶栏菜单与统一尺寸 ---- */
  .topbar .btn { height: 32px; }
  .topbar .btn.small { height: 30px; }
  .topbar .btn.primary { height: 34px; }
  .menu-wrap { position: relative; display: inline-flex; }
  .menu-btn .caret { font-style: normal; font-size: 10px; opacity: .55; margin-left: 3px; }
  .menu {
    position: absolute; top: calc(100% + 6px); left: 0; z-index: 90;
    min-width: 176px; display: none; flex-direction: column; gap: 2px; padding: 6px;
    background: var(--panel); border: 1px solid var(--line-strong); border-radius: 12px;
    box-shadow: var(--shadow-pop, 0 12px 32px rgba(17, 24, 39, 0.14));
  }
  .menu-wrap.open .menu { display: flex; }
  .menu .btn, .menu button {
    display: flex; width: 100%; align-items: center; justify-content: flex-start; gap: 8px;
    height: 34px; padding: 0 10px; border: 0; border-radius: 8px; background: transparent;
    transform: none; box-shadow: none;
  }
  .menu .btn:hover, .menu button:hover { background: var(--panel-2); border: 0; transform: none; }
  .menu-sep { height: 1px; margin: 4px 6px; background: var(--line); }

  /* ---- UI v2: 分段式视图切换 ---- */
  .view-switch {
    display: inline-flex; align-items: center; gap: 2px; padding: 3px;
    border-radius: 11px; background: var(--panel-2); border: 1px solid var(--line);
  }
  .view-btn {
    height: 30px; padding: 0 13px; border: none; border-radius: 8px; background: transparent;
    color: var(--muted); font-size: 13px; font-weight: 500; cursor: pointer; white-space: nowrap;
    transition: background .14s ease, color .14s ease, box-shadow .14s ease;
  }
  .view-btn:hover { color: var(--text); }
  .view-btn.active { background: #ffffff; color: var(--ink-0); font-weight: 600; box-shadow: 0 1px 5px rgba(17, 24, 39, 0.14); }

  /* 深色部件与浅色界面的接缝 */
  .log { border-color: rgba(255, 255, 255, 0.08); }
  .log-head { border-color: rgba(255, 255, 255, 0.08); }
  .manual-syntax { border-color: rgba(255, 255, 255, 0.08); }
  .live-panel { border-color: #26282e; }
  .live-head { border-color: rgba(255, 255, 255, 0.08); }
  .live-tip { border-color: rgba(255, 255, 255, 0.08); }
  .live-typebar { border-color: rgba(255, 255, 255, 0.08); }
  .edit-pop { border-color: rgba(255, 255, 255, 0.14); }
  .phone-screen { border-color: #26282e; }

/* ---------- 帮助问号（?）与说明浮层 ---------- */
.hq-wrap { position: relative; display: inline-flex; }
.hq {
  flex: none; width: 18px; height: 18px; display: inline-grid; place-items: center; padding: 0;
  border: 1px solid var(--line); border-radius: 50%; background: var(--panel-2);
  color: var(--muted); font-size: 11px; font-weight: 700; line-height: 1; cursor: help;
}
.hq:hover { color: var(--accent); border-color: var(--accent-border); background: var(--panel-3); }
.hq-pop {
  position: absolute; top: 26px; left: 0; z-index: 80;
  width: min(600px, 86vw); max-height: 68vh; overflow: auto; padding: 12px 14px;
  border: 1px solid var(--line-strong); border-radius: 12px;
  background: var(--panel); box-shadow: 0 14px 34px rgba(0, 0, 0, 0.22); color: var(--text);
}
.hq-pop .script-tips { margin: 0; padding-left: 16px; color: var(--muted); font-size: 12px; line-height: 1.9; }

/* ---------- 脚本模式：左右等高，输入区撑满 ---------- */
.script-input-col { display: flex; flex-direction: column; min-width: 0; }
.script-input-col > .script-card { flex: 1; display: flex; flex-direction: column; }
.script-input-col .script-textarea { flex: 1; min-height: 380px; }
.script-result-col > .script-card { flex: 1; display: flex; flex-direction: column; }
.script-result-col .script-preview { flex: 1; }
</style>
</head>
<body>
  <div class="app">
      <header class="topbar">
      <div class="brand" title="微信录屏工作流可视化编辑器">
        <div class="brand-mark">微</div>
        <div>
          工作流编辑器
          <span class="brand-sub">可视化编排 · 本地运行 · 自动生成视频</span>
        </div>
      </div>

      <div class="view-switch" role="tablist">
        <button type="button" class="view-btn active" id="btnViewFlow" role="tab">工作流编辑</button>
        <button type="button" class="view-btn" id="btnViewScript" role="tab">脚本模式</button>
        <button type="button" class="view-btn" id="btnViewGenerate" role="tab">✨ 创作</button>
      </div>

      <div class="menu-wrap" id="fileMenuWrap">
        <button type="button" class="btn small menu-btn" id="btnFileMenu">文件<i class="caret">▾</i></button>
        <div class="menu">
          <button type="button" class="btn small menu-item" id="btnNew">新建流程</button>
          <button type="button" class="btn small menu-item" id="btnLoad">载入流程</button>
          <button type="button" class="btn small menu-item" id="btnSave">保存流程</button>
          <div class="menu-sep"></div>
          <button type="button" class="btn small menu-item" id="btnImport">导入 JSON…</button>
          <button type="button" class="btn small menu-item" id="btnExport">导出 JSON…</button>
        </div>
      </div>
      <input type="file" id="fileInput" class="sr-only" accept=".json,application/json">

      <input class="flow-name" id="flowName" value="未命名流程" placeholder="流程名称" aria-label="流程名称">

      <div class="spacer"></div>

      <div class="toolbar-group">
        <button type="button" class="btn small" id="btnScene" title="打开独立的场景编辑器：可放大、点选即改联系人/消息/朋友圈，一键生成工作流">🎬 场景</button>
        <button type="button" class="btn small" id="btnConcurrent" title="并发生产：一次导入多条剧本，各自解析/配图后同时跑批出片">⚡ 并发</button>
        <button type="button" class="btn small" id="btnManual" title="打开离线使用手册：所有功能的书写格式与用法，支持搜索">📖 手册</button>
      </div>

      <div class="menu-wrap" id="toolMenuWrap">
        <button type="button" class="btn small menu-btn" id="btnToolMenu">工具<i class="caret">▾</i></button>
        <div class="menu">
          <button type="button" class="btn small menu-item" id="btnEditMode" title="进入编辑模式：实时画面可点击操作（进聊天/切页），并可直接点选元素修改文字、头像、背景">✏️ 编辑模式</button>
          <button type="button" class="btn small menu-item" id="btnLive">📱 实时画面</button>
          <button type="button" class="btn small menu-item" id="btnShot">📷 截图预览</button>
          <button type="button" class="btn small menu-item" id="btnVideos">📂 视频目录</button>
        </div>
      </div>

      <span class="status-pill" id="statusPill">就绪</span>
      <button type="button" class="btn small danger" id="btnStop" disabled>停止</button>
      <button type="button" class="btn primary" id="btnRun">▶ 运行并生成视频</button>
      <span class="save-state" id="saveState">本地已保存</span>
    </header>

    <div class="workspace" id="workspaceView">
      <aside class="panel sidebar">
        <div class="panel-title">
          <h2>动作库</h2>
          <span id="actionCount">0 个</span>
        </div>
        <div class="search-box">
          <input id="searchBox" type="search" placeholder="搜索动作，例如：打字、朋友圈、等待">
        </div>
        <div class="palette-scroll" id="palette"></div>
      </aside>

      <section class="panel board">
        <div class="board-toolbar">
          <div class="stats">
            <span class="stat-chip">步骤 <b id="stepCount">0</b></span>
            <span class="stat-chip">预计 <b id="estTime">0.0s</b></span>
            <span class="stat-chip">当前 <b id="selectedInfo">无</b></span>
          </div>
          <div class="board-actions">
            <button type="button" class="btn small" id="btnUndo" title="撤销上一步操作 (Ctrl+Z)" disabled>↶ 撤销</button>
            <button type="button" class="btn small" id="btnRedo" title="重做 (Ctrl+Y 或 Ctrl+Shift+Z)" disabled>↷ 重做</button>
            <button type="button" class="btn small" id="btnDuplicate" disabled>复制步骤</button>
            <button type="button" class="btn small danger" id="btnDelete" disabled>删除步骤</button>
            <button type="button" class="btn small primary-soft" id="btnRunFrom" title="从当前选中的步骤开始运行，用于快速试跑">▶ 从当前步骤运行</button>
          </div>
        </div>
        <div class="visual-wrap">
          <div class="flow-canvas" id="flowCanvas"></div>
        </div>
      </section>

      <aside class="panel inspector" id="propsPanel"></aside>
    </div>

    <!-- ============ 脚本模式：粘贴剧本 → AI 转译 → 预览确认 → 一键运行 ============ -->
    <section class="script-mode" id="scriptMode" hidden>
      <div class="script-panel">
        <div class="script-head">
          <h2>脚本模式</h2>
          <span class="script-sub">粘贴剧本 → AI 转译补全 → 预览确认 → 一键运行录屏</span>
          <span class="spacer"></span>
          <span class="llm-status" id="llmStatus">未配置大模型</span>
          <button type="button" class="btn small" id="btnLlmConfig" title="配置 DeepSeek API Key（只存本地 settings.json）">⚙ 配置大模型</button>
        </div>

        <div class="script-layout">
          <div class="script-input-col">
            <div class="script-card">
              <div class="script-card-title">剧本文本
                <span class="script-sub">支持标准格式，也支持松散自然语言</span>
                <span class="hq-wrap"><button type="button" class="hq" data-help="#scriptHelpSrc" title="使用说明">?</button></span>
              </div>
              <textarea id="scriptInput" class="script-textarea" spellcheck="false"
                placeholder="在这里粘贴剧本，例如：&#10;&#10;[回到聊天主页]&#10;[等待] 0.5&#10;[打开聊天] 小明&#10;[等待] 0.8&#10;[我方打字] 在吗，晚上的方案改好了发你&#10;[等待] 0.5&#10;[对方正在输入] 1.2&#10;[对方发消息] 好的，辛苦啦&#10;&#10;也可以直接写自然语言：&#10;我和小明聊了下周聚餐，他说周三有空，我回复好的到时候见。"></textarea>
              <div class="script-toolbar">
                <button type="button" class="btn primary" id="btnTranslate" title="调用 DeepSeek V4 Flash 翻译并补全仿真动作">🤖 AI 转译剧本</button>
                <button type="button" class="btn" id="btnOffline" title="不调用大模型，直接按标准格式解析">⚙ 离线解析</button>
                <button type="button" class="btn" id="btnInsertImg" title="在剧本里插入一条图片消息：转译后会成为一个待配图的卡槽，运行时可点「上传图片」按顺序配图">🖼 插入图片消息</button>
                <button type="button" class="btn" id="btnInsertHistory" title="在剧本里插入一段「历史会话块」：写会话名+人名+对白，转译后自动变成一条 [编辑主页]，进聊天前消息已存在">📜 插入历史会话</button>
                <span class="spacer"></span>
                <button type="button" class="btn small ghost" id="btnLoadExample">载入示例</button>
                <button type="button" class="btn small ghost" id="btnClearScript">清空</button>
              </div>
            </div>
            <div class="hq-src" id="scriptHelpSrc" hidden><ol class="script-tips">
                <li>先点「配置大模型」填入你的 DeepSeek API Key（只存本机 settings.json，不回显）。</li>
                <li>粘贴剧本后点「AI 转译剧本」：大模型会补全前置动作、等待、对方正在输入等仿真细节，并为名单外的联系人自动生成会话列表。</li>
                <li>转译结果在右侧逐条预览，可上移/下移/删除，点卡片可编辑参数；确认无误后点「运行并生成视频」。</li>
                <li>没有 API Key 或断网时，点「离线解析」仍可解析标准格式剧本。</li>
                <li>想精确控制节奏：在剧本里写 <code>[等待] 0.4</code>、<code>[对方正在输入] 0.5</code> 会按你写的秒数停；<code>[打字不发] 内容 | 0.3</code> 里的 <code>| 0.3</code> 表示打字后停留 0.3 秒，不写 <code>| 秒数</code> 则用默认。</li>
                <li>要配图时：点「🖼 插入图片消息」，或在剧本里写一条「[对方发图片] [图片] 描述」（想让你发就写「[发送图片]」）。转译后它会成为一个「待配图」卡槽；运行时在确认框点「📤 上传图片（按顺序）」即可按图1、图2 顺序配上图片。</li>
                <li>要给某个聊天写「历史记录」（进聊天前已存在的消息）：最省事是点顶部「🎬 场景编辑器」，在会话的「消息」tab 逐条添加后保存，再在剧本开头加一步「[应用场景] scene.json」；或直接在剧本里用「[编辑主页]」，在数据数组的每个会话里写 messages，每条含 dir（me 我方 / peer 对方）、kind（text 文字 / image 图片 / voice 语音）、text 内容、time 时间（可省）——「me 我」显示右侧绿色气泡，「peer 对方」显示左侧白气泡。</li>
                <li>更省事的写法：用「段落」历史会话块，把会话名、人名、对白直接写进剧本，系统自动转成 [编辑主页]，无需手写 JSON。格式：<code>[历史会话]</code> 开头，<code>[会话] 联系人名</code> 切分多个会话，下面每行一条「说话人：内容」，消息可用 <code>[图片]</code> / <code>[语音]</code>（可带秒数如 <code>[语音] 5秒</code>）标记，最后 <code>[历史会话结束]</code> 收尾；历史块之后照常写你的动作剧本即可。</li>
              </ol></div>
          </div>

          <div class="script-result-col">
            <div class="script-card">
              <div class="script-card-title">
                <span>转译结果</span>
                <span class="script-sub" id="scriptStats">0 步</span>
                <span class="spacer"></span>
                <button type="button" class="btn small" id="btnMoments" title="编辑朋友圈内容，并决定进朋友圈后打开哪张图 / 哪个视频、各看多久">🍩 朋友圈</button>
                <button type="button" class="btn primary" id="btnRunScript" title="按当前步骤列表运行并生成视频">▶ 运行并生成视频</button>
              </div>
              <div class="script-warnings" id="scriptWarnings" hidden></div>
              <div class="script-preview" id="scriptPreview">
                <div class="empty-script">转译结果会显示在这里，可编辑确认后运行。</div>
              </div>
              <div class="script-edit-area" id="scriptEditArea" hidden>
                <span class="script-sub">编辑选中步骤（JSON）</span>
                <textarea id="scriptEditJson" spellcheck="false"></textarea>
                <div class="row">
                  <button type="button" class="btn small" id="btnApplyEdit">应用修改</button>
                  <button type="button" class="btn small ghost" id="btnCancelEdit">取消</button>
                </div>
              </div>
              <div id="scriptAttach" style="display:none; margin-top:2px"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 创作生成：主题 + 参考剧本 → AI 生成完整剧本 → 校验报告 → 用于脚本模式 ============ -->
    <section class="script-mode" id="generateMode" hidden>
      <div class="create-panel">
        <div class="create-head">
          <h2>✨ AI 创作生成</h2>
          <span class="create-sub">输入主题 + 挑参考剧本 → 生成"男追女聊天教学"完整剧本 → 校验纠错 → 运用于脚本模式</span>
          <span class="spacer"></span>
          <span class="llm-status" id="genLlmStatus">未配置大模型</span>
        </div>

        <div class="create-layout">
          <div class="create-col">
            <div class="create-card">
              <div class="create-card-title">创作主题
                <span class="create-sub">一句话说清这段聊天教学要求</span>
                <span class="hq-wrap"><button type="button" class="hq" data-help="#createHelpSrc" title="使用说明">?</button></span>
              </div>
              <textarea id="genBrief" class="create-textarea" spellcheck="false"
                placeholder="例如：女生说加班好累，怎么共情安慰，再拉升情绪，最后自然邀约吃饭。"></textarea>

              <label class="create-field-label" for="genCategory">人物类别（主演女生归属）</label>
              <select id="genCategory" class="gen-select">
                <option value="">不限</option>
                <option value="美女">美女</option>
                <option value="学员">学员</option>
              </select>

              <label class="create-field-label">参考剧本（勾选后作为风格模板，可多选；留空则自由创作）
                <span class="create-sub" id="genRefHint" style="font-weight:400">已选 0 个</span>
              </label>
              <div class="gen-refs" id="genRefs">
                <div class="empty-script">加载中…</div>
              </div>

              <div class="create-toolbar">
                <button type="button" class="btn primary" id="btnGenerate" title="调用大模型生成完整剧本并自动校验纠错">✨ 生成剧本</button>
                <button type="button" class="btn" id="btnGenRefreshRefs" title="重新读取参考剧本库">刷新参考</button>
                <button type="button" class="btn small ghost" id="btnGenClearRefs" title="取消所有已勾选的参考剧本">清空选择</button>
                <span class="spacer"></span>
                <button type="button" class="btn small ghost" id="btnGenAddRef" title="把粘贴的剧本文本加入参考剧本库">存为参考</button>
              </div>
              <div class="script-card-title" style="margin-top:8px">新增参考剧本
                <span class="create-sub">粘贴一段标准 [指令] 剧本；标题留空会自动按内容生成</span>
              </div>
              <input id="genNewRefTitle" class="gen-select" type="text" style="margin-bottom:6px"
                     placeholder="标题（可留空自动生成，例如：已读不回 · 共情+邀约）" spellcheck="false">
              <textarea id="genNewRef" class="create-textarea" style="min-height:80px" spellcheck="false"
                placeholder="粘贴你要参考的剧本…"></textarea>
            </div>

            <div class="hq-src" id="createHelpSrc" hidden><ol class="script-tips">
                <li>生成需要先把顶部「配置大模型」填入 DeepSeek API Key。</li>
                <li>填好创作主题，勾选 1~2 个最贴近的参考剧本，点「生成剧本」（或按 Ctrl+Enter）；大模型会按参考剧本的结构与手法产出完整剧本，并自动做格式/完整性校验与自我纠错。</li>
                <li>中间会显示绿/黄/红三色校验报告、生成文本与步骤预览；点「✓ 使用到脚本模式」即可在脚本模式里编辑、配图、一键运行录屏。</li>
                <li>每次生成都会自动存进右侧「历史生成」：可搜索、载入回看、复制或删除；打分后历史条目上会显示星级，刷新页面也不丢。</li>
                <li>主题、人物类别和勾选的参考剧本会记在本地，刷新后自动恢复。</li>
                <li>运行看完后，在「评价本次创作」给 1~5 星并留言，系统会沉淀为长期偏好，下次生成自动参考，越写越好。</li>
              </ol></div>
          </div>

          <div class="create-col">
            <div class="create-card">
              <div class="create-card-title">
                <span>生成结果</span>
                <span class="spacer"></span>
                <button type="button" class="btn small ghost" id="btnGenCopy" title="复制生成文本" disabled>复制</button>
                <button type="button" class="btn small ghost" id="btnGenRegen" title="用当前主题重新生成一版" disabled>重新生成</button>
                <button type="button" class="btn primary" id="btnGenUse" title="把这份剧本用到脚本模式里编辑与运行" disabled>✓ 使用到脚本模式</button>
              </div>
              <div class="gen-progress" id="genProgress" hidden></div>
              <div class="gen-report" id="genReport"></div>
              <div class="script-card-title" style="margin-top:6px">生成文本（[指令]，可直接编辑）
                <span class="spacer"></span>
                <span class="create-sub" id="genStats">0 步 · 0 字</span>
              </div>
              <textarea id="genText" class="create-textarea" spellcheck="false" placeholder="生成的剧本会显示在这里，可在此修改，再用到脚本模式。"></textarea>
              <div class="script-card-title" style="margin-top:10px">步骤预览</div>
              <div class="gen-steps" id="genSteps"><div class="empty-script">生成后这里会预览步骤。</div></div>

              <div class="gen-feedback" id="genFeedback">
                <div class="script-card-title" style="margin-top:12px">评价本次创作
                  <span class="create-sub">打分并留言，帮 AI 越写越好</span>
                </div>
                <div class="star-row" id="genStarRow">
                  <span class="star" data-v="1">★</span>
                  <span class="star" data-v="2">★</span>
                  <span class="star" data-v="3">★</span>
                  <span class="star" data-v="4">★</span>
                  <span class="star" data-v="5">★</span>
                </div>
                <textarea id="genComment" class="create-textarea" style="min-height:60px" spellcheck="false"
                  placeholder="说说什么好、哪里不足（提交后会拆成可校验的规则，你确认后生效）…"></textarea>
                <div class="create-toolbar">
                  <button type="button" class="btn primary" id="btnGenFeedback">提交评价</button>
                  <span class="create-sub" id="genFeedbackHint"></span>
                </div>
                <div class="gen-candidates" id="genCandidates" hidden></div>
              </div>
            </div>
          </div>

          <div class="create-col history-col">
            <div class="create-card">
              <div class="create-card-title">
                <span>规则库（评价沉淀）</span>
                <span class="create-sub" id="genSkillCount">0 条</span>
                <span class="spacer"></span>
                <button type="button" class="btn small ghost" id="btnGenSkillAdd" title="手动新增一条规则">＋ 新增</button>
                <button type="button" class="btn small ghost" id="btnGenSkillRefresh" title="重新读取规则库">刷新</button>
              </div>
              <div class="create-sub" style="margin-bottom:6px;line-height:1.5">
                勾选启用后，生成时既写进提示词，也会被逐条校验；「命中」表示它拦下过多少次违规。
                点「编辑」可以自己改类型和数值。
              </div>
              <div id="genSkillEditor" hidden></div>
              <div class="gen-skills" id="genSkillList">
                <div class="empty-script">还没有规则，提交评价后会自动拆解。</div>
              </div>
              <div class="create-sub" style="margin:12px 0 6px;line-height:1.5">
                历史评价（最近 20 条，提交即生效）
              </div>
              <div class="gen-skills" id="genFeedbackList">
                <div class="empty-script">还没有评价记录。</div>
              </div>
            </div>
            <div class="create-card">
              <div class="create-card-title">
                <span>历史生成</span>
                <span class="create-sub" id="genHistoryCount">0 条</span>
                <span class="spacer"></span>
                <button type="button" class="btn small ghost" id="btnGenHistoryRefresh" title="重新读取生成历史">刷新</button>
                <button type="button" class="btn small ghost" id="btnGenHistoryClear" title="清空全部生成历史">清空</button>
              </div>
              <input id="genHistorySearch" class="gen-select" type="search"
                     placeholder="搜索创作主题 / 参考剧本…" spellcheck="false">
              <div class="gen-history" id="genHistoryList">
                <div class="empty-script">还没有生成记录。</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="log">
      <div class="log-head">
        <span class="log-dot" id="logDot"></span>
        <span>运行日志</span>
        <span style="flex:1"></span>
        <button type="button" class="btn small ghost" id="btnClearLog">清空</button>
      </div>
      <div class="log-body" id="logBody">编辑器已启动。请先从左侧添加动作，再在中间可视化流程中调整顺序。</div>
    </section>
  </div>

  <!-- 大模型配置弹窗：API Key 只存本地 settings.json，不回显明文 -->
  <div class="llm-modal" id="llmModal" hidden>
    <div class="llm-modal-card">
      <h3>配置 DeepSeek 大模型</h3>
      <div class="field">
        <label>API Key</label>
        <input id="llmApiKey" type="password" placeholder="sk-..." autocomplete="off" spellcheck="false">
      </div>
      <div class="field">
        <label>模型</label>
        <select id="llmModel">
          <option value="deepseek-flash">deepseek-flash（推荐）</option>
          <option value="deepseek-v4-pro">deepseek-v4-pro</option>
          <option value="deepseek-chat">deepseek-chat</option>
          <option value="deepseek-reasoner">deepseek-reasoner</option>
        </select>
      </div>
      <div class="field">
        <label>Base URL（一般保持默认）</label>
        <input id="llmBaseUrl" type="text" value="https://api.deepseek.com" spellcheck="false">
      </div>
      <div class="row">
        <button type="button" class="btn ghost" id="btnCancelLlm">取消</button>
        <button type="button" class="btn primary" id="btnSaveLlm">保存</button>
      </div>
      <p class="field-hint">Key 只保存在本机 settings.json，界面上不回显明文。没有 Key 或断网时，「离线解析」仍可解析标准格式剧本。</p>
    </div>
  </div>

  <!-- 运行确认弹窗：确认后才开始录屏，避免误点「运行并生成视频」直接触发 -->
  <div class="run-modal" id="confirmRunModal" hidden>
    <div class="run-modal-card">
      <div class="run-modal-icon">🎬</div>
      <h3 id="runConfirmTitle">确认开始制作视频？</h3>
      <p id="runConfirmDesc">即将运行工作流并生成视频。</p>
      <div class="run-modal-steps">
        <span class="chip" id="runConfirmSteps"></span>
        <span class="chip" id="runConfirmTime"></span>
      </div>
      <div class="run-modal-speed">
        <label for="runTypingSpeed">打字倍速</label>
        <input type="number" id="runTypingSpeed" min="1" max="40" step="1" value="30"
               title=">1 时只加快打字动画（按键节奏/拼音选字/删除回删），翻页、滚动、等待等其它动作保持正常">
        <span class="run-modal-speed-hint">只加快打字，其它正常；≥20 用原生持续打字声（默认 30）</span>
      </div>
      <div class="run-modal-speed">
        <label style="display:inline-flex;align-items:center;gap:6px;cursor:pointer;color:var(--text);font-weight:500;">
          <input type="checkbox" id="chkScene" checked> <span>套用「🎬 场景编辑器」里的场景</span>
        </label>
        <span class="run-modal-speed-hint" id="sceneHint">聊天主页将直接使用场景里的联系人与历史消息</span>
      </div>
      <div class="run-modal-speed">
        <label style="display:inline-flex;align-items:center;gap:6px;cursor:pointer;color:var(--text);font-weight:500;">
          <input type="checkbox" id="chkIntro"> <span>在开头插入锁屏收消息开场</span>
        </label>
        <span class="run-modal-speed-hint">自动取「打开聊天」的联系人做发送者，1-2 秒后转场到微信主页；需已有记录（scene.json / 历史会话）</span>
      </div>
      <div class="run-modal-speed">
        <label style="display:inline-flex;align-items:center;gap:6px;cursor:pointer;color:var(--text);font-weight:500;">
          <input type="checkbox" id="chkBgm" checked> <span>加背景音乐（自动去重、铺满视频时长）</span>
        </label>
        <span class="run-modal-speed-hint">默认 <b>苹果音效/背景音乐.mp3</b>；每次生成都会随机去重后铺底。可填其它文件路径——
          <input type="text" id="bgmPath" placeholder="留空用默认背景音乐" style="width:200px;margin-left:4px;padding:2px 6px;border:1px solid var(--line-strong);background:var(--field);color:var(--text);border-radius:6px;font-size:12px">
        </span>
      </div>
      <div class="run-modal-images hidden-none" id="runImageArea">
        <div class="run-image-head">
          <span class="run-image-status" id="runImageStatus"></span>
          <span class="spacer"></span>
          <button type="button" class="btn small" id="btnRunUpload" title="按「图1、图2、…」顺序上传，选 N 张填 N 个槽">📤 上传图片（按顺序）</button>
        </div>
        <div class="run-image-list" id="runImageList"></div>
      </div>
      <div class="row">
        <button type="button" class="btn ghost" id="btnRunCancel">取消</button>
        <button type="button" class="btn primary" id="btnRunConfirm">确认运行</button>
      </div>
    </div>
  </div>

  <!-- 离线使用手册：全部功能的书写格式与用法，支持搜索；内容来自 editor/manual.js -->
  <div class="manual-overlay" id="manualOverlay" hidden>
    <div class="manual-shell" role="dialog" aria-modal="true" aria-label="使用手册">
      <header class="manual-top">
        <div class="manual-title">
          <span class="manual-title-icon">📖</span>
          <div>
            使用手册
            <span class="manual-title-sub">全部功能的书写格式与用法 · 离线可查</span>
          </div>
        </div>
        <div class="manual-search">
          <span class="manual-search-icon">🔍</span>
          <input id="manualSearch" type="search" placeholder="搜索功能 / 指令 / 参数，例如：打字、朋友圈、时间、链接" spellcheck="false">
          <button type="button" class="manual-search-clear" id="manualSearchClear" hidden title="清空">×</button>
        </div>
        <button type="button" class="manual-close" id="manualClose" title="关闭（Esc）">×</button>
      </header>
      <div class="manual-body">
        <nav class="manual-nav" id="manualNav"></nav>
        <main class="manual-content" id="manualContent"></main>
      </div>
      <footer class="manual-foot" id="manualFoot"></footer>
    </div>
  </div>

  <!-- 实时手机画面浮窗：运行工作流时自动打开并轮询截图；「编辑模式」下可点击操作/修改元素 -->
  <div class="live-panel" id="livePanel" hidden>
    <div class="live-head">
      <span class="live-dot" id="liveDot"></span>
      <span id="liveTitle">实时手机画面</span>
      <span class="spacer"></span>
      <span class="live-modes" id="liveModes" hidden>
        <button type="button" class="mode-btn active" id="modeTap" title="点击画面 = 点击手机屏幕（进聊天、切页面）">👆 操作</button>
        <button type="button" class="mode-btn" id="modePick" title="点击画面 = 选中元素，弹出修改框">✎ 编辑</button>
      </span>
      <button type="button" class="live-close" id="btnLiveClose" title="关闭">×</button>
    </div>
    <div class="live-body">
      <div class="phone-screen" id="phoneScreen">
        <div class="live-empty" id="liveEmpty">运行工作流后<br>这里会实时显示手机画面</div>
        <img id="liveImg" alt="实时手机画面">
        <div class="edit-pop" id="editPop" hidden></div>
      </div>
    </div>
    <div class="live-typebar" id="liveTypebar" hidden>
      <input id="liveTypeInput" placeholder="先点击聊天输入框聚焦，再输入文字" aria-label="向手机输入文字">
      <button type="button" id="btnType">输入</button>
    </div>
    <div class="live-tip" id="liveTip">点击「运行并生成视频」，画面随执行自动刷新；可点「从当前步骤运行」快速试跑。</div>
  </div>

  <!-- 使用手册数据（离线，纯本地；新增功能时改这里） -->

<script>
/* UI v2: 顶栏下拉菜单（纯展示层，不改动任何既有功能绑定） */
(function () {
  "use strict";
  var wraps = document.querySelectorAll(".menu-wrap");
  wraps.forEach(function (w) {
    var btn = w.querySelector(".menu-btn");
    if (!btn) return;
    btn.addEventListener("click", function (e) {
      e.stopPropagation();
      var wasOpen = w.classList.contains("open");
      wraps.forEach(function (o) { o.classList.remove("open"); });
      if (!wasOpen) w.classList.add("open");
    });
    w.querySelectorAll(".menu-item").forEach(function (it) {
      it.addEventListener("click", function () { w.classList.remove("open"); });
    });
  });
  document.addEventListener("click", function () {
    wraps.forEach(function (o) { o.classList.remove("open"); });
  });
})();
</script>
  <script src="/manual.js"></script>

  <script>
    "use strict";

    /* ================= 状态区 ================= */
    let ACTIONS = [];
    let ACTIONS_BY_NAME = {};
    let workflow = { name: "未命名流程", steps: [] };
    let selected = -1;
    let logOffset = 0;
    let polling = null;
    let saveTimer = null;
    let dirty = false;
    let liveTimer = null;        // 实时画面轮询定时器
    let liveHasFrame = false;    // 是否已收到过一帧真实画面
    let liveFails = 0;           // 连续取帧失败次数（连续失败多次自动暂停轮询，别空转打死端口）
    let editActive = false;      // 编辑模式进程是否在运行
    let pickMode = false;        // false=操作（点击转发给手机） true=编辑（点击选元素）
    let editInfo = null;         // 当前正在编辑的元素信息
    let editStatusTimer = null;  // 编辑模式存活轮询
    let pendingRun = null;       // 确认弹窗「确认运行」后要触发的回调，避免误点直接录屏

    // ---- 脚本模式状态 ----
    let scriptSteps = [];         // 转译结果步骤列表
    let scriptSelected = -1;      // 预览选中的步骤下标
    let scriptEditIndex = -1;     // 正在 JSON 编辑的步骤下标
    let llmConfigured = false;    // 是否已配置 API Key
    let imageSlots = [];          // 脚本转译识别出的图片槽位（含配图路径）
    const imageSlotPathByStep = new Map(); // 步骤对象 -> 已配图片路径（跨重新渲染保留）
    let runSlotsInWorkflow = false; // runImageArea 当前是否对应「工作流」步骤（true）还是「脚本模式」步骤（false）

    // ---- 创作生成状态 ----
    let genSteps = [];            // 生成结果步骤列表
    let genSelectedRefs = new Set(); // 已勾选的参考剧本 id
    let genScore = 0;             // 本次评价星级
    let genCurrentBrief = "";     // 最近一次生成的创作主题（用于评价回传）
    let genCurrentId = "";        // 当前结果对应的历史记录 id
    let genHistory = [];          // 历史生成摘要列表
    let genHistoryQuery = "";     // 历史搜索关键词
    let genTimer = null;          // 生成耗时计时器
    let genSkills = [];           // 规则库（评价沉淀）
    let genSkillKinds = [];       // 规则类型选项
    let genCandidates = [];       // 本次评价已自动生效的规则（回执展示）

    const STORAGE_KEY = "wx-workflow-visual-editor-v2";
    const SCRIPT_STORAGE_KEY = "wx-script-mode-v1";
    const GEN_DRAFT_KEY = "wx-generate-draft-v1";
    const $ = (id) => document.getElementById(id);

    /* ================= 基础工具 ================= */
    function esc(value) {
      return String(value ?? "").replace(/[&<>"']/g, (c) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      }[c]));
    }

    function clone(value) {
      return JSON.parse(JSON.stringify(value));
    }

    function normalizeWorkflow(data) {
      if (!data || typeof data !== "object") return { name: "未命名流程", steps: [] };
      const steps = Array.isArray(data.steps) ? data.steps : [];
      return {
        name: String(data.name || "未命名流程"),
        steps: steps.map(normalizeStep).filter((s) => s.action)
      };
    }

    function normalizeStep(step) {
      if (!step || typeof step !== "object") return { action: "", params: {} };
      return {
        action: String(step.action || ""),
        params: step.params && typeof step.params === "object" ? { ...step.params } : {}
      };
    }

    function currentWorkflowPayload() {
      return normalizeWorkflow({
        name: $("flowName").value || "未命名流程",
        steps: workflow.steps
      });
    }

    function getDef(action) {
      return ACTIONS_BY_NAME[action] || {
        action,
        category: "未知",
        icon: "❓",
        desc: "当前动作定义不存在，可能来自旧版 workflow.json。",
        params: Object.keys((workflow.steps.find((s) => s.action === action) || {}).params || {}).map((key) => ({
          key,
          label: key,
          type: "text",
          default: ""
        }))
      };
    }

    function paramText(params, key) {
      const value = params && params[key] !== undefined ? params[key] : "";
      return String(value);
    }

    function summaryOf(def, params) {
      if (!def) return "未知动作";
      if (!def.params || !def.params.length) return def.desc || "该动作无参数";
      const parts = def.params
        .map((p) => {
          const value = paramText(params, p.key);
          if (value === "") return "";
          if (p.type === "textarea" && value.length > 36) return p.label + "：" + value.slice(0, 36) + "…";
          return p.label + "：" + value;
        })
        .filter(Boolean);
      return parts.join("，") || def.desc || "该动作无参数";
    }

    function estimateStepDuration(step) {
      const params = step.params || {};
      if (step.action === "等待") return Math.max(0, Number(params["秒数"]) || 0);
      if (["我方打字", "打字不发", "评论", "发朋友圈", "对方发消息"].includes(step.action)) {
        const text = paramText(params, "内容");
        return Math.min(20, 1.2 + text.length * 0.12);
      }
      if (step.action === "查看图片") return 2.2;
      if (["打开聊天", "返回主页", "切换Tab", "进入朋友圈", "隐藏键盘", "设置头像", "设置背景", "编辑朋友圈",
           "打开对方主页", "进入对方朋友圈", "返回上一页", "编辑对方资料"].includes(step.action)) {
        return 0.8;
      }
      if (step.action === "对方正在输入") return Math.max(0, Number(params["秒数"]) || 1.2);
      return 1;
    }

    function totalDuration() {
      return workflow.steps.reduce((sum, step) => sum + estimateStepDuration(step), 0);
    }

    function updateSaveState() {
      $("saveState").textContent = dirty ? "未保存" : "本地已保存";
    }

    function markDirty() {
      dirty = true;
      updateSaveState();
    }

    function saveLocalDebounced() {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(() => {
        saveLocal();
        dirty = false;
        updateSaveState();
      }, 260);
    }

    function saveLocal() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(currentWorkflowPayload()));
    }

    function restoreLocal() {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      try {
        workflow = normalizeWorkflow(JSON.parse(raw));
        $("flowName").value = workflow.name || "未命名流程";
      } catch (err) {
        log("本地缓存解析失败，已忽略。", "warn");
      }
    }

    /* ================= 日志 ================= */
    function log(message, cls) {
      const body = $("logBody");
      const div = document.createElement("div");
      if (cls) div.className = cls;
      div.textContent = "[" + new Date().toLocaleTimeString() + "] " + message;
      body.appendChild(div);
      body.scrollTop = body.scrollHeight;
    }

    /* ================= 动作库 ================= */
    function renderPalette(filter) {
      const el = $("palette");
      const keyword = String(filter || "").trim().toLowerCase();
      const categories = [...new Set(ACTIONS.map((a) => a.category))];
      el.innerHTML = "";

      if (!ACTIONS.length) {
        el.innerHTML = '<div class="empty-inspector"><div><div class="empty-inspector-icon">⌁</div>动作库加载失败<br>请确认 editor_server.py 正在运行</div></div>';
        return;
      }

      categories.forEach((category) => {
        const items = ACTIONS.filter((a) => {
          const text = (a.action + " " + a.desc + " " + a.category).toLowerCase();
          return a.category === category && (!keyword || text.includes(keyword));
        });
        if (!items.length) return;

        const cat = document.createElement("div");
        cat.className = "category-title";
        cat.textContent = category + " · " + items.length;
        el.appendChild(cat);

        items.forEach((a) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "action-card";
          btn.innerHTML =
            '<span class="action-icon">' + esc(a.icon || "•") + '</span>' +
            '<span class="action-main"><span class="action-name">' + esc(a.action) + '</span><span class="action-desc">' + esc(a.desc || "") + '</span></span>' +
            '<span class="action-add">＋</span>';
          btn.onclick = () => addStep(a.action);
          btn.draggable = true;
          btn.addEventListener("dragstart", (event) => {
            event.dataTransfer.effectAllowed = "copy";
            event.dataTransfer.setData("text/plain", "palette:" + a.action);
          });
          el.appendChild(btn);
        });
      });
    }

    /* ================= 可视化流程画布 ================= */
    function renderCanvas() {
      const el = $("flowCanvas");
      $("stepCount").textContent = workflow.steps.length;
      $("estTime").textContent = totalDuration().toFixed(1) + "s";

      const current = workflow.steps[selected];
      const def = current ? getDef(current.action) : null;
      $("selectedInfo").textContent = current ? current.action : "无";
      $("btnDuplicate").disabled = selected < 0 || selected >= workflow.steps.length;
      $("btnDelete").disabled = selected < 0 || selected >= workflow.steps.length;
      $("btnRunFrom").disabled = selected < 0 || selected >= workflow.steps.length;
      if ($("btnUndo")) $("btnUndo").disabled = !undoStack.length;
      if ($("btnRedo")) $("btnRedo").disabled = !redoStack.length;

      if (!workflow.steps.length) {
        el.innerHTML =
          '<div class="empty-board"><div class="empty-board-inner">' +
          '<div class="empty-board-icon">🎬</div>' +
          '<h3>把动作拖成一条可视化流程</h3>' +
          '<p>从左侧动作库点击添加步骤（新步骤会插到当前选中步骤之后）；也可直接把动作<b>拖拽</b>到流程的任意位置。支持 Ctrl+Z 撤销、Delete 删除选中、Ctrl+D 复制。</p>' +
          '</div></div>';
        el.ondragover = null;
        el.ondrop = null;
        return;
      }

      el.innerHTML = "";
      const timeline = document.createElement("div");
      timeline.className = "timeline";
      el.appendChild(timeline);

      workflow.steps.forEach((step, index) => {
        const def = getDef(step.action);
        const card = document.createElement("article");
        card.className = "step-node" + (index === selected ? " active" : "");
        card.draggable = true;
        card.dataset.index = String(index);
        card.title = "点击选择，拖动可调整顺序";

        card.innerHTML =
          '<div class="node-dot">' + esc(def.icon || "•") + '</div>' +
          '<div class="node-body">' +
            '<div class="node-top"><span class="node-title">' + esc(step.action) + '</span><span class="node-category">' + esc(def.category || "通用") + '</span></div>' +
            '<div class="node-summary">' + esc(summaryOf(def, step.params)) + '</div>' +
            '<div class="node-meta"><span class="node-index">' + (index + 1) + '</span><span>预计 ' + estimateStepDuration(step).toFixed(1) + 's</span><span>拖动卡片可改变执行顺序</span></div>' +
          '</div>' +
          '<div class="node-actions">' +
            '<button type="button" class="icon-btn" title="上移" data-op="up">↑</button>' +
            '<button type="button" class="icon-btn" title="下移" data-op="down">↓</button>' +
            '<button type="button" class="icon-btn" title="复制" data-op="duplicate">⧉</button>' +
            '<button type="button" class="icon-btn danger" title="删除" data-op="delete">×</button>' +
          '</div>';

        card.addEventListener("click", (event) => {
          if (event.target.closest("button")) return;
          selected = index;
          renderCanvas();
          renderProps();
          saveLocalDebounced();
        });

        card.addEventListener("dragstart", (event) => {
          card.classList.add("dragging");
          event.dataTransfer.effectAllowed = "move";
          event.dataTransfer.setData("text/plain", String(index));
        });

        card.addEventListener("dragend", () => {
          card.classList.remove("dragging");
        });

        card.addEventListener("dragover", (event) => {
          event.preventDefault();
        });

        card.addEventListener("drop", (event) => {
          event.preventDefault();
          const raw = event.dataTransfer.getData("text/plain");
          if (raw && raw.startsWith("palette:")) { addStep(raw.slice(8), index); return; }
          const from = Number(raw);
          if (!Number.isInteger(from)) return;
          moveStep(from, index);
        });

        card.querySelectorAll("[data-op]").forEach((btn) => {
          btn.addEventListener("click", (event) => {
            event.stopPropagation();
            const op = btn.dataset.op;
            if (op === "up") moveStep(index, index - 1);
            if (op === "down") moveStep(index, index + 1);
            if (op === "duplicate") duplicateStep(index);
            if (op === "delete") removeStep(index);
          });
        });

        timeline.appendChild(card);
      });

      el.ondragover = (event) => event.preventDefault();
      el.ondrop = (event) => {
        event.preventDefault();
        const raw = event.dataTransfer.getData("text/plain");
        if (raw && raw.startsWith("palette:")) { addStep(raw.slice(8)); return; }
        const from = Number(raw);
        if (!Number.isInteger(from)) return;
        moveStep(from, workflow.steps.length);
      };
    }

    /* ================= 参数面板 ================= */
    function renderProps() {
      const panel = $("propsPanel");

      if (selected < 0 || selected >= workflow.steps.length) {
        panel.innerHTML =
          '<div class="empty-inspector"><div>' +
          '<div class="empty-inspector-icon">✎</div>' +
          '<b>点击中间流程卡片</b><br>在这里编辑动作参数。输入时不会重置焦点，避免“无法编辑”。' +
          '</div></div>';
        return;
      }

      const step = workflow.steps[selected];
      const def = getDef(step.action);

      panel.innerHTML = "";
      const scroll = document.createElement("div");
      scroll.className = "inspector-scroll";

      const overview = document.createElement("div");
      overview.className = "overview-card";
      overview.innerHTML =
        '<div class="overview-title"><span>流程概览</span><span>' + esc(def.icon || "•") + '</span></div>' +
        '<div class="overview-grid">' +
          '<div class="overview-item"><span>当前步骤</span><b>' + (selected + 1) + '</b></div>' +
          '<div class="overview-item"><span>总步骤</span><b>' + workflow.steps.length + '</b></div>' +
          '<div class="overview-item"><span>预计耗时</span><b>' + totalDuration().toFixed(1) + 's</b></div>' +
          '<div class="overview-item"><span>保存状态</span><b>' + (dirty ? "未保存" : "已保存") + '</b></div>' +
        '</div>' +
        '<div class="progress" title="流程完成度"><i style="width:' + Math.min(100, workflow.steps.length * 18) + '%"></i></div>';
      scroll.appendChild(overview);

      const section = document.createElement("div");
      section.className = "props-section";
      section.innerHTML = '<h3>' + esc(def.icon || "•") + ' ' + esc(step.action) + '</h3>';

      if (def.desc) {
        const desc = document.createElement("div");
        desc.className = "prop-desc";
        desc.textContent = def.desc;
        section.appendChild(desc);
      }

      (def.params || []).forEach((p) => {
        const field = document.createElement("div");
        field.className = "field";

        const label = document.createElement("label");
        label.textContent = p.label || p.key;
        field.appendChild(label);

        let ctrl;
        if (p.type === "select") {
          ctrl = document.createElement("select");
          (p.options || []).forEach((option) => {
            const opt = document.createElement("option");
            opt.value = option;
            opt.textContent = option;
            ctrl.appendChild(opt);
          });
        } else if (p.type === "textarea") {
          ctrl = document.createElement("textarea");
        } else {
          ctrl = document.createElement("input");
          ctrl.type = p.type === "number" ? "number" : "text";
          if (p.type === "number") ctrl.step = "0.1";
        }

        const value = step.params[p.key] !== undefined ? step.params[p.key] : (p.default !== undefined ? p.default : "");
        ctrl.value = value;
        if (p.placeholder) ctrl.placeholder = p.placeholder;

        const commit = () => {
          pushUndoThrottled();
          step.params[p.key] = ctrl.value;
          renderCanvas();
          renderPropsOverviewOnly();
          saveLocalDebounced();
        };
        ctrl.addEventListener("input", commit);
        ctrl.addEventListener("change", commit);

        field.appendChild(ctrl);

        // 图片路径参数：附带「选图」按钮，免手打路径
        if ((p.key === "图片" || p.key === "表情") && window.__wxPick) {
          const pk = document.createElement("button");
          pk.type = "button";
          pk.className = "btn small";
          pk.textContent = "🖼 选图";
          pk.style.marginTop = "6px";
          pk.addEventListener("click", () => {
            window.__wxPick.openPicker({
              current: ctrl.value,
              onPick: (val) => { ctrl.value = val || ""; commit(); }
            });
          });
          field.appendChild(pk);
        }

        if (p.hint) {
          const hint = document.createElement("div");
          hint.className = "field-hint";
          hint.textContent = p.hint;
          field.appendChild(hint);
        }

        section.appendChild(field);
      });

      if (!def.params || !def.params.length) {
        const hint = document.createElement("div");
        hint.className = "field-hint";
        hint.textContent = "该动作没有参数。";
        section.appendChild(hint);
      }

      scroll.appendChild(section);
      panel.innerHTML = "";
      panel.appendChild(scroll);
    }

    /* 只刷新概览卡片，避免输入框正在编辑时重建整个面板。 */
    function renderPropsOverviewOnly() {
      const old = $("propsPanel").querySelector(".overview-card");
      if (!old) return;
      const def = selected >= 0 ? getDef(workflow.steps[selected].action) : null;
      const progress = Math.min(100, workflow.steps.length * 18);
      old.innerHTML =
        '<div class="overview-title"><span>流程概览</span><span>' + esc(def ? def.icon || "•" : "•") + '</span></div>' +
        '<div class="overview-grid">' +
          '<div class="overview-item"><span>当前步骤</span><b>' + (selected + 1) + '</b></div>' +
          '<div class="overview-item"><span>总步骤</span><b>' + workflow.steps.length + '</b></div>' +
          '<div class="overview-item"><span>预计耗时</span><b>' + totalDuration().toFixed(1) + 's</b></div>' +
          '<div class="overview-item"><span>保存状态</span><b>' + (dirty ? "未保存" : "已保存") + '</b></div>' +
        '</div>' +
        '<div class="progress" title="流程完成度"><i style="width:' + progress + '%"></i></div>';
    }

    /* ================= 撤销 / 重做 ================= */
    const undoStack = [];
    const redoStack = [];
    function snapshot() {
      return JSON.stringify({ steps: workflow.steps, selected });
    }
    function pushUndo() {
      undoStack.push(snapshot());
      if (undoStack.length > 100) undoStack.shift();
      redoStack.length = 0;
    }
    let _lastSnapAt = 0;
    function pushUndoThrottled() {
      const now = Date.now();
      if (now - _lastSnapAt > 1200) { pushUndo(); _lastSnapAt = now; }
    }
    function restoreSnapshot(snap) {
      const data = JSON.parse(snap);
      workflow.steps = data.steps;
      selected = Math.max(-1, Math.min(data.selected, workflow.steps.length - 1));
      renderCanvas();
      renderProps();
      markDirty();
      saveLocalDebounced();
    }
    function undo() {
      if (!undoStack.length) return;
      redoStack.push(snapshot());
      restoreSnapshot(undoStack.pop());
    }
    function redo() {
      if (!redoStack.length) return;
      undoStack.push(snapshot());
      restoreSnapshot(redoStack.pop());
    }

    /* ================= 步骤操作 ================= */
    function addStep(action, atIndex) {
      const def = getDef(action);
      const params = {};
      (def.params || []).forEach((p) => {
        params[p.key] = p.default !== undefined ? p.default : "";
      });
      const at = Number.isInteger(atIndex)
        ? Math.max(0, Math.min(workflow.steps.length, atIndex))
        : (selected >= 0 && selected < workflow.steps.length ? selected + 1 : workflow.steps.length);
      pushUndo();
      workflow.steps.splice(at, 0, { action, params });
      selected = at;
      renderCanvas();
      renderProps();
      const node = $("flowCanvas").querySelector('.step-node[data-index="' + at + '"]');
      if (node && node.scrollIntoView) node.scrollIntoView({ block: "nearest" });
      markDirty();
      saveLocalDebounced();
    }

    function removeStep(index) {
      if (index < 0 || index >= workflow.steps.length) return;
      pushUndo();
      workflow.steps.splice(index, 1);
      if (selected >= workflow.steps.length) selected = workflow.steps.length - 1;
      if (selected === index) selected = -1;
      renderCanvas();
      renderProps();
      markDirty();
      saveLocalDebounced();
    }

    function moveStep(from, to) {
      if (!Number.isInteger(from) || !Number.isInteger(to)) return;
      if (from < 0 || from >= workflow.steps.length) return;
      to = Math.max(0, Math.min(workflow.steps.length, to));
      if (from === to || from === to - 1) {
        selected = to > from ? to - 1 : to;
      } else {
        pushUndo();
        const [step] = workflow.steps.splice(from, 1);
        workflow.steps.splice(to, 0, step);
        selected = to > from ? to - 1 : to;
      }
      renderCanvas();
      renderProps();
      markDirty();
      saveLocalDebounced();
    }

    function duplicateStep(index) {
      if (index < 0 || index >= workflow.steps.length) return;
      const copy = clone(workflow.steps[index]);
      pushUndo();
      workflow.steps.splice(index + 1, 0, copy);
      selected = index + 1;
      renderCanvas();
      renderProps();
      markDirty();
      saveLocalDebounced();
    }

    /* ================= 实时画面浮窗 ================= */
    function openLivePanel() {
      const panel = $("livePanel");
      panel.hidden = false;
      if (editActive) {
        $("liveEmpty").textContent = "正在连接编辑模式画面…";
        $("liveModes").hidden = false;
        $("liveTypebar").hidden = false;
        $("liveTitle").textContent = "编辑模式 · 实时画面";
        startLivePolling();
      } else {
        $("liveEmpty").textContent = "运行工作流后<br>这里会实时显示手机画面";
        $("liveTip").textContent = "只有「编辑模式」提供实时画面；普通运行是无头录屏，结束后直接出视频。";
        $("liveDot").className = "live-dot";
        // 非编辑模式不去轮询 /api/live：8001 没监听，只会空转报「正在连接」误导用户。
      }
    }

    function closeLivePanel() {
      $("livePanel").hidden = true;
      stopLivePolling();
    }

    function startLivePolling() {
      stopLivePolling();
      liveHasFrame = false;
      liveFails = 0;
      $("liveDot").className = "live-dot on";
      $("liveTitle").textContent = "实时手机画面 · LIVE";
      tickLiveFrame();
      liveTimer = setInterval(tickLiveFrame, 350);
    }

    function tickLiveFrame() {
      const img = $("liveImg");
      img.onload = () => {
        liveHasFrame = true;
        liveFails = 0;
        img.classList.remove("loading");
        $("liveEmpty").style.display = "none";
      };
      img.onerror = () => {
        img.classList.remove("loading");
        if (!liveHasFrame) {
          $("liveEmpty").textContent = editActive ? "正在连接编辑模式画面…" : "正在连接画面…";
          $("liveEmpty").style.display = "grid";
        }
        // 连续失败（画面服务没在跑）→ 自动暂停轮询，避免每 350ms 空打一次
        if (++liveFails >= 12) {
          stopLivePolling();
          if (!liveHasFrame) {
            $("liveEmpty").textContent = "画面服务没有响应，已暂停自动刷新。请确认编辑模式是否在运行。";
            $("liveEmpty").style.display = "grid";
          }
          log("实时画面连续无响应，已暂停自动刷新；重新打开面板可重试。", "warn");
        }
      };
      // 仅在还没收到任何一帧时显示半透明等待态。
      // 一旦已有画面，就不再反复加减 loading 类（那会在 350ms 轮询里造成图片闪一下）。
      // 新帧就绪后直接替换 src，浏览器会保留上一帧直到新帧绘制完成，不会闪。
      if (!liveHasFrame) {
        img.classList.add("loading");
        $("liveEmpty").style.display = "grid";
      }
      img.src = "/api/live?t=" + Date.now();
    }

    function stopLivePolling() {
      clearInterval(liveTimer);
      liveTimer = null;
      $("liveDot").className = "live-dot";
      $("liveTitle").textContent = "实时手机画面";
    }

    /* ================= 编辑模式：点击画面操作 / 修改元素 ================= */
    const KIND_META = {
      text:      { label: "文字内容", prop: "text", hint: "直接修改这段文字。聊天列表昵称/最后一条消息会同步到数据，切换页面不丢失。" },
      image:     { label: "图片路径", prop: "src", hint: "如 /images/avatar/2_20260831_184618_874.jpg，图片放在 vue-WeChat/public/images 下" },
      bg:        { label: "背景图路径", prop: "bg", hint: "如 /images/avatar/IMG_0491_20260903_144508_035.png" },
      me_avatar: { label: "我的头像", prop: "me_avatar", hint: "全局同步：头像在所有位置一起变" },
      me_name:   { label: "我的昵称", prop: "me_name", hint: "全局同步：主页/通讯录/朋友圈一起变" },
      me_bg:     { label: "朋友圈封面", prop: "me_bg", hint: "全局同步：朋友圈封面一起变" },
    };

    async function startEditMode() {
      if (editActive) {
        await stopEditMode();
        return;
      }
      log("正在启动编辑模式（打开手机画面并待命）……", "warn");
      try {
        const res = await api("/api/editmode/start", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({})
        });
        if (!res.ok) {
          log(res.msg || "编辑模式启动失败", "err");
          return;
        }
        editActive = true;
        $("btnEditMode").classList.add("primary-soft");
        $("btnEditMode").textContent = "⏹ 退出编辑模式";
        $("liveTitle").textContent = "编辑模式 · 实时画面";
        openLivePanel();
        setPickMode(false);
        $("phoneScreen").classList.add("editable");
        $("liveTip").textContent = "点击画面即可操作手机（进聊天、切页）；切到「✎ 编辑」后点选元素可修改文字/头像/背景。";
        log("编辑模式已启动。点击画面操作手机，切到「✎ 编辑」可直接修改元素。", "ok");
        startEditStatusPolling();
      } catch (err) {
        log("编辑模式启动失败：" + err.message, "err");
      }
    }

    async function stopEditMode() {
      try {
        await api("/api/editmode/stop", { method: "POST" });
      } catch (err) { /* 忽略，进程可能已自行退出 */ }
      finishEditMode();
      log("已退出编辑模式。", "ok");
    }

    /* 无论手动退出还是进程崩溃，都统一收尾 UI 状态 */
    function finishEditMode() {
      editActive = false;
      pickMode = false;
      hideEditPop();
      $("btnEditMode").classList.remove("primary-soft");
      $("btnEditMode").textContent = "✏️ 编辑模式";
      $("liveModes").hidden = true;
      $("liveTypebar").hidden = true;
      $("phoneScreen").classList.remove("editable");
      $("liveTitle").textContent = "实时手机画面";
      $("liveTip").textContent = "编辑模式已退出。";
      stopEditStatusPolling();
    }

    function setPickMode(on) {
      pickMode = on;
      $("modeTap").classList.toggle("active", !on);
      $("modePick").classList.toggle("active", on);
      $("liveTip").textContent = on
        ? "「✎ 编辑」模式：点击画面中的元素会弹出修改框，改完点保存即时上屏。"
        : "「👆 操作」模式：点击画面 = 点击手机屏幕（可进入聊天、切换页面）。";
    }

    function startEditStatusPolling() {
      stopEditStatusPolling();
      editStatusTimer = setInterval(async () => {
        try {
          const s = await api("/api/editstatus");
          if (!s.running && editActive) {
            log("编辑模式进程已退出。", "warn");
            finishEditMode();
          }
        } catch (err) { /* 服务重启时忽略 */ }
      }, 2000);
    }

    function stopEditStatusPolling() {
      clearInterval(editStatusTimer);
      editStatusTimer = null;
    }

    function viewportFromEvent(event) {
      const rect = $("liveImg").getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width * 600;
      const y = (event.clientY - rect.top) / rect.height * 1300;
      return { x: Math.max(0, Math.min(600, x)), y: Math.max(0, Math.min(1300, y)) };
    }

    async function onScreenClick(event) {
      if (event.target.closest(".edit-pop")) return;
      if (!editActive) {
        log("请先点击顶部「✏️ 编辑模式」启用画面操作。", "warn");
        return;
      }
      const { x, y } = viewportFromEvent(event);
      if (pickMode) {
        try {
          const res = await api("/api/live/pick?x=" + x.toFixed(1) + "&y=" + y.toFixed(1));
          if (!res.ok) {
            log(res.msg || "该位置不可编辑", "warn");
            return;
          }
          showEditPop(res, x, y);
        } catch (err) {
          log("拾取元素失败：" + err.message, "err");
        }
      } else {
        try {
          const res = await api("/api/live/tap", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ x: Math.round(x), y: Math.round(y) })
          });
          if (!res.ok) log(res.msg || "点击未生效", "warn");
        } catch (err) {
          log("点击失败：" + err.message, "err");
        }
      }
    }

    function showEditPop(info, x, y) {
      editInfo = info;
      const meta = KIND_META[info.kind] || KIND_META.text;
      const value = (info.kind === "text" || info.kind === "me_name") ? (info.text || "") : (info.src || "");
      const pop = $("editPop");
      pop.innerHTML =
        '<div class="ep-kind">' + esc(meta.label) + '</div>' +
        '<input id="epValue" value="' + esc(value) + '" placeholder="' + esc(meta.label) + '">' +
        '<div class="ep-actions">' +
          '<button type="button" class="ep-cancel" id="epCancel">取消</button>' +
          '<button type="button" class="ep-save" id="epSave">保存</button>' +
        '</div>' +
        '<div class="ep-hint">' + esc(meta.hint || "") + '</div>';
      pop.hidden = false;
      const ph = $("phoneScreen").getBoundingClientRect();
      let left = x / 600 * ph.width;
      let top = y / 1300 * ph.height;
      const pw = pop.offsetWidth || 232;
      const phh = pop.offsetHeight || 130;
      if (left + pw > ph.width) left = ph.width - pw - 4;
      if (left < 4) left = 4;
      if (top + phh > ph.height) top = top - phh - 8;
      if (top < 4) top = 4;
      pop.style.left = Math.round(left) + "px";
      pop.style.top = Math.round(top) + "px";
      const input = $("epValue");
      input.focus();
      input.select();
      $("epSave").onclick = saveEdit;
      $("epCancel").onclick = hideEditPop;
    }

    async function saveEdit() {
      if (!editInfo) return;
      const meta = KIND_META[editInfo.kind] || KIND_META.text;
      const value = $("epValue").value.trim();
      try {
        const res = await api("/api/live/edit", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: editInfo.id, prop: meta.prop, value })
        });
        if (res.ok) {
          log("已修改" + meta.label + "：" + (value || "（已清空）"), "ok");
          hideEditPop();
        } else {
          log("修改失败：" + (res.msg || "未知错误"), "err");
        }
      } catch (err) {
        log("修改失败：" + err.message, "err");
      }
    }

    function hideEditPop() {
      $("editPop").hidden = true;
      editInfo = null;
    }

    async function doType() {
      const input = $("liveTypeInput");
      const text = input.value;
      if (!text) return;
      try {
        const res = await api("/api/live/type", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ text })
        });
        if (res.ok) {
          input.value = "";
        } else {
          log(res.msg || "输入失败", "warn");
        }
      } catch (err) {
        log("输入失败：" + err.message, "err");
      }
    }

    /* ================= API / 保存 / 运行 ================= */
    async function api(path, opts) {
      const res = await fetch(path, opts);
      let data = null;
      try {
        data = await res.json();
      } catch (err) {
        data = null;
      }
      // 非 2xx 也尝试读出后端返回的 {msg}，让「已在运行」「截图失败」等提示更友好
      if (!res.ok) throw new Error((data && data.msg) || (res.status + " " + res.statusText));
      return data;
    }

    function setStatus(text, running) {
      $("statusPill").textContent = text;
      $("statusPill").className = "status-pill" + (running ? " running" : "");
      $("logDot").className = "log-dot" + (running ? " on" : "");
      $("btnRun").disabled = running;
      $("btnStop").disabled = !running;
    }

    /* ================= 运行确认弹窗 ================= */
    /* 运行确认弹窗里的「套用场景」开关：运行时把「场景编辑器」保存的场景铺到聊天主页，
       这样在工作流模式下测试打字/表情/朋友圈等功能时，联系人与历史消息都是自己配好的。
       这里只做文案提示，真正的套用由后端 /api/run 的 use_scene 参数控制。 */
    let sceneInfo = null;
    async function loadSceneInfo() {
      try {
        sceneInfo = await api("/api/scene");
      } catch (err) {
        sceneInfo = null;
      }
      updateSceneHint();
    }
    function updateSceneHint() {
      const el = $("sceneHint");
      if (!el) return;
      const home = (sceneInfo && Array.isArray(sceneInfo.home)) ? sceneInfo.home : [];
      const title = (sceneInfo && sceneInfo.title) ? sceneInfo.title : "";
      if (!home.length) {
        el.textContent = "场景编辑器里还没有会话，将使用工作流自带的聊天主页";
      } else {
        el.textContent = "聊天主页将直接用场景「" + (title || "未命名") + "」的 "
          + home.length + " 个会话与历史消息";
      }
    }

    /* 运行前先弹确认框，避免「运行并生成视频」被误点/双击直接触发录屏。 */
    function openRunConfirm(info) {
      $("runConfirmTitle").textContent = info.title || "确认开始制作视频？";
      $("runConfirmDesc").textContent = info.desc || "即将运行工作流并生成视频。";
      $("runConfirmSteps").textContent = info.steps || "";
      const timeEl = $("runConfirmTime");
      if (info.time) {
        timeEl.textContent = info.time;
        timeEl.hidden = false;
      } else {
        timeEl.hidden = true;
      }
      pendingRun = info.onConfirm || null;
      renderRunImages(!!info.images);
      updateSceneHint();
      loadSceneInfo();
      $("confirmRunModal").hidden = false;
    }

    function confirmRunAction() {
      $("confirmRunModal").hidden = true;
      const fn = pendingRun;
      pendingRun = null;
      if (fn) fn();
    }

    function cancelRunAction() {
      $("confirmRunModal").hidden = true;
      pendingRun = null;
      log("已取消运行。", "warn");
    }

    /* 运行确认弹窗里的「剧本图片」区：按顺序把这张票要用的图配好，避免跑到一半才想起没配图 */
    function renderRunImages(show) {
      const area = $("runImageArea");
      if (!area) return;
      if (!show) {
        area.classList.add("hidden-none");
        area.hidden = true;
        return;
      }
      area.classList.remove("hidden-none");
      area.hidden = false;
      refreshRunImageList();
    }

    /* 「打开」参数的真值判断：是/true/否 …… */
    function _isOpenParam(v) {
      if (v === true) return true;
      const s = String(v ?? "").trim().toLowerCase();
      return !["", "0", "否", "不", "false", "no", "off", "关闭", "不打开"].includes(s);
    }
    /* 解析「焦点」参数 "x,y" -> {x,y}；缺省返回 null */
    function _parseFocusParam(v) {
      if (!v) return null;
      const s = String(v).trim();
      const p = s.split(",");
      if (p.length !== 2) return null;
      const x = Number(p[0]), y = Number(p[1]);
      if (!isFinite(x) || !isFinite(y)) return null;
      return { x: Math.min(0.97, Math.max(0.03, x)), y: Math.min(0.97, Math.max(0.03, y)) };
    }
    /* 「打开」三档模式解析：none(不打开) / view(只点开不放大) / zoom(点开并放大) */
    function _openMode(v) {
      const s = String(v ?? "").trim().toLowerCase();
      if (["", "0", "否", "不", "false", "no", "off", "关闭", "不打开"].includes(s)) return "none";
      if (["只点开", "不放大", "查看", "只显示", "不缩放", "open", "view"].includes(s)) return "view";
      return "zoom";
    }
    /* 「放大倍率」原始字符串（'' 表示未设置） */
    function _zoomStr(v) {
      return (v === undefined || v === null || v === "") ? "" : String(v);
    }
    /* 放大倍率数字（未设置回退默认 1.6，与主程序 IMAGE_ZOOM_DEFAULT 一致） */
    function slotZoomNum(s) {
      const v = (s && s.autoplayable)
        ? s.openZoom
        : (s && s.step && s.step.params && s.step.params["放大倍率"]);
      const n = parseFloat(v);
      return (isFinite(n) && n > 0.5) ? n : 1.6;
    }
    /* 焦点对象（{x,y} 或 null） */
    function slotFocusObj(s) {
      const v = (s && s.autoplayable)
        ? s.openFocus
        : (s && s.step && s.step.params && s.step.params["焦点"]);
      return _parseFocusParam(v);
    }
    /* 把图片步骤的「打开/停留/焦点/倍率」改动写回步骤 params 并按模式持久化 */
    function persistSlotParams() {
      if (runSlotsInWorkflow) {
        markDirty();
        saveRemote();
        renderCanvas();
      } else {
        syncImageAttach();
        renderScriptPreview();
        saveScriptDraft();
      }
      refreshRunImageList();
    }
    function setSlotOpenMode(slot, val) {
      if (!slot) return;
      const v = String(val ?? "").trim();
      if (slot.autoplayable) {
        if (slot.open !== undefined) slot.open = v;
        if (slot.onOptsChange) slot.onOptsChange(slot);
        return;
      }
      if (!slot.step) return;
      if (!slot.step.params) slot.step.params = {};
      if (v === "") delete slot.step.params["打开"];
      else slot.step.params["打开"] = v;
      persistSlotParams();
    }
    function setSlotZoom(slot, val) {
      if (!slot) return;
      const v = String(val ?? "").trim();
      if (slot.autoplayable) {
        if (slot.openZoom !== undefined) slot.openZoom = v;
        if (slot.onOptsChange) slot.onOptsChange(slot);
        return;
      }
      if (!slot.step) return;
      if (!slot.step.params) slot.step.params = {};
      if (v === "") delete slot.step.params["放大倍率"];
      else slot.step.params["放大倍率"] = v;
      persistSlotParams();
    }
    function setSlotHold(slot, val) {
      if (!slot) return;
      if (slot.autoplayable) {
        const v = String(val ?? "").trim();
        if (slot.openHold !== undefined) slot.openHold = v;
        if (slot.onOptsChange) slot.onOptsChange(slot);
        return;
      }
      if (!slot.step) return;
      if (!slot.step.params) slot.step.params = {};
      const v = String(val ?? "").trim();
      if (v === "") delete slot.step.params["停留"];
      else slot.step.params["停留"] = v;
      persistSlotParams();
    }
    function setSlotFocus(slot, x, y) {
      if (!slot) return;
      if (slot.autoplayable) {
        slot.openFocus = x.toFixed(2) + "," + y.toFixed(2);
        if (slot.onOptsChange) slot.onOptsChange(slot);
        return;
      }
      if (!slot.step) return;
      if (!slot.step.params) slot.step.params = {};
      slot.step.params["焦点"] = x.toFixed(2) + "," + y.toFixed(2);
      persistSlotParams();
    }

    /* 选点弹层：点缩略图 -> 弹出图片 -> 点哪放大到哪 */
    let _runFocusModal = null;
    let _runFocusSlot = null;
    function openRunFocusPicker(slot) {
      if (!slot) return;
      _runFocusSlot = slot;
      const src = slot.path;
      if (!src) { alert("请先为这张图「选图」，之后才能设置放大位置。"); return; }
      if (!_runFocusModal) {
        _runFocusModal = document.createElement("div");
        _runFocusModal.id = "runFocusModal";
        _runFocusModal.style.cssText =
          "position:fixed;inset:0;z-index:100000;background:rgba(0,0,0,.72);display:flex;align-items:center;justify-content:center;";
        _runFocusModal.innerHTML =
          '<div style="background:#20242a;border-radius:12px;padding:14px;max-width:92vw;max-height:92vh;overflow:auto;color:#e6e6e6;font-size:13px;">' +
            '<div style="display:flex;align-items:center;gap:12px;margin-bottom:10px;flex-wrap:wrap;">' +
              '<b>点击图片选择放大位置</b>' +
              '<span id="rfCoord" style="opacity:.85;"></span>' +
              '<span style="opacity:.5;">（点后自动关闭；点了右上角就是放大到右上）</span>' +
              '<button id="rfReset" type="button" style="margin-left:auto;background:#2b3140;border:1px solid #3a3f47;border-radius:6px;padding:4px 10px;color:#e6e6e6;cursor:pointer;">重置居中</button>' +
              '<button id="rfClose" type="button" style="background:#3a3f47;border:1px solid #3a3f47;border-radius:6px;padding:4px 10px;color:#e6e6e6;cursor:pointer;">关闭</button>' +
            '</div>' +
            '<div id="rfBox" style="position:relative;display:inline-block;cursor:crosshair;line-height:0;max-width:80vw;">' +
              '<img id="rfImg" alt="" draggable="false" style="max-width:80vw;max-height:72vh;display:block;">' +
              '<div id="rfMarker" style="position:absolute;width:14px;height:14px;margin:-7px 0 0 -7px;border:2px solid #4c9aff;border-radius:50%;background:rgba(76,154,255,.25);pointer-events:none;"></div>' +
            '</div>' +
          '</div>';
        document.body.appendChild(_runFocusModal);
        const box = _runFocusModal.querySelector("#rfBox");
        const img = _runFocusModal.querySelector("#rfImg");
        const marker = _runFocusModal.querySelector("#rfMarker");
        marker.style.display = "none";
        box.addEventListener("mousemove", (e) => {
          const r = img.getBoundingClientRect();
          const x = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
          const y = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
          marker.style.display = "block";
          marker.style.left = (x * 100) + "%";
          marker.style.top = (y * 100) + "%";
          _runFocusModal.querySelector("#rfCoord").textContent = "(" + x.toFixed(2) + "," + y.toFixed(2) + ")";
        });
        box.addEventListener("mouseleave", () => { marker.style.display = "none"; });
        box.addEventListener("click", (e) => {
          const r = img.getBoundingClientRect();
          const x = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
          const y = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
          const slot2 = _runFocusSlot;
          closeRunFocusModal();
          if (slot2) setSlotFocus(slot2, x, y);
        });
        _runFocusModal.querySelector("#rfClose").onclick = closeRunFocusModal;
        _runFocusModal.querySelector("#rfReset").onclick = () => {
          const slot2 = _runFocusSlot;
          closeRunFocusModal();
          if (slot2) setSlotFocus(slot2, 0.5, 0.5);
        };
      }
      const img = _runFocusModal.querySelector("#rfImg");
      img.src = src;
      const focusSrc = (_runFocusSlot && _runFocusSlot.autoplayable)
        ? _runFocusSlot.openFocus
        : (_runFocusSlot && _runFocusSlot.step && _runFocusSlot.step.params && _runFocusSlot.step.params["焦点"]);
      const cur = _parseFocusParam(focusSrc);
      _runFocusModal.querySelector("#rfCoord").textContent = cur
        ? ("当前：" + cur.x.toFixed(2) + "," + cur.y.toFixed(2))
        : "点击图片任意处设置（默认居中）";
      _runFocusModal.style.display = "flex";
    }
    function closeRunFocusModal() {
      if (_runFocusModal) _runFocusModal.style.display = "none";
    }

    /* 预览点开效果：按当前 打开模式/倍率/焦点 近似渲染图片放大后的样子 */
    let _runPreviewModal = null;
    function openRunZoomPreview(slot) {
      if (!slot) return;
      const src = slot.path;
      if (!src) { alert("请先为这张图「选图」，之后才能预览点开效果。"); return; }
      if (!_runPreviewModal) {
        _runPreviewModal = document.createElement("div");
        _runPreviewModal.id = "runPreviewModal";
        _runPreviewModal.style.cssText =
          "position:fixed;inset:0;z-index:100002;background:#000;display:none;align-items:center;justify-content:center;overflow:hidden;";
        _runPreviewModal.innerHTML =
          '<div style="position:absolute;top:16px;left:0;right:0;text-align:center;color:rgba(255,255,255,.85);font-size:13px;">' +
            '<span id="rvInfo"></span> ' +
            '<button id="rvClose" type="button" style="margin-left:10px;background:#2b3140;border:1px solid #3a3f47;border-radius:6px;padding:4px 10px;color:#e6e6e6;cursor:pointer;">关闭</button>' +
          '</div>' +
          '<div style="position:relative;width:92%;height:92%;display:flex;align-items:center;justify-content:center;overflow:hidden;">' +
            '<img id="rvImg" alt="预览" draggable="false" style="max-width:100%;max-height:100%;object-fit:contain;border-radius:6px;will-change:transform;transition:transform .18s ease;">' +
          '</div>';
        document.body.appendChild(_runPreviewModal);
        _runPreviewModal.querySelector("#rvClose").onclick = () => { _runPreviewModal.style.display = "none"; };
        _runPreviewModal.addEventListener("click", (e) => {
          if (e.target === _runPreviewModal) _runPreviewModal.style.display = "none";
        });
      }
      const img = _runPreviewModal.querySelector("#rvImg");
      img.src = src;
      const mode = _openMode(slot.autoplayable ? slot.open : (slot.step && slot.step.params && slot.step.params["打开"]));
      const zoom = slotZoomNum(slot);
      const focus = slotFocusObj(slot);
      const ox = focus ? focus.x : 0.5;
      const oy = focus ? focus.y : 0.5;
      const modeLabel = mode === "view" ? "只点开(不放大)" : (mode === "zoom" ? "点开并放大" : "不打开");
      // view 模式停留在原大；zoom 模式按倍率&焦点放大
      if (mode === "view") {
        img.style.transformOrigin = "50% 50%";
        img.style.transform = "none";
      } else {
        img.style.transformOrigin = (ox * 100) + "% " + (oy * 100) + "%";
        img.style.transform = "none";
        void img.offsetWidth;                 // 强制 reflow，重触发 transition
        img.style.transform = "scale(" + zoom.toFixed(2) + ")";
      }
      _runPreviewModal.querySelector("#rvInfo").textContent = modeLabel + " · 倍率 " + zoom.toFixed(2) + "×" +
        (focus ? (" · 焦点 " + ox.toFixed(2) + "," + oy.toFixed(2)) : " · 居中");
      _runPreviewModal.style.display = "flex";
    }

    function refreshRunImageList() {
      const list = $("runImageList");
      const statusEl = $("runImageStatus");
      if (!list) return;
      if (!imageSlots.length) {
        statusEl.textContent = "🖼 剧本里没有需要配图的图片消息";
        list.innerHTML = '<div class="run-image-empty">如需图片，可先到左侧步骤卡片点 🖼，把某条消息转成图片。</div>';
        return;
      }
      const filled = imageSlots.filter((s) => s.path).length;
      const missing = imageSlots.length - filled;
      statusEl.textContent = "🖼 剧本图片：" + filled + "/" + imageSlots.length + " 已配图" +
        (missing ? "（还有 " + missing + " 张未配，将显示为空白）" : "");
      list.innerHTML = imageSlots.map((s, i) => {
        const isAct = !!(s.step && ["对方发图片", "发送图片"].includes(s.step.action));
        const isAuto = !!(s.autoplayable);
        const capable = isAct || isAuto || !!s.openable;
        // 「打开动画」编辑器与配图清单共用一套（shared_picker.renderOpenOptsInto）：
        // 分段开关选模式 + 滑杆调倍率/停留 + 点小图设放大中心点。
        const optsHtml = capable
          ? '<span class="rum-openhost" data-i="' + i + '"></span>'
          : "";
        return '<div class="run-image-item">' +
          '<span class="rum-thumb' + (s.path ? "" : " missing") + '">' +
            (s.path ? '<img src="' + esc(s.path) + '" onerror="this.style.opacity=.25">' : "未配图") +
          '</span>' +
          '<span class="rum-info"><b>' + esc(s.no || ("图" + (i + 1))) + '</b>' + esc(s.desc || "") + '</span>' +
          '<button type="button" class="rum-pick" data-i="' + i + '">' + (s.path ? "换图" : "选图") + '</button>' +
          optsHtml +
        '</div>';
      }).join("");
      list.querySelectorAll(".rum-pick").forEach((btn) => {
        btn.onclick = () => {
          const i = Number(btn.dataset.i);
          const slot = imageSlots[i];
          if (!slot || !window.__wxPick) return;
          window.__wxPick.openPicker({
            current: slot.path || "",
            onPick: (path) => { assignImageSlot(slot, path || ""); }
          });
        };
      });
      list.querySelectorAll(".rum-openhost").forEach((h) => {
        const slot = imageSlots[Number(h.dataset.i)];
        if (slot && window.__wxPick && window.__wxPick.renderOpenOptsInto) {
          window.__wxPick.renderOpenOptsInto(h, slot);
        }
      });
    }

    function assignImageSlot(slot, path) {
      if (!slot) return;
      path = path || "";
      if (slot.setPath) {
        // 历史会话图片消息 / 链接卡片封面：写回该消息的 image 字段并持久化
        slot.setPath(path);
        slot.path = path;
        if (slot.onOptsChange) slot.onOptsChange(slot);
        if (runSlotsInWorkflow) { markDirty(); saveRemote(); renderCanvas(); }
        refreshRunImageList();
        return;
      }
      if (slot.autoplayable) {
        slot.path = path;
        if (slot.onOptsChange) slot.onOptsChange(slot);
        refreshRunImageList();
        return;
      }
      if (!slot.step) return;
      slot.path = path || "";
      imageSlotPathByStep.set(slot.step, slot.path);
      if (!slot.step.params) slot.step.params = {};
      // 表情步骤若只有 图片 key（AI 手写）就沿用 图片 写回，避免空 表情 顶掉真值
      let k = slot.imgKey || "图片";
      if (k === '表情' && slot.step.params['表情'] === undefined && slot.step.params['图片'] !== undefined) k = '图片';
      slot.step.params[k] = slot.path;
      if (runSlotsInWorkflow) {
        // 工作流模式：把图路径写回真实步骤并保存，下次运行/保存都保留
        markDirty();
        saveRemote();
        renderCanvas();
      } else {
        // 脚本模式：同步到左侧「配图清单」并刷新预览
        syncImageAttach();
        renderScriptPreview();
        saveScriptDraft();
      }
      refreshRunImageList();
    }

    /* 工作流运行入口：先弹确认框，确认后才真正 startRun */
    function requestRunWorkflow(startIndex = 0) {
      if (!workflow.steps.length) {
        alert("流程还没有步骤，请先添加动作。");
        return;
      }
      const start = Math.max(0, Math.min(startIndex, workflow.steps.length - 1));
      const slice = workflow.steps.slice(start);
      runSlotsInWorkflow = true;
      imageSlots = collectImageSlots(slice);
      const est = slice.reduce((sum, s) => sum + estimateStepDuration(s), 0).toFixed(1);
      openRunConfirm({
        title: "确认开始制作视频？",
        desc: "即将运行工作流并生成视频。运行期间手机画面会实时显示，可随时点击「停止」。",
        steps: "共 " + slice.length + " 步" + (start > 0 ? "（从第 " + (start + 1) + " 步开始）" : ""),
        time: "预计 " + est + "s",
        images: true,
        onConfirm: () => startRun(startIndex)
      });
    }

    /* 脚本模式运行入口：先弹确认框，确认后才真正 runScript */
    function requestRunScript() {
      if (!scriptSteps.length) {
        alert("还没有转译结果，请先粘贴剧本并转译。");
        return;
      }
      const est = scriptSteps.reduce((sum, s) => sum + estimateStepDuration(s), 0).toFixed(1);
      runSlotsInWorkflow = false;
      openRunConfirm({
        title: "确认开始制作视频？",
        desc: "即将按「转译结果」共 " + scriptSteps.length + " 步顺序运行并生成视频。",
        steps: "共 " + scriptSteps.length + " 步",
        time: "预计 " + est + "s",
        images: true,
        onConfirm: runScript
      });
    }

    async function startRun(startIndex = 0) {
      if (!workflow.steps.length) {
        alert("流程还没有步骤，请先添加动作。");
        return;
      }

      // 若编辑模式正在运行，先退出（避免端口/进程冲突）
      if (editActive) {
        log("检测到编辑模式运行中，正在自动退出以开始工作流……", "warn");
        await stopEditMode();
      }

      const start = Math.max(0, Math.min(startIndex, workflow.steps.length - 1));
      const payload = currentWorkflowPayload();
      if (start > 0) payload.steps = payload.steps.slice(start);

      logOffset = 0;
      $("logBody").innerHTML = "";
      setStatus("运行中...", true);
      closeLivePanel();
      $("liveTip").textContent = "已按无头模式运行，无实时预览（避免闪帧）。";
      log("正在保存并启动工作流" + (start > 0 ? "（从第 " + (start + 1) + " 步开始）" : "") + "……", "warn");

      try {
        const res = await api("/api/run", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ workflow: payload, headless: true, use_scene: !!$("chkScene").checked, typing_speed: Number($("runTypingSpeed").value), intro: !!$("chkIntro").checked, bgm: !!$("chkBgm").checked, bgm_path: $("bgmPath").value.trim() })
        });
        if (!res.ok) {
          log(res.msg || "启动失败", "err");
          setStatus(res.msg || "启动失败", false);
          return;
        }
        log("运行已启动（无头模式，无实时预览）。", "ok");
      } catch (err) {
        log("启动失败：" + err.message + "（请确认 editor_server.py 正在运行）", "err");
        setStatus("启动失败", false);
        return;
      }

      startPolling();
    }

    async function stopRun() {
      try {
        const res = await api("/api/stop", { method: "POST" });
        log(res.ok ? "已发送停止请求。" : "停止请求未生效。", res.ok ? "ok" : "err");
      } catch (err) {
        log("停止失败：" + err.message, "err");
      }
    }

    function startPolling() {
      clearInterval(polling);
      polling = setInterval(async () => {
        try {
          const status = await api("/api/status");
          if (status.running) {
            setStatus("运行中...", true);
          } else if (status.crashed) {
            // 程序启动即崩：明确报错 + 指向日志，而不是把崩溃伪装成「就绪」
            setStatus("程序异常退出（退出码 " + status.exit_code + "）", false);
            clearInterval(polling);
            polling = null;
            stopLivePolling();
            log("程序异常退出（退出码 " + status.exit_code + "），不是没点上。原因见下方运行日志最后几行；"
                + "常见原因：素材文件缺失、端口被占用、workflow 数据不合法。", "err");
          } else {
            setStatus(status.video ? "完成 ✓ " + status.video : "就绪", false);
            clearInterval(polling);
            polling = null;
            stopLivePolling();
            $("liveTip").textContent = "运行已结束，画面为最后一帧；可再次运行查看新流程。";
            if (status.video) log("视频已生成：" + status.video, "ok");
          }

          const lg = await api("/api/runlog?offset=" + logOffset);
          logOffset = lg.offset;
          if (lg.text) {
            const body = $("logBody");
            lg.text.split("\n").forEach((line) => {
              if (!line.trim()) return;
              const div = document.createElement("div");
              if (line.includes("[异常]") || line.includes("失败") || line.includes("[错误]")) div.className = "err";
              else if (line.includes("[完成]") || line.includes("已保存")) div.className = "ok";
              else if (line.includes("警告") || line.includes("失败")) div.className = "warn";
              div.textContent = line;
              body.appendChild(div);
            });
            body.scrollTop = body.scrollHeight;
          }
        } catch (err) {
          // 轮询期间短暂失败通常表示服务正在重启，不刷屏。
        }
      }, 900);
    }

    async function saveRemote() {
      try {
        await api("/api/workflow", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(currentWorkflowPayload())
        });
        dirty = false;
        updateSaveState();
        log("已保存 workflow.json。", "ok");
      } catch (err) {
        log("保存失败：" + err.message, "err");
      }
    }

    async function loadRemote() {
      try {
        workflow = normalizeWorkflow(await api("/api/workflow"));
        $("flowName").value = workflow.name || "未命名流程";
        selected = -1;
        dirty = false;
        renderCanvas();
        renderProps();
        updateSaveState();
        log("已载入 workflow.json。", "ok");
      } catch (err) {
        log("载入失败：" + err.message, "err");
      }
    }

    function newWorkflow() {
      workflow = { name: "未命名流程", steps: [] };
      $("flowName").value = "未命名流程";
      selected = -1;
      dirty = false;
      renderCanvas();
      renderProps();
      saveLocal();
      updateSaveState();
      log("已新建空流程。", "ok");
    }

    function importJson() {
      $("fileInput").click();
    }

    function handleImport(file) {
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        try {
          workflow = normalizeWorkflow(JSON.parse(String(reader.result)));
          $("flowName").value = workflow.name || "未命名流程";
          selected = -1;
          dirty = false;
          renderCanvas();
          renderProps();
          saveLocal();
          updateSaveState();
          log("已导入 JSON：" + file.name, "ok");
        } catch (err) {
          log("JSON 导入失败：" + err.message, "err");
        }
      };
      reader.readAsText(file, "utf-8");
    }

    function exportJson() {
      const payload = JSON.stringify(currentWorkflowPayload(), null, 2);
      const blob = new Blob([payload], { type: "application/json;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = (workflow.name || "workflow") + ".json";
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 500);
      log("已导出 JSON。", "ok");
    }

    /* ================= 脚本模式：粘贴剧本 → AI 转译 → 预览确认 → 一键运行 ================= */
    function setView(mode) {
      $("btnViewFlow").classList.toggle("active", mode === "flow");
      $("btnViewScript").classList.toggle("active", mode === "script");
      $("btnViewGenerate").classList.toggle("active", mode === "generate");
      $("workspaceView").hidden = mode !== "flow";
      $("scriptMode").hidden = mode !== "script";
      $("generateMode").hidden = mode !== "generate";
    }

    /* ---- 大模型配置 ---- */
    async function refreshLlmStatus() {
      const cfg = { configured: false, model: "" };
      try {
        const c = await api("/api/llm/config");
        cfg.configured = !!c.configured;
        cfg.model = c.model || "";
      } catch (err) { /* 忽略 */ }
      llmConfigured = cfg.configured;
      const el = $("llmStatus");
      if (el) {
        el.textContent = llmConfigured ? "已配置 " + cfg.model : "未配置大模型";
        el.classList.toggle("on", llmConfigured);
      }
      const gel = $("genLlmStatus");
      if (gel) {
        gel.textContent = llmConfigured ? "已配置 " + cfg.model : "未配置大模型";
        gel.classList.toggle("on", llmConfigured);
      }
    }

    function openLlmModal() {
      $("llmModal").hidden = false;
      $("llmApiKey").value = "";
      $("llmModel").value = "deepseek-flash";
      $("llmBaseUrl").value = "https://api.deepseek.com";
      $("llmApiKey").focus();
    }

    function closeLlmModal() {
      $("llmModal").hidden = true;
    }

    async function saveLlmConfig() {
      const apiKey = $("llmApiKey").value.trim();
      const model = $("llmModel").value.trim() || "deepseek-flash";
      const baseUrl = $("llmBaseUrl").value.trim() || "https://api.deepseek.com";
      try {
        await api("/api/llm/config", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ api_key: apiKey, model, base_url: baseUrl })
        });
        closeLlmModal();
        await refreshLlmStatus();
        log(apiKey ? "大模型配置已保存。" : "已清空 API Key，AI 转译将自动降级为离线解析。", "ok");
      } catch (err) {
        log("保存配置失败：" + err.message, "err");
      }
    }

    /* ---- 图片槽位识别 / 配图 ---- */
    const _imgMarkerRe = /^\s*(?:[\[【]\s*(?:图片|配图)\s*[\]】])/;
    function _imgDesc(t) { const m = _imgMarkerRe.exec(t || ""); return m ? t.slice(m[0].length).trim() : (t || ""); }
    // 若「图片」参数值本身就是以 [图片]/[配图] 开头的描述文字（离线解析的常见产物），
    // 说明它不是真实路径，返回剥掉标记后的描述；否则返回 null 表示这是正常路径。
    function _markerToDesc(v) {
      if (typeof v !== "string") return null;
      const m = _imgMarkerRe.exec(v);
      return m ? (v.slice(m[0].length).trim() || "") : null;
    }
    // 文本类步骤转图片动作的映射（返回目标动作；不能转图片则返回 null）
    function _imageFor(action) {
      if (action === "对方发消息") return "对方发图片";
      if (action === "我方打字" || action === "打字不发" || action === "发送消息") return "发送图片";
      return null;
    }
    // 判断某步骤是否属于「图片消息」类（发图片/查看图片，或带图片参数/标记），
    // 用于在预览列表里给这类步骤高亮区分。
    /* 图片参数是否已配真实图（占位描述/关键词不算已配） */
    function imgPathFilled(v) {
      const t = String(v == null ? "" : v).trim();
      return !!t && (t.startsWith("/") || /^https?:/i.test(t));
    }
    function isImageStep(step) {
      if (!step || typeof step !== "object") return false;
      const params = step.params || {};
      const imageActions = new Set(["对方发图片", "发送图片", "我方发送图片", "对方发送图片", "查看图片"]);
      if (imageActions.has(step.action)) return true;
      if (params["图片"] !== undefined && String(params["图片"]).trim() !== "") return true;
      if (step.action === "对方后台发消息") {
        const content = params["内容"] !== undefined ? params["内容"] : "";
        const hasImgParam = params["图片"] !== undefined && String(params["图片"]).trim() !== "";
        return hasImgParam || (typeof content === "string" && _imgMarkerRe.test(content));
      }
      if (["对方发消息", "我方打字", "打字不发", "发送消息"].includes(step.action)) {
        const content = params["内容"] !== undefined ? params["内容"] : params["文案"];
        return typeof content === "string" && _imgMarkerRe.test(content);
      }
      return false;
    }
    // 插话里的对方表情标记（镜像 main.py 的 _IJ_EMOJI_RE）：命中表示这条插话应渲染成「对方表情贴纸」。
    const _ijEmojiRe = /^\s*[\[【]\s*(?:对方表情|对方发表情|对方表情包|对面发表情|表情|表情包)\s*[\]】]\s*(.*)$/;
    // 收集「打字不发 / 我方打字 / 发送消息」等带插话的动作里，插话参数中带「对方表情/表情」标记的槽位。
    // 每个槽位写回时只替换对应那一段的表情关键词为真实路径，其余插话保持不变。
    function _pushInterjectionEmojiSlots(slots, step) {
      if (!step || typeof step !== "object") return;
      const params = step.params || {};
      const ij = params["插话"];
      if (typeof ij !== "string" || !ij.trim()) return;
      const segs = ij.split(/[；;]/);
      segs.forEach((seg, idx) => {
        const s = (seg || "").trim();
        const m = _ijEmojiRe.exec(s);
        if (!m) return;
        const ref = (m[1] || "").trim();
        const isReal = ref.startsWith("/") || /^https?:/i.test(ref);
        const desc = ref || "对方表情";
        slots.push({
          id: "slot_e" + slots.length,
          no: "图" + (slots.length + 1),
          desc: "对方表情：" + desc,
          path: isReal ? ref : "",
          emoji: true,
          step,
          setPath: (p) => {
            const whole = params["插话"] || "";
            const parts = whole.split(/[；;]/);
            if (parts[idx] === undefined) return;
            const trimmed = parts[idx].trim();
            const mm = _ijEmojiRe.exec(trimmed);
            if (!mm) return;
            const prefix = trimmed.slice(0, trimmed.length - mm[1].length);
            parts[idx] = prefix + (p || "");
            params["插话"] = parts.join("；");
          }
        });
      });
    }
    // 只读地从任意一组步骤里收集需要配图的槽位（不修改步骤本身）。工作流运行确认弹窗用它按顺序列出要配的图。
    function collectImageSlots(steps) {
      const slots = [];
      const imageActions = new Set(["对方发图片", "发送图片"]);
      const emojiActions = new Set(["发送表情", "对方表情"]);
      const homeActions = new Set(["编辑主页", "应用场景", "编辑会话"]);
      (steps || []).forEach((step) => {
        if (!step || typeof step !== "object") return;
        const params = step.params || {};
        // 插话里带「对方表情」标记的，也补出表情贴纸槽位（用于上传自定义表情）
        _pushInterjectionEmojiSlots(slots, step);
        let desc, path;
        if (imageActions.has(step.action)) {
          const content = params["内容"] !== undefined ? params["内容"] : params["文案"];
          const raw = params["图片"] || "";
          const md = _markerToDesc(raw);
          path = md !== null ? "" : raw;
          desc = (md !== null ? md : _imgDesc(content)) || "图片消息";
        } else if (emojiActions.has(step.action)) {
          // 表情动作（发送表情/对方表情）：参数存的是表情关键词/真实路径。
          // 真实路径直接显示缩略图；文字短名显示「未配图」，让用户上传自定义表情。
          // 上传后写回 params.表情，运行时按该路径直接发送（不经过语义匹配）。
          const raw = (params["表情"] !== undefined ? params["表情"] : params["图片"]) || "";
          path = (raw && !_markerToDesc(raw) && (raw.startsWith("/") || /^https?:/i.test(raw) || /[\\/]/.test(raw) || /\.(png|jpe?g|gif|webp|bmp)$/i.test(raw))) ? raw : "";
          desc = (params["表情"] !== undefined ? params["表情"] : params["图片"]) || params["内容"] || "表情";
          slots.push({
            id: "wf_slot_" + slots.length, no: "图" + (slots.length + 1),
            desc, path, step, imgKey: "表情"
          });
          return;
        } else if (step.action === "对方后台发消息") {
          // 图片后台消息：仅当内容以 [图片]/[配图] 开头或已有 图片 参数时才纳入图片清单
          const content = params["内容"] !== undefined ? params["内容"] : "";
          const hasImgParam = params["图片"] !== undefined && String(params["图片"]).trim() !== "";
          if (!((typeof content === "string" && _imgMarkerRe.test(content)) || hasImgParam)) return;
          const raw = params["图片"] || "";
          const md = _markerToDesc(raw);
          path = md !== null ? "" : raw;
          desc = _imgDesc(content) || "图片消息";
        } else if (step.action === "我方发链接" || step.action === "对方发链接") {
          // 链接卡片封面：图片参数是封面关键词（视频封面/封面…）、文件名或真实路径。
          // 真实路径显示缩略图；关键词/文件名显示「未配图」让用户上传自己的封面。
          const raw = params["图片"] !== undefined ? String(params["图片"]).trim() : "";
          if (raw === "") return;   // 无封面引用 -> 按标题自动匹配，不需要配图
          path = (raw.startsWith("/") || /^https?:/i.test(raw)) ? raw : "";
          desc = params["标题"] || raw || "链接封面";
        } else if (homeActions.has(step.action) && Array.isArray(params["数据"])) {
          // 历史会话块 / 场景：messages 里的图片消息与链接卡片封面也纳入配图清单
          params["数据"].forEach((conv) => {
            if (!conv || !Array.isArray(conv.messages)) return;
            conv.messages.forEach((m) => {
              if (!m) return;
              const speaker = m.dir === "me" ? "我" : (conv.name || "对方");
              if (m.kind === "image") {
                slots.push({
                  id: "wf_slot_" + slots.length,
                  no: "图" + (slots.length + 1),
                  speaker,
                  desc: (m.text || m.image || conv.name || "图片消息"),
                  path: (m.image || "").trim(),
                  autoplayable: true,
                  onOptsChange: persistSlotParams,
                  setPath: (p) => { m.image = p; },
                  get open() { return m.open || ""; },
                  set open(v) { m.open = v || ""; },
                  get openHold() { return (m.openHold === undefined || m.openHold === null || m.openHold === "") ? "" : m.openHold; },
                  set openHold(v) { m.openHold = v; },
                  get openFocus() { return m.openFocus || ""; },
                  set openFocus(v) { m.openFocus = v; },
                  get openZoom() { return m.openZoom || ""; },
                  set openZoom(v) { m.openZoom = v || ""; }
                });
              } else if (m.kind === "emoji") {
                // 表情贴纸消息：历史会话块里 [表情] 消息的 image 是表情图路径（可能是已解析
                // 出的 /images/... 真实路径，也可能是短名/占位词）。给出可手动上传表情图的槽，
                // 真实路径写回 m.image；非真实路径显示「未配图」让用户上传自己的表情。
                const _raw = (m.image || "").trim();
                const _isReal = _raw.startsWith("/") || /^https?:/i.test(_raw);
                slots.push({
                  id: "wf_slot_" + slots.length,
                  no: "图" + (slots.length + 1),
                  speaker,
                  desc: (m.text || _raw || conv.name || "表情"),
                  path: _isReal ? _raw : "",
                  emoji: true,
                  setPath: (p) => { m.image = p; }
                });
              } else if (m.kind === "link") {
                const _raw = (m.image || "").trim();
                const _isReal = _raw.startsWith("/") || /^https?:/i.test(_raw);
                slots.push({
                  id: "wf_slot_" + slots.length,
                  no: "图" + (slots.length + 1),
                  speaker,
                  desc: (m.title || m.text || m.image || conv.name || "链接封面"),
                  path: _isReal ? _raw : "",
                  setPath: (p) => { m.image = p; }
                });
              }
            });
          });
          return;
        } else {
          return;
        }
        slots.push(_withStepOpenAccessors({ id: "wf_slot_" + slots.length, no: "图" + (slots.length + 1), desc, path, step }, persistSlotParams));
      });
      return slots;
    }

    /* 运行时支持「打开动画」的图片动作：主程序对这两个动作解析 打开/停留/焦点/放大倍率 参数。
       （查看图片 不算——它运行时默认就是打开，参数缺省即"是"，放进下拉会误导） */
    const _openableImgActions = new Set(["发送图片", "对方发图片"]);
    /* 给步骤类图片槽位挂「打开动画」读写访问器：
       open/openHold/openFocus/openZoom 全部透传到 step.params（打开/停留/焦点/放大倍率），
       供 shared_picker 配图清单与运行确认弹窗共用同一套控件逻辑。 */
    function _withStepOpenAccessors(slot, onChange) {
      const step = slot.step;
      if (!step || !_openableImgActions.has(step.action)) return slot;
      const get = (k) => {
        const v = (step.params || {})[k];
        return (v === undefined || v === null) ? "" : String(v);
      };
      const set = (k, v) => {
        if (!step.params) step.params = {};
        if (v === "") delete step.params[k];
        else step.params[k] = v;
      };
      Object.defineProperties(slot, {
        open:      { get: () => get("打开"),     set: (v) => set("打开", v) },
        openHold:  { get: () => get("停留"),     set: (v) => set("停留", v) },
        openFocus: { get: () => get("焦点"),     set: (v) => set("焦点", v) },
        openZoom:  { get: () => get("放大倍率"), set: (v) => set("放大倍率", v) },
      });
      slot.openable = true;
      slot.onOptsChange = typeof onChange === "function" ? onChange : () => { renderScriptPreview(); saveScriptDraft(); };
      return slot;
    }

    function syncImageAttach() {
      const box = $("scriptAttach");
      if (!box || !window.__wxPick) return;
      const contentKeys = ["内容", "文案"];
      const imageActions = new Set(["对方发图片", "发送图片"]);
      const emojiActions = new Set(["发送表情", "对方表情"]);
      imageSlots = [];
      // 先把已被标记为图片的步骤里已配的路径记录下来，供重新识别保留
      const prevByStep = imageSlotPathByStep;
      scriptSteps.forEach((step) => {
        if (!step || typeof step !== "object") return;
        const params = step.params || {};
        // 插话里带「对方表情」标记的，也补出表情贴纸槽位（用于上传自定义表情）
        _pushInterjectionEmojiSlots(imageSlots, step);
        // 情况一：已经是图片动作（对方发图片/发送图片），即使没配图也显示槽位，方便补/换图
        if (imageActions.has(step.action)) {
          const raw = params["图片"] || prevByStep.get(step) || "";
          const md = _markerToDesc(raw);
          const path = md !== null ? "" : raw;
          const desc = (md !== null ? md : _imgDesc(params["内容"] || params["文案"] || "")) || "图片消息";
          if (path) step.params["图片"] = path;
          prevByStep.set(step, path);
          imageSlots.push(_withStepOpenAccessors({ id: "step_" + imageSlots.length, no: "图" + (imageSlots.length + 1), desc, path: path, step }));
          return;
        }
        // 情况一b：表情动作（发送表情/对方表情）——参数存的是表情关键词；
        // 若已是真实路径则显示缩略图，否则显示「未配图」让用户上传。写回 params.表情。
        if (emojiActions.has(step.action)) {
          const raw = (params["表情"] !== undefined ? params["表情"] : params["图片"]) || prevByStep.get(step) || "";
          const path = (raw && !_markerToDesc(raw) && (raw.startsWith("/") || /^https?:/i.test(raw) || /[\\/]/.test(raw) || /\.(png|jpe?g|gif|webp|bmp)$/i.test(raw))) ? raw : "";
          const desc = (params["表情"] !== undefined ? params["表情"] : params["图片"]) || params["内容"] || "表情";
          if (path) step.params["表情"] = path;
          prevByStep.set(step, path);
          imageSlots.push({
            id: "step_" + imageSlots.length, no: "图" + (imageSlots.length + 1),
            desc, path, step, imgKey: "表情", emoji: true
          });
          return;
        }
        // 情况一c：链接卡片动作（我方发链接/对方发链接）——图片参数是封面关键词/文件名/路径。
        // 真实路径显示缩略图，否则显示「未配图」让用户上传封面；配图写回 params.图片。
        if (step.action === "我方发链接" || step.action === "对方发链接") {
          const raw = params["图片"] !== undefined ? String(params["图片"]).trim() : "";
          const path = (raw && !_markerToDesc(raw) && (raw.startsWith("/") || /^https?:/i.test(raw))) ? raw : "";
          const desc = params["标题"] || raw || "链接封面";
          prevByStep.set(step, raw ? path : "");
          imageSlots.push({ id: "step_" + imageSlots.length, no: "图" + (imageSlots.length + 1), desc, path, step, imgKey: "图片" });
          return;
        }
        // 情况二：消息文本以 [图片] 开头 → 转成图片动作
        let content = "";
        for (const k of contentKeys) {
          if (params[k] !== undefined) { content = params[k]; break; }
        }
        if (typeof content === "string" && _imgMarkerRe.test(content)) {
          const target = _imageFor(step.action);
          if (target) {
            const desc = _imgDesc(content);
            const prev = prevByStep.get(step) || "";
            // 转成图片动作：内容 -> 图片参数；保留 内容 作为可读描述（运行时会忽略）
            step.action = target;
            step.params = { 图片: prev, 内容: desc };
            prevByStep.set(step, prev);
            imageSlots.push(_withStepOpenAccessors({ id: "step_" + imageSlots.length, no: "图" + (imageSlots.length + 1), desc, path: prev, step }));
            return;
          }
        }
        // 情况二b：对方后台发消息 支持图片 —— 内容以 [图片]/[配图] 开头，或已带 图片 参数。
        // 保留动作不变，图片路径写入 params.图片，内容收敛为描述（去掉 [图片] 前缀）供配图面板显示。
        if (step.action === "对方后台发消息") {
          const content = params["内容"] !== undefined ? params["内容"] : "";
          const hasImgParam = params["图片"] !== undefined && String(params["图片"]).trim() !== "";
          if ((typeof content === "string" && _imgMarkerRe.test(content)) || hasImgParam) {
            const prev = params["图片"] !== undefined ? params["图片"] : (prevByStep.get(step) || "");
            const path = (prev && !_markerToDesc(prev)) ? prev : "";
            const desc = _imgDesc(content) || "图片消息";
            step.params["内容"] = desc;
            step.params["图片"] = path;
            prevByStep.set(step, path);
            imageSlots.push({ id: "step_" + imageSlots.length, no: "图" + (imageSlots.length + 1), desc, path, step });
            return;
          }
        }
        // 情况三：历史会话块生成的 [编辑主页]/[应用场景]/[编辑会话]，其 messages 里
        // kind==image 的项 -> 图片槽（含已配图，方便勾选「打开动画」并补/换图）；
        // setPath 写回该消息的 image 字段，open/openHold/openFocus 写回消息自身。
        if ((step.action === "编辑主页" || step.action === "应用场景" || step.action === "编辑会话") && Array.isArray(params["数据"])) {
          params["数据"].forEach((conv) => {
            if (!conv || !Array.isArray(conv.messages)) return;
            conv.messages.forEach((m) => {
              if (!m) return;
              const speaker = m.dir === "me" ? "我" : (conv.name || "对方");
              if (m.kind === "image") {
                const desc = (m.text || m.image || conv.name || "图片消息");
                imageSlots.push({
                  id: "hist_" + imageSlots.length,
                  no: "图" + (imageSlots.length + 1),
                  speaker,
                  desc,
                  path: (m.image || "").trim(),
                  autoplayable: true,
                  setPath: (p) => { m.image = p; },
                  get open() { return m.open || ""; },
                  set open(v) { m.open = v || ""; },
                  get openHold() { return (m.openHold === undefined || m.openHold === null || m.openHold === "") ? "" : m.openHold; },
                  set openHold(v) { m.openHold = v; },
                  get openFocus() { return m.openFocus || ""; },
                  set openFocus(v) { m.openFocus = v; },
                  get openZoom() { return m.openZoom || ""; },
                  set openZoom(v) { m.openZoom = v || ""; },
                  onOptsChange: () => { renderScriptPreview(); saveScriptDraft(); }
                });
              } else if (m.kind === "emoji") {
                // 表情贴纸消息：历史会话块里 [表情] 消息的 image 是表情图路径（可能是已解析
                // 出的 /images/... 真实路径，也可能是短名/占位词）。给出可手动上传表情图的槽，
                // 真实路径写回 m.image；非真实路径显示「未配图」让用户上传自己的表情。
                const _raw = (m.image || "").trim();
                const _isReal = _raw.startsWith("/") || /^https?:/i.test(_raw);
                const desc = (m.text || _raw || conv.name || "表情");
                imageSlots.push({
                  id: "hist_" + imageSlots.length,
                  no: "图" + (imageSlots.length + 1),
                  speaker,
                  desc,
                  path: _isReal ? _raw : "",
                  emoji: true,
                  setPath: (p) => { m.image = p; },
                  onOptsChange: () => { renderScriptPreview(); saveScriptDraft(); }
                });
              } else if (m.kind === "link") {
                // 链接卡片封面：历史会话块里 [链接] 消息的 image 字段通常是封面关键词
                // 或短名（前端 config.js 会自动补 /images/link/ 前缀）。这里给一个可手动
                // 上传封面的槽：把真实路径写回 m.image。仅当 m.image 已是真实路径
                // （/images/ 或 http）时才显示缩略图，否则显示「未配图」让用户点选。
                const _raw = (m.image || "").trim();
                const _isReal = _raw.startsWith("/") || /^https?:/i.test(_raw);
                const desc = (m.title || m.text || m.image || conv.name || "链接封面");
                imageSlots.push({
                  id: "hist_" + imageSlots.length,
                  no: "图" + (imageSlots.length + 1),
                  speaker,
                  desc,
                  path: _isReal ? _raw : "",
                  setPath: (p) => { m.image = p; },
                  onOptsChange: () => { renderScriptPreview(); saveScriptDraft(); }
                });
              }
            });
          });
        }
      });
      box.style.display = imageSlots.length ? "" : "none";
      if (imageSlots.length) {
        __wxPick.renderAttachPanel(box, imageSlots, (id, path) => {
          const slot = imageSlots.find((s) => s.id === id);
          if (!slot) return;
          if (slot.setPath) {
            slot.setPath(path);
            slot.path = path;
          } else if (slot.step) {
            imageSlotPathByStep.set(slot.step, path);
            if (slot.step.params) {
              // 按槽位自己的 key 写回：图片步骤写 params.图片，表情步骤写 params.表情，
              // 保证「上传哪张就发哪张」——表情步骤写错 key 会丢图、运行时退回按名字选图。
              // 表情步骤若只有 图片 key（AI 手写）就沿用 图片，避免空 表情 顶掉真值。
              let k = slot.imgKey || "图片";
              if (k === '表情' && slot.step.params['表情'] === undefined && slot.step.params['图片'] !== undefined) k = '图片';
              slot.step.params[k] = path;
            }
          }
          renderScriptPreview();
          saveScriptDraft();
        });
      }
    }

    /* ---- 转译 ---- */
    async function doTranslate(forceOffline) {
      const text = $("scriptInput").value;
      if (!text.trim()) {
        alert("请先粘贴剧本文本。");
        return;
      }
      const btn = forceOffline ? $("btnOffline") : $("btnTranslate");
      const oldText = btn.textContent;
      btn.disabled = true;
      btn.textContent = forceOffline ? "解析中…" : "转译中…";
      log(forceOffline ? "正在离线解析剧本……" : "正在调用 DeepSeek 转译剧本……", "warn");
      try {
        const res = await api("/api/translate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ text, offline: forceOffline })
        });
        if (!res.ok) {
          log(res.msg || "转译失败", "err");
          return;
        }
        scriptSteps = Array.isArray(res.steps) ? res.steps : [];
        scriptSelected = -1;
        scriptEditIndex = -1;
        $("scriptEditArea").hidden = true;
        renderScriptWarnings(res.warnings || []);
        syncImageAttach();
        renderScriptPreview();
        saveScriptDraft();
        const srcLabel = res.source === "llm" ? "AI 转译" : "离线解析";
        const warnCount = (res.warnings || []).length;
        log("转译完成（" + srcLabel + "），共 " + scriptSteps.length + " 步。" +
            (warnCount ? " 有 " + warnCount + " 条提示，见右侧横幅。" : ""), "ok");
        maybeOfferMoments(text);
      } catch (err) {
        log("转译失败：" + err.message, "err");
      } finally {
        btn.disabled = false;
        btn.textContent = oldText;
      }
    }

    /* ================= 朋友圈设置（解析后自动弹出） =================
       解析结果里只要出现「进入朋友圈 / 进入对方朋友圈」（或剧本文字里提到朋友圈），
       就自动弹出朋友圈编辑面板：编内容 + 给每张图/每个视频定「打开后看多久」。
       应用时写回 scene.json，并在流程里生成/更新一段朋友圈演示段。 */
    let momentsPanelBusy = false;

    /* 从场景里找出「对方朋友圈」当前生效的那份数据，并给出写回位置的闭包。
       规则与 editor_server._build_scene_workflow 保持一致：
         scene.peers[]（多人物 × 多方案）优先 → scene.peer（旧格式）。 */
    function resolvePeerSlot(scene) {
      if (!scene || typeof scene !== "object") return null;
      const peers = Array.isArray(scene.peers) ? scene.peers : [];
      for (let i = 0; i < peers.length; i++) {
        const pp = peers[i];
        if (!pp || typeof pp !== "object") continue;
        const plans = (pp.plans && typeof pp.plans === "object") ? pp.plans : {};
        const keys = Object.keys(plans);
        const key = (pp.activePlan && plans[pp.activePlan]) ? pp.activePlan : keys[0];
        const plan = key ? plans[key] : null;
        if (plan && typeof plan === "object" && Object.keys(plan).length) {
          return {
            data: plan,
            write: function (next) {
              plans[key] = next;
              if (scene.peer && typeof scene.peer === "object") {
                for (const k of Object.keys(scene.peer)) delete scene.peer[k];
                Object.assign(scene.peer, next);
              }
            }
          };
        }
      }
      if (scene.peer && typeof scene.peer === "object" && Object.keys(scene.peer).length) {
        return { data: scene.peer, write: function (next) { scene.peer = next; } };
      }
      return null;
    }

    /* 打开朋友圈设置面板。tab: "me" | "peer" */
    async function openMomentsPanel(tab) {
      const M = window.__wxMomentsEditor;
      if (!M) { log("朋友圈设置模块没加载成功（moments_editor.js）。", "err"); return; }
      if (momentsPanelBusy) return;
      momentsPanelBusy = true;
      let scene = {};
      try { scene = await api("/api/scene"); } catch (err) { scene = {}; }
      momentsPanelBusy = false;
      if (!scene || typeof scene !== "object") scene = {};
      const slot = resolvePeerSlot(scene);
      M.open({
        tab: tab === "peer" ? "peer" : "me",
        me: Array.isArray(scene.moments) ? scene.moments : [],
        peer: slot ? slot.data : null,
        onApply: function (res) { applyMomentsResult(res); }
      });
    }

    /* ---- 把面板结果落盘：scene.json + 流程步骤 ---- */
    async function applyMomentsResult(res) {
      // ---- 1) 写回 scene.json（场景编辑器里也能看到同一份朋友圈） ----
      let scene = {};
      try { scene = await api("/api/scene"); } catch (err) { scene = {}; }
      if (!scene || typeof scene !== "object") scene = {};
      if (Array.isArray(res.me)) scene.moments = res.me;
      if (res.peer && typeof res.peer === "object") {
        const slot = resolvePeerSlot(scene);
        if (slot) slot.write(res.peer);
        else scene.peer = res.peer;
      }
      try {
        const saved = await api("/api/scene", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(scene)
        });
        if (!saved || !saved.ok) log(saved && saved.msg ? saved.msg : "场景保存失败。", "err");
      } catch (err) {
        log("场景保存失败：" + err.message, "err");
      }
      // ---- 2) 更新流程步骤 ----
      const stat = applyMomentsToSteps(res);
      scriptSelected = -1;
      scriptEditIndex = -1;
      $("scriptEditArea").hidden = true;
      renderScriptPreview();
      saveScriptDraft();
      const n = (res.demo && res.demo.me ? res.demo.me.length : 0) +
                (res.demo && res.demo.peer ? res.demo.peer.length : 0);
      log("朋友圈已保存。" + (n ? "流程里新增/更新了 " + n + " 步朋友圈演示（进入 → 滚动 → 打开）" +
          (stat.removed ? "，替换掉旧的 " + stat.removed + " 步。" : "。") : "（没勾选要打开的内容，未加演示步骤）"), "ok");
    }

    /* 把内容步骤与「朋友圈演示段」写进 scriptSteps：
       · 内容步骤（编辑朋友圈 / 编辑对方资料）就地更新，没有就插到流程最前（数据要先进场景）；
       · 演示段整段重建，位置 = 原演示段所在处 / 原朋友圈动作段所在处 / 末尾；
       · res.takeover 为真时，把流程里原有的朋友圈动作段（进入朋友圈 / 向下滚动 /
         点开图片 / 播放视频…这串）整体替换掉，避免「解析自带一段 + 面板再来一段」重复两遍。 */
    function applyMomentsToSteps(res) {
      const M = window.__wxMomentsEditor;
      const TAG = (M && M.STEP_TAG) || "_wxm";
      const tagged = function (s) { return !!(s && s[TAG]); };

      // 「朋友圈动作段」的成员：解析器自己产出的朋友圈相关动作
      const NAV = ["进入朋友圈", "进入对方朋友圈", "向下滚动", "向上滚动", "滚动到", "点开图片", "播放视频"];

      let insertAt = scriptSteps.findIndex(tagged);
      let legacyFrom = -1, legacyTo = -1;
      if (insertAt < 0 && res.takeover !== false) {
        // 找第一段「进入朋友圈 / 进入对方朋友圈」，向两侧吞掉相邻的朋友圈动作
        const start = scriptSteps.findIndex(function (s) {
          return s && !tagged(s) && (s.action === "进入朋友圈" || s.action === "进入对方朋友圈");
        });
        if (start >= 0) {
          let a = start, b = start;
          while (a - 1 >= 0 && NAV.indexOf(scriptSteps[a - 1].action) >= 0) a--;
          while (b + 1 < scriptSteps.length && NAV.indexOf(scriptSteps[b + 1].action) >= 0) b++;
          legacyFrom = a; legacyTo = b;
          insertAt = a;
        }
      }
      if (insertAt < 0) insertAt = scriptSteps.length;

      const removedBefore = scriptSteps.slice(0, insertAt).filter(tagged).length;
      let removed = scriptSteps.filter(tagged).length;

      // 内容步骤：就地更新，或记下来统一前插
      const needFront = [];
      const setData = function (action, data) {
        const idx = scriptSteps.findIndex(function (s) { return s && s.action === action && !tagged(s); });
        if (idx >= 0) {
          if (!scriptSteps[idx].params || typeof scriptSteps[idx].params !== "object") scriptSteps[idx].params = {};
          scriptSteps[idx].params["数据"] = data;
          return;
        }
        needFront.push({ action: action, params: { 数据: data } });
      };
      if (Array.isArray(res.me) && res.me.length) setData("编辑朋友圈", res.me);
      if (res.peer && Array.isArray(res.peer.posts) && res.peer.posts.length) setData("编辑对方资料", res.peer);

      // 移除旧的演示段 / 原有的朋友圈动作段
      if (legacyFrom >= 0) {
        removed += legacyTo - legacyFrom + 1;
        scriptSteps.splice(legacyFrom, legacyTo - legacyFrom + 1);
      }
      for (let i = scriptSteps.length - 1; i >= 0; i--) if (tagged(scriptSteps[i])) scriptSteps.splice(i, 1);
      // 前插内容步骤
      if (needFront.length) {
        scriptSteps.unshift.apply(scriptSteps, needFront);
        insertAt += needFront.length;
      }
      insertAt -= removedBefore;
      if (insertAt < 0) insertAt = 0;
      if (insertAt > scriptSteps.length) insertAt = scriptSteps.length;

      // 新演示段：我的朋友圈在前，对方朋友圈在后
      const block = [];
      if (res.demo && Array.isArray(res.demo.me)) block.push.apply(block, res.demo.me);
      if (res.demo && Array.isArray(res.demo.peer)) block.push.apply(block, res.demo.peer);
      if (block.length) scriptSteps.splice.apply(scriptSteps, [insertAt, 0].concat(block));
      return { removed: removed, added: block.length };
    }

    /* 解析完成后判断要不要自动弹面板 */
    function maybeOfferMoments(text) {
      const M = window.__wxMomentsEditor;
      if (!M || typeof M.detect !== "function") return false;
      const d = M.detect(scriptSteps, text);
      if (!d.any) return false;
      log("检测到流程里有朋友圈动作，已打开「朋友圈设置」：可编内容、定每张图/每个视频看多久。", "warn");
      openMomentsPanel(d.peer && !d.me ? "peer" : "me");
      return true;
    }

    /* ---- 预览渲染 ---- */
    function scriptParamText(params, key) {
      const value = params && params[key] !== undefined ? params[key] : "";
      if (value && typeof value === "object") return JSON.stringify(value);
      return String(value);
    }

    function scriptStepSummary(step) {
      const def = getDef(step.action);
      if (!def) return "未知动作";
      if (!def.params || !def.params.length) return def.desc || "该动作无参数";
      const parts = def.params
        .map((p) => {
          const value = scriptParamText(step.params, p.key);
          if (value === "") return "";
          if (value.length > 40) return p.label + "：" + value.slice(0, 40) + "…";
          return p.label + "：" + value;
        })
        .filter(Boolean);
      return parts.join("，") || def.desc || "该动作无参数";
    }

    function renderScriptWarnings(warnings) {
      const el = $("scriptWarnings");
      if (!warnings || !warnings.length) {
        el.hidden = true;
        return;
      }
      el.hidden = false;
      el.innerHTML = "<b>转译提示（" + warnings.length + " 条）</b>" +
        warnings.map((w) => '<span class="warn-item">• ' + esc(w) + '</span>').join("");
    }

    function renderScriptPreview() {
      const el = $("scriptPreview");
      $("scriptStats").textContent = scriptSteps.length + " 步";
      if (!scriptSteps.length) {
        el.innerHTML = '<div class="empty-script">转译结果会显示在这里，可编辑确认后运行。</div>';
        return;
      }
      el.innerHTML = "";
      scriptSteps.forEach((step, index) => {
        const def = getDef(step.action);
        const card = document.createElement("div");
        const imgStep = isImageStep(step);
        const imgReady = imgStep && (imgPathFilled((step.params || {})["图片"]) || imgPathFilled((step.params || {})["表情"]));
        card.className = "script-step" + (index === scriptSelected ? " selected" : "") +
          (imgStep ? (" img" + (imgReady ? " filled" : "")) : "");
        // 消息类动作可「转图片 / 转回文本」，用于大模型没识别出图片时手动补图
        const imgToggle = (["对方发消息", "我方打字", "打字不发", "发送消息", "对方发图片", "发送图片"].includes(step.action))
          ? '<button type="button" class="icon-btn" title="' +
              (["对方发图片", "发送图片"].includes(step.action) ? "转回文本消息" : "转为图片消息（补图）") +
              '" data-op="img">🖼</button>' : '';
        card.innerHTML =
          '<span class="ss-index">' + (index + 1) + '</span>' +
          '<span class="ss-icon">' + esc(def.icon || "•") + '</span>' +
          '<div class="ss-main"><div class="ss-title">' + esc(step.action) + '</div>' +
          '<div class="ss-summary">' + esc(scriptStepSummary(step)) + '</div></div>' +
          (imgStep ? '<span class="ss-need' + (imgReady ? ' ok' : '') + '">' + (imgReady ? '已配图' : '待配图') + '</span>' : '') +
          '<div class="ss-ops">' +
            '<button type="button" class="icon-btn" title="上移" data-op="up">↑</button>' +
            '<button type="button" class="icon-btn" title="下移" data-op="down">↓</button>' +
            imgToggle +
            '<button type="button" class="icon-btn" title="编辑参数（JSON）" data-op="edit">✎</button>' +
            '<button type="button" class="icon-btn danger" title="删除" data-op="del">×</button>' +
          '</div>';
        card.addEventListener("click", (event) => {
          if (event.target.closest("button")) return;
          scriptSelected = index;
          scriptEditIndex = -1;
          $("scriptEditArea").hidden = true;
          renderScriptPreview();
          saveScriptDraft();
        });
        card.querySelectorAll("[data-op]").forEach((btn) => {
          btn.addEventListener("click", (event) => {
            event.stopPropagation();
            const op = btn.dataset.op;
            if (op === "up") scriptMove(index, -1);
            if (op === "down") scriptMove(index, 1);
            if (op === "img") scriptToggleImage(index);
            if (op === "edit") scriptEdit(index);
            if (op === "del") scriptRemove(index);
          });
        });
        el.appendChild(card);
      });
    }

    function scriptMove(index, delta) {
      const to = index + delta;
      if (to < 0 || to >= scriptSteps.length) return;
      const [step] = scriptSteps.splice(index, 1);
      scriptSteps.splice(to, 0, step);
      scriptSelected = to;
      syncImageAttach();
      renderScriptPreview();
      saveScriptDraft();
    }

    // 消息类步骤在「文本 / 图片」之间切换：大模型没识别出图片时，可手动转成图片并补图；
    // 已转成图片的步骤可一键改回文本。
    function scriptToggleImage(index) {
      const step = scriptSteps[index];
      if (!step) return;
      const params = step.params || {};
      const isImage = ["对方发图片", "发送图片"].includes(step.action);
      if (isImage) {
        // 图片 -> 文本：把图片描述还原成消息内容
        const slot = imageSlots.find((s) => s.step === step);
        const desc = (slot && slot.desc) || "";
        step.action = "对方发消息";
        step.params = { 内容: desc };
      } else {
        const target = _imageFor(step.action);
        if (!target) return;
        const content = params["内容"] !== undefined ? params["内容"] : params["文案"];
        const desc = _imgDesc(typeof content === "string" ? content : "") || "图片消息";
        step.action = target;
        step.params = { 图片: params["图片"] || "", 内容: desc };
      }
      syncImageAttach();
      renderScriptPreview();
      saveScriptDraft();
    }

    function scriptRemove(index) {
      if (!confirm("确定删除这一步吗？")) return;
      scriptSteps.splice(index, 1);
      if (scriptSelected >= scriptSteps.length) scriptSelected = scriptSteps.length - 1;
      if (scriptSelected === index) scriptSelected = -1;
      if (scriptEditIndex === index) scriptEditIndex = -1;
      $("scriptEditArea").hidden = true;
      syncImageAttach();
      renderScriptPreview();
      saveScriptDraft();
    }

    function scriptEdit(index) {
      scriptSelected = index;
      scriptEditIndex = index;
      $("scriptEditArea").hidden = false;
      $("scriptEditJson").value = JSON.stringify(scriptSteps[index], null, 2);
      renderScriptPreview();
    }

    function applyScriptEdit() {
      if (scriptEditIndex < 0) return;
      try {
        const data = JSON.parse($("scriptEditJson").value);
        if (!data || typeof data !== "object" || !data.action) {
          alert("JSON 必须是一个动作对象：{ action: ..., params: { ... } }");
          return;
        }
        scriptSteps[scriptEditIndex] = {
          action: String(data.action),
          params: data.params && typeof data.params === "object" ? data.params : {}
        };
        scriptEditIndex = -1;
        $("scriptEditArea").hidden = true;
        syncImageAttach();
        renderScriptPreview();
        saveScriptDraft();
        log("步骤已更新。", "ok");
      } catch (err) {
        alert("JSON 解析失败：" + err.message);
      }
    }

    function cancelScriptEdit() {
      scriptEditIndex = -1;
      $("scriptEditArea").hidden = true;
    }

    /* ---- 草稿保存 / 载入 ---- */
    function saveScriptDraft() {
      try {
        localStorage.setItem(SCRIPT_STORAGE_KEY, JSON.stringify({
          text: $("scriptInput").value,
          steps: scriptSteps
        }));
      } catch (err) { /* 忽略存储异常 */ }
    }

    function restoreScriptDraft() {
      try {
        const raw = localStorage.getItem(SCRIPT_STORAGE_KEY);
        if (!raw) return;
        const draft = JSON.parse(raw);
        if (draft && typeof draft === "object") {
          if (typeof draft.text === "string") $("scriptInput").value = draft.text;
          if (Array.isArray(draft.steps)) scriptSteps = draft.steps;
        }
      } catch (err) { /* 忽略 */ }
    }

    /* ---- 示例剧本 ---- */
    const SCRIPT_EXAMPLE = [
      "# 以 # 开头的行是注释，空行会被忽略",
      "# 指令格式：[指令] 参数（部分指令无参数）",
      "",
      "[等待] 0.5",
      "[打开聊天] 小明",
      "[等待] 0.8",
      "[我方打字] 在吗，晚上的方案改好了发你",
      "[等待] 0.5",
      "[对方正在输入] 1.2",
      "[对方发消息] 好的，辛苦啦",
      "[等待] 0.8",
      "",
      "[回到聊天主页]",
      "[等待] 0.6",
      "[打开聊天] 小明",
      "[等待] 0.8",
      "[我方打字] 周末的电影票我买好了",
      "[对方正在输入] 1.5",
      "[对方发消息] 太棒了！几点的场",
      "[我方打字] 下午三点，万达店",
      "[等待] 0.5",
      "",
      "[返回聊天主页]",
      "[等待] 0.5",
      "[切换Tab] 发现",
      "[等待] 0.6",
      "[进入朋友圈]",
      "[等待] 0.8",
      "[向下滚动] 300",
      "[等待] 0.5",
      "[点开图片] 1,1",
      "[等待] 0.5",
      "[点赞]",
      "[向下滚动] 400",
      "[评论] 这张图拍得真不错！",
      "[等待] 1",
      "",
      "# —— 对方主页 / 对方朋友圈（复刻参考视频「微信进入主页加入朋友圈」）——",
      "[编辑对方资料] 餐车老板娘·吴遂卿",
      "[打开对方主页]",
      "[等待] 0.8",
      "[进入对方朋友圈]",
      "[等待] 0.8",
      "[向下滚动] 400",
      "[向上滚动] 200",
      "[点开图片] 1,2",
      "[播放视频]",
      "[闪回聊天]",
      "[等待] 0.5"
    ].join("\n");

    function loadScriptExample() {
      $("scriptInput").value = SCRIPT_EXAMPLE;
      saveScriptDraft();
      log("已载入示例剧本，可点击「AI 转译剧本」或「离线解析」。", "ok");
    }

    /* ---- 运行 ---- */
    async function runScript() {
      if (!scriptSteps.length) {
        alert("还没有转译结果，请先粘贴剧本并转译。");
        return;
      }
      const missing = imageSlots.filter((s) => !s.path);
      if (missing.length) {
        log("提示：还有 " + missing.length + " 张图片未配图，运行会得到空图片，建议先在「🖼 配图清单」补图。", "warn");
      }
      if (editActive) {
        log("检测到编辑模式运行中，正在自动退出以开始运行……", "warn");
        await stopEditMode();
      }
      const payload = normalizeWorkflow({ name: "脚本模式运行", steps: scriptSteps });
      logOffset = 0;
      $("logBody").innerHTML = "";
      setStatus("运行中...", true);
      closeLivePanel();
      $("liveTip").textContent = "已按无头模式运行，无实时预览（避免闪帧）。";
      log("正在启动脚本模式运行（共 " + payload.steps.length + " 步）……", "warn");
      try {
        const res = await api("/api/run", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ workflow: payload, headless: true, use_scene: !!$("chkScene").checked, typing_speed: Number($("runTypingSpeed").value), intro: !!$("chkIntro").checked, bgm: !!$("chkBgm").checked, bgm_path: $("bgmPath").value.trim() })
        });
        if (!res.ok) {
          log(res.msg || "启动失败", "err");
          setStatus(res.msg || "启动失败", false);
          return;
        }
        log("运行已启动（无头模式，无实时预览）。", "ok");
      } catch (err) {
        log("启动失败：" + err.message + "（请确认 editor_server.py 正在运行）", "err");
        setStatus("启动失败", false);
        return;
      }
      startPolling();
    }

    /* ================ 创作生成面板 ================ */
    let lastGenWarnings = []; // 最近一次的软警告（用于切到脚本模式时展示）

    function fmtTime(ts) {
      const n = Number(ts) || 0;
      if (!n) return "";
      const d = new Date(n * 1000);
      const p = (x) => String(x).padStart(2, "0");
      return p(d.getMonth() + 1) + "-" + p(d.getDate()) + " " + p(d.getHours()) + ":" + p(d.getMinutes());
    }

    async function copyText(text) {
      const t = String(text || "");
      if (!t) return false;
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(t);
          return true;
        }
      } catch (err) { /* 回退到 execCommand */ }
      const ta = document.createElement("textarea");
      ta.value = t;
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.select();
      let ok = false;
      try { ok = document.execCommand("copy"); } catch (err) { ok = false; }
      ta.remove();
      return ok;
    }

    // 主题 / 类别 / 勾选的参考剧本存本地，刷新页面不丢。
    function saveGenDraft() {
      try {
        localStorage.setItem(GEN_DRAFT_KEY, JSON.stringify({
          brief: $("genBrief").value,
          category: $("genCategory").value,
          refs: Array.from(genSelectedRefs)
        }));
      } catch (err) { /* 忽略存储异常 */ }
    }

    function restoreGenDraft() {
      try {
        const raw = localStorage.getItem(GEN_DRAFT_KEY);
        if (!raw) return;
        const d = JSON.parse(raw);
        if (d && typeof d === "object") {
          if (typeof d.brief === "string") $("genBrief").value = d.brief;
          if (typeof d.category === "string") $("genCategory").value = d.category;
          if (Array.isArray(d.refs)) genSelectedRefs = new Set(d.refs.map(String));
        }
      } catch (err) { /* 忽略 */ }
    }

    function updateGenStats() {
      const chars = ($("genText").value || "").length;
      $("genStats").textContent = genSteps.length + " 步 · " + chars + " 字";
    }

    function updateRefHint() {
      const el = $("genRefHint");
      if (el) el.textContent = "已选 " + genSelectedRefs.size + " 个";
    }

    function startGenTimer() {
      const box = $("genProgress");
      const t0 = Date.now();
      box.hidden = false;
      box.textContent = "生成中… 已用 0 秒（大模型逐轮创作 + 自我纠错，通常 20~90 秒，请勿关闭页面）";
      if (genTimer) clearInterval(genTimer);
      genTimer = setInterval(() => {
        const s = Math.floor((Date.now() - t0) / 1000);
        box.textContent = "生成中… 已用 " + s + " 秒（大模型逐轮创作 + 自我纠错，请勿关闭页面）";
      }, 1000);
    }

    function stopGenTimer(msg) {
      if (genTimer) { clearInterval(genTimer); genTimer = null; }
      const box = $("genProgress");
      if (msg) { box.hidden = false; box.textContent = msg; }
      else { box.hidden = true; box.textContent = ""; }
    }

    async function loadGenHistory() {
      const el = $("genHistoryList");
      try {
        const res = await api("/api/generate/history");
        genHistory = (res && res.items) || [];
        renderGenHistory();
      } catch (err) {
        el.innerHTML = '<div class="empty-script">历史加载失败：' + esc(err.message) + '</div>';
      }
    }

    function renderGenHistory() {
      const el = $("genHistoryList");
      $("genHistoryCount").textContent = genHistory.length + " 条";
      const q = genHistoryQuery.trim().toLowerCase();
      const items = q
        ? genHistory.filter((x) =>
            (x.brief || "").toLowerCase().includes(q) ||
            (x.category || "").toLowerCase().includes(q) ||
            (x.ref_titles || []).join(" ").toLowerCase().includes(q))
        : genHistory;
      if (!items.length) {
        el.innerHTML = '<div class="empty-script">' +
          (genHistory.length ? "没有匹配的记录。" : "还没有生成记录，生成一次就会自动存进这里。") + '</div>';
        return;
      }
      el.innerHTML = "";
      items.forEach((x) => {
        const pass = !!x.passed;
        const meta = [fmtTime(x.created_at), x.steps + " 步", (x.chars || 0) + " 字"];
        if (x.attempts > 1) meta.push(x.attempts + " 轮");
        if (x.score) meta.push("★" + x.score);
        const refs = (x.ref_titles || []).filter(Boolean);
        const card = document.createElement("div");
        card.className = "gen-history-item" + (x.id === genCurrentId ? " active" : "");
        card.innerHTML =
          '<div class="ghi-top">' +
            '<span class="ghi-brief">' + esc(x.brief || "(无主题)") + '</span>' +
            '<span class="ghi-badge ' + (pass ? "ok" : "err") + '">' + (pass ? "✔" : "✖") + '</span>' +
          '</div>' +
          '<div class="ghi-meta">' + esc(meta.join(" · ")) + '</div>' +
          (refs.length ? '<div class="ghi-refs">参考：' + esc(refs.join("、")) + '</div>' : '') +
          '<div class="ghi-actions">' +
            '<button type="button" class="btn small" data-act="load">载入</button>' +
            '<button type="button" class="btn small ghost" data-act="copy">复制</button>' +
            '<span class="spacer"></span>' +
            '<button type="button" class="icon-btn danger" data-act="del" title="删除这条记录">×</button>' +
          '</div>';
        card.querySelector('[data-act="load"]').onclick = () => loadGenHistoryItem(x.id);
        card.querySelector('[data-act="copy"]').onclick = async () => {
          try {
            const r = await api("/api/generate/history/" + x.id);
            const ok = await copyText((r.item && r.item.text) || "");
            log(ok ? "已复制该条历史剧本。" : "复制失败，请先载入后手动复制。", ok ? "ok" : "warn");
          } catch (err) { log("复制失败：" + err.message, "err"); }
        };
        card.querySelector('[data-act="del"]').onclick = async () => {
          if (!confirm("删除这条生成历史？")) return;
          try {
            await api("/api/generate/history/" + x.id, { method: "DELETE" });
            if (x.id === genCurrentId) genCurrentId = "";
            loadGenHistory();
          } catch (err) { log("删除失败：" + err.message, "err"); }
        };
        el.appendChild(card);
      });
    }

    async function loadGenHistoryItem(id) {
      try {
        const res = await api("/api/generate/history/" + id);
        const item = res && res.item;
        if (!item) { log("历史记录不存在。", "err"); return; }
        genCurrentId = String(item.id || id);
        genCurrentBrief = String(item.brief || "");
        lastGenWarnings = Array.isArray(item.warnings) ? item.warnings : [];
        genSteps = Array.isArray(item.steps) ? item.steps : [];
        $("genText").value = item.text || "";
        renderGenReport(item.report);
        renderGenSteps();
        $("btnGenUse").disabled = !genSteps.length;
        $("btnGenCopy").disabled = !$("genText").value;
        $("btnGenRegen").disabled = false;
        $("genFeedback").classList.add("show");
        $("genFeedbackHint").textContent = "这是历史记录，可评价或直接用到脚本模式。";
        setGenScore(Number(item.score) || 0);
        if (item.brief) $("genBrief").value = item.brief;
        stopGenTimer("");
        renderGenHistory();
        const card = $("genReport").closest(".create-card");
        if (card) card.scrollIntoView({ behavior: "smooth", block: "nearest" });
        log("已载入历史生成（" + fmtTime(item.created_at) + "）。", "ok");
      } catch (err) {
        log("载入历史失败：" + err.message, "err");
      }
    }

    async function clearGenHistory() {
      if (!genHistory.length) { log("没有可清空的生成历史。", "warn"); return; }
      if (!confirm("清空全部 " + genHistory.length + " 条生成历史？此操作不可恢复。")) return;
      try {
        const res = await api("/api/generate/history/clear", { method: "POST" });
        genCurrentId = "";
        log("已清空生成历史（" + ((res && res.cleared) || 0) + " 条）。", "ok");
        loadGenHistory();
      } catch (err) { log("清空失败：" + err.message, "err"); }
    }

    function renderGenReport(report) {
      const el = $("genReport");
      if (!report) { el.className = "gen-report"; el.innerHTML = ""; return; }
      const issues = (report.issues || []).filter(Boolean);
      const ruleInfo = report.rules ? "，已按 " + report.rules + " 条规则校验" : "";
      // 新范式：模型输出 JSON（或兜底文本），纠错轮走定向补丁 —— 把这两件事显示出来，
      // 用户才知道「它这次是怎么写出来的」，而不是只看到一个通过/不通过。
      let how = "";
      if (report.produce_mode === "patch") how = "，最后一轮用「定向补丁」修改";
      else if (report.patch_rounds) how = "，其中 " + report.patch_rounds + " 轮用「定向补丁」修改";
      if (!issues.length) {
        el.className = "gen-report show ok";
        el.innerHTML = "<b>✔ 校验通过</b>（共 " + (report.attempts || 1) + " 轮" + how + ruleInfo + "）" +
          ((report.attempts || 1) > 1 ? "，经 " + ((report.attempts || 1) - 1) + " 次自我纠错后达到。" : "，可直接使用。") +
          (report.auto_sunk ? "<br><span class=\"gr-item\">★ 已自动收进参考库（下次生成会用它当示范）</span>" : "");
      } else {
        el.className = "gen-report show err";
        el.innerHTML = "<b>✖ 仍有 " + issues.length + " 个问题</b>（已尝试 " + (report.attempts || 1) + " 轮" + how + ruleInfo + "）：" +
          issues.map((x) => '<span class="gr-item">• ' + esc(x) + '</span>').join("");
      }
    }

    function renderGenSteps() {
      const el = $("genSteps");
      updateGenStats();
      if (!genSteps.length) {
        el.innerHTML = '<div class="empty-script">生成后这里会预览步骤。</div>';
        return;
      }
      el.innerHTML = "";
      genSteps.forEach((step, index) => {
        const def = getDef(step.action);
        const card = document.createElement("div");
        card.className = "gen-step";
        card.innerHTML =
          '<span class="gs-index">' + (index + 1) + '</span>' +
          '<span class="gs-name">' + esc(def && def.icon ? def.icon + " " : "") + esc(step.action) + '</span>' +
          '<span class="gs-sum">' + esc(scriptStepSummary(step)) + '</span>';
        el.appendChild(card);
      });
    }

    async function loadGenRefs() {
      const el = $("genRefs");
      try {
        const res = await api("/api/reference-scripts");
        const scripts = (res && res.scripts) || [];
        if (!scripts.length) {
          el.innerHTML = '<div class="empty-script">还没有参考剧本，可在下方「新增参考剧本」粘贴保存。</div>';
          updateRefHint();
          return;
        }
        el.innerHTML = "";
        scripts.forEach((s) => {
          const item = document.createElement("label");
          item.className = "gen-ref-item" + (genSelectedRefs.has(s.id) ? " checked" : "");
          const cb = document.createElement("input");
          cb.type = "checkbox";
          cb.className = "gri-check";
          cb.checked = genSelectedRefs.has(s.id);
          cb.addEventListener("change", () => {
            if (cb.checked) genSelectedRefs.add(s.id); else genSelectedRefs.delete(s.id);
            item.classList.toggle("checked", cb.checked);
            updateRefHint();
            saveGenDraft();
          });
          const main = document.createElement("span");
          main.className = "gri-main";
          const meta = [(s.tags || []).slice(0, 4).join("、"), s.summary || ""].filter(Boolean).join(" · ");
          main.innerHTML =
            '<span class="gri-title">' + esc(s.title || "未命名") +
              (s.score ? ' <b class="gri-score">★' + s.score + '</b>' : '') + '</span>' +
            (meta ? '<span class="gri-meta">' + esc(meta) + '</span>' : '');
          const del = document.createElement("button");
          del.type = "button";
          del.className = "icon-btn danger gri-del";
          del.title = "删除该参考剧本";
          del.textContent = "×";
          del.addEventListener("click", async (e) => {
            e.preventDefault();
            if (!confirm("确定删除参考剧本《" + (s.title || "未命名") + "》吗？")) return;
            try {
              await api("/api/reference-scripts/" + s.id, { method: "DELETE" });
              genSelectedRefs.delete(s.id);
              loadGenRefs();
              log("已删除参考剧本。", "ok");
            } catch (err) { log("删除失败：" + err.message, "err"); }
          });
          item.appendChild(cb); item.appendChild(main); item.appendChild(del);
          el.appendChild(item);
        });
        updateRefHint();
      } catch (err) {
        el.innerHTML = '<div class="empty-script">参考剧本加载失败：' + esc(err.message) + '</div>';
      }
    }

    async function doGenerate() {
      const brief = $("genBrief").value.trim();
      if (!brief) { alert("请先填创作主题。"); $("genBrief").focus(); return; }
      if (!llmConfigured) { alert("请先点顶部「配置大模型」填入 DeepSeek API Key。"); return; }
      const btn = $("btnGenerate");
      const old = btn.textContent;
      btn.disabled = true;
      btn.textContent = "生成中…";
      $("btnGenRegen").disabled = true;
      saveGenDraft();
      const t0 = Date.now();
      startGenTimer();
      log("正在生成剧本并自动校验纠错……", "warn");
      try {
        const res = await api("/api/generate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            brief,
            category: $("genCategory").value,
            reference_ids: Array.from(genSelectedRefs)
          })
        });
        if (!res.ok) { stopGenTimer("生成失败：" + (res.msg || "未知错误")); log(res.msg || "生成失败", "err"); return; }
        genCurrentBrief = brief;
        genCurrentId = res.history_id || "";
        lastGenWarnings = (res.warnings) || [];
        genSteps = Array.isArray(res.steps) ? res.steps : [];
        $("genText").value = res.text || "";
        renderGenReport(res.report);
        renderGenSteps();
        $("btnGenUse").disabled = false;
        $("btnGenCopy").disabled = false;
        $("btnGenRegen").disabled = false;
        $("genFeedback").classList.add("show");
        $("genFeedbackHint").textContent = "";
        setGenScore(0);
        // 上一轮评价的规则回执不要残留在这一轮里
        genCandidates = [];
        renderGenCandidates();
        const secs = Math.round((Date.now() - t0) / 1000);
        stopGenTimer("生成完成，用时 " + secs + " 秒。");
        const _refs = (res.ref_titles || []).join("、");
        if (_refs) log("本次参考剧本：" + _refs + (res.auto_refs ? "（按主题自动挑选）" : "（手动勾选）"), "ok");
        log("生成完成，共 " + genSteps.length + " 步，用时 " + secs + " 秒" +
            (lastGenWarnings.length ? "，有 " + lastGenWarnings.length + " 条软提示。" : "。"), "ok");
        loadGenHistory();
        const card = $("genReport").closest(".create-card");
        if (card) card.scrollIntoView({ behavior: "smooth", block: "nearest" });
      } catch (err) {
        stopGenTimer("生成失败：" + err.message);
        log("生成失败：" + err.message, "err");
      } finally {
        btn.disabled = false;
        btn.textContent = old;
        // 失败时也要让「重新生成 / 复制」回到与当前结果匹配的可用状态
        $("btnGenRegen").disabled = !genSteps.length;
        $("btnGenCopy").disabled = !$("genText").value;
      }
    }

    function useToScript() {
      if (!genSteps.length) { alert("还没有生成结果，先点「生成剧本」。"); return; }
      scriptSteps = JSON.parse(JSON.stringify(genSteps));
      scriptSelected = -1;
      scriptEditIndex = -1;
      $("scriptInput").value = $("genText").value || "";
      $("scriptEditArea").hidden = true;
      syncImageAttach();
      renderScriptWarnings(lastGenWarnings || []);
      renderScriptPreview();
      saveScriptDraft();
      setView("script");
      log("已把创作结果用到脚本模式，可编辑、配图后一键运行录屏。", "ok");
    }

    function setGenScore(v) {
      genScore = v;
      document.querySelectorAll("#genStarRow .star").forEach((s) => {
        s.classList.toggle("lit", Number(s.dataset.v) <= v);
      });
    }

    async function submitGenFeedback() {
      if (!genScore) { alert("请先点星打 1~5 分。"); return; }
      const comment = $("genComment").value.trim();
      if (!comment) { alert("请写一句评价，系统要从里面拆出可校验的规则。"); return; }
      const score = genScore;
      const btn = $("btnGenFeedback");
      const oldLabel = btn.textContent;
      btn.disabled = true;
      btn.textContent = "拆解中…";
      $("genFeedbackHint").textContent = "正在把你的评价拆成可校验的规则…";
      try {
        const res = await api("/api/feedback", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            score,
            comment,
            brief: genCurrentBrief,
            category: $("genCategory").value,
            history_id: genCurrentId
          })
        });
        if (!res.ok) {
          $("genFeedbackHint").textContent = "提交失败：" + (res.msg || "未知错误");
          log(res.msg || "提交失败", "err");
          return;
        }
        // 提交成功：清空留言、重置星级，并给出明确状态
        $("genComment").value = "";
        setGenScore(0);
        genCandidates = (res && (res.saved && res.saved.length ? res.saved : res.candidates)) || [];
        renderGenCandidates();
        const n = genCandidates.length;
        $("genFeedbackHint").textContent = "✓ 已记录 " + score + " 星" +
          (n ? "，已自动生效 " + n + " 条规则（规则库共 " + (res.enabled_skills || 0) + " 条生效）"
             : "（没拆出可执行规则，可在规则库手动加）");
        log("评价已记录（" + score + " 星）。" +
            (n ? "已自动生效 " + n + " 条规则，下次生成会用到。" : ""), "ok");
        loadGenSkills();
        loadGenFeedbackHistory();
        loadGenHistory();
      } catch (err) {
        $("genFeedbackHint").textContent = "提交失败：" + err.message;
        log("评价提交失败：" + err.message, "err");
      } finally {
        btn.disabled = false;
        btn.textContent = oldLabel;
      }
    }

    /* ================= 规则库（评价沉淀成的可校验规则） ================= */

    function skillValueText(s) {
      const v = s && s.value;
      if (v === null || v === undefined || v === "") return "";
      if (Array.isArray(v)) return v.join("、");
      if (typeof v === "object") return JSON.stringify(v);
      return String(v);
    }

    async function loadGenSkills() {
      const el = $("genSkillList");
      try {
        const res = await api("/api/skills");
        genSkills = (res && res.items) || [];
        genSkillKinds = (res && res.kinds) || [];
        renderGenSkills();
      } catch (err) {
        el.innerHTML = '<div class="empty-script">规则库加载失败：' + esc(err.message) + '</div>';
      }
    }

    function renderGenSkills() {
      const el = $("genSkillList");
      const on = genSkills.filter((s) => s.enabled).length;
      $("genSkillCount").textContent = genSkills.length + " 条（启用 " + on + "）";
      if (!genSkills.length) {
        el.innerHTML = '<div class="empty-script">还没有规则，提交评价后会自动拆解。</div>';
        return;
      }
      el.innerHTML = "";
      genSkills.forEach((s) => {
        const item = document.createElement("div");
        item.className = "gen-skill-item" + (s.enabled ? " on" : "");
        const val = skillValueText(s);
        const kind = s.kind
          ? '<span class="gsk-kind">' + esc(s.kind_label || s.kind) + '</span>'
          : '<span class="gsk-kind style">风格</span>';
        item.innerHTML =
          '<div class="gsk-top">' +
            '<label class="gsk-check"><input type="checkbox"' + (s.enabled ? " checked" : "") + '>' +
              '<span>' + esc(s.title || "(未命名)") + '</span></label>' +
            '<span class="spacer" style="flex:1"></span>' +
            '<span class="gsk-hits" title="被校验器命中的次数">命中 ' + (s.hits || 0) + '</span>' +
            '<button type="button" class="gsk-val" data-act="edit" title="编辑这条规则">编辑</button>' +
            '<button type="button" class="icon-btn danger" data-act="del" title="删除规则">×</button>' +
          '</div>' +
          '<div class="gsk-meta">' + kind +
            (val ? '<span class="gsk-val">' + esc(val) + '</span>' : '') +
            (s.prompt_hint ? '<span class="gsk-src">' + esc(s.prompt_hint) + '</span>' : '') +
            (s.source_note ? '<span class="gsk-src">' + esc(s.source_note) + '</span>' : '') +
          '</div>';
        item.querySelector("input[type=checkbox]").addEventListener("change", async (e) => {
          try {
            await api("/api/skills/" + s.id, {
              method: "POST", headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ enabled: e.target.checked })
            });
            loadGenSkills();
          } catch (err) { log("切换规则失败：" + err.message, "err"); }
        });
        const editBtn = item.querySelector('[data-act="edit"]');
        if (editBtn) editBtn.addEventListener("click", () => openSkillEditor(s));
        item.querySelector('[data-act="del"]').addEventListener("click", async () => {
          if (!confirm("删除这条规则？")) return;
          try {
            await api("/api/skills/" + s.id, { method: "DELETE" });
            loadGenSkills();
            log("已删除规则。", "ok");
          } catch (err) { log("删除失败：" + err.message, "err"); }
        });
        el.appendChild(item);
      });
    }

    /* ---- 规则编辑（新增 / 修改类型、数值、标题、提示词） ---- */
    let genSkillEditing = null;   // null = 新增；否则为正在编辑的规则对象

    function skillKindOptions(curKind) {
      const opts = ['<option value="">风格（只写进提示词，不校验）</option>'];
      (genSkillKinds || []).forEach((k) => {
        opts.push('<option value="' + esc(k.kind) + '"' +
          (k.kind === curKind ? " selected" : "") + '>' + esc(k.label) + '</option>');
      });
      return opts.join("");
    }

    function openSkillEditor(s) {
      genSkillEditing = s || null;
      const el = $("genSkillEditor");
      el.hidden = false;
      el.innerHTML =
        '<div class="gsk-edit">' +
          '<div class="gsk-row"><b style="font-size:12px">' +
            (s ? "编辑规则" : "新增规则") + '</b></div>' +
          '<div class="gsk-row">' +
            '<select id="gskKind">' + skillKindOptions(s && s.kind) + '</select>' +
            '<input id="gskValue" placeholder="数值，如 2 / 15（风格可留空）" value="' +
              esc(skillValueText(s)) + '">' +
          '</div>' +
          '<input id="gskTitle" placeholder="规则标题，如「历史会话同一人最多连续 2 条」" value="' +
            esc((s && s.title) || "") + '">' +
          '<textarea id="gskHint" placeholder="写进提示词的命令句，如「历史会话里同一个人最多连续发 2 条」">' +
            esc((s && s.prompt_hint) || "") + '</textarea>' +
          '<div class="gsk-tip">类型决定校验方式（如「至少几处插话」填整数、「历史会话必须双方有来有回」填 true）；' +
            '「风格」只影响提示词、不参与校验。</div>' +
          '<div class="gsk-row">' +
            '<button type="button" class="btn primary small" id="gskSave">保存</button>' +
            '<button type="button" class="btn small ghost" id="gskCancel">取消</button>' +
          '</div>' +
        '</div>';
      $("gskSave").addEventListener("click", saveSkillEditor);
      $("gskCancel").addEventListener("click", () => {
        el.hidden = true;
        el.innerHTML = "";
        genSkillEditing = null;
      });
    }

    function parseSkillValue(raw) {
      const v = String(raw == null ? "" : raw).trim();
      if (v === "") return null;
      if (v === "true") return true;
      if (v === "false") return false;
      if (/^-?\d+$/.test(v)) return parseInt(v, 10);
      return v;
    }

    async function saveSkillEditor() {
      const kind = $("gskKind").value || null;
      const payload = {
        title: $("gskTitle").value.trim(),
        kind: kind,
        value: parseSkillValue($("gskValue").value),
        prompt_hint: $("gskHint").value.trim(),
        type: kind ? "rule" : "style"
      };
      if (!payload.title && !payload.prompt_hint) {
        alert("标题或提示词至少填一个。");
        return;
      }
      try {
        if (genSkillEditing) {
          await api("/api/skills/" + genSkillEditing.id, {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });
          log("已更新规则。", "ok");
        } else {
          await api("/api/skills", {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify(Object.assign({ enabled: true, source_note: "手动添加" }, payload))
          });
          log("已新增规则。", "ok");
        }
        $("genSkillEditor").hidden = true;
        $("genSkillEditor").innerHTML = "";
        genSkillEditing = null;
        loadGenSkills();
      } catch (err) { log("保存规则失败：" + err.message, "err"); }
    }

    async function loadGenFeedbackHistory() {
      const el = $("genFeedbackList");
      if (!el) return;
      try {
        const res = await api("/api/feedback");
        const items = (res && res.items) || [];
        if (!items.length) {
          el.innerHTML = '<div class="empty-script">还没有评价记录。</div>';
          return;
        }
        el.innerHTML = "";
        items.forEach((f) => {
          const row = document.createElement("div");
          row.className = "gen-skill-item";
          const when = f.created_at ? new Date(f.created_at * 1000).toLocaleString() : "";
          row.innerHTML =
            '<div class="gsk-top"><b>★' + esc(String(f.score || "")) + '</b>' +
              '<span class="gsk-src">' + esc(f.brief || "") + '</span>' +
              '<span class="spacer" style="flex:1"></span>' +
              '<span class="gsk-hits">' + esc(when) + '</span></div>' +
            '<div class="gsk-meta">' + esc((f.comment || "").slice(0, 120)) + '</div>';
          el.appendChild(row);
        });
      } catch (err) {
        el.innerHTML = '<div class="empty-script">评价记录加载失败：' + esc(err.message) + '</div>';
      }
    }

    function renderGenCandidates() {
      const el = $("genCandidates");
      if (!genCandidates.length) { el.hidden = true; el.innerHTML = ""; return; }
      el.hidden = false;
      el.innerHTML =
        '<div class="gsc-title">✓ 本次评价已自动生效 ' + genCandidates.length +
          ' 条规则：下次生成会写进提示词并逐条校验（不想要可在下方「规则库」关掉）</div>' +
        '<div class="gsc-list"></div>';
      const list = el.querySelector(".gsc-list");
      genCandidates.forEach((c) => {
        const row = document.createElement("div");
        row.className = "gsc-item";
        row.innerHTML =
          '<span class="gsc-main"><b>' + esc(c.title || c.prompt_hint || "规则") + '</b>' +
            '<span class="gsc-sub">' + esc(c.prompt_hint || "") + '</span></span>' +
          (c.kind ? '<span class="gsk-kind">' + esc(c.kind_label || c.kind) + '</span>'
                  : '<span class="gsk-kind style">风格</span>');
        list.appendChild(row);
      });
    }

    async function addGenRef() {
      const text = $("genNewRef").value.trim();
      if (!text) { alert("请先粘贴要保存的参考剧本。"); return; }
      const title = ($("genNewRefTitle").value || "").trim();
      try {
        const res = await api("/api/reference-scripts", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ title, text })
        });
        if (!res.ok) { log(res.msg || "保存失败", "err"); return; }
        $("genNewRef").value = "";
        $("genNewRefTitle").value = "";
        loadGenRefs();
        log("已保存参考剧本《" + ((res.item && res.item.title) || title || "自动命名") +
            "》，可在上方勾选后用于生成。", "ok");
      } catch (err) {
        log("保存失败：" + err.message, "err");
      }
    }

    function initGenPanel() {
      restoreGenDraft();
      $("btnGenerate").onclick = doGenerate;
      $("btnGenUse").onclick = useToScript;
      $("btnGenCopy").onclick = async () => {
        const ok = await copyText($("genText").value);
        log(ok ? "已复制生成文本。" : "复制失败，请手动全选复制。", ok ? "ok" : "warn");
      };
      $("btnGenRegen").onclick = doGenerate;
      $("btnGenRefreshRefs").onclick = loadGenRefs;
      $("btnGenClearRefs").onclick = () => {
        genSelectedRefs.clear();
        saveGenDraft();
        loadGenRefs();
      };
      $("btnGenAddRef").onclick = addGenRef;
      $("btnGenFeedback").onclick = submitGenFeedback;
      $("btnGenSkillRefresh").onclick = loadGenSkills;
      $("btnGenSkillAdd").onclick = () => openSkillEditor(null);
      $("btnGenHistoryRefresh").onclick = loadGenHistory;
      $("btnGenHistoryClear").onclick = clearGenHistory;
      $("genHistorySearch").addEventListener("input", (e) => {
        genHistoryQuery = e.target.value || "";
        renderGenHistory();
      });
      $("genBrief").addEventListener("input", saveGenDraft);
      $("genCategory").addEventListener("change", saveGenDraft);
      $("genBrief").addEventListener("keydown", (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === "Enter") { e.preventDefault(); doGenerate(); }
      });
      $("genText").addEventListener("input", updateGenStats);
      document.querySelectorAll("#genStarRow .star").forEach((s) => {
        s.addEventListener("click", () => setGenScore(Number(s.dataset.v)));
      });
      updateRefHint();
      loadGenRefs();
      loadGenSkills();
      loadGenFeedbackHistory();
      loadGenHistory();
    }

    /* ================= 初始化 ================= */
    async function init() {
      restoreLocal();
      // 打字倍速：记忆最近一次设置，运行确认弹窗打开时用所选速度（不随刷新/重启丢失）
      const savedTs = localStorage.getItem("runTypingSpeed");
      if (savedTs && isFinite(Number(savedTs))) {
        $("runTypingSpeed").value = Math.max(1, Math.min(40, Number(savedTs)));
      }
      $("runTypingSpeed").addEventListener("input", () => {
        localStorage.setItem("runTypingSpeed", $("runTypingSpeed").value);
      });
      $("flowName").value = workflow.name || "未命名流程";
      renderCanvas();
      renderProps();
      updateSaveState();
      // 脚本模式初始化：恢复草稿 + 渲染预览 + 读取大模型配置状态
      restoreScriptDraft();
      renderScriptWarnings([]);
      renderScriptPreview();
      refreshLlmStatus();
      initGenPanel();

      try {
        ACTIONS = await api("/api/actions");
        ACTIONS_BY_NAME = {};
        ACTIONS.forEach((a) => { ACTIONS_BY_NAME[a.action] = a; });
        $("actionCount").textContent = ACTIONS.length + " 个";
        renderPalette("");
        log("动作库已加载：" + ACTIONS.length + " 个动作。", "ok");
      } catch (err) {
        log("动作库加载失败：" + err.message, "err");
      }

      try {
        const remote = await api("/api/workflow");
        const hasLocalSteps = workflow.steps.length > 0;
        if (!hasLocalSteps && remote && remote.steps && remote.steps.length) {
          workflow = normalizeWorkflow(remote);
          $("flowName").value = workflow.name || "未命名流程";
          renderCanvas();
          renderProps();
          log("已载入服务端 workflow.json。", "ok");
        }
      } catch (err) {
        // 如果本地编辑器还没启动服务，这里失败是正常的。
      }

      renderCanvas();
      renderProps();
      updateSaveState();
    }

    /* ================= 事件绑定 ================= */
    $("btnRun").onclick = () => requestRunWorkflow(0);
    $("btnStop").onclick = stopRun;
    $("btnSave").onclick = saveRemote;
    $("btnLoad").onclick = loadRemote;
    $("btnNew").onclick = newWorkflow;
    $("btnImport").onclick = importJson;
    $("btnExport").onclick = exportJson;
    $("btnUndo").onclick = () => undo();
    $("btnRedo").onclick = () => redo();
    $("btnDuplicate").onclick = () => duplicateStep(selected);
    $("btnDelete").onclick = () => removeStep(selected);
    /* 帮助问号：点「?」弹出对应说明（纯展示层） */
    document.addEventListener("click", (event) => {
      const q = event.target.closest(".hq");
      document.querySelectorAll(".hq-pop").forEach((p) => {
        if (!q || p.parentElement.querySelector(".hq") !== q) p.remove();
      });
      if (!q) return;
      event.preventDefault();
      const src = document.querySelector(q.getAttribute("data-help"));
      if (!src) return;
      const pop = document.createElement("div");
      pop.className = "hq-pop";
      pop.innerHTML = src.innerHTML;
      q.parentElement.appendChild(pop);
    });
    /* 键盘快捷键：焦点在输入框里时不拦截 */
    document.addEventListener("keydown", (event) => {
      const t = event.target;
      const typing = t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.tagName === "SELECT" || t.isContentEditable);
      const mod = event.ctrlKey || event.metaKey;
      if (mod && !event.shiftKey && (event.key === "z" || event.key === "Z")) {
        if (!typing) { event.preventDefault(); undo(); }
        return;
      }
      if (mod && ((event.shiftKey && (event.key === "Z" || event.key === "z")) || event.key === "y" || event.key === "Y")) {
        if (!typing) { event.preventDefault(); redo(); }
        return;
      }
      if (typing) return;
      if (mod && (event.key === "d" || event.key === "D")) {
        event.preventDefault();
        if (selected >= 0 && selected < workflow.steps.length) duplicateStep(selected);
        return;
      }
      if (event.key === "Delete" || event.key === "Backspace") {
        if (selected >= 0 && selected < workflow.steps.length) { event.preventDefault(); removeStep(selected); }
      }
    });
    $("btnRunFrom").onclick = () => {
      if (selected < 0 || selected >= workflow.steps.length) {
        alert("请先在中间流程中选中一个步骤。");
        return;
      }
      requestRunWorkflow(selected);
    };
    $("btnLive").onclick = () => {
      const panel = $("livePanel");
      if (panel.hidden) {
        openLivePanel();
        log("已打开实时画面预览。", "ok");
      } else {
        closeLivePanel();
        log("已关闭实时画面预览。", "ok");
      }
    };
    $("btnLiveClose").onclick = () => closeLivePanel();
    $("btnEditMode").onclick = startEditMode;
    $("modeTap").onclick = () => setPickMode(false);
    $("modePick").onclick = () => setPickMode(true);
    $("liveImg").addEventListener("click", onScreenClick);
    $("btnType").onclick = doType;
    $("liveTypeInput").addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        doType();
      }
    });
    $("btnVideos").onclick = () => fetch("/api/openvideos");
    $("btnClearLog").onclick = () => {
      $("logBody").innerHTML = "";
      logOffset = 0;
      log("日志已清空。", "ok");
    };
    $("btnShot").onclick = async () => {
      log("正在生成首页截图……");
      try {
        const res = await api("/api/screenshot");
        if (res.ok && res.file) {
          window.open("/shot/" + res.file, "_blank");
          log("截图已生成：" + res.file, "ok");
        } else {
          log("截图失败：" + (res.msg || "未知错误"), "err");
        }
      } catch (err) {
        log("截图失败：" + err.message, "err");
      }
    };
    // 独立场景编辑器：菜单编辑整机内容（可放大、点选即改），一键生成工作流
    $("btnScene").onclick = () => {
      const w = window.open("/scene", "_blank");
      if (!w) log("弹窗被拦截，请允许本站打开新窗口，或直接在浏览器访问 /scene。", "warn");
    };

    $("btnConcurrent").onclick = () => {
      const w = window.open("/concurrent", "_blank");
      if (!w) log("弹窗被拦截，请允许本站打开新窗口，或直接在浏览器访问 /concurrent。", "warn");
    };

    $("searchBox").oninput = (event) => renderPalette(event.target.value);
    $("flowName").oninput = () => {
      workflow.name = $("flowName").value || "未命名流程";
      markDirty();
      saveLocalDebounced();
    };
    $("fileInput").onchange = (event) => {
      handleImport(event.target.files && event.target.files[0]);
      event.target.value = "";
    };

    document.addEventListener("keydown", (event) => {
      const key = event.key.toLowerCase();
      if ((event.ctrlKey || event.metaKey) && key === "s") {
        event.preventDefault();
        saveRemote();
      }
      if ((event.ctrlKey || event.metaKey) && key === "enter") {
        event.preventDefault();
        requestRunWorkflow();
      }
    });

    /* ================= 脚本模式事件绑定 ================= */
    $("btnViewFlow").onclick = () => setView("flow");
    $("btnViewScript").onclick = () => setView("script");
    $("btnViewGenerate").onclick = () => setView("generate");
    $("btnLlmConfig").onclick = openLlmModal;
    $("btnSaveLlm").onclick = saveLlmConfig;
    $("btnCancelLlm").onclick = closeLlmModal;
    $("btnTranslate").onclick = () => doTranslate(false);
    $("btnOffline").onclick = () => doTranslate(true);
    $("btnRunScript").onclick = requestRunScript;
    if ($("btnMoments")) {
      $("btnMoments").onclick = () => {
        const cur = scriptSteps[scriptSelected];
        openMomentsPanel(cur && cur.action === "进入对方朋友圈" ? "peer" : "me");
      };
    }
    $("btnInsertImg").onclick = () => {
      const ta = $("scriptInput");
      const marker = "[对方发图片] [图片] ";
      const v = ta.value;
      // 在光标处插入，无光标时光标在末尾（聚焦后选中长度写0）
      const s = ta.selectionStart == null ? v.length : ta.selectionStart;
      const e = ta.selectionEnd == null ? v.length : ta.selectionEnd;
      let pre = v.slice(0, s);
      let post = v.slice(e);
      // 避免紧跟上一行，保证换行
      if (pre && !pre.endsWith("\n")) pre += "\n";
      if (post && !post.startsWith("\n")) post = "\n" + post;
      const insert = marker + "{在这里填这张图的描述}";
      ta.value = pre + insert + post;
      const pos = pre.length + marker.length;
      ta.setSelectionRange(pos, pos + "{在这里填这张图的描述}".length);
      ta.focus();
      saveScriptDraft();
      log("已插入一条图片消息：转译后会成为一个「待配图」卡槽，可点「上传图片（按顺序）」配图。", "ok");
    };
    $("btnInsertHistory").onclick = () => {
      const ta = $("scriptInput");
      const v = ta.value;
      // 在光标处插入，无光标时光标在末尾（聚焦后选中长度写0）
      const s = ta.selectionStart == null ? v.length : ta.selectionStart;
      const e = ta.selectionEnd == null ? v.length : ta.selectionEnd;
      let pre = v.slice(0, s);
      let post = v.slice(e);
      if (pre && !pre.endsWith("\n")) pre += "\n";
      if (post && !post.startsWith("\n")) post = "\n" + post;
      const insert = "[历史会话]\n"
        + "[会话] 香儿\n"
        + "香儿：我今晚好想哭\n"
        + "我：哭什么呀\n"
        + "[会话] 小明\n"
        + "小明：周末有空吗\n"
        + "我：有的，怎么了\n"
        + "[历史会话结束]\n";
      ta.value = pre + insert + post;
      const pos = (pre + "[历史会话]\n[会话] 香儿\n").length;
      ta.setSelectionRange(pos, pos + 6);
      ta.focus();
      saveScriptDraft();
      log("已插入历史会话块：可改会话名/人名/对白，转译后自动生成 [编辑主页]，再在后面写动作剧本。", "ok");
    };
    $("btnLoadExample").onclick = loadScriptExample;
    $("btnClearScript").onclick = () => {
      $("scriptInput").value = "";
      saveScriptDraft();
      log("剧本已清空。", "ok");
    };
    $("btnApplyEdit").onclick = applyScriptEdit;
    $("btnCancelEdit").onclick = cancelScriptEdit;
    $("scriptInput").addEventListener("input", saveScriptDraft);

    // 运行确认弹窗按钮 + 点击遮罩/Esc 取消
    $("btnRunConfirm").onclick = confirmRunAction;
    $("btnRunCancel").onclick = cancelRunAction;
    $("btnRunUpload").onclick = () => {
      if (!window.__wxPick || !imageSlots.length) return;
      const inp = document.createElement("input");
      inp.type = "file";
      inp.multiple = true;
      inp.accept = "image/png,image/jpeg,image/gif,image/webp,image/bmp";
      inp.onchange = () => {
        if (!inp.files.length) return;
        const files = Array.from(inp.files).slice(0, Math.max(1, imageSlots.length));
        window.__wxPick.uploadFiles(files, (paths) => {
          paths.forEach((p, i) => { if (imageSlots[i]) assignImageSlot(imageSlots[i], p); });
        });
      };
      inp.click();
    };
    $("confirmRunModal").addEventListener("click", (event) => {
      if (event.target === $("confirmRunModal")) cancelRunAction();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !$("confirmRunModal").hidden) cancelRunAction();
    });

    init();
  </script>
  <script>
  /* ================= 离线使用手册（📖 使用手册） ================= */
  (function () {
    "use strict";
    const overlay = document.getElementById("manualOverlay");
    if (!overlay) return;
    const navEl = document.getElementById("manualNav");
    const contentEl = document.getElementById("manualContent");
    const footEl = document.getElementById("manualFoot");
    const searchEl = document.getElementById("manualSearch");
    const searchClearEl = document.getElementById("manualSearchClear");
    const closeEl = document.getElementById("manualClose");
    const btn = document.getElementById("btnManual");

    const data = window.WX_MANUAL || { categories: [] };
    const cats = Array.isArray(data.categories) ? data.categories : [];
    let activeId = cats.length ? cats[0].id : null;

    const esc = (s) => String(s == null ? "" : s)
      .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");

    function hl(text, q) {
      const safe = esc(text);
      if (!q) return safe;
      try {
        const re = new RegExp("(" + q.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + ")", "gi");
        return safe.replace(re, '<mark class="manual-hit">$1</mark>');
      } catch (e) { return safe; }
    }

    function itemMatches(it, q) {
      if (!q) return true;
      const hay = [it.name, it.tag, it.syntax, it.desc, it.example,
        (it.bullets || []).join(" ")].join("\n").toLowerCase();
      return hay.indexOf(q) !== -1;
    }

    function renderItem(it, q) {
      const out = [];
      out.push('<div class="manual-item">');
      out.push('<div class="manual-item-head">');
      out.push('<span class="manual-item-name">' + hl(it.name || "", q) + "</span>");
      if (it.tag) out.push('<span class="manual-item-tag">' + esc(it.tag) + "</span>");
      out.push("</div>");
      if (it.desc) out.push('<p class="manual-item-desc">' + hl(it.desc, q) + "</p>");
      if (it.syntax) out.push('<code class="manual-syntax">' + hl(it.syntax, q) + "</code>");
      if (it.bullets && it.bullets.length) {
        out.push("<ul>" + it.bullets.map((b) => "<li>" + hl(b, q) + "</li>").join("") + "</ul>");
      }
      if (it.example) {
        out.push('<div class="manual-example-label">示例</div>');
        out.push('<code class="manual-syntax">' + hl(it.example, q) + "</code>");
      }
      out.push("</div>");
      return out.join("");
    }

    function render() {
      const q = (searchEl.value || "").trim().toLowerCase();
      searchClearEl.hidden = !q;

      navEl.innerHTML = cats.map((c) => {
        const n = (c.items || []).filter((it) => itemMatches(it, q)).length;
        return '<button type="button" class="manual-nav-item' + (c.id === activeId ? " active" : "") +
          '" data-cat="' + esc(c.id) + '"><span>' + (c.icon || "📄") + "</span><span>" + esc(c.title) +
          '</span><span class="count">' + n + "</span></button>";
      }).join("");

      const blocks = [];
      cats.forEach((c) => {
        const items = (c.items || []).filter((it) => itemMatches(it, q));
        if (q && !items.length) return;
        blocks.push('<section class="manual-section" data-cat="' + esc(c.id) + '">');
        blocks.push('<div class="manual-section-head"><h2>' + (c.icon || "") + " " + esc(c.title) + "</h2></div>");
        if (c.intro) blocks.push('<p class="manual-section-intro">' + hl(c.intro, q) + "</p>");
        blocks.push(items.map((it) => renderItem(it, q)).join(""));
        blocks.push("</section>");
      });
      contentEl.innerHTML = blocks.length ? blocks.join("") :
        '<div class="manual-empty">没有找到匹配的内容，换个关键词试试。</div>';

      const total = cats.reduce((s, c) => s + ((c.items || []).length), 0);
      const shown = q
        ? cats.reduce((s, c) => s + (c.items || []).filter((it) => itemMatches(it, q)).length, 0)
        : total;
      footEl.innerHTML = q
        ? '搜索「<b>' + esc(searchEl.value.trim()) + '</b>」：命中 <b>' + shown + "</b> / " + total + " 条"
        : "共 <b>" + cats.length + "</b> 个分类、<b>" + total + "</b> 条功能说明 · 更新于 <b>" +
          esc(data.updatedAt || "-") + "</b>";

      if (q) {
        const first = contentEl.querySelector(".manual-section");
        if (first) first.scrollIntoView({ block: "start" });
      }
    }

    function openManual() {
      overlay.hidden = false;
      render();
      setTimeout(() => searchEl.focus(), 30);
    }
    function closeManual() {
      overlay.hidden = true;
      searchEl.value = "";
      render();
    }

    if (btn) btn.onclick = openManual;
    closeEl.onclick = closeManual;
    overlay.addEventListener("click", (e) => { if (e.target === overlay) closeManual(); });
    navEl.addEventListener("click", (e) => {
      const b = e.target.closest(".manual-nav-item");
      if (!b) return;
      const id = b.getAttribute("data-cat");
      const sec = contentEl.querySelector('.manual-section[data-cat="' + id + '"]');
      if (sec) sec.scrollIntoView({ behavior: "smooth", block: "start" });
      activeId = id;
      navEl.querySelectorAll(".manual-nav-item").forEach((x) => x.classList.toggle("active", x === b));
    });
    searchEl.addEventListener("input", render);
    searchClearEl.onclick = () => { searchEl.value = ""; render(); searchEl.focus(); };
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !overlay.hidden) closeManual();
    });
  })();
  </script>
  <script src="/shared_picker.js"></script>
  <!-- 朋友圈设置面板：离线解析检测到「进入朋友圈 / 进入对方朋友圈」时自动弹出 -->
  <script src="/moments_editor.js"></script>
</body>
</html>